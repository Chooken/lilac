Const[T]: object {

    private {
        value: T
    }

    create: function(value: T) constant: Const[T] {
        constant = Const[T] { value = value }
    }

    get: function(self) value: T {
        value = self.value
    }

    @on_override: function(prev: ref Const[T], new: ref Const[T]) nothing {
        @compile_error("You cannot override a constant value.")
    }
}