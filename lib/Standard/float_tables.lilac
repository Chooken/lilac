    /// Entry `j` of the exp table: `2^(j / 128) = a + b + l`, with `a` 26 bits and `a + b` a double.
    exp_table_entry: function (j: Int32) (a: Float64, b: Float64, l: Float64) {
        view: ref @array(@fbit64, 384) = (ref exp_table) as ref unknown as ref @array(@fbit64, 384)
        base: @bit_native = (j * 3).to_uint_wrapping() as @bit_native
        raw_a: @fbit64 = @array_at(view, base)
        raw_b: @fbit64 = @array_at(view, @i_add_native(base, 0x1))
        raw_l: @fbit64 = @array_at(view, @i_add_native(base, 0x2))
        a = raw_a as Float64
        b = raw_b as Float64
        l = raw_l as Float64
    }

    /// `(e^r - 1 - r) / r^2` for `|r| <= ln 2 / 256` in plain `Float64` (to `r^4 / 720`).
    exp_fast_poly: function (r: Float64) Float64 =>
        ((((0.001388888888888889 * r + 0.008333333333333333) * r + 0.041666666666666664) * r + 0.16666666666666666) * r + 0.5)

    LN_FAST_SPLIT: Int32 => 53

    /// `ln 2` in 42 bits, so that an exponent times it is exact ...
    LN_2_HIGH42: Float64 => 0.6931471805598903

    /// ... and the rest of it.
    LN_2_LOW42: Float64 => 5.497923018708371e-14

