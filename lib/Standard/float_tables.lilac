        raw_r: @fbit64 = @array_at(view, base)
        raw_h: @fbit64 = @array_at(view, @i_add_native(base, 0x1))
        raw_l: @fbit64 = @array_at(view, @i_add_native(base, 0x2))
        r = raw_r as Float64
        t = Dd.new(raw_h as Float64, raw_l as Float64)
    }

    /// `(ln(1 + z) - z + z^2 / 2) / z^3` for `|z| <= 2^-7` in plain `Float64` (to `z^7 / 10`).
    ln_fast_poly: function (z: Float64) Float64 =>
        (((((((-0.1 * z + 0.1111111111111111) * z + -0.125) * z + 0.14285714285714285) * z + -0.16666666666666666) * z + 0.2) * z + -0.25) * z + 0.3333333333333333)

    /// `(sin t - t) / (t z)` for `|t| <= pi / 4 + eps`, `z = t^2`, as a polynomial in `z`.
    sin_poly: function (z: Dd) res: Dd {
        t: Float64 = -1.216125041553518e-34
        t = t * z.hi + 1.1309962886447716e-31
        t = t * z.hi + -9.183689863795546e-29
        t = t * z.hi + 6.446950284384474e-26
        t = t * z.hi + -3.868170170630684e-23
        t = t * z.hi + 1.9572941063391263e-20
        t = t * z.hi + -8.22063524662433e-18
        res = Dd.of(t)
        res = res * z + Dd.new(2.8114572543455206e-15, 1.6508842730861433e-31)
        res = res * z + Dd.new(-7.647163731819816e-13, -7.03872877733453e-30)
        res = res * z + Dd.new(1.6059043836821613e-10, 1.2585294588752098e-26)
        res = res * z + Dd.new(-2.505210838544172e-08, 1.448814070935912e-24)
        res = res * z + Dd.new(2.7557319223985893e-06, -1.858393274046472e-22)
        res = res * z + Dd.new(-0.0001984126984126984, -1.7209558293420705e-22)
        res = res * z + Dd.new(0.008333333333333333, 1.1564823173178714e-19)
        res = res * z + Dd.new(-0.16666666666666666, -9.25185853854297e-18)
    }

    /// `(cos t - 1) / z` for `|t| <= pi / 4 + eps`, `z = t^2`, as a polynomial in `z`.
    cos_poly: function (z: Dd) res: Dd {
        t: Float64 = -3.7699876288159054e-33
        t = t * z.hi + 3.279889237069838e-30
        t = t * z.hi + -2.4795962632247976e-27
        t = t * z.hi + 1.6117375710961184e-24
        t = t * z.hi + -8.896791392450574e-22
        t = t * z.hi + 4.110317623312165e-19
        res = Dd.of(t)
        res = res * z + Dd.new(-1.5619206968586225e-16, -1.1910679660273754e-32)
        res = res * z + Dd.new(4.779477332387385e-14, 4.399205485834081e-31)
        res = res * z + Dd.new(-1.1470745597729725e-11, -2.0655512752830745e-28)
        res = res * z + Dd.new(2.08767569878681e-09, -1.20734505911326e-25)
        res = res * z + Dd.new(-2.755731922398589e-07, -2.3767714622250297e-23)
        res = res * z + Dd.new(2.48015873015873e-05, 2.1511947866775882e-23)
        res = res * z + Dd.new(-0.001388888888888889, 5.300543954373577e-20)
        res = res * z + Dd.new(0.041666666666666664, 2.3129646346357427e-18)
        res = res * z + Dd.new(-0.5, 0.0)
    }

