    /// `atan(j / 64)`.
    atan_table_entry: function (j: Int32) res: Dd {
        view: ref @array(@fbit64, 130) = (ref atan_table) as ref unknown as ref @array(@fbit64, 130)
        base: @bit_native = (j * 2).to_uint_wrapping() as @bit_native
        raw_h: @fbit64 = @array_at(view, base)
        raw_l: @fbit64 = @array_at(view, @i_add_native(base, 0x1))
        res = Dd.new(raw_h as Float64, raw_l as Float64)
    }

    /// `sum B_2k / (2k (2k-1)) w^(k-1)` with `w = 1 / z^2`, for `z >= 20`; times `1/z` it is the correction of `ln Gamma(z)`.
    stirling_poly: function (z: Dd) res: Dd {
        t: Float64 = 382900751.39141417
        t = t * z.hi + -15238221.539407415
        t = t * z.hi + 691472.268851313
        t = t * z.hi + -36108.77125372499
        t = t * z.hi + 2193.1033333333335
        t = t * z.hi + -156.84828462600203
        t = t * z.hi + 13.402864044168393
        t = t * z.hi + -1.3924322169059011
        t = t * z.hi + 0.17964437236883057
        t = t * z.hi + -0.029550653594771242
        t = t * z.hi + 0.00641025641025641
        t = t * z.hi + -0.0019175269175269176
        res = Dd.of(t)
        res = res * z + Dd.new(0.0008417508417508417, 3.6870174889237694e-20)
        res = res * z + Dd.new(-0.0005952380952380953, 5.36938218754726e-20)
        res = res * z + Dd.new(0.0007936507936507937, 6.883823317368282e-22)
        res = res * z + Dd.new(-0.002777777777777778, 1.0601087908747154e-19)
        res = res * z + Dd.new(0.08333333333333333, 4.625929269271485e-18)
    }

