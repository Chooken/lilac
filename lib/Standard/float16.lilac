    }

    /// This value as an `Int64`, rounded toward zero; past `Int64`'s range
    /// it is `Int64.MIN` or `Int64.MAX`, and NaN is 0.
    to_int64_truncated: function (self: Float16) Int64 => @float_to_int(self.data) as @bit64 as Int64

    /// This value as an `Int64`; fails on NaN, on an infinity, on a fraction
    /// and out of `Int64`'s range.
    to_int64: function (self: Float16) value: Int64 else nothing {
        if @f_greater_than_or_equal_16(self.data, -65504.0) and @f_less_than_or_equal_16(self.data, 65504.0) and @f_trunc_16(self.data) == self.data {
            value = @float_to_int(self.data) as @bit64
            return
        }
        fail
    }

    /// This value as an `Int`, rounded toward zero; past `Int`'s range
    /// it is `Int.MIN` or `Int.MAX`, and NaN is 0.
    to_int_truncated: function (self: Float16) Int => @float_to_int(self.data) as @bit_native as Int

    /// This value as an `Int`; fails on NaN, on an infinity, on a fraction
    /// and out of `Int`'s range.
    to_int: function (self: Float16) value: Int else nothing {
        if self.to_int64() -> wide: Int64 {
            if wide.to_int() -> narrow: Int {
                value = narrow
                return
            }
        }
        fail
    }

    /// This value as a `Uint8`, rounded toward zero; past `Uint8`'s range
    /// it is `Uint8.MIN` or `Uint8.MAX`, and NaN is 0.
    to_uint8_truncated: function (self: Float16) Uint8 => @float_to_uint(self.data) as @bit8 as Uint8

    /// This value as a `Uint8`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint8`'s range.
    to_uint8: function (self: Float16) value: Uint8 else nothing {
        if @f_greater_than_or_equal_16(self.data, 0.0) and @f_less_than_16(self.data, 256.0) and @f_trunc_16(self.data) == self.data {
            value = @float_to_uint(self.data) as @bit8
            return
        }
        fail
    }

    /// This value as a `Uint16`, rounded toward zero; past `Uint16`'s range
    /// it is `Uint16.MIN` or `Uint16.MAX`, and NaN is 0.
    to_uint16_truncated: function (self: Float16) Uint16 => @float_to_uint(self.data) as @bit16 as Uint16

    /// This value as a `Uint16`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint16`'s range.
    to_uint16: function (self: Float16) value: Uint16 else nothing {
        if @f_greater_than_or_equal_16(self.data, 0.0) and @f_less_than_or_equal_16(self.data, 65504.0) and @f_trunc_16(self.data) == self.data {
            value = @float_to_uint(self.data) as @bit16
            return
        }
        fail
    }

    /// This value as a `Uint32`, rounded toward zero; past `Uint32`'s range
    /// it is `Uint32.MIN` or `Uint32.MAX`, and NaN is 0.
    to_uint32_truncated: function (self: Float16) Uint32 => @float_to_uint(self.data) as @bit32 as Uint32

    /// This value as a `Uint32`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint32`'s range.
    to_uint32: function (self: Float16) value: Uint32 else nothing {
        if @f_greater_than_or_equal_16(self.data, 0.0) and @f_less_than_or_equal_16(self.data, 65504.0) and @f_trunc_16(self.data) == self.data {
            value = @float_to_uint(self.data) as @bit32
            return
        }
        fail
    }

    /// This value as a `Uint64`, rounded toward zero; past `Uint64`'s range
    /// it is `Uint64.MIN` or `Uint64.MAX`, and NaN is 0.
    to_uint64_truncated: function (self: Float16) Uint64 => @float_to_uint(self.data) as @bit64 as Uint64

    /// This value as a `Uint64`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint64`'s range.
    to_uint64: function (self: Float16) value: Uint64 else nothing {
        if @f_greater_than_or_equal_16(self.data, 0.0) and @f_less_than_or_equal_16(self.data, 65504.0) and @f_trunc_16(self.data) == self.data {
            value = @float_to_uint(self.data) as @bit64
            return
        }
        fail
    }

    /// This value as a `Uint`, rounded toward zero; past `Uint`'s range
    /// it is `Uint.MIN` or `Uint.MAX`, and NaN is 0.
    to_uint_truncated: function (self: Float16) Uint => @float_to_uint(self.data) as @bit_native as Uint

    /// This value as a `Uint`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint`'s range.
    to_uint: function (self: Float16) value: Uint else nothing {
        if self.to_uint64() -> wide: Uint64 {
            if wide.to_uint() -> narrow: Uint {
                value = narrow
                return
            }
        }
        fail
    }

    /// Parses a `Float16` from decimal text (`1.5`, `1e-4`, `inf`, `-inf`, `nan`;
    /// `_` separators allowed), rounded once to nearest (ties to even).
    parse: function (text: @byte_buffer) value: Float16 else error: ParseError {
        raw: @bit64 = parse_float_bits(text, 16) else -> err: ParseError {
            error = err
            fail
        }
        value = Float16 { data = @bits_to_fbit_16(@truncate(raw)) }
    }

    /// Shortest decimal string that reads back to the same `Float16` bits.
    @format: function (self, out: ref Formatter) nothing {
        write_float_shortest(out, @extend_zero(@fbit_to_bits_16(self.data)), 16)
    }

    /// Formatted with `precision` digits after the decimal point: `{x.fixed(3)}`.
    fixed: function (self: Float16, precision: Uint32) Fixed =>
        Fixed { bits = @extend_zero(@fbit_to_bits_16(self.data)), width = 16, precision = precision as @bit32 }

    /// Formatted in scientific notation with `precision` digits after the
    /// decimal point: `{x.scientific(4)}`.
    scientific: function (self: Float16, precision: Uint32) Scientific =>
        Scientific { bits = @extend_zero(@fbit_to_bits_16(self.data)), width = 16, precision = precision as @bit32 }

    /// The IEEE 754 bits in hexadecimal: `{x.hex()}`.
    hex: function (self: Float16) Hex => Hex { value = @extend_zero(@fbit_to_bits_16(self.data)) }

    /// The IEEE 754 bits in binary: `{x.binary()}`.
    binary: function (self: Float16) Binary => Binary { value = @extend_zero(@fbit_to_bits_16(self.data)) }
}
