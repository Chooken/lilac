    to_int16_wrapping: function (self: Uint) Int16 => @truncate(self.data) as @bit16 as Int16

    /// This value as an `Int32`; fails when it is out of `Int32`'s range.
    to_int32: function (self: Uint) value: Int32 else nothing {
        bits: @bit32 = @truncate(self.data)
        back: @bit_native = @extend_sign(bits)
        if back == self.data and @i_greater_than_or_equal_32(bits, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int32`, wrapping around at `Int32`'s range: the
    /// low bits.
    to_int32_wrapping: function (self: Uint) Int32 => @truncate(self.data) as @bit32 as Int32

    /// This value as an `Int64`; fails when it is out of `Int64`'s range.
    to_int64: function (self: Uint) value: Int64 else nothing {
        bits: @bit64 = @extend_zero(self.data)
        back: @bit_native = @truncate(bits)
        if back == self.data and @i_greater_than_or_equal_64(bits, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int64`, wrapping around at `Int64`'s range: the
    /// low bits, zero-extended.
    to_int64_wrapping: function (self: Uint) Int64 => @extend_zero(self.data) as @bit64 as Int64

    /// This value as an `Int`; fails when it is out of `Int`'s range.
    to_int: function (self: Uint) value: Int else nothing {
        bits: @bit_native = self.data
        back: @bit_native = bits
        if back == self.data and @i_greater_than_or_equal_native(bits, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int`, wrapping around at `Int`'s range: the
    /// low bits, zero-extended.
    to_int_wrapping: function (self: Uint) Int => self.data as @bit_native as Int

    /// This value as a `Uint8`; fails when it is out of `Uint8`'s range.
    to_uint8: function (self: Uint) value: Uint8 else nothing {
        bits: @bit8 = @truncate(self.data)
        back: @bit_native = @extend_zero(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint8`, wrapping around at `Uint8`'s range: the
    /// low bits.
    to_uint8_wrapping: function (self: Uint) Uint8 => @truncate(self.data) as @bit8 as Uint8

    /// This value as a `Uint16`; fails when it is out of `Uint16`'s range.
    to_uint16: function (self: Uint) value: Uint16 else nothing {
        bits: @bit16 = @truncate(self.data)
        back: @bit_native = @extend_zero(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint16`, wrapping around at `Uint16`'s range: the
    /// low bits.
    to_uint16_wrapping: function (self: Uint) Uint16 => @truncate(self.data) as @bit16 as Uint16

    /// This value as a `Uint32`; fails when it is out of `Uint32`'s range.
    to_uint32: function (self: Uint) value: Uint32 else nothing {
        bits: @bit32 = @truncate(self.data)
        back: @bit_native = @extend_zero(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint32`, wrapping around at `Uint32`'s range: the
    /// low bits.
    to_uint32_wrapping: function (self: Uint) Uint32 => @truncate(self.data) as @bit32 as Uint32

    /// This value as a `Float16`, rounded to the nearest (ties to even);
    /// past `Float16`'s largest finite value it is an infinity.
    to_float16_rounded: function (self: Uint) Float16 => @uint_to_float(self.data) as @fbit16 as Float16

    /// This value as a `Float32`, rounded to the nearest (ties to even).
    to_float32_rounded: function (self: Uint) Float32 => @uint_to_float(self.data) as @fbit32 as Float32

    /// This value as a `Float64`, rounded to the nearest (ties to even).
    to_float64_rounded: function (self: Uint) Float64 => @uint_to_float(self.data) as @fbit64 as Float64

    /// Parses an unsigned integer in decimal, `0x` hexadecimal or `0b` binary
    /// (`_` separators allowed).
    parse: function (text: @byte_buffer) value: Uint else error: ParseError {
        raw: @bit64 = parse_unsigned_int(text, @extend_zero(Uint.MAX.data)) else -> err: ParseError {
            error = err
            fail
        }
        value = Uint { data = @truncate(raw) }
    }

    /// Unsigned decimal.
    @format: function (self, out: ref Formatter) nothing {
        write_unsigned(out, @extend_zero(self.data), 0xA)
    }

    /// The bits in hexadecimal, at this type's width: `{n.hex()}`.
    hex: function (self: Uint) Hex => Hex { value = @extend_zero(self.data) }

    /// The bits in binary, at this type's width: `{n.binary()}`.
    binary: function (self: Uint) Binary => Binary { value = @extend_zero(self.data) }
}
