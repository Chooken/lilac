/// A value that may be missing: `Some` with it, or `None`. A zeroed
/// `Optional` is `None`.
Optional[T]: either {
    /// There is no value.
    None
    /// The value is here.
    Some: T

    /// The value of a `Some` (moved out of the optional); fails on `None`.
    get: function(self: Optional[T]) value: T else nothing {
        match self {
            .Some -> some_value: T {
                value = some_value
                return
            }
        }
        fail
    }

    get_unchecked: function (self: Optional[T]) value: T {
        value = (ref self) as ref unknown as ref T
    }

    /// A reference to the `Some` value, left in place; fails on `None`.
    /// Writes through it change the optional's value. For an
    /// `Optional[ref X]` it is the stored reference itself.
    get_ref: function (self) value: ref T else nothing {
        match self {
            .Some -> some_value: ref T {
                value = some_value
                return
            }
        }
        fail
    }

    get_ref_unchecked: function (self) value: ref T {
        value = self as ref unknown as ref T
    }

    unwrap_or: function(self: Optional[T], default: T) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            value = default
        }
    }

    /// Only usable when T has a static `default()`; checked when called.
    unwrap_or_default: function(self: Optional[T]) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            value = T.default()
        }
    }

    unwrap_or_panic: function(self: Optional[T]) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            @panic("Tried to unwrap an Optional with a none value.")
        }
    }

    /// `Some(value)` or `None`; usable when `T` copies and has a `@format`
    /// (checked where it is used).
    @format: function (self, out: ref Formatter) nothing {
        match self {
            .Some -> some_value: T {
                out.write($"Some({some_value})")
            }
            .None => out.write_bytes("None")
        }
    }
}
