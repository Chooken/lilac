Optional[T]: enum {
    Some: T
    None

    // The value of a `Some` (moved out of the optional); fails on `None`.
    get: function(self: Optional[T]) value: T else nothing {
        match self {
            .Some -> some_value: T {
                value = some_value
                return
            }
        }
        fail
    }

    unwrap_or: function(self: Optional[T], default: T) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            value = default
        }
    }

    // Only usable when T has a static `default()`; checked when called.
    unwrap_or_default: function(self: Optional[T]) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            value = T.default()
        }
    }

    // `Some(value)` or `None`; usable when `T` copies and has a `@format`
    // (checked where it is used).
    @format: function (self, out: ref Formatter) nothing {
        match self {
            .Some -> some_value: T {
                out.write($"Some({some_value})")
            }
            .None => out.write_bytes("None")
        }
    }
}
