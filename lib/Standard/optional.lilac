/// A value that may be missing: `Some` with it, or `None`. A zeroed
/// `Optional` is `None`.
Optional[T]: either {
    /// There is no value.
    None
    /// The value is here.
    Some: T

    /// The value of a `Some` (moved out of the optional); fails on `None`.
    get: function(self: Optional[T]) value: T else nothing {
        match self {
            .Some -> some_value: T {
                value = some_value
                return
            }
        }
        fail
    }

    /// The value of a `Some` (moved out of the optional), without testing
    /// the tag: on `None` it is garbage. Debug builds panic instead.
    get_unchecked: function (self: Optional[T]) value: T {
        if @builtin.Build.mode == .Debug {
            if self.is_none() {
                @panic("get_unchecked on a None")
            }
        }
        // Wrapped in a structure, the payload moves out whatever `T` is,
        // a reference too.
        payload: ref Payload[T] = (ref self).payload_address() as ref Payload[T]
        moved: Payload[T] = @read(payload)
        value = @move(moved.value)
        // The value has moved out, so `self` must not drop it again.
        @write(ref self, .None)
    }

    /// A reference to the `Some` value, left in place; fails on `None`.
    /// Writes through it change the optional's value. For an
    /// `Optional[ref X]` it is the stored reference itself.
    get_ref: function (self) value: ref T else nothing {
        match self {
            .Some -> some_value: ref T {
                value = some_value
                return
            }
        }
        fail
    }

    /// A reference to the `Some` value, left in place, without testing the
    /// tag: on `None` it points at garbage. Debug builds panic instead.
    /// For an `Optional[ref X]` it is the stored reference itself, as
    /// `get_ref` gives.
    get_ref_unchecked: function (self) value: ref T {
        if @builtin.Build.mode == .Debug {
            if self.is_none() {
                @panic("get_ref_unchecked on a None")
            }
        }
        // `ref T` is `T` exactly when `T` is a reference. Both arms check
        // for every `T`, so each reads the slot through `ref unknown`.
        if @is_same(ref T, T) {
            stored: ref Payload[ref unknown] = self.payload_address() as ref Payload[ref unknown]
            value = stored.value as ref T
        } else {
            value = self.payload_address() as ref T
        }
    }

    private {
        /// Where the payload lies: an either is a C tagged union, a
        /// `@bit8` tag (two variants) and then the payload at its own
        /// alignment, which is past the tag.
        payload_address: function (self) ref unknown => @ptr_add(self as ref unknown, @align_of(T))
    }

    unwrap_or: function(self: Optional[T], default: T) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            value = default
        }
    }

    /// Only usable when T has a static `default()`; checked when called.
    unwrap_or_default: function(self: Optional[T]) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            value = T.default()
        }
    }

    unwrap_or_panic: function(self: Optional[T]) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            @panic("Tried to unwrap an Optional with a none value.")
        }
    }

    /// Whether this is a `Some`.
    is_some: function (self) result: Bool {
        result = false
        match self {
            .Some => result = true
        }
    }

    /// Whether this is a `None`.
    is_none: function (self) result: Bool {
        result = false
        match self {
            .None => result = true
        }
    }

    /// `Some(value)` or `None`; usable when `T` copies and has a `@format`
    /// (checked where it is used).
    @format: function (self, out: ref Formatter) nothing {
        match self {
            .Some -> some_value: T {
                out.write($"Some({some_value})")
            }
            .None => out.write_bytes("None")
        }
    }
}

private {
    /// An `Optional`'s payload as a structure of its own, which can be
    /// moved and read whatever `T` is.
    Payload[T]: structure {
        value: T
    }
}
