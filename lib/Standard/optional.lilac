Optional[T]: enum {
    Some: T
    None

    // The value of a `Some`; fails on `None`.
    get: function(self) value: T else nothing {
        match self {
            .Some -> some_value: T {
                value = some_value
                return
            }
        }
        fail
    }

    unwrap_or: function(self, default: T) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            value = default
        }
    }

    // Only usable when T has a static `default()`; checked when called.
    unwrap_or_default: function(self) value: T {
        match self {
            .Some -> some_value: T {
                value = some_value
            }
        } else {
            value = T.default()
        }
    }
}
