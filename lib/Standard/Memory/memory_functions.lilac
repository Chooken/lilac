

/// Exchanges the values at `a` and `b`, moving each; no hook runs.
swap[T]: function (a: ref T, b: ref T) nothing {
    c: T = @read(a)
    @write(a, @read(b))
    @write(b, @move(c))
}

byte_buffer_to_slice: function (byte_buffer: @byte_buffer) Slice[Byte] => Slice[Byte].new(
    @byte_buffer_ptr(byte_buffer) as ref unknown as ref Byte,
    @byte_buffer_len(byte_buffer)
)

slice_to_byte_buffer: function (slice: Slice[Byte]) @byte_buffer => @byte_buffer_from(
    slice.base() as ref unknown as ref @bit8,
    slice.get_count(),
)

equal_bytes: function (a: Slice[Byte], b: Slice[Byte]) result: Bool {
    
    if a.get_count() != b.get_count() {
        result = false
        return
    }

    index: Int = 0
    // We know a and b are the same length so we only test one.
    loop if index < a.get_count() {
        a_byte: @bit8 = @load_u8(
            a.base() as ref unknown as ref @bit8,
            index
        )
        b_byte: @bit8 = @load_u8(
            b.base() as ref unknown as ref @bit8,
            index
        )

        if a_byte != b_byte {
            result = false
            return
        }

        index += 1
    }

    result = true
}

compare_bytes: function (a: Slice[Byte], b: Slice[Byte]) ordering: Ordering {
    
    min_length: Int = Int.min(a.get_count(), b.get_count())

    index: Int = 0
    
    loop if index < min_length {

        a_byte: @bit8 = @load_u8(
            a.base() as ref unknown as ref @bit8,
            index
        )
        b_byte: @bit8 = @load_u8(
            b.base() as ref unknown as ref @bit8,
            index
        )

        if a_byte == b_byte {
            index += 1
            continue
        }

        if @i_less_than_u_8(a_byte, b_byte) {
            ordering = .Less
        } else {
            ordering = .Greater
        }

        return
    }

    if a.get_count() == b.get_count() {
        ordering = .Equal
    } else if a.get_count() < b.get_count() {
        ordering = .Less
    } else {
        ordering = .Greater
    }
}

find_byte: function (bytes: Slice[Byte], byte: Byte, from: Int) at: Int else nothing {

    index: Int = from
    // We know a and b are the same length so we only test one.
    loop if index < bytes.get_count() {

        if bytes.get(index) == byte {
            at = index
            return
        }

        index += 1
    }

    fail
}