using Standard.Memory
using Standard.Heap as Heap

/// A growable array of `T`s, in memory from its allocator. It owns its
/// elements: dropping the list drops each, then frees the memory, and
/// copying it copies each (through `T`'s `@on_copy`) into new memory from
/// the same allocator. So `T` must be copyable: hold a value that only
/// moves through a wrapper that copies, such as a reference-counted one.
/// Every index is checked, and one out of range panics.
List[T]: structure {

    private {
        data: Memory[T]
        count: Int
    }

    /// An empty list over the default allocator. Nothing is allocated
    /// until the first element is added.
    new: function () list: List[T] {
        list = new_using(Heap.get_default_allocator())
    }

    /// An empty list over `allocator`, which must outlive it. Nothing is
    /// allocated until the first element is added.
    new_using: function (allocator: Heap.Allocator) list: List[T] {
        list = List[T] {
            data = Memory[T].new_using(0, allocator)
            count = 0
        }
    }

    /// How many elements the list holds.
    get_count: function (self) Int => self.count

    /// How many elements fit before the list next grows.
    get_capacity: function (self) capacity: Int {
        capacity = self.data.get_count()
    } 

    /// Element `index`, in place; panics unless `0 <= index < count`. The
    /// reference lasts until the list next grows, shrinks or shifts its
    /// elements.
    get: function (self, index: Int) value: ref T {

        if index >= self.count {
            @panic($"Tried to get index {index} when the list only has {self.count}")
        }

        if index < 0 {
            @panic($"Tried to get index {index} indexes must be non negative.")
        }

        value = self.data.get(index)
    }

    get_slice: function (self) Slice[T] => self.data.get_slice()

    /// Adds `value` (moved in) at the end, growing the list when it is
    /// full.
    add: function (self, value: T) nothing {

        if self.count >= self.get_capacity() {
            self.grow()
        }

        @write(self.data.get(self.count), value)

        self.count += 1
    }

    /// Adds a copy of each of `slice`'s elements at the end (through `T`'s
    /// `@on_copy`), growing the list when they do not fit. `slice` must
    /// not view this list's own elements, whose memory growing may move.
    add_slice: function (self, slice: Slice[T]) nothing {

        if self.get_capacity() - self.count < slice.get_count() {
            self.reserve(self.count + slice.get_count() + 8)
        }

        if slice.get_count() == 0 as Int {
            return
        }

        slice.copy_to(self.data.get_slice(), self.count)

        self.count += slice.get_count()
    }

    /// Puts `value` (moved in) at `index`, shifting the elements from
    /// there on up by one; `index` may be `count`, which adds it at the
    /// end. Panics unless `0 <= index <= count`.
    insert: function (self, index: Int, value: T) nothing {

        if index > self.count {
            @panic($"Tried to insert index {index} when the list only has {self.count}")
        }

        if index < 0 {
            @panic($"Tried to insert index {index} indexes must be non negative.")
        }

        if self.count >= self.get_capacity() {
            self.grow()
        }

        if index != self.count {
            move_slice: Slice[T] = self.data.slice(Range.of(index, self.count))
            move_slice.move_to(self.data, index + 1)
        }

        @write(self.data.get(index), value)

        self.count += 1
    }

    /// The last element, moved out of the list, or `.None` when it is
    /// empty.
    pop: function (self) value: Optional[T] {

        if self.count == 0 as Int {
            value = .None
            return
        }

        self.count -= 1

        item: ref T = self.data.get(self.count)

        value = .Some(@read(item))

        @memset(item as ref unknown, 0x0, @size_of(T))
    }

    /// Drops the element at `index` and shifts the ones after it down by
    /// one. Panics unless `0 <= index < count`.
    remove: function (self, index: Int) nothing {

        if index >= self.count {
            @panic($"Tried to remove index {index} when the list only has {self.count}")
        }

        if index < 0 {
            @panic($"Tried to remove index {index} indexes must be non negative.")
        }

        value: ref T = self.data.get(index)
        @drop(value)

        if index != self.count - 1 {
            move_slice: Slice[T] = self.data.slice(Range.of(index + 1, self.count))
            move_slice.move_to(self.data, index)
        }

        self.count -= 1
        @memset(self.data.get(self.count) as ref unknown, 0x0, @size_of(T))
    }

    /// Drops the elements `range` covers and shifts the ones after it
    /// down to close the gap. Panics unless the range lies inside
    /// `0..count`.
    remove_range: function (self, range: Range) nothing {

        if range.max() > self.count {
            @panic($"Tried to remove {range} when the list only has {self.count}")
        }

        if range.min() < 0 {
            @panic($"Tried to remove {range} indexes must be non negative.")
        }

        if range.length() == 0 as Int {
            return
        }

        index: Int = range.min()

        loop if index < range.max() {

            value: ref T = self.data.get(index)
            @drop(value)
            index += 1

        } else break

        if range.max() != self.count {
            move_slice: Slice[T] = self.data.slice(Range.of(range.max(), self.count))
            move_slice.move_to(self.data, range.min())
        }

        self.count -= range.length()
        @memset(self.data.get(self.count) as ref unknown, 0x0, @size_of(T) * range.length())
    }

    /// Doubles the capacity (to 4 when it is 0).
    grow: function (self) nothing {
        self.reserve(self.get_capacity() * 2)
    }

    /// Grows the capacity to at least `capacity` elements; a smaller one
    /// changes nothing. The elements may move.
    reserve: function (self, capacity: Int) nothing {

        if capacity <= self.get_capacity() {
            return
        }

        self.data.resize(capacity)
    }

    /// Shrinks the capacity to the count. The elements may move.
    trim: function (self) nothing {
        self.data.resize(self.count)
    }

    /// A list of copies of the elements, over the same allocator, with
    /// room for exactly them; an empty list allocates nothing.
    @on_copy: function (self) copy: List[T] {

        copy = new_using(self.data.get_allocator())

        if self.count == 0 as Int {
            return
        }

        copy.add_slice(self.data.slice(Range.of(0, self.count)))
    }

    @on_drop: function (self) nothing {

        index: Int = 0

        loop if index < self.count {

            value: ref T = self.data.get(index)
            @drop(value)
            index += 1

        } else break

        self.data.free()
    }
}
