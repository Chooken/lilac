using *.Heap

Box[T]: object {

    private {
        value: Optional[ref T]
    }

    create: function(data: T) box: Box[T] {

        // Allocate (zeroed) and move the data in.
        ptr: ref T = Allocator.create[T]()
        ptr = data

        // Put it in a box.
        box = Box[T] {
            value = .Some(ptr)
        }
    }

    @on_drop: function(self) nothing {
        if self.value.get() -> value: ref T {
            Allocator.destroy[T](value)
        }
    }
}
