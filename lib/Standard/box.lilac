using Standard.Heap as Heap

/// One value on the heap, owned: a `Box` moves (it cannot be copied) and
/// dropping it drops the value and frees its memory.
Box[T]: object {

    private {
        value: ref T
        allocator: Heap.Allocator
    }

    /// A box holding `data`, moved onto the heap from
    /// `Heap.default_allocator`.
    new: function(data: T) box: Box[T] {
        box = new_using(data, Heap.get_default_allocator())
    }

    /// A box holding `data`, moved into memory from `allocator`, which
    /// must stay in place while the box lives.
    new_using: function(data: T, allocator: Heap.Allocator) box: Box[T] {
        box = Box[T] {
            value = allocator.create[T](data)
            allocator = allocator
        }
    }

    /// The value, moved out of the box; the box's memory is freed.
    into_inner: function(self: Box[T]) data: T {
        @discard(self)
        data = @read(self.value)
        self.allocator.free[T](self.value)
    }

    @on_drop: function(self) nothing {
        self.allocator.destroy[T](self.value)
    }
}
