using *.Heap

Box[T]: object {

    private {
        value: Optional[ref T]
    }

    create: function(data: T) box: Box[T] {

        // Allocate (zeroed) and move the data in.
        ptr: ref T = Allocator.create[T]()
        ptr = data

        // Put it in a box.
        box = Box[T] {
            value = .Some(ptr)
        }
    }

    // Hands the allocation to a new box; this one is left empty.
    move: function(self) to: Box[T] {
        to = Box[T] {
            value = self.value
        }
        self.value = .None
    }

    @on_copy: function(self) copy: Box[T] {
        @compile_error("You cannot copy a Box[T]. If you want to move it use variable.move()!")
    }

    @on_drop: function(self) nothing {
        if self.value.unwrap() -> value: ref T {
            Allocator.destroy[T](value)
        }
    }
}
