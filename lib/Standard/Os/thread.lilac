// Threads: `spawn` starts one running `entry(argument)`, `join` waits for
// it to finish. Windows uses `CreateThread`, macOS (and Linux under
// `--libc`) `pthread_create`, and native Linux its own `clone` thread on a
// 1 MiB mapping that holds its stack and thread-local block
// (`@linux_thread_clone`). A native Linux program that links a shared C library
// should use `--libc`: a raw `clone` thread has no C-library thread state.

using Standard.Os.Windows as Windows
using Standard.Os.Linux as Linux

// A running thread from `spawn`. `join` it exactly once; nothing frees it
// otherwise.
Thread: object {
    // The Windows thread handle, or the `pthread_t`; native Linux keeps
    // the thread id.
    value: @bit_native
    // The start block (from `allocate`), or the native Linux mapping.
    memory: ref unknown
}

// Starts a thread running `entry(argument)`.
spawn: function (entry: function (argument: ref unknown) nothing, argument: ref unknown) result: Result[Thread, Error] {
    match @builtin.Target.os {
        .Windows => {
            start: ref unknown = allocate(start_size).get() else -> why: Error {
                result = .Error(why)
                return
            }
            start_block(start, entry, argument)
            id: @bit32 = 0x0
            handle: ref unknown = Windows.CreateThread(null(), 0x0, thread_start as ref unknown, start, 0x0, ref id)
            if @ptr_to_address(handle) == 0x0 {
                why: Error = error_of_windows(Windows.GetLastError())
                deallocate(start)
                result = .Error(why)
            } else {
                thread: Thread { value = @ptr_to_address(handle), memory = start }
                result = .Ok(thread)
            }
        }
        .Linux => {
            if @builtin.Target.libc {
                result = posix_spawn_thread(entry, argument)
            } else {
                result = clone_thread(entry, argument)
            }
        }
        .MacOs => {
            result = posix_spawn_thread(entry, argument)
        }
    } else {
        @compile_error("Standard.Os has no files, clocks, random bytes or threads on a target with no OS")
        result = .Error(.Unsupported)
    }
}

// Waits for `thread` to finish, then releases it.
join: function (thread: Thread) error: Optional[Error] {
    error = .None
    match @builtin.Target.os {
        .Windows => {
            handle: ref unknown = @address_to_ptr(thread.value)
            if Windows.WaitForSingleObject(handle, Windows.INFINITE) == Windows.WAIT_FAILED {
                error = .Some(error_of_windows(Windows.GetLastError()))
            }
            Windows.CloseHandle(handle)
            deallocate(thread.memory)
        }
        .Linux => {
            if @builtin.Target.libc {
                error = posix_join_thread(thread)
            } else {
                // The kernel zeroes the id word when the thread exits
                // (`CLONE_CHILD_CLEARTID`) and wakes its futex.
                id: ref @bit32 = thread.memory as ref @bit32
                loop {
                    current: @bit32 = @atomic_load_acquire_32(id)
                    if current == 0x0 {
                        break
                    }
                    Linux.futex(thread.memory, Linux.FUTEX_WAIT, current, null(), null(), 0x0)
                }
                unmap_pages(thread.memory, clone_mapping)
            }
        }
        .MacOs => {
            error = posix_join_thread(thread)
        }
    } else {
        @compile_error("Standard.Os has no files, clocks, random bytes or threads on a target with no OS")
    }
}

// Lets another thread run.
yield_thread: function () nothing {
    match @builtin.Target.os {
        .Windows => {
            Windows.SwitchToThread()
        }
        .Linux => {
            Linux.sched_yield()
        }
        .MacOs => {
            sched_yield()
        }
    } else {
        @compile_error("Standard.Os has no files, clocks, random bytes or threads on a target with no OS")
    }
}

private {
    // The block `thread_start` reads: the function, then its argument.
    StartBlock: object {
        entry: @bit_native
        argument: ref unknown
    }

    // Where every thread starts: `CreateThread`, `pthread_create` and the
    // native Linux `clone` call it with the start block, and it runs
    // `entry(argument)`.
    thread_start: export "lilac_thread_start" function (start: ref unknown) result: ref unknown {
        slot: ref function (argument: ref unknown) nothing = start as ref function (argument: ref unknown) nothing
        entry: function (argument: ref unknown) nothing = slot
        block: ref StartBlock = start as ref StartBlock
        entry(block.argument)
        result = null()
    }

    start_size: @bit_native => 0x10

    // Fills the start block at `memory`.
    start_block: function (memory: ref unknown, entry: function (argument: ref unknown) nothing, argument: ref unknown) nothing {
        block: ref StartBlock = memory as ref StartBlock
        block.argument = argument
        slot: ref function (argument: ref unknown) nothing = memory as ref function (argument: ref unknown) nothing
        slot = entry
    }

    // The native Linux thread mapping: the id word at 0, the start block
    // at 0x10, the thread-local area from 0x40 to 0x4000, then the stack
    // up to the end.
    clone_mapping: @bit_native => 0x100000
    clone_start: @bit_native => 0x10
    clone_tls: @bit_native => 0x40
    clone_tls_size: @bit_native => 0x3FC0

    clone_thread: function (entry: function (argument: ref unknown) nothing, argument: ref unknown) result: Result[Thread, Error] {
        mapping: ref unknown = map_pages(clone_mapping).get() else -> why: Error {
            result = .Error(why)
            return
        }
        start: ref unknown = @ptr_add(mapping, clone_start)
        start_block(start, entry, argument)
        // Shares everything a thread does; the id word is set before
        // `clone` returns and cleared when the thread exits.
        flags: @bit_native = @bit_or_native(@bit_or_native(@bit_or_native(Linux.CLONE_VM, Linux.CLONE_FS), @bit_or_native(Linux.CLONE_FILES, Linux.CLONE_SIGHAND)), @bit_or_native(@bit_or_native(Linux.CLONE_THREAD, Linux.CLONE_SYSVSEM), @bit_or_native(Linux.CLONE_SETTLS, @bit_or_native(Linux.CLONE_PARENT_SETTID, Linux.CLONE_CHILD_CLEARTID))))
        raw: @bit_native = @linux_thread_clone(flags, @ptr_add(mapping, clone_mapping), mapping, mapping, @ptr_add(mapping, clone_tls), clone_tls_size, thread_start as ref unknown, start)
        if Linux.is_error(raw) {
            why: Error = error_of_errno(Linux.errno_of(raw))
            unmap_pages(mapping, clone_mapping)
            result = .Error(why)
        } else {
            thread: Thread { value = raw, memory = mapping }
            result = .Ok(thread)
        }
    }

    // `pthread_create` and `pthread_join`, the same POSIX functions on
    // macOS and in a Linux C library.
    pthread_create: extern function (thread: ref @bit_native, attr: ref unknown, start_routine: ref unknown, arg: ref unknown) result: @bit32
    pthread_join: extern function (thread: @bit_native, value_ptr: ref unknown) result: @bit32
    sched_yield: extern function () result: @bit32

    posix_spawn_thread: function (entry: function (argument: ref unknown) nothing, argument: ref unknown) result: Result[Thread, Error] {
        start: ref unknown = allocate(start_size).get() else -> why: Error {
            result = .Error(why)
            return
        }
        start_block(start, entry, argument)
        handle: @bit_native = 0x0
        code: @bit32 = pthread_create(ref handle, null(), thread_start as ref unknown, start)
        if code == 0x0 {
            thread: Thread { value = handle, memory = start }
            result = .Ok(thread)
        } else {
            deallocate(start)
            result = .Error(error_of_errno(code))
        }
    }

    posix_join_thread: function (thread: Thread) error: Optional[Error] {
        error = .None
        code: @bit32 = pthread_join(thread.value, null())
        if code == 0x0 {
            deallocate(thread.memory)
        } else {
            error = .Some(error_of_errno(code))
        }
    }
}
