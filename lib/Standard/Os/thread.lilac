// Threads: `spawn` starts one running `entry(argument)`, `join` waits for
// it to finish. Windows uses `CreateThread`, macOS (and Linux under
// `--libc`) `pthread_create`, and native Linux its own `clone` thread on a
// mapping that holds its stack and thread-local block
// (`@linux_thread_clone`). A native Linux program that links a shared C library
// should use `--libc`: a raw `clone` thread has no C-library thread state.
//
// Every thread gets the same stack on every OS (`default_stack_size`,
// unless `spawn_with` says otherwise) with a guard below it, so deep
// recursion behaves alike everywhere and an overflow crashes at once.

using Standard.Os.Windows as Windows
using Standard.Os.Linux as Linux
using Standard.Os.MacOs as MacOs

/// A running thread from `spawn`. `join` it exactly once; nothing frees it
/// otherwise.
Thread: structure {
    /// The Windows thread handle, or the `pthread_t`; native Linux keeps
    /// the thread id.
    value: @bit_native
    /// The start block (a page from `map_pages`), or the native Linux
    /// mapping.
    memory: ref unknown
    /// The size of `memory`.
    size: @bit_native
}

/// What a thread runs: `entry(argument)`.
ThreadEntry: alias function (argument: ref unknown) nothing

/// The stack `spawn` gives a thread: 8 MiB on 64-bit targets (the Linux
/// and macOS main thread's), 2 MiB on 32-bit ones. It is reserved, not
/// committed: only the pages a thread touches use memory.
default_stack_size: @bit_native => if @builtin.Target.pointer_size == 0x8 then 0x800000 else 0x200000

/// Starts a thread running `entry(argument)` on a `default_stack_size`
/// stack.
spawn: function (entry: ref ThreadEntry, argument: ref unknown) result: Result[Thread, Error] {
    result = spawn_with(entry, argument, default_stack_size)
}

/// Starts a thread running `entry(argument)` on a stack of at least
/// `stack_size` bytes (rounded up to a multiple of 64 KiB, and at least
/// 128 KiB). `.InvalidInput` when that size does not fit in an address.
spawn_with: function (entry: ref ThreadEntry, argument: ref unknown, stack_size: @bit_native) result: Result[Thread, Error] {
    size: @bit_native = stack_bytes(stack_size) else {
        result = .Error(.InvalidInput)
        return
    }
    match @builtin.Target.os {
        .Windows => {
            start: ref unknown = map_pages(start_size).get() else -> why: Error {
                result = .Error(why)
                return
            }
            start_block(start, entry, argument)
            id: @bit32 = 0x0
            // A reservation keeps the OS's guard page below the stack.
            handle: ref unknown = Windows.CreateThread(null(), size, ref thread_start as ref unknown, start, Windows.STACK_SIZE_PARAM_IS_A_RESERVATION, ref id)
            if @ptr_to_address(handle) == 0x0 {
                why: Error = error_of_windows(Windows.GetLastError())
                unmap_pages(start, start_size)
                result = .Error(why)
            } else {
                thread: Thread { value = @ptr_to_address(handle), memory = start, size = start_size }
                result = .Ok(thread)
            }
        }
        .Linux => {
            if @builtin.Target.libc {
                result = posix_spawn_thread(entry, argument, size)
            } else {
                result = clone_thread(entry, argument, size)
            }
        }
        .MacOs => {
            result = posix_spawn_thread(entry, argument, size)
        }
    } else {
        result = .Error(.Unsupported)
    }
}

/// Waits for `thread` to finish, then releases it.
join: function (thread: Thread) error: Optional[Error] {
    error = .None
    match @builtin.Target.os {
        .Windows => {
            handle: ref unknown = @address_to_ptr(thread.value)
            if Windows.WaitForSingleObject(handle, Windows.INFINITE) == Windows.WAIT_FAILED {
                error = .Some(error_of_windows(Windows.GetLastError()))
            }
            Windows.CloseHandle(handle)
            unmap_pages(thread.memory, thread.size)
        }
        .Linux => {
            if @builtin.Target.libc {
                error = posix_join_thread(thread)
            } else {
                // The kernel zeroes the id word when the thread exits
                // (`CLONE_CHILD_CLEARTID`) and wakes its futex.
                header: ref unknown = clone_header_of(thread.memory, thread.size)
                id: ref @bit32 = header as ref @bit32
                loop {
                    current: @bit32 = @atomic_load_acquire_32(id)
                    if current == 0x0 {
                        break
                    }
                    Linux.futex(header, Linux.FUTEX_WAIT, current, null(), null(), 0x0)
                }
                unmap_pages(thread.memory, thread.size)
            }
        }
        .MacOs => {
            error = posix_join_thread(thread)
        }
    } else {
        error = .Some(.Unsupported)
    }
}

/// Lets another thread run.
/// Doesn't do anything if unsupported.
yield_thread: function () nothing {
    match @builtin.Target.os {
        .Windows => {
            Windows.SwitchToThread()
        }
        .Linux => {
            Linux.sched_yield()
        }
        .MacOs => {
            sched_yield()
        }
    }
}

/// How many threads can run at once: the processors this program may
/// run on (its affinity on Linux; on Windows those of its processor
/// group, at most 64). At least 1, and 1 where it cannot be found.
available_parallelism: function () count: @bit_native {
    count = 0x1
    match @builtin.Target.os {
        .Windows => {
            // `SYSTEM_INFO` is 48 bytes on 64-bit targets, 36 on 32-bit.
            storage: @array(@bit64, 6) = @array(@bit64, 6) {}
            storage_ref: ref @array(@bit64, 6) = ref storage
            info: ref Windows.SYSTEM_INFO = storage_ref as ref unknown as ref Windows.SYSTEM_INFO
            Windows.GetSystemInfo(info)
            if info.dwNumberOfProcessors != 0x0 {
                count = @extend_zero(info.dwNumberOfProcessors)
            }
        }
        .Linux => {
            // Room for 8,192 processors on 64-bit targets; the kernel
            // fills the bytes it uses and returns their count.
            mask: @array(@bit_native, 128) = @array(@bit_native, 128) {}
            words: ref @array(@bit_native, 128) = ref mask
            written: @bit_native = Linux.sched_getaffinity(0x0, @i_mul_native(0x80, @builtin.Target.pointer_size), words as ref unknown)
            if Linux.is_error(written) {
                return
            }
            used: @bit_native = @i_div_u_native(written, @builtin.Target.pointer_size)
            total: @bit_native = 0x0
            index: @bit_native = 0x0
            loop {
                if index == used {
                    break
                }
                total = @i_add_native(total, @bit_count_ones_native(@array_at(words, index)))
                index = @i_add_native(index, 0x1)
            }
            if total != 0x0 {
                count = total
            }
        }
        .MacOs => {
            online: @bit_native = MacOs.sysconf(MacOs._SC_NPROCESSORS_ONLN)
            // `-1` on failure; anything from 1 to 65,536 is an answer.
            if @i_less_than_u_native(@i_sub_native(online, 0x1), 0x10000) {
                count = online
            }
        }
    }
}

private {
    /// `stack_size` rounded up to a multiple of 64 KiB (whole pages on
    /// every target) and at least 128 KiB (glibc's smallest pthread stack
    /// on 64-bit Arm); fails when that does not fit in an address.
    stack_bytes: function (stack_size: @bit_native) bytes: @bit_native else nothing {
        bytes = 0x20000
        if @i_greater_than_u_native(stack_size, @bit_not_native(0xFFFF)) {
            fail
        }
        rounded: @bit_native = @bit_and_native(@i_add_native(stack_size, 0xFFFF), @bit_not_native(0xFFFF))
        if @i_greater_than_u_native(rounded, bytes) {
            bytes = rounded
        }
    }

    /// The block `thread_start` reads: the function, then its argument.
    StartBlock: structure {
        entry: ref ThreadEntry
        argument: ref unknown
    }

    /// Where every thread starts: `CreateThread`, `pthread_create` and the
    /// native Linux `clone` call it with the start block, and it runs
    /// `entry(argument)`.
    thread_start: export "lilac_thread_start" function (start: ref unknown) result: ref unknown {
        block: ref StartBlock = start as ref StartBlock
        block.entry(block.argument)
        result = null()
    }

    start_size: @bit_native => 0x10

    /// Fills the start block at `memory`.
    start_block: function (memory: ref unknown, entry: ref ThreadEntry, argument: ref unknown) nothing {
        block: ref StartBlock = memory as ref StartBlock
        block.argument = argument
        block.entry = entry
    }

    /// The native Linux thread mapping, from the bottom: a guard
    /// (`clone_guard` bytes that can be neither read nor written, so a
    /// stack overflow faults instead of running into other memory), the
    /// stack, growing down, and at the top the header (`clone_header`
    /// bytes): the id word at 0, the start block at 0x10 and the
    /// thread-local area from 0x40 to its end. 64 KiB is whole pages on
    /// every Linux.
    clone_guard: @bit_native => 0x10000
    clone_header: @bit_native => 0x4000
    clone_start: @bit_native => 0x10
    clone_tls: @bit_native => 0x40
    clone_tls_size: @bit_native => 0x3FC0

    /// The header of the `size`-byte native Linux mapping at `mapping`.
    clone_header_of: function (mapping: ref unknown, size: @bit_native) header: ref unknown => @ptr_add(mapping, @i_sub_native(size, clone_header))

    clone_thread: function (entry: ref ThreadEntry, argument: ref unknown, stack_size: @bit_native) result: Result[Thread, Error] {
        // The stack keeps its whole size between the guard and the header.
        size: @bit_native = @i_add_native(stack_size, @i_add_native(clone_guard, clone_header))
        if @i_less_than_u_native(size, stack_size) {
            result = .Error(.InvalidInput)
            return
        }
        mapping: ref unknown = map_pages(size).get() else -> why: Error {
            result = .Error(why)
            return
        }
        guarded: @bit_native = Linux.mprotect(mapping, clone_guard, Linux.PROT_NONE)
        if Linux.is_error(guarded) {
            why: Error = error_of_errno(Linux.errno_of(guarded))
            unmap_pages(mapping, size)
            result = .Error(why)
            return
        }
        header: ref unknown = clone_header_of(mapping, size)
        start: ref unknown = @ptr_add(header, clone_start)
        start_block(start, entry, argument)
        // Shares everything a thread does; the id word is set before
        // `clone` returns and cleared when the thread exits.
        flags: @bit_native = @bit_or_native(@bit_or_native(@bit_or_native(Linux.CLONE_VM, Linux.CLONE_FS), @bit_or_native(Linux.CLONE_FILES, Linux.CLONE_SIGHAND)), @bit_or_native(@bit_or_native(Linux.CLONE_THREAD, Linux.CLONE_SYSVSEM), @bit_or_native(Linux.CLONE_SETTLS, @bit_or_native(Linux.CLONE_PARENT_SETTID, Linux.CLONE_CHILD_CLEARTID))))
        // The stack's top is where the header starts.
        raw: @bit_native = @linux_thread_clone(flags, header, header, header, @ptr_add(header, clone_tls), clone_tls_size, ref thread_start as ref unknown, start)
        if Linux.is_error(raw) {
            why: Error = error_of_errno(Linux.errno_of(raw))
            unmap_pages(mapping, size)
            result = .Error(why)
        } else {
            thread: Thread { value = raw, memory = mapping, size = size }
            result = .Ok(thread)
        }
    }

    // `pthread_create` and `pthread_join`, the same POSIX functions on
    // macOS and in a Linux C library.
    pthread_create: extern function (thread: ref @bit_native, attr: ref unknown, start_routine: ref unknown, arg: ref unknown) result: @bit32
    pthread_join: extern function (thread: @bit_native, value_ptr: ref unknown) result: @bit32
    pthread_attr_init: extern function (attr: ref unknown) result: @bit32
    pthread_attr_setstacksize: extern function (attr: ref unknown, stacksize: @bit_native) result: @bit32
    pthread_attr_destroy: extern function (attr: ref unknown) result: @bit32
    sched_yield: extern function () result: @bit32

    posix_spawn_thread: function (entry: ref ThreadEntry, argument: ref unknown, stack_size: @bit_native) result: Result[Thread, Error] {
        start: ref unknown = map_pages(start_size).get() else -> why: Error {
            result = .Error(why)
            return
        }
        start_block(start, entry, argument)
        // A `pthread_attr_t`: 64 bytes on macOS and 64-bit glibc, less
        // elsewhere. pthread keeps its own guard page below the stack.
        attributes: @array(@bit64, 8) = @array(@bit64, 8) {}
        attributes_ref: ref @array(@bit64, 8) = ref attributes
        attr: ref unknown = attributes_ref as ref unknown
        handle: @bit_native = 0x0
        code: @bit32 = pthread_attr_init(attr)
        if code == 0x0 {
            code = pthread_attr_setstacksize(attr, stack_size)
            if code == 0x0 {
                code = pthread_create(ref handle, attr, ref thread_start as ref unknown, start)
            }
            pthread_attr_destroy(attr)
        }
        if code == 0x0 {
            thread: Thread { value = handle, memory = start, size = start_size }
            result = .Ok(thread)
        } else {
            unmap_pages(start, start_size)
            result = .Error(error_of_errno(code))
        }
    }

    posix_join_thread: function (thread: Thread) error: Optional[Error] {
        error = .None
        code: @bit32 = pthread_join(thread.value, null())
        if code == 0x0 {
            unmap_pages(thread.memory, start_size)
        } else {
            error = .Some(error_of_errno(code))
        }
    }
}
