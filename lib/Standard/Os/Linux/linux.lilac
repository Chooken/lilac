
mmap: function (size: @bit_native) memory: ref unknown {
    address: @bit_native = @syscall(call_location(0x9, 0xde), 0x0, size, 0x3, 0x22, @i_sub_native(0x0, 0x1), 0x0)
    if @i_greater_than_u_native(address, @i_sub_native(0x0, 0x1000)) {
        address = 0x0
    }
    memory = @address_to_ptr(address)
}

unmap: function (memory: ref unknown, size: @bit_native) result: @bit_native {
    result = @syscall(call_location(0xb, 0xd7), @ptr_to_address(memory), size, 0x0, 0x0, 0x0, 0x0)
}

exit_group: function (code: @bit32) nothing {
    result: @bit_native = @syscall(call_location(0xe7, 0x5e), @extend_zero(code), 0x0, 0x0, 0x0, 0x0, 0x0)
}

write: function (fd: @bit32, buffer: ref @bit8, count: @bit_native) written: @bit_native {
    written = @syscall(call_location(0x1, 0x40), @extend_zero(fd), @ptr_to_address(buffer as ref unknown), count, 0x0, 0x0, 0x0)
}

// The Linux system-call number: `x86` on x86-64, `arm` on 64-bit Arm.
call_location: function (x86: @bit_native, arm: @bit_native) number: @bit_native {
    match @builtin.Target.arch {
        .X86_64 => {
            number = x86
        }
        .Aarch64 => {
            number = arm
        }
    } else {
        @compile_error("Standard.Os makes Linux system calls only on x86-64 and 64-bit Arm; build with `--libc`")
    }
}