// Linux system calls, made directly with `@syscall`: no C library, also
// under `--libc`. Names, argument orders and constants are the kernel's,
// so the man pages document them. Only calls both x86-64 and 64-bit Arm
// have are here: `openat`, not `open`; `pipe2`, not `pipe`.
//
// A call returns the kernel's raw result: a value, or `-errno` on failure
// (`is_error`, `errno_of`). C `int` is `@bit32`; `long`, `size_t`, `off_t`
// and addresses are `@bit_native`; `void *` is `ref unknown`.

// The system-call number: `x86` on x86-64, `arm` on 64-bit Arm.
call_number: function (x86: @bit_native, arm: @bit_native) number: @bit_native {
    match @builtin.Target.arch {
        .X86_64 => {
            number = x86
        }
        .Aarch64 => {
            number = arm
        }
    } else {
        @compile_error("Standard.Os.Linux makes system calls only on x86-64 and 64-bit Arm; build with `--libc`")
    }
}

// Whether a system call's `result` is an error: `-4095` to `-1`.
is_error: function (result: @bit_native) Bool => @i_greater_than_u_native(result, @i_negate_native(0x1000))

// The `errno` of a failed call's `result` (the `E*` constants).
errno_of: function (result: @bit_native) @bit32 => @truncate(@i_negate_native(result))
