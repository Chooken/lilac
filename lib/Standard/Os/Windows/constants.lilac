// Win32 constants, by their `windows.h` names.

// `GetStdHandle` ids.
STD_INPUT_HANDLE: @bit32 => 0xFFFFFFF6
STD_OUTPUT_HANDLE: @bit32 => 0xFFFFFFF5
STD_ERROR_HANDLE: @bit32 => 0xFFFFFFF4

/// What `CreateFileW` and others return on failure, as an address
/// (`@ptr_to_address(handle) == INVALID_HANDLE_VALUE`).
INVALID_HANDLE_VALUE: @bit_native => @i_negate_native(0x1)

TRUE: @bit32 => 0x1
FALSE: @bit32 => 0x0

// Access rights.
GENERIC_READ: @bit32 => 0x80000000
GENERIC_WRITE: @bit32 => 0x40000000
GENERIC_EXECUTE: @bit32 => 0x20000000
GENERIC_ALL: @bit32 => 0x10000000

// `CreateFileW` sharing, dispositions, attributes and flags.
FILE_SHARE_READ: @bit32 => 0x1
FILE_SHARE_WRITE: @bit32 => 0x2
FILE_SHARE_DELETE: @bit32 => 0x4
CREATE_NEW: @bit32 => 0x1
CREATE_ALWAYS: @bit32 => 0x2
OPEN_EXISTING: @bit32 => 0x3
OPEN_ALWAYS: @bit32 => 0x4
TRUNCATE_EXISTING: @bit32 => 0x5
FILE_ATTRIBUTE_READONLY: @bit32 => 0x1
FILE_ATTRIBUTE_HIDDEN: @bit32 => 0x2
FILE_ATTRIBUTE_DIRECTORY: @bit32 => 0x10
FILE_ATTRIBUTE_NORMAL: @bit32 => 0x80
FILE_FLAG_BACKUP_SEMANTICS: @bit32 => 0x2000000
FILE_FLAG_DELETE_ON_CLOSE: @bit32 => 0x4000000
INVALID_FILE_ATTRIBUTES: @bit32 => 0xFFFFFFFF
FILE_APPEND_DATA: @bit32 => 0x4

// `SetFilePointerEx` methods.
FILE_BEGIN: @bit32 => 0x0
FILE_CURRENT: @bit32 => 0x1
FILE_END: @bit32 => 0x2

// `GetFileType` kinds.
FILE_TYPE_UNKNOWN: @bit32 => 0x0
FILE_TYPE_DISK: @bit32 => 0x1
FILE_TYPE_CHAR: @bit32 => 0x2
FILE_TYPE_PIPE: @bit32 => 0x3

// `MoveFileExW` flags.
MOVEFILE_REPLACE_EXISTING: @bit32 => 0x1
MOVEFILE_COPY_ALLOWED: @bit32 => 0x2
MOVEFILE_WRITE_THROUGH: @bit32 => 0x8

// `DuplicateHandle` options.
DUPLICATE_CLOSE_SOURCE: @bit32 => 0x1
DUPLICATE_SAME_ACCESS: @bit32 => 0x2

// Console modes.
ENABLE_PROCESSED_OUTPUT: @bit32 => 0x1
ENABLE_WRAP_AT_EOL_OUTPUT: @bit32 => 0x2
ENABLE_VIRTUAL_TERMINAL_PROCESSING: @bit32 => 0x4

// Code pages and conversion flags.
CP_UTF8: @bit32 => 0xFDE9
MB_ERR_INVALID_CHARS: @bit32 => 0x8
WC_ERR_INVALID_CHARS: @bit32 => 0x80

// Heap flags.
HEAP_NO_SERIALIZE: @bit32 => 0x1
HEAP_GENERATE_EXCEPTIONS: @bit32 => 0x4
HEAP_ZERO_MEMORY: @bit32 => 0x8
HEAP_REALLOC_IN_PLACE_ONLY: @bit32 => 0x10

// Virtual memory allocation types and protections.
MEM_COMMIT: @bit32 => 0x1000
MEM_RESERVE: @bit32 => 0x2000
MEM_DECOMMIT: @bit32 => 0x4000
MEM_RELEASE: @bit32 => 0x8000
PAGE_NOACCESS: @bit32 => 0x1
PAGE_READONLY: @bit32 => 0x2
PAGE_READWRITE: @bit32 => 0x4
PAGE_EXECUTE: @bit32 => 0x10
PAGE_EXECUTE_READ: @bit32 => 0x20
PAGE_EXECUTE_READWRITE: @bit32 => 0x40
PAGE_GUARD: @bit32 => 0x100

// Waits.
INFINITE: @bit32 => 0xFFFFFFFF
WAIT_OBJECT_0: @bit32 => 0x0
WAIT_ABANDONED: @bit32 => 0x80
WAIT_TIMEOUT: @bit32 => 0x102
WAIT_FAILED: @bit32 => 0xFFFFFFFF

// Process and thread creation.
CREATE_SUSPENDED: @bit32 => 0x4
CREATE_NO_WINDOW: @bit32 => 0x8000000
CREATE_UNICODE_ENVIRONMENT: @bit32 => 0x400
STACK_SIZE_PARAM_IS_A_RESERVATION: @bit32 => 0x10000
STARTF_USESTDHANDLES: @bit32 => 0x100
STILL_ACTIVE: @bit32 => 0x103

// `GetLastError` codes.
ERROR_SUCCESS: @bit32 => 0x0
ERROR_INVALID_FUNCTION: @bit32 => 0x1
ERROR_FILE_NOT_FOUND: @bit32 => 0x2
ERROR_PATH_NOT_FOUND: @bit32 => 0x3
ERROR_TOO_MANY_OPEN_FILES: @bit32 => 0x4
ERROR_ACCESS_DENIED: @bit32 => 0x5
ERROR_INVALID_HANDLE: @bit32 => 0x6
ERROR_NOT_ENOUGH_MEMORY: @bit32 => 0x8
ERROR_OUTOFMEMORY: @bit32 => 0xE
ERROR_INVALID_DRIVE: @bit32 => 0xF
ERROR_NOT_SAME_DEVICE: @bit32 => 0x11
ERROR_NO_MORE_FILES: @bit32 => 0x12
ERROR_WRITE_PROTECT: @bit32 => 0x13
ERROR_SHARING_VIOLATION: @bit32 => 0x20
ERROR_HANDLE_EOF: @bit32 => 0x26
ERROR_NOT_SUPPORTED: @bit32 => 0x32
ERROR_FILE_EXISTS: @bit32 => 0x50
ERROR_INVALID_PARAMETER: @bit32 => 0x57
ERROR_BROKEN_PIPE: @bit32 => 0x6D
ERROR_INSUFFICIENT_BUFFER: @bit32 => 0x7A
ERROR_INVALID_NAME: @bit32 => 0x7B
ERROR_DIR_NOT_EMPTY: @bit32 => 0x91
ERROR_ALREADY_EXISTS: @bit32 => 0xB7
ERROR_ENVVAR_NOT_FOUND: @bit32 => 0xCB
ERROR_NO_DATA: @bit32 => 0xE8
ERROR_DIRECTORY: @bit32 => 0x10B
ERROR_OPERATION_ABORTED: @bit32 => 0x3E3
ERROR_IO_PENDING: @bit32 => 0x3E5
ERROR_TIMEOUT: @bit32 => 0x5B4
