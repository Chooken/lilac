// The operating-system calls Standard is built on, picked per target at
// compile time from `@builtin.Target`: `kernel32` on Windows, system calls
// on Linux, and the C library on macOS, on Linux under `--libc`, and on a
// bare target that links one. Only the live arm of each `match` is
// compiled, so a program only links what its target uses.

// Writes `len` bytes at `data` to standard stream `fd` (1 = stdout,
// 2 = stderr).

using Standard.Os.Windows as Windows
using Standard.Os.Linux as Linux
using Standard.C as C

write_stream: function (fd: @bit32, buffer: ref @bit8, length: @bit_native) nothing {
    if @builtin.Target.libc {
        written: @bit_native = C.write(fd, buffer, length)
    } else match @builtin.Target.os {
        .Windows => {
            // I don't like this what if your not writing to std?
            handle: ref unknown = Windows.GetStdHandle(Windows.GetStd(fd))
            written: @bit32 = 0x0
            ok: @bit32 = Windows.WriteFile(handle, buffer, @truncate(length), ref written, @address_to_ptr(0x0))
        }
        .Linux => {
            written: @bit_native = Linux.write(fd, buffer, length)
        }
        .MacOs => {
            written: @bit_native = C.write(fd, buffer, length)
        }
        .None => {
            needs_libc()
            written: @bit_native = C.write(fd, buffer, length)
        }
    }
}

// Ends the process with `code`. Does not return.
exit_process: function (code: @bit32) nothing {
    if @builtin.Target.libc {
        C.exit(code)
    } else match @builtin.Target.os {
        .Windows => Windows.ExitProcess(code)
        .Linux => Linux.exit_group(code)
        .MacOs => C.exit(code)
        .None => {
            needs_libc()
            C.exit(code)
        }
    }
}

// `size` zeroed bytes, or null when out of memory. Free them with
// `deallocate`.
allocate: function (size: @bit_native) memory: ref unknown {
    if @builtin.Target.libc {
        memory = C.calloc(0x1, size)
    } else match @builtin.Target.os {
        .Windows => {
            memory = Windows.HeapAlloc(Windows.GetProcessHeap(), heap_zero_memory, size)
        }
        .Linux => {
            // One mapping per allocation, its length in a header in front.
            total: @bit_native = @i_add_native(size, alloc_header)
            mapped: ref unknown = map_pages(total)
            if @i_greater_than_u_native(@ptr_to_address(mapped), 0x0) {
                header: ref AllocHeader = mapped as ref AllocHeader
                header.length = total
                memory = @ptr_add(mapped, alloc_header)
            } else {
                memory = mapped
            }
        }
        .MacOs => {
            memory = C.calloc(0x1, size)
        }
        .None => {
            needs_libc()
            memory = C.calloc(0x1, size)
        }
    }
}

// Frees memory from `allocate`.
deallocate: function (memory: ref unknown) nothing {
    if @builtin.Target.libc {
        C.free(memory)
    } else match @builtin.Target.os {
        .Windows => {
            ok: @bit32 = Windows.HeapFree(Windows.GetProcessHeap(), 0x0, memory)
        }
        .Linux => {
            mapped: ref unknown = @address_to_ptr(@i_sub_native(@ptr_to_address(memory), alloc_header))
            header: ref AllocHeader = mapped as ref AllocHeader
            unmap_pages(mapped, header.length)
        }
        .MacOs => C.free(memory)
        .None => {
            needs_libc()
            C.free(memory)
        }
    }
}

// `size` bytes of fresh zeroed pages (`size` is rounded up to whole pages),
// or null when out of memory. Release them with `unmap_pages`.
map_pages: function (size: @bit_native) memory: ref unknown {
    if @builtin.Target.libc {
        memory = c_map(size, 0x1002)
    } else match @builtin.Target.os {
        .Windows => {
            memory = Windows.VirtualAlloc(@address_to_ptr(0x0), size, mem_commit_reserve, page_read_write)
        }
        .Linux => {
            memory = Linux.mmap(size)
        }
        .MacOs => {
            memory = c_map(size, 0x1002)
        }
        .None => {
            // No virtual memory: plain zeroed memory from the C library.
            needs_libc()
            memory = C.calloc(0x1, size)
        }
    }
}

// Releases `size` bytes of pages from `map_pages`.
unmap_pages: function (memory: ref unknown, size: @bit_native) nothing {
    if @builtin.Target.libc {
        memory = c_map(size, 0x1002)
    } else match @builtin.Target.os {
        .Windows => {
            ok: @bit32 = Windows.VirtualFree(memory, 0x0, mem_release)
        }
        .Linux => {
            result: @bit_native = Linux.unmap(memory, size)
        }
        .MacOs => {
            result: @bit32 = C.munmap(memory, size)
        }
        .None => {
            needs_libc()
            C.free(memory)
        }
    }
}

private {
    // The bytes in front of each Linux allocation, holding the mapping's
    // length for `munmap` (16 keeps the allocation 16-byte aligned).
    AllocHeader: object {
        length: @bit_native
    }

    alloc_header: @bit_native => 0x10

    // `GetStdHandle` takes `-10 - fd`: stdout (1) is `-11`, stderr `-12`.
    std_handle_base: @bit32 => 0xfffffff6

    heap_zero_memory: @bit32 => 0x8
    mem_commit_reserve: @bit32 => 0x3000
    mem_release: @bit32 => 0x8000
    page_read_write: @bit32 => 0x4

    

    // A bare target has no OS of its own: Standard needs a C library there.
    needs_libc: function () nothing {
        if @builtin.Target.libc {
        } else {
            @compile_error("Standard.Os needs a C library on a target with no OS; build with `--libc`")
        }
    }

    // `mmap` of fresh read-write pages with the target's `flags`
    // (`MAP_PRIVATE | MAP_ANONYMOUS`), or null.
    c_map: function (size: @bit_native, flags: @bit32) memory: ref unknown {
        memory = C.mmap(@address_to_ptr(0x0), size, 0x3, flags, 0xffffffff, 0x0)
        // `MAP_FAILED` is `-1`.
        if @i_greater_than_u_native(@ptr_to_address(memory), @i_sub_native(0x0, 0x1000)) {
            memory = @address_to_ptr(0x0)
        }
    }
}
