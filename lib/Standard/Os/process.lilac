// Ending the process.

using Standard.Os.Windows as Windows
using Standard.Os.Linux as Linux
using Standard.Os.MacOs as MacOs
using Standard.C as C

/// Ends the process with `code`. Does not return. Under `--libc` (and on
/// macOS) this is C's `exit`, which flushes C `stdio` first.
exit: function (code: @bit32) nothing {
    match @builtin.Target.os {
        .Windows => {
            if @builtin.Target.libc {
                C.exit(code)
            } else {
                Windows.ExitProcess(code)
            }
        }
        .Linux => {
            if @builtin.Target.libc {
                C.exit(code)
            } else {
                result: @bit_native = Linux.exit_group(code)
            }
        }
        .MacOs => MacOs.exit(code)
    } else {
        needs_libc()
        C.exit(code)
    }
}
