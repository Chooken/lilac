// The heap allocator, over the OS (`Standard.Os`).

using Standard.Os

Allocator: object {

    // A zeroed allocation, so the first assignment drops a zero value.
    create[T]: function() allocation: ref T {
        allocation = allocate(@size_of(T)) as ref T
    }

    destroy[T]: function(allocation: ref T) nothing {
        deallocate(allocation as ref unknown)
    }
}
