// The heap allocator, over the OS (`Standard.Os`).

using Standard.Os

Allocator: object {

    // A new allocation holding `value`, moved in. Free it with `destroy`.
    create[T]: function(value: T) allocation: ref T {
        memory: ref unknown = allocate(@size_of(T)).get() else {
            @panic("out of memory")
        }
        allocation = memory as ref T
        @write(allocation, value)
    }

    // Drops the value at `allocation` and frees it.
    destroy[T]: function(allocation: ref T) nothing {
        @drop(allocation)
        deallocate(allocation as ref unknown)
    }

    // Frees `allocation` without dropping anything: its value was moved
    // out (`@read`).
    free[T]: function(allocation: ref T) nothing {
        deallocate(allocation as ref unknown)
    }
}
