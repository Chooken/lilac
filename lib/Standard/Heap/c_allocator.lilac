
/// The C library's heap: `calloc`, `realloc` and `free`. It needs a C
/// library (`--libc`), and shares its heap with C code. Aligns to at most
/// two pointers, C's `max_align_t`.
CAllocator: object {

    ALLOCATOR_TABLE: ref AllocatorTable[CAllocator] => ref c_table

    /// This allocator as an `Allocator`. It keeps no state, so the handle
    /// is usable wherever the program runs.
    ALLOCATOR: Allocator => Allocator.from[CAllocator](ref c_allocator_instance)

    /// A new allocation holding `value`, moved in. Free it with `destroy`.
    create[T]: function (self, value: T) allocation: ref T {
        allocation = self.allocate_raw(@size_of(T), @align_of(T))
        @write(allocation, value)
    }

    /// Drops the value at `allocation` (from `create`) and frees it.
    destroy[T]: function (self, allocation: ref T) nothing {
        @drop(allocation)
        self.free_raw(allocation as ref unknown, @size_of(T), @align_of(T))
    }

    /// Frees `allocation` (from `create`) without dropping anything: its
    /// value was moved out (`@read`).
    free[T]: function (self, allocation: ref T) nothing {
        self.free_raw(allocation as ref unknown, @size_of(T), @align_of(T))
    }

    /// Room for `count` zeroed `T`s, as a slice of them. Free it with
    /// `deallocate`.
    allocate[T]: function (self, count: Int) allocation: Slice[T] {
        allocation = Slice[T].create(
            self.allocate_raw(
                array_size(@size_of(T), count), 
                @align_of(T)
            ) as ref T, 
            count
        )
    }

    /// `memory` (from `allocate` or `reallocate`, whole) resized to
    /// `new_count` elements, keeping the first of them; new elements are
    /// zeroed. The elements may move: use the returned slice, never
    /// `memory` again.
    reallocate[T]: function (self, memory: Slice[T], new_count: Int) allocation: Slice[T] {
        allocation = Slice[T].create(
            self.reallocate_raw(
                memory.base() as ref unknown, 
                array_size(@size_of(T), memory.get_count()), 
                array_size(@size_of(T), new_count), 
                @align_of(T)
            ) as ref T,
            new_count
        )
    }

    /// Frees `memory` (from `allocate` or `reallocate`, whole) without
    /// dropping anything.
    deallocate[T]: function (self, memory: Slice[T]) nothing {
        self.free_raw(
            memory.base() as ref unknown, 
            array_size(@size_of(T), memory.get_count()), 
            @align_of(T)
        )
    }

    /// `size` zeroed bytes aligned to `alignment` (at most two pointers);
    /// panics when the request is bad or out of memory.
    allocate_raw: function (self, size: Int, alignment: Int) allocation: ref unknown {
        check_request(size, alignment)
        within_c_alignment(alignment)
        if size == 0 as Int {
            allocation = empty_allocation(alignment)
            return
        }
        allocation = C.calloc(0x1, size as @bit_native)
        if @ptr_to_address(allocation) == 0x0 {
            @panic("Out of memory.")
        }
    }

    /// `memory` (`old_size` bytes at `alignment` from this allocator)
    /// resized to `new_size`, keeping its bytes up to the smaller size and
    /// zeroing the rest; panics when the request is bad or out of memory.
    reallocate_raw: function (self, memory: ref unknown, old_size: Int, new_size: Int, alignment: Int) allocation: ref unknown {
        check_request(old_size, alignment)
        check_request(new_size, alignment)
        within_c_alignment(alignment)
        if old_size == 0 as Int {
            allocation = self.allocate_raw(new_size, alignment)
            return
        }
        if new_size == 0 as Int {
            self.free_raw(memory, old_size, alignment)
            allocation = empty_allocation(alignment)
            return
        }
        allocation = C.realloc(memory, new_size as @bit_native)
        if @ptr_to_address(allocation) == 0x0 {
            @panic("Out of memory.")
        }
        // `realloc` leaves what it adds unset.
        if new_size > old_size {
            @memset(@ptr_add(allocation, old_size as @bit_native), 0x0, (new_size - old_size) as @bit_native)
        }
    }

    /// Gives back `memory`, `size` bytes at `alignment` from this
    /// allocator.
    free_raw: function (self, memory: ref unknown, size: Int, alignment: Int) nothing {
        check_request(size, alignment)
        within_c_alignment(alignment)
        if size == 0 as Int {
            return
        }
        C.free(memory)
    }
}

private {

    /// The allocator `ALLOCATOR` is built over: stateless, so one global
    /// instance serves every handle.
    c_allocator_instance: CAllocator = CAllocator {}

    /// Refuses an alignment past C's `max_align_t`: two pointers.
    within_c_alignment: function (alignment: Int) nothing {
        if alignment > 2 * (@size_of(@bit_native) as Int) {
            @panic("CAllocator aligns to at most two pointers.")
        }
    }

    c_table: AllocatorTable[CAllocator] = AllocatorTable {
        allocate = ref CAllocator.allocate_raw
        reallocate = ref CAllocator.reallocate_raw
        free = ref CAllocator.free_raw
    }

}