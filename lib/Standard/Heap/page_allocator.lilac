
/// Whole pages from the OS for each allocation (`Os.map_pages`), given
/// back to it when freed. It keeps no state, so every thread may use it,
/// but each allocation takes at least a page: allocate in bulk from it, or
/// put an arena over it. Aligns to at most a page.
PageAllocator: object {

    ALLOCATOR_TABLE: ref AllocatorTable[PageAllocator] => ref page_table

    /// This allocator as an `Allocator`. It keeps no state, so the handle
    /// is usable wherever the program runs.
    ALLOCATOR: Allocator => Allocator.from[PageAllocator](ref page_allocator_instance)

    /// `size` zeroed bytes of pages aligned to `alignment` (at most a
    /// page); panics when the request is bad or out of memory.
    allocate_raw: function (self, size: Int, alignment: Int) allocation: ref unknown {
        check_request(size, alignment)
        within_page(alignment)
        if size == 0 as Int {
            allocation = empty_allocation(alignment)
            return
        }
        pages: ref unknown = Os.map_pages(size as @bit_native).get() else {
            @panic("Out of memory.")
        }
        allocation = pages
    }

    /// In place while the size stays within the same pages, else moved to
    /// new pages.
    reallocate_raw: function (self, memory: ref unknown, old_size: Int, new_size: Int, alignment: Int) allocation: ref unknown {
        check_request(old_size, alignment)
        check_request(new_size, alignment)
        within_page(alignment)
        if old_size == 0 as Int {
            allocation = self.allocate_raw(new_size, alignment)
            return
        }
        if new_size == 0 as Int {
            self.free_raw(memory, old_size, alignment)
            allocation = empty_allocation(alignment)
            return
        }
        page: Int = @builtin.Target.page_size
        if (old_size - 1) / page == (new_size - 1) / page {
            // What a shrink gives back goes back to zero, for a later
            // growth.
            if new_size < old_size {
                @memset(@ptr_add(memory, new_size as @bit_native), 0x0, (old_size - new_size) as @bit_native)
            }
            allocation = memory
            return
        }
        allocation = self.allocate_raw(new_size, alignment)
        @memcpy(allocation, memory, smaller(old_size, new_size) as @bit_native)
        self.free_raw(memory, old_size, alignment)
    }

    /// Gives back `memory`, `size` bytes at `alignment` from this
    /// allocator.
    free_raw: function (self, memory: ref unknown, size: Int, alignment: Int) nothing {
        check_request(size, alignment)
        within_page(alignment)
        if size == 0 as Int {
            return
        }
        Os.unmap_pages(memory, size as @bit_native)
    }
}

private {

    /// The allocator `ALLOCATOR` is built over: stateless, so one global
    /// instance serves every handle.
    page_allocator_instance: PageAllocator = PageAllocator {}

    /// Refuses an alignment past a page.
    within_page: function (alignment: Int) nothing {
        if alignment > @builtin.Target.page_size {
            @panic("PageAllocator aligns to at most a page.")
        }
    }

    page_table: AllocatorTable[PageAllocator] = AllocatorTable {
        allocate = ref PageAllocator.allocate_raw
        reallocate = ref PageAllocator.reallocate_raw
        free = ref PageAllocator.free_raw
    }

}