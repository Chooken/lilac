using Standard.Os as Os

/// A general-purpose allocator: any size at any alignment, each
/// allocation freed on its own. Thread-safe (one lock around every call).
///
/// A request of at most `MAX_SMALL` bytes, at an alignment of at most a
/// page, is rounded up to one of 36 size classes (16 bytes apart up to
/// 128, then four classes per doubling, so at most a quarter of a slot is
/// rounding) and takes a slot of that class: the last slot the class
/// freed, else the next slot of its newest slab (one mapping of pages,
/// split into equal slots), else a new slab. A freed slot goes back to
/// its class, so small allocation and free take constant time and keep
/// no header. Slabs stay mapped for the class's later allocations until
/// the allocator is dropped. Every larger (or more aligned) request is a
/// mapping of its own, unmapped when it is freed.
///
/// `new` maps the size classes' table, so a new allocator either is
/// ready or the program already panicked. Every allocation panics when
/// out of memory: a returned reference is always live.
///
/// `free` and `reallocate` must be given the size and alignment the
/// memory was allocated with: they pick the class. In a Debug build every
/// free and resize checks that: memory this allocator did not give, a
/// wrong size or alignment, a double free, and a write to freed memory
/// that is then reallocated all panic.
GeneralAllocator: structure {

    private {
        // Every size class's freed slots and slabs; mapped by `new`.
        classes: ref ClassTable
        // The live large allocations' headers, newest first.
        large: Optional[ref LargeHeader]
        // Bytes of live allocations, as requested, and bytes mapped.
        used: Int
        mapped: Int
        // 0 when no call is running, 1 while one is.
        lock: @bit32
    }

    ALLOCATOR_TABLE: ref AllocatorTable[GeneralAllocator] => ref general_allocator_table

    /// The largest request a size class takes: 16 KiB.
    MAX_SMALL: Int => 16 * 1024

    /// A new allocator. It maps the size classes' table now, panicking
    /// when out of memory.
    new: function () allocator: GeneralAllocator {
        table: ref ClassTable = map_class_table()
        allocator = GeneralAllocator {
            classes = table
            large = .None
            used = 0
            mapped = class_table_size()
            lock = 0x0
        }
    }

    /// Bytes of live allocations, as requested.
    get_used: function (self) used: Int {
        self.acquire()
        used = self.used
        self.release()
    }

    /// Bytes mapped: every slab, used or not, the size classes' table, and
    /// every large allocation with its header and padding.
    get_capacity: function (self) mapped: Int {
        self.acquire()
        mapped = self.mapped
        self.release()
    }

    /// This allocator as an `Allocator`. It must stay in place while the
    /// handle is used.
    allocator: function (self) Allocator => Allocator.from[GeneralAllocator](self)

    /// A new allocation holding `value`, moved in. Free it with `destroy`.
    create[T]: function (self, value: T) allocation: ref T {
        allocation = self.allocate_raw(@size_of(T), @align_of(T)) as ref T
        @write(allocation, value)
    }

    /// Drops the value at `allocation` (from `create`) and frees it.
    destroy[T]: function (self, allocation: ref T) nothing {
        @drop(allocation)
        self.free_raw(allocation as ref unknown, @size_of(T), @align_of(T))
    }

    /// Frees `allocation` (from `create`) without dropping anything: its
    /// value was moved out (`@read`).
    free[T]: function (self, allocation: ref T) nothing {
        self.free_raw(allocation as ref unknown, @size_of(T), @align_of(T))
    }

    /// Room for `count` zeroed `T`s, as a slice of them. Free it with
    /// `deallocate`.
    allocate[T]: function (self, count: Int) allocation: Slice[T] {
        allocation = Slice[T].new(
            self.allocate_raw(
                array_size(@size_of(T), count), 
                @align_of(T)
            ) as ref T, 
            count
        )
    }

    /// `memory` (from `allocate` or `reallocate`, whole) resized to
    /// `new_count` elements, keeping the first of them; new elements are
    /// zeroed. The elements may move: use the returned slice, never
    /// `memory` again.
    reallocate[T]: function (self, memory: Slice[T], new_count: Int) allocation: Slice[T] {
        allocation = Slice[T].new(
            self.reallocate_raw(
                memory.base() as ref unknown, 
                array_size(@size_of(T), memory.get_count()), 
                array_size(@size_of(T), new_count), 
                @align_of(T)
            ) as ref T,
            new_count
        )
    }

    /// Frees `memory` (from `allocate` or `reallocate`, whole) without
    /// dropping anything.
    deallocate[T]: function (self, memory: Slice[T]) nothing {
        self.free_raw(
            memory.base() as ref unknown, 
            array_size(@size_of(T), memory.get_count()), 
            @align_of(T)
        )
    }

    /// `size` zeroed bytes aligned to `alignment` (a power of two);
    /// panics when the request is bad or out of memory.
    allocate_raw: function (self, size: Int, alignment: Int) allocation: ref unknown {
        check_request(size, alignment)
        if size == 0 as Int {
            allocation = empty_allocation(alignment)
            return
        }
        self.acquire()
        allocation = self.allocate_unlocked(size, alignment)
        self.release()
    }

    /// `memory` (`old_size` bytes at `alignment` from this allocator)
    /// resized to `new_size`, keeping its bytes up to the smaller size and
    /// zeroing the rest: in place while the size class stays the same (or
    /// a large allocation's mapping still fits it, and is not twice what it
    /// needs), else moved. Panics when the request is bad or out of
    /// memory, and `memory` is then untouched.
    reallocate_raw: function (self, memory: ref unknown, old_size: Int, new_size: Int, alignment: Int) allocation: ref unknown {
        check_request(old_size, alignment)
        check_request(new_size, alignment)
        if old_size == 0 as Int {
            allocation = self.allocate_raw(new_size, alignment)
            return
        }
        if new_size == 0 as Int {
            self.free_raw(memory, old_size, alignment)
            allocation = empty_allocation(alignment)
            return
        }
        self.acquire()
        allocation = self.reallocate_unlocked(memory, old_size, new_size, alignment)
        self.release()
    }

    /// Gives back `memory`, `size` bytes at `alignment` from this
    /// allocator.
    free_raw: function (self, memory: ref unknown, size: Int, alignment: Int) nothing {
        check_request(size, alignment)
        if size == 0 as Int {
            return
        }
        self.acquire()
        self.free_unlocked(memory, size, alignment)
        self.release()
    }

    /// Unmaps every slab, the size classes' table and every large
    /// allocation: everything allocated from it is gone.
    @on_drop: function (self) nothing {
        table: ref ClassTable = self.classes
        index: Int = 0
        loop {
            if index == CLASS_COUNT {
                break
            }
            next_slab: Optional[ref Slab] = class_at(table, index).slab
            loop if next_slab.get() -> slab: ref Slab {
                // Read before the unmap takes the header with it.
                next_slab = slab.next
                Os.unmap_pages(slab.base, slab.size as @bit_native)
            } else break
            index = index + 1
        }
        Os.unmap_pages(table as ref unknown, class_table_size() as @bit_native)

        next_large: Optional[ref LargeHeader] = self.large
        loop if next_large.get() -> header: ref LargeHeader {
            next_large = header.next
            Os.unmap_pages(header.mapping, header.mapping_size as @bit_native)
        } else break
    }

    private {

        /// Waits until no other call is running, then holds the lock.
        acquire: function (self) nothing {
            loop {
                if @atomic_compare_swap_acquire_32(ref self.lock, 0x0, 0x1) == 0x0 {
                    break
                }
                // Wait for it to look free before trying again, so a
                // waiting thread reads the lock instead of writing it.
                loop {
                    if @atomic_load_relaxed_32(ref self.lock) == 0x0 {
                        break
                    }
                    Os.yield_thread()
                }
            }
        }

        release: function (self) nothing {
            @atomic_store_release_32(ref self.lock, 0x0)
        }

        allocate_unlocked: function (self, size: Int, alignment: Int) allocation: ref unknown {
            class: Int = class_of(size, alignment)
            if class < 0 {
                allocation = self.allocate_large(size, alignment)
            } else {
                allocation = self.allocate_small(class, size)
            }
            self.used = self.used + size
        }

        reallocate_unlocked: function (self, memory: ref unknown, old_size: Int, new_size: Int, alignment: Int) allocation: ref unknown {
            old_class: Int = class_of(old_size, alignment)
            new_class: Int = class_of(new_size, alignment)

            // The same slot.
            if old_class >= 0 and old_class == new_class {
                if @builtin.Build.mode == .Debug {
                    state: ref SizeClass = self.class_state(old_class)
                    flag: ref @bit8 = slot_flag(state, class_size(old_class), memory)
                    if @load_u8(flag, 0x0) == 0x0 {
                        @panic("Resized memory that was already freed.")
                    }
                }
                self.resize_in_place(memory, old_size, new_size)
                allocation = memory
                return
            }

            // The same mapping, while it fits and is not mostly unused.
            if old_class < 0 and new_class < 0 {
                header: ref LargeHeader = self.large_header(memory, old_size)
                offset: Int = @i_sub_native(@ptr_to_address(memory), @ptr_to_address(header.mapping))
                if new_size <= header.mapping_size - offset {
                    needed: Int = align_up(offset + new_size, @builtin.Target.page_size)
                    if needed > header.mapping_size / 2 {
                        self.resize_in_place(memory, old_size, new_size)
                        header.size = new_size
                        allocation = memory
                        return
                    }
                }
            }

            allocation = self.allocate_unlocked(new_size, alignment)
            @memcpy(allocation, memory, smaller(old_size, new_size) as @bit_native)
            self.free_unlocked(memory, old_size, alignment)
        }

        /// `memory`'s size changed where it is: new bytes are zeroed (a
        /// shrink earlier may have left them used).
        resize_in_place: function (self, memory: ref unknown, old_size: Int, new_size: Int) nothing {
            if new_size > old_size {
                @memset(@ptr_add(memory, old_size as @bit_native), 0x0, (new_size - old_size) as @bit_native)
            }
            self.used = self.used - old_size + new_size
        }

        free_unlocked: function (self, memory: ref unknown, size: Int, alignment: Int) nothing {
            class: Int = class_of(size, alignment)
            if class < 0 {
                self.free_large(memory, size)
            } else {
                self.free_small(class, memory)
            }
            self.used = self.used - size
        }

        /// The state of `class`: every freed or resized slot means one was
        /// allocated. In a Debug build, a panic when it was not.
        class_state: function (self, class: Int) state: ref SizeClass {
            state = class_at(self.classes, class)
        }

        /// A slot of `class` with its first `size` bytes zeroed; panics
        /// when out of memory.
        allocate_small: function (self, class: Int, size: Int) slot: ref unknown {
            state: ref SizeClass = class_at(self.classes, class)
            slot_size: Int = class_size(class)
            slot = self.next_slot(state, slot_size, size)

            if @builtin.Build.mode == .Debug {
                flag: ref @bit8 = slot_flag(state, slot_size, slot)
                if @load_u8(flag, 0x0) != 0x0 {
                    @panic("GeneralAllocator is corrupted: a live slot was on the free list.")
                }
                @store_u8(flag, 0x0, 0x1)
            }
        }

        /// `state`'s next slot, its first `size` bytes zeroed: its most
        /// recently freed one, else the next of its newest slab (never
        /// used, so the pages are still zero); panics when out of memory.
        next_slot: function (self, state: ref SizeClass, slot_size: Int, size: Int) slot: ref unknown {
            freed: Optional[ref unknown] = take_free(state, slot_size, size)
            if freed.get() -> reused: ref unknown {
                slot = reused
                return
            }
            slab: ref Slab = self.carving_slab(state, slot_size)
            slot = @ptr_add(slab.base, slab.carved as @bit_native)
            slab.carved = slab.carved + slot_size
        }

        /// `state`'s newest slab when it has a slot of `slot_size` left to
        /// carve, else a new one; panics when out of memory.
        carving_slab: function (self, state: ref SizeClass, slot_size: Int) carving: ref Slab {
            if state.slab.get() -> newest: ref Slab {
                if newest.carved <= newest.limit - slot_size {
                    carving = newest
                    return
                }
            }
            carving = add_slab(state, slot_size)
            self.mapped = self.mapped + carving.size
        }

        /// Puts `memory`, a slot of `class`, back on its class's free list.
        free_small: function (self, class: Int, memory: ref unknown) nothing {
            state: ref SizeClass = self.class_state(class)

            if @builtin.Build.mode == .Debug {
                slot_size: Int = class_size(class)
                flag: ref @bit8 = slot_flag(state, slot_size, memory)
                if @load_u8(flag, 0x0) == 0x0 {
                    @panic("Freed memory that was already freed.")
                }
                @store_u8(flag, 0x0, 0x0)
                // Checked when the slot is handed out again.
                @memset(memory, POISON, slot_size as @bit_native)
            }

            slot: ref FreeSlot = memory as ref FreeSlot
            @write(slot, FreeSlot { next = state.free })
            state.free = .Some(slot)
        }

        /// `size` zeroed bytes at `alignment` in a mapping of their own,
        /// after a header; panics when out of memory.
        allocate_large: function (self, size: Int, alignment: Int) allocation: ref unknown {

            page: Int = @builtin.Target.page_size
            header_size: Int = @size_of(LargeHeader)
            aligned: Int = alignment
            if aligned < MIN_ALIGNMENT {
                aligned = MIN_ALIGNMENT
            }

            // The header, then the padding up to the alignment: exact at
            // most a page aligned (the mapping is), else at most
            // `aligned - 1` bytes past the header.
            padding: Int = align_up(header_size, aligned)
            if aligned > page {
                padding = header_size + (aligned - 1)
            }
            if size > Int.MAX - padding - (page - 1) {
                @panic("Out of memory.")
            }
            mapping_size: Int = align_up(padding + size, page)

            mapping: ref unknown = map_or_panic(mapping_size)
            self.mapped = self.mapped + mapping_size

            base: Int = @ptr_to_address(mapping)
            offset: Int = align_up(base.wrapping_add(header_size), aligned).wrapping_subtract(base)
            memory: ref unknown = @ptr_add(mapping, offset as @bit_native)

            header: ref LargeHeader = header_of(memory)
            @write(header, LargeHeader {
                mapping = mapping
                mapping_size = mapping_size
                size = size
                next = self.large
                previous = .None
            })
            if self.large.get() -> newest: ref LargeHeader {
                newest.previous = .Some(header)
            }
            self.large = .Some(header)
            allocation = memory
        }

        /// Unmaps the large allocation `memory`, `size` bytes.
        free_large: function (self, memory: ref unknown, size: Int) nothing {
            header: ref LargeHeader = self.large_header(memory, size)

            if header.previous.get() -> previous: ref LargeHeader {
                previous.next = header.next
            } else {
                self.large = header.next
            }
            if header.next.get() -> next: ref LargeHeader {
                next.previous = header.previous
            }

            // Read before the unmap takes the header with it.
            mapping: ref unknown = header.mapping
            mapping_size: Int = header.mapping_size
            self.mapped = self.mapped - mapping_size
            Os.unmap_pages(mapping, mapping_size as @bit_native)
        }

        /// The header of the large allocation `memory`, `size` bytes; in
        /// a Debug build, a panic unless it is one of this allocator's live
        /// ones, of that size.
        large_header: function (self, memory: ref unknown, size: Int) header: ref LargeHeader {
            header = header_of(memory)
            if @builtin.Build.mode == .Debug {
                next_large: Optional[ref LargeHeader] = self.large
                loop {
                    live: ref LargeHeader = next_large.get() else {
                        @panic(NOT_OURS)
                    }
                    if @ptr_to_address(live as ref unknown) == @ptr_to_address(header as ref unknown) {
                        break
                    }
                    next_large = live.next
                }
                if header.size != size {
                    @panic(NOT_OURS)
                }
            }
        }
    }
}

private {

    /// The number of size classes, `ClassTable.classes`' length.
    CLASS_COUNT: Int => 36

    /// Every allocation's least alignment: C's `max_align_t` on 64-bit
    /// targets, and every class's size is a multiple of it.
    MIN_ALIGNMENT: Int => 16

    /// The least a slab maps: 64 KiB (Windows' allocation granularity).
    MIN_SLAB: Int => 64 * 1024

    /// What a freed slot holds past its link, in a Debug build.
    POISON: @bit8 => 0xDE

    NOT_OURS: @byte_buffer => "Freed or resized memory this allocator did not give, or with another size or alignment."

    /// Every size class's state. The table is mapped by `new`, which
    /// writes each state, so no state depends on zeroed memory.
    ClassTable: structure {
        classes: @array(SizeClass, 36)
    }

    /// One size class: its freed slots and its slabs.
    SizeClass: structure {
        // The most recently freed slot.
        free: Optional[ref FreeSlot]
        // The newest slab, the one slots are carved from.
        slab: Optional[ref Slab]
    }

    /// A freed slot: the slot freed before it.
    FreeSlot: structure {
        next: Optional[ref FreeSlot]
    }

    /// A slab's header, at its end so the slots start at its first page
    /// (aligned as the slot size is, up to a page). In a Debug build it is
    /// followed by a live flag byte per slot.
    Slab: structure {
        base: ref unknown
        // Bytes mapped.
        size: Int
        // Bytes of slots handed out so far, from `base`.
        carved: Int
        // Bytes of slots the slab holds.
        limit: Int
        // The class's slab before this one.
        next: Optional[ref Slab]
    }

    /// A large allocation's header, just before it.
    LargeHeader: structure {
        mapping: ref unknown
        mapping_size: Int
        // Bytes the allocation takes, as requested.
        size: Int
        // The live large allocations around it.
        next: Optional[ref LargeHeader]
        previous: Optional[ref LargeHeader]
    }

    general_allocator_table: AllocatorTable[GeneralAllocator] = AllocatorTable {
        allocate = ref GeneralAllocator.allocate_raw
        reallocate = ref GeneralAllocator.reallocate_raw
        free = ref GeneralAllocator.free_raw
    }

    /// The size class of `size` bytes at `alignment`, or -1 when it is a
    /// large allocation. A class's slots are aligned to every power of two
    /// that divides the class's size, up to a page, so the size is first
    /// rounded up to the alignment: the class of a multiple of a power of
    /// two is a multiple of it.
    class_of: function (size: Int, alignment: Int) class: Int {
        class = -1
        if size > GeneralAllocator.MAX_SMALL or alignment > GeneralAllocator.MAX_SMALL or alignment > @builtin.Target.page_size {
            return
        }

        rounded: Int = size
        if rounded < MIN_ALIGNMENT {
            rounded = MIN_ALIGNMENT
        }
        if alignment > MIN_ALIGNMENT {
            rounded = align_up(rounded, alignment)
        }
        if rounded > GeneralAllocator.MAX_SMALL {
            return
        }

        if rounded <= 128 {
            class = (rounded + 15) / 16 - 1
            return
        }

        // 2^k < rounded <= 2^(k + 1), k >= 7: four classes 2^(k - 2)
        // apart.
        zeros: Int = @bit_leading_zeros_native((rounded - 1) as @bit_native)
        width: Int = @size_of(Int)
        k: Int = width * 8 - 1 - zeros
        power: Int = @bit_shift_left_native(0x1, k as @bit_native)
        class = 8 + (k - 7) * 4 + (rounded - 1 - power) / (power / 4)
    }

    /// The slot size of `class`, the inverse of `class_of`.
    class_size: function (class: Int) size: Int {
        if class < 8 {
            size = (class + 1) * 16
            return
        }
        group: Int = (class - 8) / 4
        power: Int = @bit_shift_left_native(0x80, group as @bit_native)
        size = power + ((class - 8) % 4 + 1) * (power / 4)
    }

    class_at: function (table: ref ClassTable, class: Int) ref SizeClass => @array_at(ref table.classes, class as @bit_native)

    /// The pages `ClassTable` takes.
    class_table_size: function () Int => align_up(@size_of(ClassTable), @builtin.Target.page_size)

    /// A new table of empty size classes; panics when out of memory. Each
    /// state is written, so none depends on zeroed memory.
    map_class_table: function () table: ref ClassTable {
        memory: ref unknown = map_or_panic(class_table_size())
        classes: ref ClassTable = memory as ref ClassTable
        index: Int = 0
        loop {
            if index == CLASS_COUNT {
                break
            }
            @write(class_at(classes, index), SizeClass {
                free = .None
                slab = .None
            })
            index = index + 1
        }
        table = classes
    }

    /// `state`'s most recently freed slot, off its free list, with its
    /// first `size` bytes zeroed; `None` when it has none.
    take_free: function (state: ref SizeClass, slot_size: Int, size: Int) memory: Optional[ref unknown] {
        memory = .None
        slot: ref FreeSlot = state.free.get() else {
            return
        }
        if @builtin.Build.mode == .Debug {
            check_poison(slot as ref unknown, slot_size)
        }
        state.free = slot.next
        @memset(slot as ref unknown, 0x0, size as @bit_native)
        memory = .Some(slot as ref unknown)
    }

    /// A new slab for `state`'s slots of `slot_size`, now its newest; it
    /// holds at least 16 slots. Panics when out of memory.
    add_slab: function (state: ref SizeClass, slot_size: Int) slab: ref Slab {

        size: Int = align_up(slot_size * 16, @builtin.Target.page_size)
        if size < MIN_SLAB {
            size = MIN_SLAB
        }

        tail: Int = @size_of(Slab)
        if @builtin.Build.mode == .Debug {
            tail = tail + size / slot_size
        }
        tail = align_up(tail, MIN_ALIGNMENT)

        base: ref unknown = map_or_panic(size)
        header: ref Slab = @ptr_add(base, (size - tail) as @bit_native) as ref Slab
        @write(header, Slab {
            base = base
            size = size
            carved = 0
            limit = (size - tail) / slot_size * slot_size
            next = state.slab
        })
        state.slab = .Some(header)
        slab = header
    }

    /// The Debug live flag of the slot at `memory` in `state`'s slabs of
    /// `slot_size` slots; a panic when `memory` is no slot of them.
    slot_flag: function (state: ref SizeClass, slot_size: Int, memory: ref unknown) flag: ref @bit8 {
        address: @bit_native = @ptr_to_address(memory)
        next_slab: Optional[ref Slab] = state.slab
        loop {
            slab: ref Slab = next_slab.get() else {
                @panic(NOT_OURS)
            }
            base: @bit_native = @ptr_to_address(slab.base)
            if @i_greater_than_or_equal_u_native(address, base) and @i_less_than_u_native(address, @i_add_native(base, slab.carved as @bit_native)) {
                offset: Int = @i_sub_native(address, base)
                if offset % slot_size != 0 as Int {
                    @panic(NOT_OURS)
                }
                flag = @ptr_add(slab as ref unknown, (@size_of(Slab) + offset / slot_size) as @bit_native) as ref @bit8
                return
            }
            next_slab = slab.next
        }
    }

    /// Panics unless the freed slot `memory` still holds `POISON` past its
    /// link: anything else was written after it was freed.
    check_poison: function (memory: ref unknown, slot_size: Int) nothing {
        bytes: ref @bit8 = memory as ref @bit8
        index: Int = @size_of(FreeSlot)
        loop {
            if index == slot_size {
                break
            }
            if @load_u8(bytes, index as @bit_native) != POISON {
                @panic("Memory was written after it was freed.")
            }
            index = index + 1
        }
    }

    /// The header just before the large allocation `memory`.
    header_of: function (memory: ref unknown) ref LargeHeader => @address_to_ptr(@i_sub_native(@ptr_to_address(memory), @size_of(LargeHeader) as @bit_native)) as ref LargeHeader

    /// `size` bytes of fresh zeroed pages; panics when out of memory.
    map_or_panic: function (size: Int) memory: ref unknown {
        pages: ref unknown = Os.map_pages(size as @bit_native).get() else {
            @panic("Out of memory.")
        }
        memory = pages
    }
}
