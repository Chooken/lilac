/// The outcome of an operation that can fail: `Ok` with its value, or
/// `Error` with why. A zeroed `Result` is `Ok` with a zero value.
Result[T, E]: enum {
    /// It worked, giving this value.
    Ok: T
    /// It failed, for this reason.
    Error: E

    is_ok: function(self) ok: Bool {
        match self {
            .Ok => {
                ok = true
            }
        } else {
            ok = false
        }
    }

    /// The value of an `Ok` (moved out of the result); fails with the
    /// error of an `Error`.
    get: function(self: Result[T, E]) value: T else error: E {
        match self {
            .Ok -> ok_value: T {
                value = ok_value
                return
            }
            .Error -> why: E {
                error = why
            }
        }
        fail
    }

    unwrap_or: function(self: Result[T, E], default: T) value: T {
        match self {
            .Ok -> ok_value: T {
                value = ok_value
            }
        } else {
            value = default
        }
    }

    /// The error of an `Error`; fails on an `Ok`.
    error: function(self: Result[T, E]) error: E else nothing {
        match self {
            .Error -> why: E {
                error = why
                return
            }
        }
        fail
    }

    /// `Ok(value)` or `Error(error)`; usable when `T` and `E` copy and have
    /// a `@format` (checked where it is used).
    @format: function (self, out: ref Formatter) nothing {
        match self {
            .Ok -> ok_value: T {
                out.write($"Ok({ok_value})")
            }
            .Error -> why: E {
                out.write($"Error({why})")
            }
        }
    }
}
