// The outcome of an operation that can fail: `Ok` with its value, or
// `Error` with why. A zeroed `Result` is `Ok` with a zero value.
Result[T, E]: enum {
    Ok: T
    Error: E

    is_ok: function(self) ok: Bool {
        match self {
            .Ok => {
                ok = true
            }
        } else {
            ok = false
        }
    }

    // The value of an `Ok`; fails with the error of an `Error`.
    get: function(self) value: T else error: E {
        match self {
            .Ok -> ok_value: T {
                value = ok_value
                return
            }
            .Error -> why: E {
                error = why
            }
        }
        fail
    }

    unwrap_or: function(self, default: T) value: T {
        match self {
            .Ok -> ok_value: T {
                value = ok_value
            }
        } else {
            value = default
        }
    }

    // The error of an `Error`; fails on an `Ok`.
    error: function(self) error: E else nothing {
        match self {
            .Error -> why: E {
                error = why
                return
            }
        }
        fail
    }
}
