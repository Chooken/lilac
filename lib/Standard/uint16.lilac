        back: @bit16 = bits
        if back == self.data and @i_greater_than_or_equal_16(bits, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int16`, wrapping around at `Int16`'s range: the
    /// low bits.
    to_int16_wrapping: function (self: Uint16) Int16 => self.data as @bit16 as Int16

    /// This value as a `Uint8`; fails when it is out of `Uint8`'s range.
    to_uint8: function (self: Uint16) value: Uint8 else nothing {
        bits: @bit8 = @truncate(self.data)
        back: @bit16 = @extend_zero(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint8`, wrapping around at `Uint8`'s range: the
    /// low bits.
    to_uint8_wrapping: function (self: Uint16) Uint8 => @truncate(self.data) as @bit8 as Uint8

    /// This value as a `Float16`, rounded to the nearest (ties to even);
    /// past `Float16`'s largest finite value it is an infinity.
    to_float16_rounded: function (self: Uint16) Float16 => @uint_to_float(self.data) as @fbit16 as Float16

    /// Parses an unsigned integer in decimal, `0x` hexadecimal or `0b` binary
    /// (`_` separators allowed).
    parse: function (text: @byte_buffer) value: Uint16 else error: ParseError {
        raw: @bit64 = parse_unsigned_int(text, @extend_zero(Uint16.MAX.data)) else -> err: ParseError {
            error = err
            fail
        }
        value = Uint16 { data = @truncate(raw) }
    }

    /// Unsigned decimal.
    @format: function (self, out: ref Formatter) nothing {
        write_unsigned(out, @extend_zero(self.data), 0xA)
    }

    /// The bits in hexadecimal, at this type's width: `{n.hex()}`.
    hex: function (self: Uint16) Hex => Hex { value = @extend_zero(self.data) }

    /// The bits in binary, at this type's width: `{n.binary()}`.
    binary: function (self: Uint16) Binary => Binary { value = @extend_zero(self.data) }
}
