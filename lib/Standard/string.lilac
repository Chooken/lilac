using Standard.Collections
using Standard.Heap as Heap

String: structure {

    private {
        layout: StringLayout
    }

    new: function (format: Format) result: String {
        result = String {
            layout = .Inline(StringInline.new())
        }
        result.formatter().write(format)
    }

    new_using: function (format: Format, allocator: Heap.Allocator) result: String {
        result = String {
            layout = .Heap(StringHeap.new_using(allocator))
        }
        result.formatter().write(format)
    }

    add: function (self, text: @byte_buffer) nothing {
        match self.layout {
            .Inline -> inline: ref StringInline { 
                inline.add(text) else -> buffer: StringHeap {
                    self.layout = .Heap(buffer)
                    return
                }
            }

            .Heap -> buffer: ref StringHeap {
                buffer.add(text)
            }
        }
    }

    formatter: function (self) result: Formatter {
        result = Formatter.over[String](self, ref String.add)
    }

    hash: function (self) @bit64 => Hash.Wyhash.hash(0x0, self.byte_slice())

    is_inlined: function (self) Bool => match self.layout {
        .Inline => true
    } else false

    @eql: function (lhs: String, rhs: String) Bool => Memory.equal_bytes(lhs.byte_slice(), rhs.byte_slice())

    @eql: function (lhs: String, rhs: @byte_buffer) Bool => Memory.equal_bytes(lhs.byte_slice(), rhs)

    @eql: function (lhs: @byte_buffer, rhs: String) Bool => Memory.equal_bytes(lhs, rhs.byte_slice())

    @conversion: function (from: Format) String => new(from)

    @format: function (self, format: ref Formatter) nothing {
        
        match self.layout {

            .Inline -> inline: ref StringInline {
                format.write_bytes(@byte_buffer_from(
                    (ref inline.buffer) as ref unknown as ref @bit8,
                    inline.count as Int
                ))
            }

            .Heap -> buffer: ref StringHeap {

                slice: Slice[Uint8] = buffer.list.get_slice()

                format.write_bytes(@byte_buffer_from(
                    (slice.base()) as ref unknown as ref @bit8,
                    buffer.list.get_count()
                ))
            }
        }
    }

    private {
        byte_slice: function (self) slice: Slice[Byte] {
            match self.layout {

                .Inline -> inline: StringInline {
                    slice = inline.get_slice()
                }

                .Heap -> heap: StringHeap {
                    slice = heap.get_slice()
                }
            }
        }
    }
}

StringLayout: either {
    Inline: StringInline
    Heap: StringHeap
}

StringInline: structure {

    buffer: @array(Uint8, 23)
    count: Uint8

    SIZE: Int => 23

    new: function () result: StringInline {
        result = StringInline {
            buffer = @array(Uint8, 23) {}
            count = 0
        }
    }

    add: function (self, text: @byte_buffer) nothing else buffer: StringHeap {

        new_slice: Slice[Uint8] = Slice[Uint8].new(
            @byte_buffer_ptr(text) as ref unknown as ref Uint8, 
            @byte_buffer_len(text)
        )

        count: Int = @byte_buffer_len(text)

        if SIZE < self.count as Int + count {

            buffer = StringHeap.new()

            // Add existing.
            buffer.list.add_slice(
                Slice[Uint8].new(
                    (ref self.buffer) as ref unknown as ref Uint8,
                    self.count
                )
            )

            // Add new. 
            buffer.list.add_slice(new_slice)
            fail
        }

        buffer_slice: Slice[Uint8].new(
            (ref self.buffer) as ref unknown as ref Uint8,
            @array_len(self.buffer)
        )

        new_slice.move_to(buffer_slice, self.count)
        self.count += count.to_uint8_wrapping()
    }

    get_slice: function (self) Slice[Byte] => Slice[Byte].new(
        ref self.buffer as ref unknown as ref Byte,
        self.count
    )
}

StringHeap: structure {

    private {
        list: List[Byte]
    }

    new: function () result: StringHeap {
        result = new_using(Heap.get_default_allocator())
    }

    new_using: function (allocator: Heap.Allocator) result: StringHeap {
        result = StringHeap {
            list = List[Uint8].new_using(allocator)
        }
    }

    add: function (self, text: @byte_buffer) nothing {

        new_slice: Slice[Uint8] = Slice[Uint8].new(
            @byte_buffer_ptr(text) as ref unknown as ref Uint8, 
            @byte_buffer_len(text)
        )

        self.list.add_slice(new_slice)
    }

    get_slice: function (self) Slice[Byte] => self.list.get_slice()
}