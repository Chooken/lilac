        over1: @bit8 = @i_add_overflows_16(self.data, other.data)
        bit: @bit16 = if carry then 0x1 else 0x0
        second: @bit16 = @i_add_16(first, bit)
        over2: @bit8 = @i_add_overflows_16(first, bit)
        sum = Int16 { data = second }
        carry_out = over1 != over2
    }

    /// `self - other - borrow`, with the wrapped difference and whether it
    /// overflowed.
    borrowing_subtract: function (self: Int16, other: Int16, borrow: Bool) (difference: Int16, borrow_out: Bool) {
        first: @bit16 = @i_sub_16(self.data, other.data)
        over1: @bit8 = @i_sub_overflows_16(self.data, other.data)
        bit: @bit16 = if borrow then 0x1 else 0x0
        second: @bit16 = @i_sub_16(first, bit)
        over2: @bit8 = @i_sub_overflows_16(first, bit)
        difference = Int16 { data = second }
        borrow_out = over1 != over2
    }

    @conversion: function (from: @bit16) Int16 => Int16 { data = from }
    @conversion: function (from: Int16) @bit16 => from.data

    // `as` from every integer type whose values all fit.
    @conversion: function (from: Int8) Int16 => Int16 { data = @extend_sign(from as @bit8) }
    @conversion: function (from: Uint8) Int16 => Int16 { data = @extend_zero(from as @bit8) }

    /// This value as an `Int8`; fails when it is out of `Int8`'s range.
    to_int8: function (self: Int16) value: Int8 else nothing {
        bits: @bit8 = @truncate(self.data)
        back: @bit16 = @extend_sign(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int8`, wrapping around at `Int8`'s range: the
    /// low bits.
    to_int8_wrapping: function (self: Int16) Int8 => @truncate(self.data) as @bit8 as Int8

    /// This value as a `Uint8`; fails when it is out of `Uint8`'s range.
    to_uint8: function (self: Int16) value: Uint8 else nothing {
        bits: @bit8 = @truncate(self.data)
        back: @bit16 = @extend_zero(bits)
        if back == self.data and @i_greater_than_or_equal_16(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint8`, wrapping around at `Uint8`'s range: the
    /// low bits.
    to_uint8_wrapping: function (self: Int16) Uint8 => @truncate(self.data) as @bit8 as Uint8

    /// This value as a `Uint16`; fails when it is out of `Uint16`'s range.
    to_uint16: function (self: Int16) value: Uint16 else nothing {
        bits: @bit16 = self.data
        back: @bit16 = bits
        if back == self.data and @i_greater_than_or_equal_16(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint16`, wrapping around at `Uint16`'s range: the
    /// low bits.
    to_uint16_wrapping: function (self: Int16) Uint16 => self.data as @bit16 as Uint16

    /// This value as a `Uint32`; fails when it is out of `Uint32`'s range.
    to_uint32: function (self: Int16) value: Uint32 else nothing {
        bits: @bit32 = @extend_sign(self.data)
        back: @bit16 = @truncate(bits)
        if back == self.data and @i_greater_than_or_equal_16(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint32`, wrapping around at `Uint32`'s range: the
    /// low bits, sign-extended.
    to_uint32_wrapping: function (self: Int16) Uint32 => @extend_sign(self.data) as @bit32 as Uint32

    /// This value as a `Uint64`; fails when it is out of `Uint64`'s range.
    to_uint64: function (self: Int16) value: Uint64 else nothing {
        bits: @bit64 = @extend_sign(self.data)
        back: @bit16 = @truncate(bits)
        if back == self.data and @i_greater_than_or_equal_16(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint64`, wrapping around at `Uint64`'s range: the
    /// low bits, sign-extended.
    to_uint64_wrapping: function (self: Int16) Uint64 => @extend_sign(self.data) as @bit64 as Uint64

    /// This value as a `Uint`; fails when it is out of `Uint`'s range.
    to_uint: function (self: Int16) value: Uint else nothing {
        bits: @bit_native = @extend_sign(self.data)
        back: @bit16 = @truncate(bits)
        if back == self.data and @i_greater_than_or_equal_16(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint`, wrapping around at `Uint`'s range: the
    /// low bits, sign-extended.
    to_uint_wrapping: function (self: Int16) Uint => @extend_sign(self.data) as @bit_native as Uint

    /// This value as a `Float16`, rounded to the nearest (ties to even);
    /// past `Float16`'s largest finite value it is an infinity.
    to_float16_rounded: function (self: Int16) Float16 => @int_to_float(self.data) as @fbit16 as Float16

    /// Parses a signed integer in decimal, `0x` hexadecimal or `0b` binary
    /// (`_` separators allowed).
    parse: function (text: @byte_buffer) value: Int16 else error: ParseError {
        raw: @bit64 = parse_signed_int(text, @extend_zero(@i_negate_16(Int16.MIN.data)), @extend_zero(Int16.MAX.data)) else -> err: ParseError {
            error = err
            fail
        }
        value = Int16 { data = @truncate(raw) }
    }

    /// Signed decimal.
    @format: function (self, out: ref Formatter) nothing {
        write_signed(out, @extend_sign(self.data))
    }

    /// The bits in hexadecimal, at this type's width: `{n.hex()}`.
    hex: function (self: Int16) Hex => Hex { value = @extend_zero(self.data) }

    /// The bits in binary, at this type's width: `{n.binary()}`.
    binary: function (self: Int16) Binary => Binary { value = @extend_zero(self.data) }
}
