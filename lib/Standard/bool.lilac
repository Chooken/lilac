Bool: object {

    private {
        data: @bit8
    }

    from_int8: function (from: @bit8) Bool => Bool { data = from }

    @conversion: function (from: Bool) to: @bit8 => from.data
    @conversion: function (from: @bit8) to: Bool => Bool { data = from }

    /// `true` or `false`.
    @format: function (self, out: ref Formatter) nothing {
        if self.data == 0x0 {
            out.write_bytes("false")
        } else {
            out.write_bytes("true")
        }
    }
}

true: Bool => Bool.from_int8(0x1)
false: Bool => Bool.from_int8(0x0)
