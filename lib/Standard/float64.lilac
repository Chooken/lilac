    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    exp_m1: function (self: Float64) r: Float64 {
        s: Scaled = expm1_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(exp_m1_accurate(self))
    }

    /// The natural logarithm. `ln(+-0.0)` is `-inf`, `ln(1.0)` is `+0.0`, `ln(+inf)` is `+inf`, and a negative value or NaN gives NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    ln: function (self: Float64) r: Float64 {
        r = quick64(ln_fast(self))
        if r.is_nan() {
            s: Scaled = ln_kernel(self)
            r = if s.sure64() then s.round64() else mp_round64(ln_accurate(self))
        }
    }

    /// The base-2 logarithm (exact for powers of two). `log2(+-0.0)` is `-inf`; a negative value or NaN gives NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    log2: function (self: Float64) r: Float64 {
        s: Scaled = log2_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(log2_accurate(self))
    }

    /// The base-10 logarithm. `log10(+-0.0)` is `-inf`; a negative value or NaN gives NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    log10: function (self: Float64) r: Float64 {
        s: Scaled = log10_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(log10_accurate(self))
    }

    /// `ln(1 + self)`, accurate for `self` near zero. `ln_1p(-1.0)` is `-inf`, below `-1.0` it is NaN, and `-0.0` stays `-0.0`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    ln_1p: function (self: Float64) r: Float64 {
        s: Scaled = ln_1p_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(ln_1p_accurate(self))
    }

    /// The error function `2/sqrt(pi) * integral of e^-t^2 from 0 to self`, in `[-1, 1]`; `erf(+-inf)` is `+-1.0` and `-0.0` stays `-0.0`.
    ///
    /// Within 1 ulp, and almost always correctly rounded: the kernel's result (error below 2^-90 relative) is rounded once, with no correctly rounded fallback, so it is off by one ulp only when the exact value lies within 2^-37 ulp of a rounding boundary; exact results are exact.
    erf: function (self: Float64) Float64 => erf_kernel(self).round64()

    /// The complementary error function `1 - erf(self)`, in `[0, 2]`, accurate where it is tiny; `erfc(+inf)` is `0.0` and `erfc(-inf)` is `2.0`.
    ///
    /// Within 1 ulp, and almost always correctly rounded: the kernel's result (error below 2^-90 relative) is rounded once, with no correctly rounded fallback, so it is off by one ulp only when the exact value lies within 2^-37 ulp of a rounding boundary; exact results are exact.
    erfc: function (self: Float64) Float64 => erfc_kernel(self).round64()

    /// The gamma function (`gamma(n + 1) = n!`). NaN at the negative integers and `-inf`; `gamma(+-0.0)` is `+-inf`; overflows to `+inf` past 171.62.
    ///
    /// Within 1 ulp, and almost always correctly rounded: the kernel's result (error below 2^-90 relative) is rounded once, with no correctly rounded fallback, so it is off by one ulp only when the exact value lies within 2^-37 ulp of a rounding boundary; exact results are exact.
    gamma: function (self: Float64) Float64 => gamma_kernel(self).round64()

    /// The natural logarithm of the absolute value of the gamma function; `+inf` at zero and the negative integers, and `ln_gamma(1.0)` and `ln_gamma(2.0)` are `+0.0`. Series around 1 and 2 keep it accurate there; at the zeros between the negative integers the absolute error stays below 2^-95, so the relative error grows to about 2^-45 for an argument within one ulp of a zero.
    ///
    /// Within 1 ulp, and almost always correctly rounded: the kernel's result (error below 2^-90 relative) is rounded once, with no correctly rounded fallback, so it is off by one ulp only when the exact value lies within 2^-37 ulp of a rounding boundary; exact results are exact. Near the zeros between the negative integers only the absolute error is that small (see above).
    ln_gamma: function (self: Float64) Float64 => lgamma_kernel(self).round64()

    /// The hyperbolic sine. Overflows to `+-inf`; `-0.0` stays `-0.0`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    sinh: function (self: Float64) r: Float64 {
        s: Scaled = sinh_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(sinh_accurate(self))
    }

    /// The hyperbolic cosine. Overflows to `+inf`; `cosh(+-inf)` is `+inf`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    cosh: function (self: Float64) r: Float64 {
        s: Scaled = cosh_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(cosh_accurate(self))
    }

    /// The hyperbolic tangent, in `[-1, 1]`; `tanh(+-inf)` is `+-1.0` and `-0.0` stays `-0.0`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    tanh: function (self: Float64) r: Float64 {
        s: Scaled = tanh_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(tanh_accurate(self))
    }

    /// The inverse hyperbolic sine; `asinh(+-inf)` is `+-inf` and `-0.0` stays `-0.0`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    asinh: function (self: Float64) r: Float64 {
        s: Scaled = asinh_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(asinh_accurate(self))
    }

    /// The inverse hyperbolic cosine, for `self >= 1.0`; `acosh(1.0)` is `+0.0`, below `1.0` it is NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    acosh: function (self: Float64) r: Float64 {
        s: Scaled = acosh_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(acosh_accurate(self))
    }

    /// The inverse hyperbolic tangent, for `|self| <= 1.0`; `atanh(+-1.0)` is `+-inf`, beyond it NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    atanh: function (self: Float64) r: Float64 {
        s: Scaled = atanh_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(atanh_accurate(self))
    }

    /// The arctangent, in `[-pi/2, pi/2]`. `atan(+-inf)` is `+-pi/2`; `-0.0` stays `-0.0`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    atan: function (self: Float64) r: Float64 {
        s: Scaled = atan_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(atan_accurate(self))
    }

    /// The arcsine, in `[-pi/2, pi/2]`. NaN outside `[-1, 1]`; `-0.0` stays `-0.0`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    asin: function (self: Float64) r: Float64 {
        s: Scaled = asin_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(asin_accurate(self))
    }

    /// The arccosine, in `[0, pi]`. NaN outside `[-1, 1]`; `acos(1.0)` is `+0.0`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    acos: function (self: Float64) r: Float64 {
        s: Scaled = acos_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(acos_accurate(self))
    }

    /// The sine of an angle in radians; any finite argument is reduced exactly (`(1e300).sin()` is right). `sin(+-0.0)` keeps its sign; an infinity or NaN gives NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    sin: function (self: Float64) r: Float64 {
        s: Scaled = sin_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(sin_accurate(self))
    }

    /// The cosine of an angle in radians; any finite argument is reduced exactly. An infinity or NaN gives NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    cos: function (self: Float64) r: Float64 {
        s: Scaled = cos_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(cos_accurate(self))
    }

    /// The tangent of an angle in radians; any finite argument is reduced exactly. `tan(+-0.0)` keeps its sign; an infinity or NaN gives NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    tan: function (self: Float64) r: Float64 {
        s: Scaled = tan_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(tan_accurate(self))
    }

    /// `sin(pi * self)`, with the argument reduced exactly: `sin_pi(n)` is a zero with the sign of `self`, `sin_pi(0.5)` is `1.0`. An infinity or NaN gives NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    sin_pi: function (self: Float64) r: Float64 {
        s: Scaled = sin_pi_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(sin_pi_accurate(self))
    }

    /// `cos(pi * self)`, with the argument reduced exactly: `cos_pi(0.5)` is `+0.0`, `cos_pi(1.0)` is `-1.0`. An infinity or NaN gives NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    cos_pi: function (self: Float64) r: Float64 {
        s: Scaled = cos_pi_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(cos_pi_accurate(self))
    }

    /// `tan(pi * self)`: `tan_pi(n)` is a zero with the sign of `self`, and at the half-integers (the poles) it is an infinity with the sign of `self`. An infinity or NaN gives NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    tan_pi: function (self: Float64) r: Float64 {
        s: Scaled = tan_pi_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(tan_pi_accurate(self))
    }

    /// The logarithm of `self` to `base`, `ln(self) / ln(base)`. NaN when
    /// `self` is negative or `base` is not positive or is `1.0`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    log: function (self: Float64, base: Float64) r: Float64 {
        s: Scaled = log_base_kernel(self, base)
        r = if s.sure64() then s.round64() else mp_round64(log_base_accurate(self, base))
    }

    /// The sine and cosine of an angle in radians, as `(sine, cosine)`; each is
    /// exactly what `sin` and `cos` return.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    sin_cos: function (self: Float64) (sine: Float64, cosine: Float64) {
        s: Scaled, c: Scaled = sin_cos_kernel(self)
        sine = if s.sure64() then s.round64() else mp_round64(sin_accurate(self))
        cosine = if c.sure64() then c.round64() else mp_round64(cos_accurate(self))
    }

    /// The angle of the point `(other, self)` (`self` is y, `other` is x), in
    /// `[-pi, pi]`, with C's `atan2` special values: `atan2(+-0.0, -0.0)` is `+-pi`,
    /// `atan2(+-0.0, +0.0)` is `+-0.0`, and infinities give multiples of `pi/4`.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    atan2: function (self: Float64, other: Float64) r: Float64 {
        s: Scaled = atan2_kernel(self, other)
        r = if s.sure64() then s.round64() else mp_round64(atan2_accurate(self, other))
    }

    /// `self` raised to the power `other`, with C's special values: `pow(x, +-0.0)` and
    /// `pow(1.0, y)` are `1.0` even for NaN; a negative base with a non-integer
    /// exponent is NaN; `pow(+-0.0, y)` is an infinity for negative `y`; `pow(-1.0, +-inf)` is `1.0`.
    /// Exact when the result is representable (`pow(3.0, 2.0)`).
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    pow: function (self: Float64, other: Float64) r: Float64 {
        s: Scaled = pow_kernel(self, other)
        r = if s.sure64() then s.round64() else mp_round64(pow_accurate(self, other))
    }

    /// `self` raised to the integer power `n` (`pow` with an exact exponent).
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    pow_int: function (self: Float64, n: Int32) r: Float64 {
        s: Scaled = pow_kernel(self, n as Float64)
        r = if s.sure64() then s.round64() else mp_round64(pow_accurate(self, n as Float64))
    }

    /// The cube root (defined for negative values; exact for cubes).
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    cbrt: function (self: Float64) r: Float64 {
        s: Scaled = cbrt_kernel(self)
        r = if s.sure64() then s.round64() else mp_round64(cbrt_accurate(self))
    }

    /// `sqrt(self^2 + other^2)` without intermediate overflow; an infinity wins over NaN.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    hypot: function (self: Float64, other: Float64) r: Float64 {
        s: Scaled = hypot_kernel(self, other)
        r = if s.sure64() then s.round64() else mp_round64(hypot_accurate(self, other))
    }

    /// The `n`-th root of `self`: negative values have odd roots only, `n = 0` is NaN,
    /// and a negative `n` is the reciprocal root.
    ///
    /// Correctly rounded (to nearest, ties to even): the kernel's result (error below 2^-90 relative) is rounded when every value within 2^-70 relative of it rounds alike, and otherwise a 384-bit evaluation decides, which takes a value within 2^-240 relative of a midpoint for the midpoint (the hardest cases known, other than exact midpoints, come no closer than 2^-150; `atan2` steps past the window itself when its quotient is a subnormal midpoint).
    root: function (self: Float64, n: Int32) r: Float64 {
        s: Scaled = root_kernel(self, n)
        r = if s.sure64() then s.round64() else mp_round64(root_accurate(self, n))
    }

    @conversion: function (from: @fbit64) Float64 => Float64 { data = from }
    @conversion: function (from: Float64) @fbit64 => from.data

    // `as` from every type whose values all fit.
    @conversion: function (from: Float16) Float64 => Float64 { data = @float_convert(from as @fbit16) }
    @conversion: function (from: Float32) Float64 => Float64 { data = @float_convert(from as @fbit32) }
    @conversion: function (from: Int8) Float64 => Float64 { data = @int_to_float(from as @bit8) }
    @conversion: function (from: Int16) Float64 => Float64 { data = @int_to_float(from as @bit16) }
    @conversion: function (from: Int32) Float64 => Float64 { data = @int_to_float(from as @bit32) }
    @conversion: function (from: Uint8) Float64 => Float64 { data = @uint_to_float(from as @bit8) }
    @conversion: function (from: Uint16) Float64 => Float64 { data = @uint_to_float(from as @bit16) }
    @conversion: function (from: Uint32) Float64 => Float64 { data = @uint_to_float(from as @bit32) }

    /// This value as a `Float16`, rounded to the nearest (ties to even);
    /// past `Float16`'s largest finite value it is an infinity.
    to_float16_rounded: function (self: Float64) Float16 => @float_convert(self.data) as @fbit16 as Float16

    /// This value as a `Float32`, rounded to the nearest (ties to even);
    /// past `Float32`'s largest finite value it is an infinity.
    to_float32_rounded: function (self: Float64) Float32 => @float_convert(self.data) as @fbit32 as Float32

    /// This value as an `Int8`, rounded toward zero; past `Int8`'s range
    /// it is `Int8.MIN` or `Int8.MAX`, and NaN is 0.
    to_int8_truncated: function (self: Float64) Int8 => @float_to_int(self.data) as @bit8 as Int8

    /// This value as an `Int8`; fails on NaN, on an infinity, on a fraction
    /// and out of `Int8`'s range.
    to_int8: function (self: Float64) value: Int8 else nothing {
        if @f_greater_than_or_equal_64(self.data, -128.0) and @f_less_than_64(self.data, 128.0) and @f_trunc_64(self.data) == self.data {
            value = @float_to_int(self.data) as @bit8
            return
        }
        fail
    }

    /// This value as an `Int16`, rounded toward zero; past `Int16`'s range
    /// it is `Int16.MIN` or `Int16.MAX`, and NaN is 0.
    to_int16_truncated: function (self: Float64) Int16 => @float_to_int(self.data) as @bit16 as Int16

    /// This value as an `Int16`; fails on NaN, on an infinity, on a fraction
    /// and out of `Int16`'s range.
    to_int16: function (self: Float64) value: Int16 else nothing {
        if @f_greater_than_or_equal_64(self.data, -32768.0) and @f_less_than_64(self.data, 32768.0) and @f_trunc_64(self.data) == self.data {
            value = @float_to_int(self.data) as @bit16
            return
        }
        fail
    }

    /// This value as an `Int32`, rounded toward zero; past `Int32`'s range
    /// it is `Int32.MIN` or `Int32.MAX`, and NaN is 0.
    to_int32_truncated: function (self: Float64) Int32 => @float_to_int(self.data) as @bit32 as Int32

    /// This value as an `Int32`; fails on NaN, on an infinity, on a fraction
    /// and out of `Int32`'s range.
    to_int32: function (self: Float64) value: Int32 else nothing {
        if @f_greater_than_or_equal_64(self.data, -2147483648.0) and @f_less_than_64(self.data, 2147483648.0) and @f_trunc_64(self.data) == self.data {
            value = @float_to_int(self.data) as @bit32
            return
        }
        fail
    }

    /// This value as an `Int64`, rounded toward zero; past `Int64`'s range
    /// it is `Int64.MIN` or `Int64.MAX`, and NaN is 0.
    to_int64_truncated: function (self: Float64) Int64 => @float_to_int(self.data) as @bit64 as Int64

    /// This value as an `Int64`; fails on NaN, on an infinity, on a fraction
    /// and out of `Int64`'s range.
    to_int64: function (self: Float64) value: Int64 else nothing {
        if @f_greater_than_or_equal_64(self.data, -9223372036854775808.0) and @f_less_than_64(self.data, 9223372036854775808.0) and @f_trunc_64(self.data) == self.data {
            value = @float_to_int(self.data) as @bit64
            return
        }
        fail
    }

    /// This value as an `Int`, rounded toward zero; past `Int`'s range
    /// it is `Int.MIN` or `Int.MAX`, and NaN is 0.
    to_int_truncated: function (self: Float64) Int => @float_to_int(self.data) as @bit_native as Int

    /// This value as an `Int`; fails on NaN, on an infinity, on a fraction
    /// and out of `Int`'s range.
    to_int: function (self: Float64) value: Int else nothing {
        if self.to_int64() -> wide: Int64 {
            if wide.to_int() -> narrow: Int {
                value = narrow
                return
            }
        }
        fail
    }

    /// This value as a `Uint8`, rounded toward zero; past `Uint8`'s range
    /// it is `Uint8.MIN` or `Uint8.MAX`, and NaN is 0.
    to_uint8_truncated: function (self: Float64) Uint8 => @float_to_uint(self.data) as @bit8 as Uint8

    /// This value as a `Uint8`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint8`'s range.
    to_uint8: function (self: Float64) value: Uint8 else nothing {
        if @f_greater_than_or_equal_64(self.data, 0.0) and @f_less_than_64(self.data, 256.0) and @f_trunc_64(self.data) == self.data {
            value = @float_to_uint(self.data) as @bit8
            return
        }
        fail
    }

    /// This value as a `Uint16`, rounded toward zero; past `Uint16`'s range
    /// it is `Uint16.MIN` or `Uint16.MAX`, and NaN is 0.
    to_uint16_truncated: function (self: Float64) Uint16 => @float_to_uint(self.data) as @bit16 as Uint16

    /// This value as a `Uint16`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint16`'s range.
    to_uint16: function (self: Float64) value: Uint16 else nothing {
        if @f_greater_than_or_equal_64(self.data, 0.0) and @f_less_than_64(self.data, 65536.0) and @f_trunc_64(self.data) == self.data {
            value = @float_to_uint(self.data) as @bit16
            return
        }
        fail
    }

    /// This value as a `Uint32`, rounded toward zero; past `Uint32`'s range
    /// it is `Uint32.MIN` or `Uint32.MAX`, and NaN is 0.
    to_uint32_truncated: function (self: Float64) Uint32 => @float_to_uint(self.data) as @bit32 as Uint32

    /// This value as a `Uint32`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint32`'s range.
    to_uint32: function (self: Float64) value: Uint32 else nothing {
        if @f_greater_than_or_equal_64(self.data, 0.0) and @f_less_than_64(self.data, 4294967296.0) and @f_trunc_64(self.data) == self.data {
            value = @float_to_uint(self.data) as @bit32
            return
        }
        fail
    }

    /// This value as a `Uint64`, rounded toward zero; past `Uint64`'s range
    /// it is `Uint64.MIN` or `Uint64.MAX`, and NaN is 0.
    to_uint64_truncated: function (self: Float64) Uint64 => @float_to_uint(self.data) as @bit64 as Uint64

    /// This value as a `Uint64`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint64`'s range.
    to_uint64: function (self: Float64) value: Uint64 else nothing {
        if @f_greater_than_or_equal_64(self.data, 0.0) and @f_less_than_64(self.data, 18446744073709551616.0) and @f_trunc_64(self.data) == self.data {
            value = @float_to_uint(self.data) as @bit64
            return
        }
        fail
    }

    /// This value as a `Uint`, rounded toward zero; past `Uint`'s range
    /// it is `Uint.MIN` or `Uint.MAX`, and NaN is 0.
    to_uint_truncated: function (self: Float64) Uint => @float_to_uint(self.data) as @bit_native as Uint

    /// This value as a `Uint`; fails on NaN, on an infinity, on a fraction
    /// and out of `Uint`'s range.
    to_uint: function (self: Float64) value: Uint else nothing {
        if self.to_uint64() -> wide: Uint64 {
            if wide.to_uint() -> narrow: Uint {
                value = narrow
                return
            }
        }
        fail
    }

    /// Parses a `Float64` from decimal text (`1.5`, `1e-4`, `inf`, `-inf`, `nan`;
    /// `_` separators allowed), rounded once to nearest (ties to even).
    parse: function (text: @byte_buffer) value: Float64 else error: ParseError {
        raw: @bit64 = parse_float_bits(text, 64) else -> err: ParseError {
            error = err
            fail
        }
        value = Float64 { data = @bits_to_fbit_64(raw) }
    }

    /// Shortest decimal string that reads back to the same `Float64` bits.
    @format: function (self, out: ref Formatter) nothing {
        write_float_shortest(out, @fbit_to_bits_64(self.data), 64)
    }

    /// Formatted with `precision` digits after the decimal point: `{x.fixed(3)}`.
    fixed: function (self: Float64, precision: Uint32) Fixed =>
        Fixed { bits = @fbit_to_bits_64(self.data), width = 64, precision = precision as @bit32 }

    /// Formatted in scientific notation with `precision` digits after the
    /// decimal point: `{x.scientific(4)}`.
    scientific: function (self: Float64, precision: Uint32) Scientific =>
        Scientific { bits = @fbit_to_bits_64(self.data), width = 64, precision = precision as @bit32 }

    /// The IEEE 754 bits in hexadecimal: `{x.hex()}`.
    hex: function (self: Float64) Hex => Hex { value = @fbit_to_bits_64(self.data) }

    /// The IEEE 754 bits in binary: `{x.binary()}`.
    binary: function (self: Float64) Binary => Binary { value = @fbit_to_bits_64(self.data) }
}
