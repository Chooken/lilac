Int8: object {
    
    private {
        data: @bit8
    }

    @add: function (lhs: Int8, rhs: Int8) Int8 => @i_add_8(lhs.data, rhs.data)
    @sub: function (lhs: Int8, rhs: Int8) Int8 => @i_sub_8(lhs.data, rhs.data)
    @mul: function (lhs: Int8, rhs: Int8) Int8 => @i_mul_8(lhs.data, rhs.data)
    @div: function (lhs: Int8, rhs: Int8) Int8 => @i_div_8(lhs.data, rhs.data)
    @mod: function (lhs: Int8, rhs: Int8) Int8 => @i_mod_8(lhs.data, rhs.data)

    @less_than: function (lhs: Int8, rhs: Int8) Bool => @i_less_than_8(lhs.data, rhs.data)
    @greater_than: function (lhs: Int8, rhs: Int8) Bool =>  @i_greater_than_8(lhs.data, rhs.data)
    @less_than_or_equal: function (lhs: Int8, rhs: Int8) Bool => @i_less_than_or_equal_8(lhs.data, rhs.data)
    @greater_than_or_equal: function (lhs: Int8, rhs: Int8) Bool => @i_greater_than_or_equal_8(lhs.data, rhs.data)

    @negate: function (value: Int8) Int8 => @i_negate_8(value.data)

    @conversion: function(from: @bit8) Int8 => Int8 { data = from }
    @conversion: function(from: Int8) @bit8 => from.data
}