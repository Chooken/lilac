    /// `self - other - borrow`, with the wrapped difference and whether it
    /// overflowed.
    borrowing_subtract: function (self: Int8, other: Int8, borrow: Bool) (difference: Int8, borrow_out: Bool) {
        first: @bit8 = @i_sub_8(self.data, other.data)
        over1: @bit8 = @i_sub_overflows_8(self.data, other.data)
        bit: @bit8 = if borrow then 0x1 else 0x0
        second: @bit8 = @i_sub_8(first, bit)
        over2: @bit8 = @i_sub_overflows_8(first, bit)
        difference = Int8 { data = second }
        borrow_out = over1 != over2
    }

    @conversion: function (from: @bit8) Int8 => Int8 { data = from }
    @conversion: function (from: Int8) @bit8 => from.data

    /// This value as a `Uint8`; fails when it is out of `Uint8`'s range.
    to_uint8: function (self: Int8) value: Uint8 else nothing {
        bits: @bit8 = self.data
        back: @bit8 = bits
        if back == self.data and @i_greater_than_or_equal_8(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint8`, wrapping around at `Uint8`'s range: the
    /// low bits.
    to_uint8_wrapping: function (self: Int8) Uint8 => self.data as @bit8 as Uint8

    /// This value as a `Uint16`; fails when it is out of `Uint16`'s range.
    to_uint16: function (self: Int8) value: Uint16 else nothing {
        bits: @bit16 = @extend_sign(self.data)
        back: @bit8 = @truncate(bits)
        if back == self.data and @i_greater_than_or_equal_8(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint16`, wrapping around at `Uint16`'s range: the
    /// low bits, sign-extended.
    to_uint16_wrapping: function (self: Int8) Uint16 => @extend_sign(self.data) as @bit16 as Uint16

    /// This value as a `Uint32`; fails when it is out of `Uint32`'s range.
    to_uint32: function (self: Int8) value: Uint32 else nothing {
        bits: @bit32 = @extend_sign(self.data)
        back: @bit8 = @truncate(bits)
        if back == self.data and @i_greater_than_or_equal_8(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint32`, wrapping around at `Uint32`'s range: the
    /// low bits, sign-extended.
    to_uint32_wrapping: function (self: Int8) Uint32 => @extend_sign(self.data) as @bit32 as Uint32

    /// This value as a `Uint64`; fails when it is out of `Uint64`'s range.
    to_uint64: function (self: Int8) value: Uint64 else nothing {
        bits: @bit64 = @extend_sign(self.data)
        back: @bit8 = @truncate(bits)
        if back == self.data and @i_greater_than_or_equal_8(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint64`, wrapping around at `Uint64`'s range: the
    /// low bits, sign-extended.
    to_uint64_wrapping: function (self: Int8) Uint64 => @extend_sign(self.data) as @bit64 as Uint64

    /// This value as a `Uint`; fails when it is out of `Uint`'s range.
    to_uint: function (self: Int8) value: Uint else nothing {
        bits: @bit_native = @extend_sign(self.data)
        back: @bit8 = @truncate(bits)
        if back == self.data and @i_greater_than_or_equal_8(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint`, wrapping around at `Uint`'s range: the
    /// low bits, sign-extended.
    to_uint_wrapping: function (self: Int8) Uint => @extend_sign(self.data) as @bit_native as Uint

    /// Parses a signed integer in decimal, `0x` hexadecimal or `0b` binary
    /// (`_` separators allowed).
    parse: function (text: @byte_buffer) value: Int8 else error: ParseError {
        raw: @bit64 = parse_signed_int(text, @extend_zero(@i_negate_8(Int8.MIN.data)), @extend_zero(Int8.MAX.data)) else -> err: ParseError {
            error = err
            fail
        }
        value = Int8 { data = @truncate(raw) }
    }

    /// Signed decimal.
    @format: function (self, out: ref Formatter) nothing {
        write_signed(out, @extend_sign(self.data))
    }

    /// The bits in hexadecimal, at this type's width: `{n.hex()}`.
    hex: function (self: Int8) Hex => Hex { value = @extend_zero(self.data) }

    /// The bits in binary, at this type's width: `{n.binary()}`.
    binary: function (self: Int8) Binary => Binary { value = @extend_zero(self.data) }
}
