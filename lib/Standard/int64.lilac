Int64: object {
    
    private {
        data: @bit64
    }

    @add: function (lhs: Int64, rhs: Int64) Int64 => @i_add_64(lhs.data, rhs.data)
    @sub: function (lhs: Int64, rhs: Int64) Int64 => @i_sub_64(lhs.data, rhs.data)
    @mul: function (lhs: Int64, rhs: Int64) Int64 => @i_mul_64(lhs.data, rhs.data)
    @div: function (lhs: Int64, rhs: Int64) Int64 => @i_div_64(lhs.data, rhs.data)
    @mod: function (lhs: Int64, rhs: Int64) Int64 => @i_mod_64(lhs.data, rhs.data)

    @less_than: function (lhs: Int64, rhs: Int64) Bool => @i_less_than_64(lhs.data, rhs.data)
    @greater_than: function (lhs: Int64, rhs: Int64) Bool =>  @i_greater_than_64(lhs.data, rhs.data)
    @less_than_or_equal: function (lhs: Int64, rhs: Int64) Bool => @i_less_than_or_equal_64(lhs.data, rhs.data)
    @greater_than_or_equal: function (lhs: Int64, rhs: Int64) Bool => @i_greater_than_or_equal_64(lhs.data, rhs.data)

    @negate: function (value: Int64) Int64 => @i_negate_64(value.data)

    @conversion: function(from: @bit64) Int64 => Int64 { data = from }
    @conversion: function(from: Int64) @bit64 => from.data
}