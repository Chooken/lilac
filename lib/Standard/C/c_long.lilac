
if @builtin.Target.os == .Windows {

    CLong: object {
        data: @bit32

        @conversion: function(from: Int32) CLong => CLong { data = from }
        @conversion: function(from: @bit32) CLong => CLong { data = from }

        @conversion: function(from: CLong) @bit32 => from.data
        @conversion: function(from: CLong) Int32 => from.data
    }

} else {

    CLong: object {
        data: @bit64

        @conversion: function(from: Int64) CLong => CLong { data = from }
        @conversion: function(from: @bit64) CLong => CLong { data = from }

        @conversion: function(from: CLong) @bit64 => from.data
        @conversion: function(from: CLong) Int64 => from.data
    }

}