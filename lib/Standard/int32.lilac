Int32: object {
    
    private {
        data: @bit32
    }

    @add: function (lhs: Int32, rhs: Int32) Int32 => @i_add_32(lhs.data, rhs.data)
    @sub: function (lhs: Int32, rhs: Int32) Int32 => @i_sub_32(lhs.data, rhs.data)
    @mul: function (lhs: Int32, rhs: Int32) Int32 => @i_mul_32(lhs.data, rhs.data)
    @div: function (lhs: Int32, rhs: Int32) Int32 => @i_div_32(lhs.data, rhs.data)
    @mod: function (lhs: Int32, rhs: Int32) Int32 => @i_mod_32(lhs.data, rhs.data)

    @less_than: function (lhs: Int32, rhs: Int32) Bool => @i_less_than_32(lhs.data, rhs.data)
    @greater_than: function (lhs: Int32, rhs: Int32) Bool =>  @i_greater_than_32(lhs.data, rhs.data)
    @less_than_or_equal: function (lhs: Int32, rhs: Int32) Bool => @i_less_than_or_equal_32(lhs.data, rhs.data)
    @greater_than_or_equal: function (lhs: Int32, rhs: Int32) Bool => @i_greater_than_or_equal_32(lhs.data, rhs.data)

    @negate: function (value: Int32) Int32 => @i_negate_32(value.data)

    @conversion: function(from: @bit32) Int32 => Int32 { data = from }
    @conversion: function(from: Int32) @bit32 => from.data

    /// Signed decimal.
    @format: function (self, out: ref Formatter) nothing {
        write_signed(out, @extend_sign(self.data))
    }

    /// The bits in hexadecimal, at this type's width: `{n.hex()}`.
    hex: function (self) Hex => Hex { value = @extend_zero(self.data) }

    /// The bits in binary, at this type's width: `{n.binary()}`.
    binary: function (self) Binary => Binary { value = @extend_zero(self.data) }
}
