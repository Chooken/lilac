    borrowing_subtract: function (self: Int, other: Int, borrow: Bool) (difference: Int, borrow_out: Bool) {
        first: @bit_native = @i_sub_native(self.data, other.data)
        over1: @bit8 = @i_sub_overflows_native(self.data, other.data)
        bit: @bit_native = if borrow then 0x1 else 0x0
        second: @bit_native = @i_sub_native(first, bit)
        over2: @bit8 = @i_sub_overflows_native(first, bit)
        difference = Int { data = second }
        borrow_out = over1 != over2
    }

    @conversion: function (from: @bit_native) Int => Int { data = from }
    @conversion: function (from: Int) @bit_native => from.data

    // `as` from every integer type whose values all fit.
    @conversion: function (from: Int8) Int => Int { data = @extend_sign(from as @bit8) }
    @conversion: function (from: Int16) Int => Int { data = @extend_sign(from as @bit16) }
    @conversion: function (from: Int32) Int => Int { data = @extend_sign(from as @bit32) }
    @conversion: function (from: Uint8) Int => Int { data = @extend_zero(from as @bit8) }
    @conversion: function (from: Uint16) Int => Int { data = @extend_zero(from as @bit16) }

    /// This value as an `Int8`; fails when it is out of `Int8`'s range.
    to_int8: function (self: Int) value: Int8 else nothing {
        bits: @bit8 = @truncate(self.data)
        back: @bit_native = @extend_sign(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int8`, wrapping around at `Int8`'s range: the
    /// low bits.
    to_int8_wrapping: function (self: Int) Int8 => @truncate(self.data) as @bit8 as Int8

    /// This value as an `Int16`; fails when it is out of `Int16`'s range.
    to_int16: function (self: Int) value: Int16 else nothing {
        bits: @bit16 = @truncate(self.data)
        back: @bit_native = @extend_sign(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int16`, wrapping around at `Int16`'s range: the
    /// low bits.
    to_int16_wrapping: function (self: Int) Int16 => @truncate(self.data) as @bit16 as Int16

    /// This value as an `Int32`; fails when it is out of `Int32`'s range.
    to_int32: function (self: Int) value: Int32 else nothing {
        bits: @bit32 = @truncate(self.data)
        back: @bit_native = @extend_sign(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int32`, wrapping around at `Int32`'s range: the
    /// low bits.
    to_int32_wrapping: function (self: Int) Int32 => @truncate(self.data) as @bit32 as Int32

    /// This value as a `Uint8`; fails when it is out of `Uint8`'s range.
    to_uint8: function (self: Int) value: Uint8 else nothing {
        bits: @bit8 = @truncate(self.data)
        back: @bit_native = @extend_zero(bits)
        if back == self.data and @i_greater_than_or_equal_native(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint8`, wrapping around at `Uint8`'s range: the
    /// low bits.
    to_uint8_wrapping: function (self: Int) Uint8 => @truncate(self.data) as @bit8 as Uint8

    /// This value as a `Uint16`; fails when it is out of `Uint16`'s range.
    to_uint16: function (self: Int) value: Uint16 else nothing {
        bits: @bit16 = @truncate(self.data)
        back: @bit_native = @extend_zero(bits)
        if back == self.data and @i_greater_than_or_equal_native(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint16`, wrapping around at `Uint16`'s range: the
    /// low bits.
    to_uint16_wrapping: function (self: Int) Uint16 => @truncate(self.data) as @bit16 as Uint16

    /// This value as a `Uint32`; fails when it is out of `Uint32`'s range.
    to_uint32: function (self: Int) value: Uint32 else nothing {
        bits: @bit32 = @truncate(self.data)
        back: @bit_native = @extend_zero(bits)
        if back == self.data and @i_greater_than_or_equal_native(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint32`, wrapping around at `Uint32`'s range: the
    /// low bits.
    to_uint32_wrapping: function (self: Int) Uint32 => @truncate(self.data) as @bit32 as Uint32

    /// This value as a `Uint64`; fails when it is out of `Uint64`'s range.
    to_uint64: function (self: Int) value: Uint64 else nothing {
        bits: @bit64 = @extend_sign(self.data)
        back: @bit_native = @truncate(bits)
        if back == self.data and @i_greater_than_or_equal_native(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint64`, wrapping around at `Uint64`'s range: the
    /// low bits, sign-extended.
    to_uint64_wrapping: function (self: Int) Uint64 => @extend_sign(self.data) as @bit64 as Uint64

    /// This value as a `Uint`; fails when it is out of `Uint`'s range.
    to_uint: function (self: Int) value: Uint else nothing {
        bits: @bit_native = self.data
        back: @bit_native = bits
        if back == self.data and @i_greater_than_or_equal_native(self.data, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint`, wrapping around at `Uint`'s range: the
    /// low bits, sign-extended.
    to_uint_wrapping: function (self: Int) Uint => self.data as @bit_native as Uint

    /// This value as a `Float16`, rounded to the nearest (ties to even);
    /// past `Float16`'s largest finite value it is an infinity.
    to_float16_rounded: function (self: Int) Float16 => @int_to_float(self.data) as @fbit16 as Float16

    /// This value as a `Float32`, rounded to the nearest (ties to even).
    to_float32_rounded: function (self: Int) Float32 => @int_to_float(self.data) as @fbit32 as Float32

    /// This value as a `Float64`, rounded to the nearest (ties to even).
    to_float64_rounded: function (self: Int) Float64 => @int_to_float(self.data) as @fbit64 as Float64

    /// Parses a signed integer in decimal, `0x` hexadecimal or `0b` binary
    /// (`_` separators allowed).
    parse: function (text: @byte_buffer) value: Int else error: ParseError {
        raw: @bit64 = parse_signed_int(text, @extend_zero(@i_negate_native(Int.MIN.data)), @extend_zero(Int.MAX.data)) else -> err: ParseError {
            error = err
            fail
        }
        value = Int { data = @truncate(raw) }
    }

    /// Signed decimal.
    @format: function (self, out: ref Formatter) nothing {
        write_signed(out, @extend_sign(self.data))
    }

    /// The bits in hexadecimal, at this type's width: `{n.hex()}`.
    hex: function (self: Int) Hex => Hex { value = @extend_zero(self.data) }

    /// The bits in binary, at this type's width: `{n.binary()}`.
    binary: function (self: Int) Binary => Binary { value = @extend_zero(self.data) }
}
