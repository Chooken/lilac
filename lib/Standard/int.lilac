Int: object {
    
    private {
        data: @bit_native
    }

    @add: function (lhs: Int, rhs: Int) Int => @i_add_native(lhs.data, rhs.data)
    @sub: function (lhs: Int, rhs: Int) Int => @i_sub_native(lhs.data, rhs.data)
    @mul: function (lhs: Int, rhs: Int) Int => @i_mul_native(lhs.data, rhs.data)
    @div: function (lhs: Int, rhs: Int) Int => @i_div_native(lhs.data, rhs.data)
    @mod: function (lhs: Int, rhs: Int) Int => @i_mod_native(lhs.data, rhs.data)

    @less_than: function (lhs: Int, rhs: Int) Bool => @i_less_than_native(lhs.data, rhs.data)
    @greater_than: function (lhs: Int, rhs: Int) Bool =>  @i_greater_than_native(lhs.data, rhs.data)
    @less_than_or_equal: function (lhs: Int, rhs: Int) Bool => @i_less_than_or_equal_native(lhs.data, rhs.data)
    @greater_than_or_equal: function (lhs: Int, rhs: Int) Bool => @i_greater_than_or_equal_native(lhs.data, rhs.data)

    @negate: function (value: Int) Int => @i_negate_native(value.data)

    @add: function (lhs: Int, rhs: @bit_native) Int => @i_add_native(lhs.data, rhs)
    @sub: function (lhs: Int, rhs: @bit_native) Int => @i_sub_native(lhs.data, rhs)
    @mul: function (lhs: Int, rhs: @bit_native) Int => @i_mul_native(lhs.data, rhs)
    @div: function (lhs: Int, rhs: @bit_native) Int => @i_div_native(lhs.data, rhs)
    @mod: function (lhs: Int, rhs: @bit_native) Int => @i_mod_native(lhs.data, rhs)

    @less_than: function (lhs: Int, rhs: @bit_native) Bool => @i_less_than_native(lhs.data, rhs)
    @greater_than: function (lhs: Int, rhs: @bit_native) Bool =>  @i_greater_than_native(lhs.data, rhs)
    @less_than_or_equal: function (lhs: Int, rhs: @bit_native) Bool => @i_less_than_or_equal_native(lhs.data, rhs)
    @greater_than_or_equal: function (lhs: Int, rhs: @bit_native) Bool => @i_greater_than_or_equal_native(lhs.data, rhs)

    @add: function (lhs: @bit_native, rhs: Int) Int => @i_add_native(lhs, rhs.data)
    @sub: function (lhs: @bit_native, rhs: Int) Int => @i_sub_native(lhs, rhs.data)
    @mul: function (lhs: @bit_native, rhs: Int) Int => @i_mul_native(lhs, rhs.data)
    @div: function (lhs: @bit_native, rhs: Int) Int => @i_div_native(lhs, rhs.data)
    @mod: function (lhs: @bit_native, rhs: Int) Int => @i_mod_native(lhs, rhs.data)

    @less_than: function (lhs: @bit_native, rhs: Int) Bool => @i_less_than_native(lhs, rhs.data)
    @greater_than: function (lhs: @bit_native, rhs: Int) Bool =>  @i_greater_than_native(lhs, rhs.data)
    @less_than_or_equal: function (lhs: @bit_native, rhs: Int) Bool => @i_less_than_or_equal_native(lhs, rhs.data)
    @greater_than_or_equal: function (lhs: @bit_native, rhs: Int) Bool => @i_greater_than_or_equal_native(lhs, rhs.data)

    @conversion: function(from: @bit_native) Int => Int { data = from }
    @conversion: function(from: Int) @bit_native => from.data

    // Signed decimal.
    @format: function (self, out: ref Formatter) nothing {
        write_signed(out, @extend_sign(self.data))
    }

    // The bits in hexadecimal, at this type's width: `{n.hex()}`.
    hex: function (self) Hex => Hex { value = @extend_zero(self.data) }

    // The bits in binary, at this type's width: `{n.binary()}`.
    binary: function (self) Binary => Binary { value = @extend_zero(self.data) }
}
