// Writing text to the standard output and error streams, and reading
// lines from standard input. Text is a `Format`: an f-string, a literal
// or one formattable value. Each call is written out before it returns,
// so a program's output shows as it runs, and is one write, so the text
// of two threads never mixes. Then whole files: read as text, written,
// appended to and removed.

using Standard.Collections
using Standard.Os as Os

/// Writes `text` to standard output.
print: function (text: Format) nothing {
    print_standard(text, false)
}

/// Writes `text` and a newline to standard output.
print_line: function (text: Format) nothing {
    print_standard(text, true)
}

/// Writes `text` to standard error.
print_error: function (text: Format) nothing {
    print_error_text(text, false)
}

/// Writes `text` and a newline to standard error.
print_error_line: function (text: Format) nothing {
    print_error_text(text, true)
}

/// One line from standard input, without its newline; fails at the end of
/// the input. Bytes that are not UTF-8 become U+FFFD. Standard output is
/// flushed first, so a prompt shows. A failed read panics.
///
///     loop if read_line() -> line: String { print_line($"you said {line}") }
read_line: function () line: String else nothing {

    text: String = String.new("")

    standard_input().read_line_lossy(ref text) else -> line_error: Optional[Error] {
        if line_error.get() -> error: Error {
            @panic($"reading standard input failed: {error}")
        }
        fail
    }

    line = text
}

/// Writes `text` to standard output, then reads the answer: one line, as
/// `read_line` reads it.
///
///     name: String = ask("Your name: ") else { return }
ask: function (text: Format) line: String else nothing {
    print(text)
    answer: String = read_line() else {
        fail
    }
    line = answer
}

/// The whole file at `path` as text: `.InvalidData` when it is not UTF-8.
///
///     notes: String = read_file($"{folder}/notes.txt") else -> e: Error { ... }
read_file: function (path: Format) text: String else error: Error {

    file: File = File.open(path) else -> open_error: Error {
        error = open_error
        fail
    }

    bytes: List[Byte] = List[Byte].new()

    // Only a hint: the file can change size while it is read.
    if file.size() -> size: Uint64 {
        if size.to_int() -> count: Int {
            bytes.reserve(count)
        }
    }

    file.reader().read_all(ref bytes) else -> read_error: Error {
        error = read_error
        fail
    }

    // Validated once, whole, so no scalar is split between two reads.
    valid: String = String.from_bytes(bytes.get_slice()) else {
        error = .InvalidData
        fail
    }
    text = valid
}

/// Writes `text` to the file at `path`, created if missing and replaced if
/// not.
write_file: function (path: Format, text: Format) nothing else error: Error {
    file: File = File.create(path) else -> open_error: Error {
        error = open_error
        fail
    }
    write_and_close(@move(file), text) else -> write_error: Error {
        error = write_error
        fail
    }
}

/// Writes `text` at the end of the file at `path`, created if missing.
append_file: function (path: Format, text: Format) nothing else error: Error {
    file: File = File.open_with(path, .Append) else -> open_error: Error {
        error = open_error
        fail
    }
    write_and_close(@move(file), text) else -> write_error: Error {
        error = write_error
        fail
    }
}

/// Removes the file at `path`.
remove_file: function (path: Format) nothing else error: Error {

    buffer: PathBuffer = PathBuffer.empty()
    buffer.format(path) else -> path_error: Error {
        error = path_error
        fail
    }

    match Os.remove_file(buffer.text()) {
        .Some -> remove_error: Error {
            error = remove_error
            fail
        }
    }
}

private {

    /// Writes `text` to `file` through a buffer, so a format of many
    /// pieces is few system calls, then closes it: a close can report a
    /// write the system held back.
    write_and_close: function (file: File, text: Format) nothing else error: Error {

        write_buffered(ref file, text) else -> write_error: Error {
            error = write_error
            fail
        }

        @move(file).close() else -> close_error: Error {
            error = close_error
            fail
        }
    }

    /// Writes `text` to `file` through a `BufferedWriter`, and flushes it.
    write_buffered: function (file: ref File, text: Format) nothing else error: Error {

        buffered: BufferedWriter = BufferedWriter.over(file.writer(), false)
        writer: Writer = buffered.writer()

        writer.write(text) else -> write_error: Error {
            error = write_error
            fail
        }

        writer.flush() else -> flush_error: Error {
            error = flush_error
            fail
        }
    }

    /// Writes `text` to standard error, then a newline when `line`. The
    /// stream itself is unbuffered, so the text gathers in a buffer on
    /// the stack first and goes out in one write (a panic message too).
    /// An error is dropped: there is nowhere left to report it.
    print_error_text: function (text: Format, line: Bool) nothing {

        buffered: BufferedWriter = BufferedWriter.over(standard_error(), false)
        writer: Writer = buffered.writer()

        if line {
            writer.write_line(text) else {
                return
            }
        } else {
            writer.write(text) else {
                return
            }
        }

        writer.flush() else {
            return
        }
    }
}
