// Writing text to the standard output and error streams, through the OS
// (`Standard.Os`). Text is a `Format`: an f-string, a literal or one
// formattable value. It is formatted into a buffer on the stack and written
// a line at a time.

using Standard.Os as Os

print: function (text: Format) nothing {
    line: Line = Line.over(Os.standard_output())
    out: Formatter = line.formatter()
    out.write(text)
    line.flush()
}

print_line: function (text: Format) nothing {
    line: Line = Line.over(Os.standard_output())
    out: Formatter = line.formatter()
    out.write(text)
    out.write_bytes("\n")
    line.flush()
}

print_error: function (text: Format) nothing {
    line: Line = Line.over(Os.standard_error())
    out: Formatter = line.formatter()
    out.write(text)
    line.flush()
}

print_error_line: function (text: Format) nothing {
    line: Line = Line.over(Os.standard_error())
    out: Formatter = line.formatter()
    out.write(text)
    out.write_bytes("\n")
    line.flush()
}

print_byte: function (byte: @bit8) nothing {
    b: @bit8 = byte
    p: ref @bit8 = ref b
    Os.write_all(Os.standard_output(), p as ref unknown, 0x1)
}

/// Writes the code point `c` (a character literal such as 'H') as UTF-8.
print_char: function (c: @bit32) nothing {
    if @i_less_than_u_32(c, 0x80) {
        print_byte(@truncate(c))
    } else if @i_less_than_u_32(c, 0x800) {
        print_byte(@truncate(@i_add_32(0xC0, @i_div_u_32(c, 0x40))))
        print_continuation(c, 0x1)
    } else if @i_less_than_u_32(c, 0x10000) {
        print_byte(@truncate(@i_add_32(0xE0, @i_div_u_32(c, 0x1000))))
        print_continuation(c, 0x40)
        print_continuation(c, 0x1)
    } else {
        print_byte(@truncate(@i_add_32(0xF0, @i_div_u_32(c, 0x40000))))
        print_continuation(c, 0x1000)
        print_continuation(c, 0x40)
        print_continuation(c, 0x1)
    }
}

private {
    /// Formatted bytes on their way to a stream: written when a line ends,
    /// when the buffer fills, and at `flush`.
    Line: structure {
        handle: Os.Handle
        used: Int
        bytes: @array(Byte, 0x100)

        over: function (handle: Os.Handle) line: Line {
            line = Line { handle = handle, used = 0, bytes = @array(Byte, 0x100) {} }
        }

        /// The whole buffer, used or not.
        buffer: function (self) Slice[Byte] => Slice[Byte].new(@array_at(ref self.bytes, 0x0), @array_len(self.bytes))

        /// A formatter that writes into this line. It holds the line's
        /// address, so it is used only while the line is in place.
        formatter: function (self) out: Formatter {
            out = Formatter.over[Line](self, ref Line.push)
        }

        /// `Line`'s sink: buffers `text`, writing at each newline and when full.
        push: function (self, text: Slice[Byte]) nothing {
            buffer: Slice[Byte] = self.buffer()
            rest: Slice[Byte] = text

            // A piece at a time: as much as fits, cut after a newline.
            loop if rest.get_count() > 0 {
                take: Int = Int.min(rest.get_count(), buffer.get_count() - self.used)
                ends_line: Bool = false

                if Memory.find_byte(rest.slice(Range.of(0, take)), 0x0A, 0) -> newline: Int {
                    take = newline + 1
                    ends_line = true
                }

                rest.slice(Range.of(0, take)).copy_to(buffer, self.used)
                self.used += take

                if ends_line or self.used == buffer.get_count() {
                    self.flush()
                }

                rest = rest.slice(Range.of(take, rest.get_count()))
            }
        }

        /// Writes what is buffered; a failure is dropped, as C's `printf`
        /// does.
        flush: function (self) nothing {
            if self.used == 0 as Int { return }
            Os.write_all(self.handle, @array_at(ref self.bytes, 0x0) as ref unknown, self.used as @bit_native)
            self.used = 0
        }
    }

    /// One UTF-8 continuation byte: six bits of `c / scale`.
    print_continuation: function (c: @bit32, scale: @bit32) nothing {
        print_byte(@truncate(@i_add_32(0x80, @i_mod_u_32(@i_div_u_32(c, scale), 0x40))))
    }
}
