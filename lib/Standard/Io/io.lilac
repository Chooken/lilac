// Writing text to the standard output and error streams. Text is a
// `Format`: an f-string, a literal or one formattable value. Each call is
// written out before it returns, so a program's output shows as it runs,
// and is one write, so the text of two threads never mixes.

/// Writes `text` to standard output.
print: function (text: Format) nothing {
    print_standard(text, false)
}

/// Writes `text` and a newline to standard output.
print_line: function (text: Format) nothing {
    print_standard(text, true)
}

/// Writes `text` to standard error.
print_error: function (text: Format) nothing {
    print_error_text(text, false)
}

/// Writes `text` and a newline to standard error.
print_error_line: function (text: Format) nothing {
    print_error_text(text, true)
}

/// Writes one byte to standard output, as it is.
print_byte: function (byte: @bit8) nothing {
    bytes: @array(Byte, 0x1) = @array(Byte, 0x1) {}
    @array_at(ref bytes, 0x0) = byte as Byte
    print_standard_bytes(Slice[Byte].new(@array_at(ref bytes, 0x0), 1))
}

/// Writes the code point `c` (a character literal such as 'H') as UTF-8;
/// one that is not a scalar value writes U+FFFD.
print_char: function (c: @bit32) nothing {
    scalar: Scalar = Scalar.from(c as Uint32) else {
        print(Scalar.REPLACEMENT)
        return
    }
    print(scalar)
}

private {

    /// Writes `text` to standard error, then a newline when `line`. The
    /// stream itself is unbuffered, so the text gathers in a buffer on
    /// the stack first and goes out in one write (a panic message too).
    /// An error is dropped: there is nowhere left to report it.
    print_error_text: function (text: Format, line: Bool) nothing {

        buffered: BufferedWriter = BufferedWriter.over(standard_error(), false)
        writer: Writer = buffered.writer()

        if line {
            writer.write_line(text) else {
                return
            }
        } else {
            writer.write(text) else {
                return
            }
        }

        writer.flush() else {
            return
        }
    }
}
