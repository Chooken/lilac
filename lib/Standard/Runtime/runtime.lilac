// The platform hooks a Lilac executable needs: the compiler's entry stub
// calls `@entry` and then `@exit(0)`, and its panic handler writes through
// `@compiler_print` and then calls `@exit(101)`. Mounting Standard supplies
// all three.

using Standard.Os as Os
using Standard.Io as Io
using Standard.Heap as Heap

/// Records the process arguments in `Standard.Os`, sets
/// `Heap.default_allocator` to an arena that lives as long as the program,
/// then runs the program: its root-namespace `main`.
@entry: function (count: @bit_native, arguments: ref unknown, environment: ref unknown) nothing {
    Os.argument_count = count
    Os.argument_vector = arguments
    Os.environment_vector = environment

    program_arena = .Some(Heap.ArenaAllocator.init())
    if program_arena.get_ref() -> arena: ref Heap.ArenaAllocator {
        Heap.default_allocator = .Some(Heap.Allocator.from[Heap.ArenaAllocator](arena))
    }

    main()
}

@exit: function (code: @bit32) nothing {
    Os.exit(code)
}

/// Panic messages and stack traces go to standard error. A message is a
/// `Format`, so `@panic($"index {i} past {n}")` formats.
@compiler_print: function (text: Format) nothing {
    Io.print_error(text)
}

private {
    /// The arena behind `Heap.default_allocator`, set by `@entry`.
    program_arena: Optional[Heap.ArenaAllocator] = .None
}
