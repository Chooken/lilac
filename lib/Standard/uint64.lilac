    /// This value as an `Int8`, wrapping around at `Int8`'s range: the
    /// low bits.
    to_int8_wrapping: function (self: Uint64) Int8 => @truncate(self.data) as @bit8 as Int8

    /// This value as an `Int16`; fails when it is out of `Int16`'s range.
    to_int16: function (self: Uint64) value: Int16 else nothing {
        bits: @bit16 = @truncate(self.data)
        back: @bit64 = @extend_sign(bits)
        if back == self.data and @i_greater_than_or_equal_16(bits, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int16`, wrapping around at `Int16`'s range: the
    /// low bits.
    to_int16_wrapping: function (self: Uint64) Int16 => @truncate(self.data) as @bit16 as Int16

    /// This value as an `Int32`; fails when it is out of `Int32`'s range.
    to_int32: function (self: Uint64) value: Int32 else nothing {
        bits: @bit32 = @truncate(self.data)
        back: @bit64 = @extend_sign(bits)
        if back == self.data and @i_greater_than_or_equal_32(bits, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int32`, wrapping around at `Int32`'s range: the
    /// low bits.
    to_int32_wrapping: function (self: Uint64) Int32 => @truncate(self.data) as @bit32 as Int32

    /// This value as an `Int64`; fails when it is out of `Int64`'s range.
    to_int64: function (self: Uint64) value: Int64 else nothing {
        bits: @bit64 = self.data
        back: @bit64 = bits
        if back == self.data and @i_greater_than_or_equal_64(bits, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int64`, wrapping around at `Int64`'s range: the
    /// low bits.
    to_int64_wrapping: function (self: Uint64) Int64 => self.data as @bit64 as Int64

    /// This value as an `Int`; fails when it is out of `Int`'s range.
    to_int: function (self: Uint64) value: Int else nothing {
        bits: @bit_native = @truncate(self.data)
        back: @bit64 = @extend_sign(bits)
        if back == self.data and @i_greater_than_or_equal_native(bits, 0x0) {
            value = bits
            return
        }
        fail
    }

    /// This value as an `Int`, wrapping around at `Int`'s range: the
    /// low bits.
    to_int_wrapping: function (self: Uint64) Int => @truncate(self.data) as @bit_native as Int

    /// This value as a `Uint8`; fails when it is out of `Uint8`'s range.
    to_uint8: function (self: Uint64) value: Uint8 else nothing {
        bits: @bit8 = @truncate(self.data)
        back: @bit64 = @extend_zero(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint8`, wrapping around at `Uint8`'s range: the
    /// low bits.
    to_uint8_wrapping: function (self: Uint64) Uint8 => @truncate(self.data) as @bit8 as Uint8

    /// This value as a `Uint16`; fails when it is out of `Uint16`'s range.
    to_uint16: function (self: Uint64) value: Uint16 else nothing {
        bits: @bit16 = @truncate(self.data)
        back: @bit64 = @extend_zero(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint16`, wrapping around at `Uint16`'s range: the
    /// low bits.
    to_uint16_wrapping: function (self: Uint64) Uint16 => @truncate(self.data) as @bit16 as Uint16

    /// This value as a `Uint32`; fails when it is out of `Uint32`'s range.
    to_uint32: function (self: Uint64) value: Uint32 else nothing {
        bits: @bit32 = @truncate(self.data)
        back: @bit64 = @extend_zero(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint32`, wrapping around at `Uint32`'s range: the
    /// low bits.
    to_uint32_wrapping: function (self: Uint64) Uint32 => @truncate(self.data) as @bit32 as Uint32

    /// This value as a `Uint`; fails when it is out of `Uint`'s range.
    to_uint: function (self: Uint64) value: Uint else nothing {
        bits: @bit_native = @truncate(self.data)
        back: @bit64 = @extend_zero(bits)
        if back == self.data {
            value = bits
            return
        }
        fail
    }

    /// This value as a `Uint`, wrapping around at `Uint`'s range: the
    /// low bits.
    to_uint_wrapping: function (self: Uint64) Uint => @truncate(self.data) as @bit_native as Uint

    /// This value as a `Float16`, rounded to the nearest (ties to even);
    /// past `Float16`'s largest finite value it is an infinity.
    to_float16_rounded: function (self: Uint64) Float16 => @uint_to_float(self.data) as @fbit16 as Float16

    /// This value as a `Float32`, rounded to the nearest (ties to even).
    to_float32_rounded: function (self: Uint64) Float32 => @uint_to_float(self.data) as @fbit32 as Float32

    /// This value as a `Float64`, rounded to the nearest (ties to even).
    to_float64_rounded: function (self: Uint64) Float64 => @uint_to_float(self.data) as @fbit64 as Float64

    /// Parses an unsigned integer in decimal, `0x` hexadecimal or `0b` binary
    /// (`_` separators allowed).
    parse: function (text: @byte_buffer) value: Uint64 else error: ParseError {
        raw: @bit64 = parse_unsigned_int(text, Uint64.MAX.data) else -> err: ParseError {
            error = err
            fail
        }
        value = Uint64 { data = raw }
    }

    /// Unsigned decimal.
    @format: function (self, out: ref Formatter) nothing {
        write_unsigned(out, self.data, 0xA)
    }

    /// The bits in hexadecimal, at this type's width: `{n.hex()}`.
    hex: function (self: Uint64) Hex => Hex { value = self.data }

    /// The bits in binary, at this type's width: `{n.binary()}`.
    binary: function (self: Uint64) Binary => Binary { value = self.data }
}
