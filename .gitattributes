# Auto detect text files and perform LF normalization
* text=auto

# IR snapshots are compared byte-for-byte by `emit-ir`/`emit-llvm --check`; pin
# LF so a Windows checkout (core.autocrlf=true) does not rewrite them to CRLF.
*.lir text eol=lf
*.ll text eol=lf

# Shell scripts run under bash, which reads a CR as part of the line.
*.sh text eol=lf
