{
  "name": "lilac",
  "displayName": "Lilac",
  "description": "Syntax highlighting for the Lilac language and Lilac IR",
  "version": "0.5.0",
  "publisher": "lilac-lang",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/Chooken/Lilac.git" },
  "engines": { "vscode": "^1.82.0" },
  "categories": ["Programming Languages"],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:lilac",
    "onCommand:lilac.showLir",
    "onCommand:lilac.selectLirStage",
    "onCommand:lilac.restartServer"
  ],
  "contributes": {
    "commands": [
      { "command": "lilac.showLir", "title": "Lilac: Show IR" },
      { "command": "lilac.selectLirStage", "title": "Lilac: Select IR Stage" },
      { "command": "lilac.restartServer", "title": "Lilac: Restart Language Server" }
    ],
    "languages": [
      {
        "id": "lilac",
        "aliases": ["Lilac", "lilac"],
        "extensions": [".lilac"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "lilac-ir",
        "aliases": ["Lilac IR", "lilac-ir"],
        "extensions": [".lir"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "lilac",
        "scopeName": "source.lilac",
        "path": "./syntaxes/lilac.tmLanguage.json"
      },
      {
        "language": "lilac-ir",
        "scopeName": "source.lilac-ir",
        "path": "./syntaxes/lilac-ir.tmLanguage.json"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "lilac",
        "scopes": {
          "function": ["entity.name.function"],
          "type": ["entity.name.type"],
          "enum": ["entity.name.type.enum"],
          "property": ["variable.other.property"],
          "enumMember": ["variable.other.enummember"],
          "variable": ["variable.other"],
          "parameter": ["variable.parameter"],
          "namespace": ["entity.name.type.namespace"]
        }
      }
    ],
    "configuration": {
      "title": "Lilac",
      "properties": {
        "lilac.serverPath": {
          "type": "string",
          "default": "lilac-lsp",
          "description": "Path to the lilac-lsp executable."
        },
        "lilac.libraries": {
          "type": "object",
          "default": {},
          "additionalProperties": { "type": "string" },
          "description": "Mounted libraries, as { \"Name\": \"dir\" } (the CLI's --lib=Name=dir). A relative dir is taken from the workspace folder. Merged over lilac.json's \"libraries\"."
        }
      }
    }
  },
  "scripts": {
    "test": "node --test test/lirMap.test.js test/semanticTokenScopes.test.js && node scripts/run-grammar-tests.mjs \"test/*.test\"",
    "package": "vsce package"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "vscode-tmgrammar-test": "^0.1.3",
    "@vscode/vsce": "^4.0.0"
  }
}
