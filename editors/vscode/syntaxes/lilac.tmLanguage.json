{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Lilac",
  "scopeName": "source.lilac",
  "fileTypes": ["lilac"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#decl-names" },
    { "include": "#builtin-types" },
    { "include": "#hooks" },
    { "include": "#keywords" },
    { "include": "#numbers" },
    { "include": "#fstrings" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#brackets" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "match": "//.*$",
      "name": "comment.line.double-slash.lilac"
    },
    "decl-names": {
      "patterns": [
        {
          "match": "^\\s*(@?[A-Za-z_]\\w*)(\\s*:)(\\s*)((?:extern|export)\\s+)?(function)\\b",
          "captures": {
            "1": { "name": "entity.name.function.lilac" },
            "2": { "name": "keyword.operator.lilac" },
            "4": { "name": "storage.type.lilac" },
            "5": { "name": "storage.type.lilac" }
          }
        },
        {
          "match": "^\\s*([A-Za-z_]\\w*)(\\s*:)(\\s*)(structure|either)\\b",
          "captures": {
            "1": { "name": "entity.name.type.lilac" },
            "2": { "name": "keyword.operator.lilac" },
            "4": { "name": "storage.type.lilac" }
          }
        }
      ]
    },
    "builtin-types": {
      "match": "@(bit8|bit16|bit32|bit64|bit_native|byte_buffer|array|format_args)\\b",
      "name": "support.type.builtin.lilac"
    },
    "hooks": {
      "match": "@[A-Za-z_]\\w*",
      "name": "support.function.builtin.lilac"
    },
    "keywords": {
      "patterns": [
        { "match": "\\b(structure|function|either|alias|extern|export)\\b", "name": "storage.type.lilac" },
        { "match": "\\b(using)\\b", "name": "keyword.control.import.lilac" },
        { "match": "\\b(private)\\b", "name": "storage.modifier.lilac" },
        { "match": "\\b(ref|unknown|nothing|self)\\b", "name": "storage.type.lilac" },
        { "match": "\\b(if|then|else|loop|match|break|continue|return|fail)\\b", "name": "keyword.control.lilac" },
        { "match": "\\b(and|or|not)\\b", "name": "keyword.operator.lilac" },
        { "match": "\\b(as)\\b", "name": "keyword.other.as.lilac" }
      ]
    },
    "numbers": {
      "patterns": [
        { "match": "\\b0[xX][0-9A-Fa-f_]*\\b", "name": "constant.numeric.hex.lilac" },
        { "match": "\\b0[bB][01_]*\\b", "name": "constant.numeric.binary.lilac" },
        { "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*\\b", "name": "constant.numeric.float.lilac" },
        { "match": "\\b[0-9][0-9_]*\\b", "name": "constant.numeric.integer.lilac" }
      ]
    },
    "fstrings": {
      "begin": "\\$\"",
      "end": "[\"\\n]",
      "beginCaptures": { "0": { "name": "string.interpolated.lilac punctuation.definition.string.begin.lilac" } },
      "endCaptures": { "0": { "name": "string.interpolated.lilac punctuation.definition.string.end.lilac" } },
      "name": "meta.fstring.lilac",
      "patterns": [
        { "match": "\\{\\{|\\}\\}", "name": "string.interpolated.lilac constant.character.escape.lilac" },
        { "match": "\\\\[\\\\\"]", "name": "string.interpolated.lilac constant.character.escape.lilac" },
        { "match": "[^{}\"\\\\\\n]+|[\\\\}]", "name": "string.interpolated.lilac" },
        {
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.lilac" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.lilac" } },
          "name": "meta.interpolation.lilac",
          "contentName": "meta.embedded.line.lilac",
          "patterns": [
            { "include": "#builtin-types" },
            { "include": "#hooks" },
            { "include": "#keywords" },
            { "include": "#numbers" },
            { "include": "#fstrings" },
            { "include": "#strings" },
            { "include": "#chars" },
            { "include": "#brackets" },
            { "include": "#operators" }
          ]
        }
      ]
    },
    "strings": {
      "begin": "\"",
      "end": "[\"\\n]",
      "name": "string.quoted.double.lilac",
      "patterns": [
        { "match": "\\\\(?:[\"\\\\n]|x[0-9A-Fa-f]{2})", "name": "constant.character.escape.lilac" }
      ]
    },
    "chars": {
      "match": "'(\\\\.|[^'\\\\])'",
      "name": "string.quoted.single.lilac"
    },
    "brackets": {
      "match": "[\\[\\]]",
      "name": "punctuation.section.brackets.lilac"
    },
    "operators": {
      "match": "(==|!=|\\+=|-=|\\*=|/=|%=|=>|->|<=|>=|[.,:=+\\-*/%<>!])",
      "name": "keyword.operator.lilac"
    }
  }
}
