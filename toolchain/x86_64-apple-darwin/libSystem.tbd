--- !tapi-tbd
tbd-version:     4
targets:         [ x86_64-macos ]
install-name:    '/usr/lib/libSystem.B.dylib'
current-version: 1345
exports:
  - targets:         [ x86_64-macos ]
    symbols:         [ __NSGetArgc, __NSGetArgv, __NSGetEnviron, ___chkstk_darwin,
                       ___error, __exit, _abort, _access, _arc4random_buf, _bzero,
                       _calloc, _chdir, _clock_gettime, _clock_gettime_nsec_np, _close,
                       _dup, _dup2, _exit, _fcntl, _fmod, _fmodf, _free, _fsync,
                       _ftruncate, _getcwd, _getentropy, _getenv, _getpid, _isatty,
                       _kill, _lseek, _mach_absolute_time, _mach_timebase_info, _madvise,
                       _malloc, _memcpy, _memmove, _memset, _mkdir, _mmap, _mprotect,
                       _munmap, _nanosleep, _open, _os_unfair_lock_lock,
                       _os_unfair_lock_trylock, _os_unfair_lock_unlock, _pipe, _pread,
                       _pthread_create, _pthread_detach, _pthread_join, _pthread_self,
                       _pwrite, _read, _realloc, _rename, _rmdir, _sched_yield, _sysconf,
                       _unlink, _usleep, _write, dyld_stub_binder ]
...
