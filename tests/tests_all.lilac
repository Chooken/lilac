
// main function
main: function () nothing {}

// int addition
main: function () nothing {
    addition: @bit32 = iadd(0x1, 0x2)
}

// references
main: function () nothing {
    variable: @bit32 = 0x0
    ref_to_variable: ref @bit32 = ref variable
    ref_to_variable = 0x1
}

// references 2
main: function () nothing {
    variable: @bit32 = 0x0
    variable_2: @bit32 = 0x2
    ref_to_variable: ref @bit32 = ref variable
    ref_to_variable = ref varibale_2
    ref_to_variable = 0x1
}

// if condition
main: function () nothing {
    
    conditional: @bit32 = 0x0

    if 0x0 {
        conditional = 0x1
    }
}

// if and
main: function () nothing {
    
    conditional: @bit32 = 0x0

    if 0x0 and 0x1 {
        conditional = 0x1
    }
}

// if or
main: function () nothing {
    
    conditional: @bit32 = 0x0

    if 0x0 or 0x1 {
        conditional = 0x1
    }
}

// if condition with else
main: function () nothing {
    
    conditional: @bit32 = 0x0

    if 0x0 {
        conditional = 0x1
    } else {
        conditional = 0x2
    }
}

// if as a value

main: function () nothing {
    
    conditional: @bit32 =  if 0x0 0x0 else 0x1
}

// if as a value (fails)

// conditions must be exhaustitive if returning a value.
main: function () nothing {
    
    conditional: @bit32 = if 0x0 0x0
}


// function returns

main: function () nothing {
    return_val: @bit32 = get()
}

get: function () result: @bit32 {
    result = 0x1
}

// function mutli returns

main: function () nothing {
    condition: @bit32, return_val: @bit32 = get_multi()
}

get_multi: function () condition: @bit32, result: @bit32 {
    condition = 0x1
    result = 0x2
}

// if captures

main: function () nothing {
    if get_multi() -> result: @bit32 {

    }
}

get_multi: function () condition: @bit32, result: @bit32 {
    condition = 0x1
    result = 0x2
}
 
// object declaration

Object: object {
    member: @bit8
}

main: function () nothing {}

// object setter

Object: object {
    member: @bit8
}

main: function () nothing {
    variable: Object = Object {
        member = 0x1
    }
}

// object setter 2

Object: object {
    member: @bit8
}

main: function () nothing {
    variable: Object {
        member = 0x1
    }
}

// object setter (should fail need to define all members)

Object: object {
    member: @bit8
}

main: function () nothing {
    variable: Object = Object {}
}

// object static function

Object: object {
    member: @bit8

    add: function (num: @bit32) result: @bit32 {
        result = @iadd(instance.member, num)
    }
}

main: function () nothing {
    variable: Object = Object {
        member = 0x1
    }

    member: @bit32 = Object.add(0x2)
}

// object static function w/ ref 

Object: object {
    member: @bit8

    get: function (instance: ref Object) result: @bit32 {
        result = instance.member
    }
}

main: function () nothing {
    variable: Object = Object {
        member = 0x1
    }

    member: @bit32 = Object.get(ref variable)
}

// object instance function

Object: object {
    member: @bit8

    get: function (instance: ref Object) result: @bit32 {
        result = instance.member
    }
}

main: function () nothing {
    variable: Object = Object {
        member = 0x1
    }

    member: @bit32 = variable.get()
}

// object instance function w/ self

Object: object {
    member: @bit8

    get: function (self) result: @bit32 {
        result = self.member
    }
}

main: function () nothing {
    variable: Object = Object {
        member = 0x1
    }

    member: @bit32 = variable.get()
}

// inline variables

one: @bit32 => 0x1

main: function () nothing {
    variable: @bit32 = one
}

// inline functions

addOne: function (value: @bit32) @bit32 => @iadd(value, 0x1)

main: function () nothing {
    variable: @bit32 = addOne(0x1)
}

// inline functions w/ variable

addOne: function (value: @bit32) @bit32 => @iadd(value, 0x1)

main: function () nothing {
    variable: @bit32 = 0x2

    result: @bit32 = addOne(variable)
}

// enum declaration

Number: enum {
    One
    Two
    Three
}

main: function () nothing {}

// enum use

Number: enum {
    One
    Two
    Three
}

main: function () nothing {

    number: Number = Number.One
}

// enum use w/ implicit member

Number: enum {
    One
    Two
    Three
}

main: function () nothing {

    number: Number = .One
    number = .Two
    number = .Three
}

// union declaration 

OptionalBit32: enum {
    Some: @bit32
    None
}

main: function () nothing {}

// union use

OptionalBit32: enum {
    Some: @bit32
    None
}

main: function () nothing {

    variable: OptionalBit32 = .Some(0x0)
    variable = .None
}

// match 

main: function () nothing {

    match 0x0 {
        0x0 => {}
        0x1 => {}
    }
}

// match enum

Number: enum {
    One
    Two
    Three
}

main: function () nothing {

    number: Number = .One

    match number {
        .One {}
        .Two {}
    }
}

// match union w/ capture

OptionalBit32: enum {
    Some: @bit32
    None
}

main: function () nothing {

    number: OptionalBit32 = .Some(0x1)

    match number {
        .Some -> some: @bit32 {

        }

        .None => return
    }
}

// match with else 

main: function () nothing {

    match 0x0 {
        0x1 {

        }
    } else {
        
    }
}

// match return value

main: function () nothing {

    variable: @bit32 = match 0x0 {
        0x1 => 0x1
    } else 0x3
}

// match return value (fails)

// Match must be exhaustitive if using its value.
main: function () nothing {

    variable: @bit32 = match 0x0 {
        0x1 => 0x1
    } else 0x3
}

// interface declaration

IAnimal: interface {
    get: function (self) @bit32
}

main: function () nothing {}

// interface use

IAnimal: interface {
    get: function (self) @bit32
}

Cat: object {

    value: @bit32

    get: function (self) result: @bit32 {
        result = self.value
    }
}

Dog: object {
    get: function (self) result: @bit32 {
        result = 0x4
    }
}

main: function () nothing {

    animal: IAnimal = Cat {
        value = 0x1
    }

    cat_val: @bit32 = animal.get()

    animal = Dog {}

    dog_val = animal.get()
}

// generic function

gen_function[T]: function (in: T) out: T {
    out = in
}

main: function () nothing {
    variable: @bit32 = gen_function[@bit32](0x1)
}

// generic obj

GenObject[T]: object {
    value: T
}

main: function () nothing {
    variable: GenObject[@bit32] {
        value = 0x0
    }
}

// generic union

Optional[T]: union {
    Some: T
}

main: function () nothing {
    variable: Optional[@bit32] = .Some(0x0)
}

// generic duck typing

gen_function[T]: function () out: T {
    out = T.get()
}

Object: object {
    get: function () result: @bit32 {
        result = 0x2
    }
}

main: function () nothing {
    variable: @bit32 = gen_function[@bit32]()
}

// RAII init declaration

Object: object {

    value: @bit32

    @init: function (value: @bit32) result: Object {
        result = Object {
            value = value
        }
    }
}

main: function () nothing {}

// RAII init use

Object: object {

    value: @bit32

    @init: function (value: @bit32) result: Object {
        result = Object {
            value = value
        }
    }
}

main: function () nothing {
    variable: Object(0x1)
}

// RAII on_override declaration

Object: object {

    value: @bit32

    @on_override: function (from: ref Object, to: ref Object) nothing {
        to.value = 0x1
    }
}

main: function () nothing {}

// RAII on_override use

Object: object {

    value: @bit32

    @on_override: function (from: ref Object, to: ref Object) nothing {
        to.value = 0x1
    }
}

main: function () nothing {
    variable: Object { value = 0x2 }

    variable = Object { value = 0x2 }
}

// RAII on_copy declaration

Object: object {

    value: @bit32

    @on_copy: function (from: ref Object) copy: Object {
        copy = Object {
            value = from.value
        }
    }
}

main: function () nothing {}

// RAII on_copy use

Object: object {

    value: @bit32

    @on_copy: function (from: ref Object) copy: Object {
        copy = Object {
            value = from.value
        }
    }
}

main: function () nothing {
    variable: Object { value = 0x2 }
    variable2: Object = variable
}

// RAII on_drop declaration

Object: object {

    value: @bit32

    @on_drop: function (from: ref Object) nothing {
        from.value = 0x1
    }
}

main: function () nothing {}

// RAII on_drop use

Object: object {

    value: @bit32

    @on_drop: function (from: ref Object) nothing {
        from.value = 0x1
    }
}

main: function () nothing {
    variable: Object { value = 0x2 }
}

// Operator + @add

@add: function (lhs: @bit32, rhs: @bit32) result: @bit32 {
    result = @iadd(lhs, rhs)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit32 = 0x2
    c: @bit32 = a + b
}

// Operator - @sub

@sub: function (lhs: @bit32, rhs: @bit32) result: @bit32 {
    result = @isub(lhs, rhs)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit32 = 0x2
    c: @bit32 = a - b
}

// Operator * @mul

@mul: function (lhs: @bit32, rhs: @bit32) result: @bit32 {
    result = @imul(lhs, rhs)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit32 = 0x2
    c: @bit32 = a * b
}

// Operator / @div

@div: function (lhs: @bit32, rhs: @bit32) result: @bit32 {
    result = @idiv(lhs, rhs)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit32 = 0x2
    c: @bit32 = a / b
}

// Operator % @mod

@mod: function (lhs: @bit32, rhs: @bit32) result: @bit32 {
    result = @imod(lhs, rhs)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit32 = 0x2
    c: @bit32 = a % b
}

// Operator < @lessThan

@lessThan: function (lhs: @bit32, rhs: @bit32) result: @bit8 {
    result = @iLessThan(lhs, rhs)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit32 = 0x2
    c: @bit8 = a < b
}

// Operator > @greaterThan

@greaterThan: function (lhs: @bit32, rhs: @bit32) result: @bit8 {
    result = @iGreaterThan(lhs, rhs)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit32 = 0x2
    c: @bit8 = a > b
}

// Operator <= @lessThanOrEql

@lessThanOrEql: function (lhs: @bit32, rhs: @bit32) result: @bit8 {
    result = @iLessThanOrEql(lhs, rhs)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit32 = 0x2
    c: @bit8 = a <= b
}

// Operator >= @greaterThanOrEql

@greaterThanOrEql: function (lhs: @bit32, rhs: @bit32) result: @bit8 {
    result = @iGreaterThanOrEql(lhs, rhs)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit32 = 0x2
    c: @bit8 = a >= b
}

// Unary Operator - @negate

@negate: function (value: @bit32) result: @bit32 {
    result = @inegate(value)
}

main: function () nothing {
    a: @bit32 = 0x1
    c: @bit8 = -b
}

// Conversions 

@conversion: function (from: @bit32) to: @bit8 {
    to = @truncate(from)
}

main: function () nothing {
    a: @bit32 = 0x1
    b: @bit8 = a
}

// @compilerError (Fails)

main: function () nothing {
    @compilerError("This is expected.")
}

// @asInt8

main: function () nothing {
    integer: @bit8 = @asInt8(5)
}

