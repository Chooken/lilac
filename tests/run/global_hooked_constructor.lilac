// expect-stdout: 7 9 dropped 0
// expect-exit: 0
// A global may be initialized by a call to a `=>` function returning a
// type with a drop hook, generic or not, when its arguments are plain
// constants: the function's body builds the global in place, like a
// literal, and a global never drops.

using Standard
using Standard.Io

drops: Int = 0

Guarded[T]: structure {
    private {
        value: T
        next: Optional[ref Guarded[T]]
    }

    new: function (value: T) Guarded[T] => Guarded[T] { value = value, next = .None }

    get_value: function (self) T => self.value

    @on_drop: function (self) nothing {
        drops = drops + 1
    }
}

Pair: structure {
    first: Guarded[Int]
    second: Guarded[Int]

    of: function (first: Int, second: Int) Pair => Pair {
        first = Guarded[Int].new(first)
        second = Guarded[Int].new(second)
    }
}

single: Guarded[Int] = Guarded[Int].new(7)
pair: Pair = Pair.of(8, 9)

main: function () nothing {
    print_line($"{single.get_value()} {pair.second.get_value()} dropped {drops}")
}
