// libc
// expect-stdout: OK
// Uses every `Standard` type, and formats each, so the whole library is
// instantiated, checked and emitted. Prints `OK` and exits 0 when every
// computed check matched.

using Standard
using Standard.C

exit: extern function (code: @bit32) nothing

expect: function (ok: Bool, code: @bit32) nothing {
    if ok {
    } else {
        r: CInt = putchar(0x58)
        exit(code)
    }
}

ints: function () nothing {
    a: Int32 = 0x6
    b: Int32 = 0x4
    sum: Int32 = a + b * a - b / a % b
    expect(sum == 0x1E as Int32, 0x1)
    n: Int32 = -a
    expect(n < a, 0x2)
    expect(b <= a, 0x3)
    expect(a > b, 0x4)
    expect(a >= a, 0x5)

    i8: Int8 = 0x7
    i16: Int16 = 0x7
    i64: Int64 = 0x7
    nat: Int = 0x7
    expect(i8 + i8 == 0xE as Int8, 0x6)
    expect(i16 * i16 == 0x31 as Int16, 0x7)
    expect(i64 - i64 == 0x0 as Int64, 0x8)
    expect(nat / nat == 0x1 as Int, 0x9)

    // Every comparison hook on every integer type.
    expect(i8 <= i8, 0xA)
    expect(i8 >= i8, 0xA)
    expect(i8 < i8 + i8, 0xA)
    expect(i8 + i8 > i8, 0xA)
    expect(i16 <= i16, 0xB)
    expect(i16 >= i16, 0xB)
    expect(i16 < i16 + i16, 0xB)
    expect(i16 + i16 > i16, 0xB)
    expect(i64 <= i64, 0xC)
    expect(i64 >= i64, 0xC)
    expect(i64 < i64 + i64, 0xC)
    expect(i64 + i64 > i64, 0xC)
    expect(nat <= nat, 0xD)
    expect(nat >= nat, 0xD)
    expect(nat < nat + nat, 0xD)
    expect(nat + nat > nat, 0xD)
    expect(-i8 < i8, 0xE)
    expect(-i16 < i16, 0xE)
    expect(-i64 < i64, 0xE)
    expect(-nat < nat, 0xE)
    expect(i8 % i8 == 0x0 as Int8, 0xF)
    expect(a.compare(b) == .Greater, 0xF)
    expect(b.compare(a).reverse() == .Greater, 0xF)
    expect(b.compare(b).and_then(.Less) == .Less, 0xF)
}

floats: function () nothing {
    f: Float64 = 1.5
    g: Float64 = f + f
    expect(f <= g, 0x10)
    expect(f < g, 0x11)
    expect(g >= f, 0x12)
    expect(g > f, 0x13)
    expect(f >= f, 0x13)
    expect(-f < f, 0x13)
    expect(g - f == f, 0x13)
    expect(g / f == 2.0 as Float64, 0x13)
    h: Float32 = 2.0
    expect(h * h == 4.0 as Float32, 0x14)
    expect(h <= h, 0x15)
    expect(h >= h, 0x15)
    expect(h < h + h, 0x15)
    expect(h + h > h, 0x15)
    expect(-h < h, 0x15)
    expect(h - h == 0.0 as Float32, 0x15)
    expect(h / h == 1.0 as Float32, 0x15)
}

bools: function () nothing {
    expect(true, 0x20)
    if false {
        exit(0x21)
    }
}

optionals: function () nothing {
    some: Optional[Int32] = .Some(0x9 as Int32)
    none: Optional[Int32] = .None
    value: Int32 = some.get() else {
        exit(0x30)
        return
    }
    if none.get() -> nothing_here: Int32 {
        exit(0x33)
    }
    expect(value == 0x9 as Int32, 0x31)
    expect(none.unwrap_or(0x2 as Int32) == 0x2 as Int32, 0x32)
}

boxes: function () nothing {
    box: Box[Int32] = Box[Int32].create(0x5 as Int32)
    moved: Box[Int32] = box
}

consts: function () nothing {
    c: Const[Int32] = Const[Int32].create(0x3 as Int32)
    expect(c.get() == 0x3 as Int32, 0x40)
}

c_library: function () nothing {
    expect(sqrt(16.0) == 4.0 as Float64, 0x50)
    expect(sqrtf(9.0) == 3.0 as Float32, 0x51)
    whole: Float64 = 0.0
    frac: Float64 = modf(2.5, ref whole)
    expect(frac == 0.5 as Float64, 0x52)
    expect(whole == 2.0 as Float64, 0x53)
    digit: CInt = isdigit(0x37)
    expect(digit as @bit32 as Int32 > 0x0 as Int32, 0x54)
    upper: CInt = toupper(0x61)
    expect(upper as @bit32 == 0x41, 0x55)
    block: ref unknown = malloc(0x10)
    zeroed: ref unknown = memset(block, 0x0, 0x10)
    free(block)
}


// Formatted text collected in a buffer, to compare with what it should be.
Capture: object {
    used: @bit_native
    bytes: @array(@bit8, 0x100)
}

capture_push: function (capture: ref Capture, text: @byte_buffer) nothing {
    @memcpy(@ptr_add(@array_at(ref capture.bytes, 0x0) as ref unknown, capture.used), @byte_buffer_ptr(text) as ref unknown, @byte_buffer_len(text))
    capture.used = @i_add_native(capture.used, @byte_buffer_len(text))
}

// Exits with `code` unless `text` formats as exactly `want`.
expect_format: function (text: Format, want: @byte_buffer, code: @bit32) nothing {
    capture: Capture = Capture { used = 0x0, bytes = @array(@bit8, 0x100) {} }
    out: Formatter = Formatter.over[Capture](ref capture, ref capture_push)
    out.write(text)
    if capture.used == @byte_buffer_len(want) {
    } else {
        exit(code)
    }
    got: ref @bit8 = @array_at(ref capture.bytes, 0x0)
    index: @bit_native = 0x0
    loop {
        if index == capture.used { break }
        if @load_u8(got, index) == @load_u8(@byte_buffer_ptr(want), index) {
        } else {
            exit(code)
        }
        index = @i_add_native(index, 0x1)
    }
}

formatting: function () nothing {
    b8: @bit8 = 0xFF
    b16: @bit16 = 0x0
    b32: @bit32 = 0xFFFFFFFF
    b64: @bit64 = 0xFFFFFFFFFFFFFFFF
    native: @bit_native = 0x2A
    expect_format($"{b8} {b16} {b32} {b64} {native}", "255 0 4294967295 18446744073709551615 42", 0x60)

    i8: Int8 = -0x80 as Int8
    i16: Int16 = -0x1 as Int16
    i32: Int32 = 0x7FFFFFFF as Int32
    i64: Int64 = -0x8000000000000000 as Int64
    nat: Int = -0x7 as Int
    expect_format($"{i8} {i16} {i32} {i64} {nat}", "-128 -1 2147483647 -9223372036854775808 -7", 0x61)

    expect_format($"{i8.hex()} {i16.hex()} {(0xBEEF as Int32).hex()} {(0x0 as Int64).hex()}", "80 ffff beef 0", 0x62)
    expect_format($"{(0x5 as Int8).binary()} {(-0x1 as Int8).binary()} {(0x0 as Int).binary()}", "101 11111111 0", 0x63)

    expect_format($"{true} {false}", "true false", 0x64)
    bytes: @byte_buffer = "bytes"
    expect_format(bytes, "bytes", 0x65)
    expect_format($"<{$"{b8}"}> {{}}", "<255> {}", 0x66)

    some: Optional[Int32] = .Some(0x9 as Int32)
    none: Optional[Int32] = .None
    ok: Result[Int, Bool] = .Ok(0x3 as Int)
    failed: Result[Int, Bool] = .Error(false)
    expect_format($"{some} {none} {ok} {failed}", "Some(9) None Ok(3) Error(false)", 0x67)

    word: Format = $"é{b8}"
    expect_format($"[{pad_left(ref word, 0x6)}]", "[  é255]", 0x68)
    expect_format($"[{pad_right(ref word, 0x6)}]", "[é255  ]", 0x69)
    expect_format($"[{pad_center(ref word, 0x7)}]", "[ é255  ]", 0x6A)
    expect_format($"[{pad_left(ref word, 0x2)}]", "[é255]", 0x6B)
    expect_format($"{1.5 as Float64} {(0.125 as Float64).fixed(2)} {(1500.0 as Float64).scientific(1)}", "1.5 0.12 1.5e3", 0x6C)
}

main: function () nothing {
    c_library()
    ints()
    floats()
    bools()
    optionals()
    boxes()
    consts()
    formatting()
    r: CInt = putchar(0x4F)
    r = putchar(0x4B)
    r = putchar(0xA)
}
