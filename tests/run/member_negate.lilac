// expect-exit: 3
// lib: Standard=lib/Standard

using Standard.Process

Num: object {
    data: @bit32

    @negate: function (value: Num) out: Num {
        out = Num { data = @i_sub_32(0x0, value.data) }
    }
}

main: function () nothing {
    a: Num = Num { data = 0xFFFFFFFD }
    b: Num = -a
    exit(b.data)
}
