// no-standard
// expect-exit: trap
// The program supplies its own platform hooks, and its `@exit` returns: the
// entry stub traps after `@exit(0)` rather than running on.

@entry: function () nothing {
    main()
}

@exit: function (code: @bit32) nothing {
}

@compiler_print: function (text: @byte_buffer) nothing {
}

main: function () nothing {
}
