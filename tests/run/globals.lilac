// expect-exit: 0
// Top-level `name: Type = constant` and `name: Type` are mutable globals:
// constant initial values (scalars, structures, variants), zeroed ones, and
// reads, writes and references through functions.

using Standard
using Standard.Process

Point: structure {
    x: @bit32
    y: @bit32
}

Shape: either {
    Empty
    Square: @bit32
}

count: @bit32 = 0x2A
origin: Point = Point { x = 0x3, y = 0x4 }
shape: Shape = .Square(0x7)
zeroed: @bit64
pointer: ref @bit32
total: Int32 = 0x5

bump: function () nothing {
    count = @i_add_32(count, 0x1)
}

check: function (ok: @bit8, code: @bit32) nothing {
    if ok {
    } else {
        exit(code)
    }
}

main: function () nothing {
    check(count == 0x2A, 0x1)
    bump()
    bump()
    check(count == 0x2C, 0x2)
    check(origin.y == 0x4, 0x3)
    origin.x = 0x9
    check(origin.x == 0x9, 0x4)
    match shape {
        .Square -> side: @bit32 => check(side == 0x7, 0x5)
    } else {
        exit(0x6)
    }
    check(zeroed == 0x0, 0x7)
    pointer = ref count
    pointer = 0x1
    check(count == 0x1, 0x8)
    total = total + 0x1 as Int32
    check(total == 0x6 as Int32, 0x9)
}
