// expect-exit: 101
// expect-stderr: panic: dropped
// expect-stderr:   at Guard.@on_drop (panic_drop_temp.lilac:12:13)
// expect-stderr:   at main (panic_drop_temp.lilac:22:21)

// A temporary dies at the end of its statement, reported at the statement's
// expression. (`out = ...` drops the zeroed `out` first, hence the guard.)
Guard: object {
    member: @bit32
    @on_drop: function (from: ref Guard) nothing {
        if @i_less_than_u_32(0x0, from.member) {
            @panic("dropped")
        }
    }
}

make: function () out: Guard {
    out = Guard { member = 0x1 }
}

main: function () nothing {
    value: @bit32 = make().member
}
