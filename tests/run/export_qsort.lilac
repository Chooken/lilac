// libc
// expect-exit: 0
// An `export` passed to C: `qsort` calls `compare` back with the C ABI to
// sort four integers.

using Standard.Process

Numbers: object {
    a: @bit32
    b: @bit32
    c: @bit32
    d: @bit32
}

qsort: extern function (base: ref Numbers, count: @bit_native, size: @bit_native, compare: export function (a: ref @bit32, b: ref @bit32) order: @bit32) nothing

compare: export function (a: ref @bit32, b: ref @bit32) order: @bit32 {
    order = 0x0
    if @i_less_than_32(a, b) {
        order = -0x1
    }
    if @i_less_than_32(b, a) {
        order = 0x1
    }
}

check: function (value: @bit32, want: @bit32, code: @bit32) nothing {
    if value == want {
    } else {
        exit(code)
    }
}

main: function () nothing {
    numbers: Numbers = Numbers { a = 0x1e, b = -0x5, c = 0x7, d = 0x0 }
    qsort(ref numbers, 0x4, 0x4, compare)
    check(numbers.a, -0x5, 0x1)
    check(numbers.b, 0x0, 0x2)
    check(numbers.c, 0x7, 0x3)
    check(numbers.d, 0x1e, 0x4)
}
