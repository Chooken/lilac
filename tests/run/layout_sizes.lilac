// expect-exit: 0
// Objects are C structs and arrays C arrays (robustness plan phase 2): each
// field at the next multiple of its alignment, the size padded to the
// largest alignment, no reordering, and an empty object is size 0, align 1.
// Pinned for the 64-bit hosts the run tests build on.

using Standard.Process

Empty: object {
}

Padded: object {
    a: @bit64
    b: @bit8
}

Nested: object {
    a: @bit8
    inner: Padded
    c: @bit16
}

Quad: object {
    a: @bit8
    q: @fbit128
}

Holder: object {
    a: @bit8
    items: @array(Padded, 0x3)
    gap: Empty
    b: @bit8
}

Row: object {
    cells: @array(Padded, 0x3)
}

Grid: object {
    rows: @array(@array(@bit16, 0x3), 0x5)
}

Pointers: object {
    a: @bit16
    p: ref Padded
    n: @bit_native
    h: @fbit16
}

check: function (ok: @bit8, code: @bit32) nothing {
    if ok {
    } else {
        exit(code)
    }
}

main: function () nothing {
    check(@size_of(Empty) == 0x0, 0x1)
    check(@align_of(Empty) == 0x1, 0x2)
    check(@size_of(Padded) == 0x10, 0x3)
    check(@align_of(Padded) == 0x8, 0x4)
    check(@size_of(Nested) == 0x20, 0x5)
    check(@size_of(Quad) == 0x20, 0x6)
    check(@align_of(Quad) == 0x10, 0x7)
    check(@size_of(Row) == 0x30, 0x8)
    check(@size_of(Holder) == 0x40, 0x9)
    check(@align_of(Holder) == 0x8, 0xa)
    check(@size_of(Pointers) == 0x20, 0xb)
    check(@size_of(Grid) == 0x1e, 0xc)
    check(@align_of(Grid) == 0x2, 0xd)
}
