// expect-stdout: 40000 40000 40000
// `Sync.Mutex` and `Sync.RawMutex` under contention: four threads each
// add 10,000 to a constant global `Mutex[Int]`, to a counter a global
// `RawMutex` guards, and to a `Mutex` on `main`'s stack, so every count
// comes out exact. Exits with the number of the first failed check.

using Standard
using Standard.Io
using Standard.Process
using Standard.Os as Os
using Standard.Sync as Sync

total: Sync.Mutex[Int] = Sync.Mutex[Int].new(0)
raw: Sync.RawMutex
raw_total: @bit32

work: function (argument: ref unknown) nothing {
    local: ref Sync.Mutex[Int] = argument as ref Sync.Mutex[Int]
    index: Int = 0
    loop if index < 10000 {
        guard: Sync.MutexGuard[Int] = total.lock()
        guard.value() += 1
        raw.lock()
        raw_total = @i_add_32(raw_total, 0x1)
        raw.unlock()
        // A temporary guard unlocks at the end of its statement.
        local.lock().value() += 1
        index += 1
    }
}

main: function () nothing {
    local: Sync.Mutex[Int] = Sync.Mutex[Int].new(0)
    threads: @array(Os.Thread, 4) = @array(Os.Thread, 4) {}
    running: ref @array(Os.Thread, 4) = ref threads
    index: @bit_native = 0x0
    loop if index != 0x4 {
        thread: Os.Thread = Os.spawn(ref work, ref local as ref unknown).get() else {
            exit(0x1)
            return
        }
        stored: ref Os.Thread = @array_at(running, index)
        stored = thread
        index = @i_add_native(index, 0x1)
    }
    index = 0x0
    loop if index != 0x4 {
        match Os.join(@array_at(running, index)) {
            .Some => exit(0x2)
        }
        index = @i_add_native(index, 0x1)
    }
    if raw.is_locked() {
        exit(0x3)
    }
    counted: Int = total.lock().value()
    raw_counted: Uint32 = raw_total as Uint32
    local_counted: Int = local.lock().value()
    print_line($"{counted} {raw_counted} {local_counted}")
}
