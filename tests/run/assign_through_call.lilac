// expect-stdout: 5 2 3
// expect-stdout: 15 2 13
// expect-stdout: 1 9
// expect-stdout: 4 9
// expect-stdout: 2
// expect-stdout: [a][x]b
// A call returning a `ref` is a place: `=` and `op=` write through the
// reference, also to a field of what it points to. `op=` runs the call
// once. The old value of an element with an `@on_drop` drops once, when
// it is replaced.

using Standard
using Standard.Io
using Standard.Collections

Point: object {
    x: Int
    y: Int
}

Leaf: object {
    c: @bit32

    @on_copy: function (self) copy: Leaf {
        copy = Leaf { c = self.c }
    }

    @on_drop: function (self) nothing {
        print_char(self.c)
    }
}

calls: Int = 0

first: function (list: ref List[Int]) value: ref Int {
    calls += 1
    value = list.get(0)
}

main: function () nothing {
    numbers: List[Int] = List[Int].init()
    numbers.add(1)
    numbers.add(2)
    numbers.add(3)
    numbers.get(0) = 5
    print_line($"{numbers.get(0)} {numbers.get(1)} {numbers.get(2)}")

    numbers.get(0) += 10
    numbers.get(2) *= 4
    numbers.get(2) += 1
    print_line($"{numbers.get(0)} {numbers.get(1)} {numbers.get(2)}")

    points: List[Point] = List[Point].init()
    points.add(Point { x = 1, y = 2 })
    points.get(0).y = 9
    print_line($"{points.get(0).x} {points.get(0).y}")
    points.get(0).x += 3
    print_line($"{points.get(0).x} {points.get(0).y}")

    first(ref numbers) += 1
    first(ref numbers) = 0
    print_line($"{calls}")

    {
        leaves: List[Leaf] = List[Leaf].init()
        leaves.add(Leaf { c = 'a' })
        print_char('[')
        leaves.get(0) = Leaf { c = 'b' }
        print_char(']')
        leaves.add(Leaf { c = 'x' })
        print_char('[')
        leaves.remove(1)
        print_char(']')
    }
    print_line("")
}
