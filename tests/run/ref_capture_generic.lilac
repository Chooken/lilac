// expect-stdout: b
// expect-stdout: x|y
// expect-stdout: q|r
// expect-stdout: t
// A reference capture in a generic body (`-> v: ref T` on an
// `Optional[T]`) is decided per instance: a value `T` gives the payload's
// slot, so writes change the optional in place; `T = ref X` gives the
// stored reference (`ref ref X` does not exist), so `v = value` rebinds
// `v` and writes through `v` reach `X`. `get_ref` works for both, and a
// temporary scrutinee is fine when `T` is a reference.

using Standard
using Standard.Io

Leaf: structure {
    c: @bit32

    @on_drop: function (self) nothing {
        print_char(self.c)
    }
}

/// Puts `value` in a `Some`, through a reference capture.
set_some[T]: function (optional: ref Optional[T], value: T) nothing {
    match optional {
        .Some -> slot: ref T {
            slot = value
        }
    }
}

/// The `Some` value's reference, through `get_ref`.
peek[T]: function (optional: ref Optional[T]) value: ref T {
    if optional.get_ref() -> found: ref T {
        value = found
        return
    }
    @panic("peek of None")
}

fresh[T]: function (value: T) Optional[T] => .Some(value)

/// A reference capture on a temporary: allowed only when `T` is itself
/// a reference, since that capture copies.
through_fresh[T]: function (value: T) nothing {
    match fresh[T](value) {
        .Some -> found: ref T {
            found = 't'
        }
    }
}

main: function () nothing {
    letter: Optional[@bit32] = .Some('a')
    set_some[@bit32](ref letter, 'b')
    print_char(peek[@bit32](ref letter))
    print_char(0xA)

    {
        leaf: Optional[Leaf] = .Some(Leaf { c = 'x' })
        set_some[Leaf](ref leaf, Leaf { c = 'y' })
        print_char('|')
    }
    print_char(0xA)

    // `T = ref @bit32`: `slot = value` rebinds the capture, so the
    // optional still refers to `target`; `peek` gives that reference.
    target: @bit32 = 'q'
    other: @bit32 = 'o'
    pointer: Optional[ref @bit32] = .Some(ref target)
    set_some[ref @bit32](ref pointer, ref other)
    print_char(peek[ref @bit32](ref pointer))
    print_char('|')
    reference: ref @bit32 = peek[ref @bit32](ref pointer)
    reference = 'r'
    print_char(target)
    print_char(0xA)

    written: @bit32 = 's'
    through_fresh[ref @bit32](ref written)
    print_char(written)
    print_char(0xA)
}
