// expect-stdout: 1 1024 -128 1 -1 0 128
// expect-stdout: 0 1 11 15 4294967295 0 1 11
// expect-stdout: 0 1 1 6 7 none none
// expect-stdout: 0 0 1 2 2 19 none none
// Integer powers and roots (math plan phase 3): `pow`, `isqrt`, `ilog2` and
// `ilog10`.

using Standard
using Standard.Io

main: function () nothing {
    print_line($"{(5 as Int32).pow(0)} {(2 as Int32).pow(10)} {(-2 as Int8).pow(7)} {(-1 as Int32).pow(100)} {(-1 as Int32).pow(99)} {(0 as Int32).pow(5)} {(2 as Uint8).pow(7)}")

    print_line($"{(0 as Uint8).isqrt()} {(1 as Uint8).isqrt()} {(143 as Uint8).isqrt()} {Uint8.MAX.isqrt()} {Uint64.MAX.isqrt()} {(0 as Int8).isqrt()} {(1 as Int8).isqrt()} {Int8.MAX.isqrt()}")

    l0: Int8 = (1 as Int8).ilog2() else { return }
    l1: Int8 = (2 as Int8).ilog2() else { return }
    l2: Int8 = (3 as Int8).ilog2() else { return }
    l3: Int8 = Int8.MAX.ilog2() else { return }
    l4: Uint8 = Uint8.MAX.ilog2() else { return }
    print($"{l0} {l1} {l2} {l3} {l4} ")
    if (0 as Int8).ilog2() -> v: Int8 { print($"{v} ") } else { print("none ") }
    if (-1 as Int8).ilog2() -> v: Int8 { print_line($"{v}") } else { print_line("none") }

    d0: Uint64 = (1 as Uint64).ilog10() else { return }
    d1: Uint64 = (9 as Uint64).ilog10() else { return }
    d2: Uint64 = (10 as Uint64).ilog10() else { return }
    d3: Uint64 = (999 as Uint64).ilog10() else { return }
    d4: Int8 = Int8.MAX.ilog10() else { return }
    d5: Uint64 = Uint64.MAX.ilog10() else { return }
    print($"{d0} {d1} {d2} {d3} {d4} {d5} ")
    if (0 as Uint64).ilog10() -> v: Uint64 { print($"{v} ") } else { print("none ") }
    if (Int64.MIN).ilog10() -> v: Int64 { print_line($"{v}") } else { print_line("none") }
}
