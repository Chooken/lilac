// expect-error: E038
// A `=>` function builds a global in place only from plain constants: an
// argument of a type with a drop hook would move into its body, which
// runs hooks, so the initializer is not constant.

using Standard

Guarded: structure {
    value: Int

    new: function (value: Int) Guarded => Guarded { value = value }

    @on_drop: function (self) nothing {
    }
}

Holder: structure {
    inner: Guarded

    of: function (inner: Guarded) Holder => Holder { inner = inner }
}

held: Holder = Holder.of(Guarded.new(1))

main: function () nothing {
}
