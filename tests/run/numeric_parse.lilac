// expect-stdout: -128 127 255 18446744073709551615 42 -9223372036854775808
// expect-stdout: Empty InvalidDigit Overflow Trailing
// expect-stdout: 3ff0000000000000 3ff0000000000002 0 2 8000000000000000 7ff0000000000000 fff0000000000000 true
// expect-stdout: 3f800000 3c00 Overflow InvalidDigit
// Parsing integers and floats (math plan phase 6): `Int*.parse`,
// `Uint*.parse` and `Float*.parse`, including IEEE halfway points and
// `ParseError` variants.

using Standard
using Standard.Io

main: function () nothing {
    i1: Int8 = Int8.parse("-128") else { return }
    i2: Int8 = Int8.parse("0x7F") else { return }
    u1: Uint8 = Uint8.parse("0b1111_1111") else { return }
    u2: Uint64 = Uint64.parse("18_446_744_073_709_551_615") else { return }
    n1: Int = Int.parse("+42") else { return }
    i64: Int64 = Int64.parse("-9223372036854775808") else { return }
    print_line($"{i1} {i2} {u1} {u2} {n1} {i64}")

    if Int8.parse("") -> _: Int8 { return } else -> e1: ParseError { print($"{e1} ") }
    if Int8.parse("12x") -> _: Int8 { return } else -> e2: ParseError { print($"{e2} ") }
    if Int8.parse("128") -> _: Int8 { return } else -> e3: ParseError { print($"{e3} ") }
    if Float64.parse("1.5xyz") -> _: Float64 { return } else -> e4: ParseError { print_line($"{e4}") }

    // Halfway between 1.0 (even LSB 0) and 1.0 + 2^-52: rounds to even 1.0.
    h_even: Float64 = Float64.parse("1.00000000000000011102230246251565404236316680908203125") else { return }
    // Halfway between 1.0 + 2^-52 (odd LSB 1) and 1.0 + 2 * 2^-52: rounds up to even.
    h_odd: Float64 = Float64.parse("1.00000000000000033306690738754696212708950042724609375") else { return }
    // Halfway between 0.0 and MIN_SUBNORMAL (2^-1075): rounds to even 0.0.
    sub_even: Float64 = Float64.parse("2.47032822920623272088284396434110686e-324") else { return }
    // Halfway between MIN_SUBNORMAL (odd) and 2 * MIN_SUBNORMAL: rounds up to 2 * MIN_SUBNORMAL.
    sub_odd: Float64 = Float64.parse("7.41098468761869816264853189302332059e-324") else { return }
    neg_z: Float64 = Float64.parse("-0") else { return }
    inf_p: Float64 = Float64.parse("inf") else { return }
    inf_n: Float64 = Float64.parse("-inf") else { return }
    nan_v: Float64 = Float64.parse("nan") else { return }
    print_line($"{h_even.hex()} {h_odd.hex()} {sub_even.hex()} {sub_odd.hex()} {neg_z.hex()} {inf_p.hex()} {inf_n.hex()} {nan_v.is_nan()}")

    f32: Float32 = Float32.parse("1.0") else { return }
    f16: Float16 = Float16.parse("1.0") else { return }
    print($"{f32.hex()} {f16.hex()} ")
    if Float16.parse("65520.0") -> _: Float16 { return } else -> e5: ParseError { print($"{e5} ") }
    if Float64.parse(".") -> _: Float64 { return } else -> e6: ParseError { print_line($"{e6}") }
}
