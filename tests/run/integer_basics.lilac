// expect-stdout: Less Equal Greater true true true false true Greater Less
// expect-stdout: 0 1 127 128 0 255
// expect-stdout: -1 0 1 0 1
// expect-stdout: -128 127 0 10 0 255
// expect-stdout: false true true false false true true false
// expect-stdout: 1 1 1 64 none 1 1 128 none
// expect-stdout: 42 7
// Integer basics and `Ordering` (math plan phase 3): `compare`, `abs`,
// `unsigned_abs`, `sign`, `min`, `max`, `clamp`, `is_power_of_two` and
// `next_power_of_two`, at boundary values (`MIN`, `MAX`, 0, ±1, powers of
// two) and in global initializers.

using Standard
using Standard.Io

const_abs: Int32 = (-42 as Int32).abs()
const_clamped: Int32 = (100 as Int32).clamp(0, 7)

main: function () nothing {
    a: Int32 = -5
    b: Int32 = 5
    lt: Ordering = a.compare(b)
    eq: Ordering = b.compare(5)
    gt: Ordering = b.compare(a)
    print_line($"{lt} {eq} {gt} {lt.is_less()} {eq.is_equal()} {gt.is_greater()} {gt.is_less_or_equal()} {eq.is_greater_or_equal()} {lt.reverse()} {eq.and_then(lt)}")

    z: Int8 = 0
    neg_one: Int8 = -1
    print_line($"{z.abs()} {neg_one.abs()} {Int8.MAX.abs()} {Int8.MIN.unsigned_abs()} {(0 as Uint8).unsigned_abs()} {Uint8.MAX.abs()}")

    print_line($"{Int64.MIN.sign()} {(0 as Int64).sign()} {Int64.MAX.sign()} {(0 as Uint64).sign()} {Uint64.MAX.sign()}")

    print_line($"{Int8.MIN.min(Int8.MAX)} {Int8.MIN.max(Int8.MAX)} {(-50 as Int8).clamp(0, 10)} {(50 as Int8).clamp(0, 10)} {Uint8.MIN.min(Uint8.MAX)} {Uint8.MIN.max(Uint8.MAX)}")

    print_line($"{Int8.MIN.is_power_of_two()} {(1 as Int8).is_power_of_two()} {(64 as Int8).is_power_of_two()} {(0 as Int8).is_power_of_two()} {(0 as Uint8).is_power_of_two()} {(1 as Uint8).is_power_of_two()} {(128 as Uint8).is_power_of_two()} {Uint8.MAX.is_power_of_two()}")

    p0: Int8 = (-5 as Int8).next_power_of_two() else { return }
    p1: Int8 = (0 as Int8).next_power_of_two() else { return }
    p2: Int8 = (1 as Int8).next_power_of_two() else { return }
    p3: Int8 = (33 as Int8).next_power_of_two() else { return }
    u0: Uint8 = (0 as Uint8).next_power_of_two() else { return }
    u1: Uint8 = (1 as Uint8).next_power_of_two() else { return }
    u2: Uint8 = (128 as Uint8).next_power_of_two() else { return }
    print($"{p0} {p1} {p2} {p3} ")
    if (65 as Int8).next_power_of_two() -> v: Int8 { print($"{v} ") } else { print("none ") }
    print($"{u0} {u1} {u2} ")
    if (129 as Uint8).next_power_of_two() -> v: Uint8 { print_line($"{v}") } else { print_line("none") }

    print_line($"{const_abs} {const_clamped}")
}
