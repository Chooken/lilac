// expect-stdout: id 7
// expect-stdout: make 9
// expect-stdout: get 9
// expect-stdout: pick 2
// expect-stdout: convert 5
// expect-stdout: table 7 9 9 2 5
// expect-stdout: generic 3 4
// expect-stdout: same 1
// expect-stdout: picker 6
// Generic instances as function values: `ref f[A]`, `ref Type[A].f`,
// `ref Type.f[B]`, `ref Type[A].f[B]` and, in a type's body, its own
// static `ref f[B]` each name one instance. They are ordinary function
// references: called directly, kept in a global table, and named from
// inside a generic body at its parameter.

using Standard.Io

id[T]: function (value: T) out: T {
    out = value
}

Box[T]: object {
    value: T

    make: function (value: T) out: Box[T] {
        out = Box[T] { value = value }
    }

    get: function (self) out: T {
        out = self.value
    }

    convert[U]: function (self, extra: U) out: U {
        out = extra
    }
}

Plain: object {
    pick[T]: function (first: T, second: T) out: T {
        out = second
    }

    // A type's own static function, named bare in its body.
    picker: function () out: ref function (first: @bit8, second: @bit8) @bit8 {
        out = ref pick[@bit8]
    }
}

Table: object {
    id: ref function (value: @bit32) @bit32
    make: ref function (value: @bit8) Box[@bit8]
    get: ref function (self: ref Box[@bit8]) @bit8
    pick: ref function (first: @bit8, second: @bit8) @bit8
    convert: ref function (self: ref Box[@bit8], extra: @bit32) @bit32
}

TABLE: Table = Table {
    id = ref id[@bit32]
    make = ref Box[@bit8].make
    get = ref Box[@bit8].get
    pick = ref Plain.pick[@bit8]
    convert = ref Box[@bit8].convert[@bit32]
}

// From a generic body: the instance at `T`, requested per instance.
apply[T]: function (value: T) out: T {
    f: ref function (value: T) T = ref id[T]
    out = f(value)
}

main: function () nothing {
    f: ref function (value: @bit32) @bit32 = ref id[@bit32]
    print_line($"id {f(0x7)}")
    make: ref function (value: @bit8) Box[@bit8] = ref Box[@bit8].make
    box: Box[@bit8] = make(0x9)
    print_line($"make {box.value}")
    get: ref function (self: ref Box[@bit8]) @bit8 = ref Box[@bit8].get
    print_line($"get {get(ref box)}")
    pick: ref function (first: @bit8, second: @bit8) @bit8 = ref Plain.pick[@bit8]
    print_line($"pick {pick(0x1, 0x2)}")
    convert: ref function (self: ref Box[@bit8], extra: @bit32) @bit32 = ref Box[@bit8].convert[@bit32]
    print_line($"convert {convert(ref box, 0x5)}")
    stored: Box[@bit8] = TABLE.make(0x9)
    print_line($"table {TABLE.id(0x7)} {stored.value} {TABLE.get(ref stored)} {TABLE.pick(0x1, 0x2)} {TABLE.convert(ref stored, 0x5)}")
    print_line($"generic {apply[@bit32](0x3)} {apply[@bit8](0x4)}")
    same: @bit8 = if TABLE.id == f then 0x1 else 0x0
    print_line($"same {same}")
    picker: ref function (first: @bit8, second: @bit8) @bit8 = Plain.picker()
    print_line($"picker {picker(0x5, 0x6)}")
}
