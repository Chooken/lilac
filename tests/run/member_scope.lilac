// expect-stdout: 7 14 8 limit 7
// expect-stdout: 4 1 2
// expect-stdout: 5 99 11 106
// Inside a type's bodies (methods, hooks, member constants), its own
// constants and static functions are bare names. They come after locals
// and before the file's items, and in a generic type a bare static is the
// current instance's.

using Standard
using Standard.Io

LIMIT: @bit32 => 0x63

twice: function (x: @bit32) @bit32 => 0x0

Box: object {
    LIMIT: @bit32 => 0x7
    DOUBLE: @bit32 => twice(LIMIT)
    STEP: ref function (@bit32) @bit32 => ref next
    value: @bit32

    twice: function (x: @bit32) @bit32 => @i_add_32(x, x)
    next: function (x: @bit32) @bit32 => @i_add_32(x, 0x1)
    make: function () box: Box {
        box = Box { value = LIMIT }
    }

    stepped: function (self) @bit32 => STEP(self.value)
    shadowed: function (self) result: @bit32 {
        LIMIT: @bit32 = 0x5
        result = LIMIT
    }
    through_ref: function (self) result: @bit32 {
        f: ref function (@bit32) @bit32 = ref twice
        result = f(0x4)
    }

    @format: function (self, out: ref Formatter) nothing {
        if self.value == LIMIT {
            out.write("limit")
        } else {
            out.write("other")
        }
    }
}

Sized[T]: object {
    item: T

    size: function () Int => @size_of(T)
    get_size: function (self) Int => size()
}

Outer: object {
    inner: function () @bit32 => @i_add_32(LIMIT, Box.LIMIT)
}

show: function (value: @bit32) Int32 => value

main: function () nothing {
    box: Box = Box.make()
    print($"{show(box.value)} {show(Box.DOUBLE)} {show(box.stepped())} {box} {show(Box.LIMIT)}\n")
    small: Sized[@bit8] = Sized[@bit8] { item = 0x1 }
    wide: Sized[@bit32] = Sized[@bit32] { item = 0x1 }
    print($"{wide.get_size()} {small.get_size()} {Sized[@bit16].size()}\n")
    print($"{show(box.shadowed())} {show(LIMIT)} {show(@i_add_32(box.through_ref(), 0x3))} {show(Outer.inner())}\n")
}
