// expect-stdout: Hello, world
// expect-stdout: é!
// expect-exit: 5
// Standard.Io, Standard.Process and Box (over Standard.Heap.Allocator),
// with no C library.

using Standard
using Standard.Io
using Standard.Process

Noisy: structure {
    char: @bit32

    // The box drops its value once, at the end of the block (`Box.new`
    // moves it onto the heap, so nothing drops early).
    @on_drop: function (self) nothing {
        print($"{self.char as Scalar}")
    }
}

main: function () nothing {
    print("Hello, ")
    print_line("world")
    print_error_line("to stderr")
    {
        b: Box[Noisy] = Box[Noisy].new(Noisy { char = 0xE9 })
    }
    print_line("!")
    exit(0x5)
}
