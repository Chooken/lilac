// expect-stdout: kl||nr
// expect-stdout: kl|r
// expect-stdout: |lr
// A field moves out of an object with no `@on_drop` of its own: the rest
// of it still drops, setting the field again makes it whole, and a field
// moved on one branch only drops once either way.

using Standard
using Standard.Io

Leaf: object {
    c: @bit32

    @on_drop: function (self) nothing {
        print_char(self.c)
    }
}

Pair: object {
    left: Leaf
    right: Leaf
}

keep: function (leaf: Leaf) nothing {
    print_char('k')
}

whole_again: function () nothing {
    pair: Pair = Pair { left = Leaf { c = 'l' }, right = Leaf { c = 'r' } }
    keep(pair.left)
    print_char('|')
    pair.left = Leaf { c = 'n' }
    print_char('|')
}

maybe_keep: function (give: Bool) nothing {
    pair: Pair = Pair { left = Leaf { c = 'l' }, right = Leaf { c = 'r' } }
    if give {
        keep(pair.left)
    }
    print_char('|')
}

main: function () nothing {
    whole_again()
    print_char(0xA)
    maybe_keep(true)
    print_char(0xA)
    maybe_keep(false)
    print_char(0xA)
}
