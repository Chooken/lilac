// pending: robustness plan phase 2 (the layout overflows instead of reporting)
// expect-error: E067
// An object larger than the target allows (`isize::MAX` bytes) is an
// error, not an overflow.

using Standard.Process

Big: object {
    a: @array(@array(@bit64, 0xFFFFFFFF), 0xFFFFFFFF)
}

main: function () nothing {
    n: @bit_native = @size_of(Big)
    exit(@truncate(n))
}
