// expect-exit: 31

using Standard.Process

// `continue` jumps to the loop head, which re-tests a `loop if` condition,
// and only ever affects the innermost loop.
main: function () nothing {
    // The odd numbers up to 9: 1 + 3 + 5 + 7 + 9 = 25.
    sum: @bit32 = 0x0
    i: @bit32 = 0x0
    loop if @i_less_than_32(i, 0xa) {
        i = @i_add_32(i, 0x1)
        if @i_less_than_u_32(@i_mod_u_32(i, 0x2), 0x1) {
            continue
        }
        sum = @i_add_32(sum, i)
    } else break

    // Three outer passes, each counting the inner odd `k` (1 and 3): 6.
    j: @bit32 = 0x0
    loop if @i_less_than_32(j, 0x3) {
        j = @i_add_32(j, 0x1)
        k: @bit32 = 0x0
        loop if @i_less_than_32(k, 0x3) {
            k = @i_add_32(k, 0x1)
            if @i_less_than_u_32(@i_mod_u_32(k, 0x2), 0x1) {
                continue
            }
            sum = @i_add_32(sum, 0x1)
        } else break
    } else break
    exit(sum)
}
