// expect-stdout: 7 14 42 2 4 4 7 9 14 1
// expect-stdout: 127 -128 32767 -32768 2147483647 -2147483648 9223372036854775807 -9223372036854775808
// expect-stdout: 9223372036854775807 -9223372036854775808 7fffffffffffffff
// A constant declared in a type's body is named through the type
// (`Box.LIMIT`, `Int.MAX`): one value for every instance of a generic
// (`Gen.SIZE` is `Gen[@bit8].SIZE`), private ones only from the type, and
// a type parameter's (`T.LIMIT`) resolves per instance. Enums declare them
// beside their variants, and they fold like top-level constants: in a
// global's initializer and in a top-level condition.

using Standard
using Standard.Io

Box: object {
    LIMIT: @bit32 => 0x7
    TWICE: @bit32 => @i_add_32(Box.LIMIT, Box.LIMIT)
    value: @bit32

    private {
        SECRET: @bit32 => 0x2A
    }

    secret: function () @bit32 => Box.SECRET
}

Color: enum {
    Red
    Green
    COUNT: @bit32 => 0x2
}

Gen[T]: object {
    SIZE: @bit32 => 0x4
    item: T
}

Wide: object {
    LIMIT: @bit32 => 0x9
}

limit_of[T]: function () @bit32 => T.LIMIT

STARTED: @bit32 = Box.TWICE

if Box.LIMIT == 0x7 {
    selected: function () @bit32 => 0x1
} else {
    selected: function () @bit32 => 0x2
}

show: function (value: @bit32) Int32 => value

main: function () nothing {
    print($"{show(Box.LIMIT)} {show(Box.TWICE)} {show(Box.secret())} {show(Color.COUNT)} ")
    print($"{show(Gen.SIZE)} {show(Gen[@bit8].SIZE)} ")
    print($"{show(limit_of[Box]())} {show(limit_of[Wide]())} {show(STARTED)} {show(selected())}\n")
    print($"{Int8.MAX} {Int8.MIN} {Int16.MAX} {Int16.MIN} {Int32.MAX} {Int32.MIN} {Int64.MAX} {Int64.MIN}\n")
    print($"{Int.MAX} {Int.MIN} {Int.MAX.hex()}\n")
}
