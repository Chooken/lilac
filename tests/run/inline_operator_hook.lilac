// expect-exit: 5

using Standard.Process

Num: object {
    data: @bit32

    @add: function (lhs: Num, rhs: Num) out: Num => Num { data = @i_add_32(lhs.data, rhs.data) }
    @conversion: function (from: Num) to: @bit32 => from.data
}

main: function () nothing {
    a: Num = Num { data = 0x2 }
    b: Num = Num { data = 0x3 }
    c: Num = a + b
    r: @bit32 = c
    exit(r)
}
