// build-arg: --stack-traces=off
// expect-exit: 101
// expect-stderr: panic: Freed memory that was already freed.
// expect-stderr:   at Standard.Heap.GeneralAllocator.free_small (Standard/Heap/general_allocator.lilac:331:21)
// expect-stderr:   (stack trace disabled; build with --stack-traces=on)
// A Debug `GeneralAllocator` panics on a second free of a slot.

using Standard
using Standard.Heap

main: function () nothing {
    general: GeneralAllocator = GeneralAllocator.init()
    memory: ref unknown = general.allocate_raw(24, 8)
    general.free_raw(memory, 24, 8)
    general.free_raw(memory, 24, 8)
}
