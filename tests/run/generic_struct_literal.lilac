// expect-exit: 4
// lib: Standard=lib/Standard

using Standard.Process

Box[T]: object {
    value: T

    make: function (v: T) out: Box[T] {
        out = Box[T] { value = v }
    }
}

main: function () nothing {
    a: Box[@bit32] = Box[@bit32] { value = 0x1 }
    b: Box[@bit32] = Box[@bit32].make(0x3)
    exit(@i_add_32(a.value, b.value))
}
