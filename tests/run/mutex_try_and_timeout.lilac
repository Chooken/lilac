// expect-stdout: done
// `Sync.Mutex`'s non-blocking and timed locks: `try_lock` fails while the
// mutex is held, even by the same thread; `lock_timeout` from another
// thread gives up only once its time has passed, and succeeds when the
// holder unlocks in time; `get_unlocked` and `into_inner` reach the value
// with no lock. Exits with the number of the first failed check.

using Standard
using Standard.Io
using Standard.Process
using Standard.Os as Os
using Standard.Sync as Sync

shared: Sync.Mutex[Int] = Sync.Mutex[Int].new(7)

millisecond: @bit64 => 0xF4240

check: function (ok: Bool, code: @bit32) nothing {
    if ok {
    } else {
        exit(code)
    }
}

/// Run while `main` holds `shared`: both attempts must fail, the timed
/// one no sooner than its 20 ms.
give_up: function (argument: ref unknown) nothing {
    if shared.try_lock() -> held: Sync.MutexGuard[Int] {
        exit(0x10)
    }
    start: @bit64 = Os.monotonic_nanos()
    if shared.lock_timeout(@i_mul_64(millisecond, 0x14)) -> held: Sync.MutexGuard[Int] {
        exit(0x11)
    }
    waited: @bit64 = @i_sub_64(Os.monotonic_nanos(), start)
    if @i_less_than_u_64(waited, @i_mul_64(millisecond, 0x14)) {
        exit(0x12)
    }
}

/// Run while `main` holds `shared` for a while: a long timed lock gets it
/// once `main` lets go.
wait_for_it: function (argument: ref unknown) nothing {
    if shared.lock_timeout(@i_mul_64(millisecond, 0x2710)) -> held: Sync.MutexGuard[Int] {
        held.value() += 100
    } else {
        exit(0x20)
    }
}

run: function (entry: ref Os.ThreadEntry) nothing {
    thread: Os.Thread = Os.spawn(entry, ref shared as ref unknown).get() else {
        exit(0x1)
        return
    }
    match Os.join(thread) {
        .Some => exit(0x2)
    }
}

main: function () nothing {
    // The same thread: `try_lock` on a held mutex fails, never deadlocks.
    guard: Sync.MutexGuard[Int] = shared.lock()
    if shared.try_lock() -> again: Sync.MutexGuard[Int] {
        exit(0x3)
    }
    run(ref give_up)
    guard.unlock()

    if shared.try_lock() -> held: Sync.MutexGuard[Int] {
        check(held.value() == 7 as Int, 0x4)
    } else {
        exit(0x5)
    }

    // Held when the thread starts, let go 20 ms later.
    holding: Sync.MutexGuard[Int] = shared.lock()
    thread: Os.Thread = Os.spawn(ref wait_for_it, ref shared as ref unknown).get() else {
        exit(0x6)
        return
    }
    Os.sleep(@i_mul_64(millisecond, 0x14))
    holding.unlock()
    match Os.join(thread) {
        .Some => exit(0x7)
    }
    check(shared.lock().value() == 107 as Int, 0x8)

    // Nothing else can reach a mutex that is still being set up.
    local: Sync.Mutex[Int] = Sync.Mutex[Int].new(1)
    local.get_unlocked() += 1
    check(@move(local).into_inner() == 2 as Int, 0x9)
    print_line("done")
}
