// expect-stdout: 8 2 200 127 1 1 0
// expect-stdout: folded
// expect-exit: 0
// The constant evaluator folds the hardware's numeric operations (math
// plan phase 1) to the bits the run-time operations give: each global
// below is a constant (a global that is not is `E038`), and `main`
// compares it with the same operation on parameters, which nothing
// folds. A constant `if` on a float comparison keeps only its live arm.

using Standard
using Standard.Io
using Standard.Process

check: function (ok: @bit8, code: @bit32) nothing {
    if ok {
    } else {
        exit(code)
    }
}

COUNT: @bit32 = @bit_count_ones_32(0xFF)
ROTATE: @bit8 = @bit_rotate_left_8(0x81, 0x9)
SATURATED: @bit8 = @i_add_saturating_u_8(0x64, 0x64)
SIGNED_SATURATED: @bit8 = @i_add_saturating_8(0x64, 0x64)
HIGH: @bit64 = @i_multiply_high_u_64(0x8000000000000000, 0x2)
OVERFLOWS: @bit8 = @i_mul_overflows_32(0x10000, 0x10000)
NO_OVERFLOW: @bit8 = @i_sub_overflows_u_16(0x2, 0x1)

SQRT_2: @fbit64 = @f_sqrt_64(2.0)
SQRT_2_HALF: @fbit16 = @f_sqrt_16(2.0)
SQRT_2_SINGLE: @fbit32 = @f_sqrt_32(2.0)
// `0.1 * 10 - 1` rounded once: not 0.
FUSED: @fbit64 = @f_multiply_add_64(0.1, 10.0, @f_negate_64(1.0))
FUSED_HALF: @fbit16 = @f_multiply_add_16(0.1, 10.0, @f_negate_16(1.0))
ROUND_AWAY: @fbit64 = @f_round_64(@f_negate_64(2.5))
ROUND_EVEN: @fbit64 = @f_round_even_64(@f_negate_64(2.5))
CEIL: @fbit32 = @f_ceil_32(@f_negate_32(0.5))
FLOOR: @fbit16 = @f_floor_16(@f_negate_16(0.5))
MIN_ZERO: @fbit64 = @f_min_64(0.0, @f_negate_64(0.0))
MAX_ZERO: @fbit64 = @f_max_64(@f_negate_64(0.0), 0.0)
SIGN: @fbit64 = @f_copy_sign_64(3.0, @f_negate_64(0.0))
ABS: @fbit32 = @f_abs_32(@f_negate_32(7.5))
SUM: @fbit64 = @f_add_64(@f_mul_64(0.1, 3.0), 0.2)
// Conversions: saturating and NaN to 0, rounding once, overflow to
// infinity.
TO_INT: @bit32 = @float_to_int(1e10)
TO_UINT: @bit8 = @float_to_uint(@f_negate_64(3.5))
NAN_TO_INT: @bit64 = @float_to_int(@bits_to_fbit_64(0x7FF8000000000000))
FROM_INT: @fbit64 = @int_to_float(0xFFFFFFFFFFFFFFFF)
FROM_UINT: @fbit32 = @uint_to_float(0xFFFFFFFFFFFFFFFF)
HALF_OVERFLOW: @fbit16 = @uint_to_float(0xFFFF)
NARROW: @fbit16 = @float_convert(@bits_to_fbit_64(0x3FF0020000001000))
WIDEN: @fbit64 = @float_convert(@bits_to_fbit_16(0x0001))
BITS: @bit32 = @fbit_to_bits_32(1.0)

sqrt64: function (x: @fbit64) r: @fbit64 { r = @f_sqrt_64(x) }
sqrt32: function (x: @fbit32) r: @fbit32 { r = @f_sqrt_32(x) }
sqrt16: function (x: @fbit16) r: @fbit16 { r = @f_sqrt_16(x) }
fma64: function (a: @fbit64, b: @fbit64, c: @fbit64) r: @fbit64 { r = @f_multiply_add_64(a, b, c) }
fma16: function (a: @fbit16, b: @fbit16, c: @fbit16) r: @fbit16 { r = @f_multiply_add_16(a, b, c) }
round64: function (x: @fbit64) r: @fbit64 { r = @f_round_64(x) }
round_even64: function (x: @fbit64) r: @fbit64 { r = @f_round_even_64(x) }
ceil32: function (x: @fbit32) r: @fbit32 { r = @f_ceil_32(x) }
floor16: function (x: @fbit16) r: @fbit16 { r = @f_floor_16(x) }
min64: function (a: @fbit64, b: @fbit64) r: @fbit64 { r = @f_min_64(a, b) }
max64: function (a: @fbit64, b: @fbit64) r: @fbit64 { r = @f_max_64(a, b) }
copy_sign64: function (a: @fbit64, b: @fbit64) r: @fbit64 { r = @f_copy_sign_64(a, b) }
abs32: function (x: @fbit32) r: @fbit32 { r = @f_abs_32(x) }
sum64: function (a: @fbit64, b: @fbit64, c: @fbit64) r: @fbit64 { r = @f_add_64(@f_mul_64(a, b), c) }
to_int32: function (x: @fbit64) r: @bit32 { r = @float_to_int(x) }
to_uint8: function (x: @fbit64) r: @bit8 { r = @float_to_uint(x) }
to_int64: function (x: @fbit64) r: @bit64 { r = @float_to_int(x) }
from_int64: function (x: @bit64) r: @fbit64 { r = @int_to_float(x) }
from_uint32: function (x: @bit64) r: @fbit32 { r = @uint_to_float(x) }
from_uint16: function (x: @bit16) r: @fbit16 { r = @uint_to_float(x) }
narrow: function (x: @fbit64) r: @fbit16 { r = @float_convert(x) }
widen: function (x: @fbit16) r: @fbit64 { r = @float_convert(x) }

main: function () nothing {
    print_line($"{COUNT} {@i_sub_8(ROTATE, 0x1)} {SATURATED} {SIGNED_SATURATED} {HIGH} {OVERFLOWS} {NO_OVERFLOW}")
    check(@fbit_to_bits_64(SQRT_2) == @fbit_to_bits_64(sqrt64(2.0)), 0x1)
    check(@fbit_to_bits_64(SQRT_2) == 0x3FF6A09E667F3BCD, 0x2)
    check(@fbit_to_bits_16(SQRT_2_HALF) == @fbit_to_bits_16(sqrt16(2.0)), 0x3)
    check(@fbit_to_bits_32(SQRT_2_SINGLE) == @fbit_to_bits_32(sqrt32(2.0)), 0x4)
    check(@fbit_to_bits_64(FUSED) == @fbit_to_bits_64(fma64(0.1, 10.0, @f_negate_64(1.0))), 0x5)
    check(@fbit_to_bits_64(FUSED) == 0x3C90000000000000, 0x6)
    check(@fbit_to_bits_16(FUSED_HALF) == @fbit_to_bits_16(fma16(0.1, 10.0, @f_negate_16(1.0))), 0x7)
    check(@fbit_to_bits_16(FUSED_HALF) == 0x8C00, 0x8)
    check(@fbit_to_bits_64(ROUND_AWAY) == @fbit_to_bits_64(round64(@f_negate_64(2.5))), 0x9)
    check(@fbit_to_bits_64(ROUND_EVEN) == @fbit_to_bits_64(round_even64(@f_negate_64(2.5))), 0xA)
    check(@fbit_to_bits_32(CEIL) == @fbit_to_bits_32(ceil32(@f_negate_32(0.5))), 0xB)
    check(@fbit_to_bits_32(CEIL) == 0x80000000, 0xC)
    check(@fbit_to_bits_16(FLOOR) == @fbit_to_bits_16(floor16(@f_negate_16(0.5))), 0xD)
    check(@fbit_to_bits_64(MIN_ZERO) == @fbit_to_bits_64(min64(0.0, @f_negate_64(0.0))), 0xE)
    check(@fbit_to_bits_64(MIN_ZERO) == 0x8000000000000000, 0xF)
    check(@fbit_to_bits_64(MAX_ZERO) == @fbit_to_bits_64(max64(@f_negate_64(0.0), 0.0)), 0x10)
    check(@fbit_to_bits_64(MAX_ZERO) == 0x0, 0x11)
    check(@fbit_to_bits_64(SIGN) == @fbit_to_bits_64(copy_sign64(3.0, @f_negate_64(0.0))), 0x12)
    check(@fbit_to_bits_32(ABS) == @fbit_to_bits_32(abs32(@f_negate_32(7.5))), 0x13)
    check(@fbit_to_bits_64(SUM) == @fbit_to_bits_64(sum64(0.1, 3.0, 0.2)), 0x14)
    check(TO_INT == to_int32(1e10), 0x15)
    check(TO_INT == 0x7FFFFFFF, 0x16)
    check(TO_UINT == to_uint8(@f_negate_64(3.5)), 0x17)
    check(NAN_TO_INT == to_int64(@bits_to_fbit_64(0x7FF8000000000000)), 0x18)
    check(@fbit_to_bits_64(FROM_INT) == @fbit_to_bits_64(from_int64(0xFFFFFFFFFFFFFFFF)), 0x19)
    check(@fbit_to_bits_64(FROM_INT) == 0xBFF0000000000000, 0x1A)
    check(@fbit_to_bits_32(FROM_UINT) == @fbit_to_bits_32(from_uint32(0xFFFFFFFFFFFFFFFF)), 0x1B)
    check(@fbit_to_bits_16(HALF_OVERFLOW) == @fbit_to_bits_16(from_uint16(0xFFFF)), 0x1C)
    check(@fbit_to_bits_16(HALF_OVERFLOW) == 0x7C00, 0x1D)
    check(@fbit_to_bits_16(NARROW) == @fbit_to_bits_16(narrow(@bits_to_fbit_64(0x3FF0020000001000))), 0x1E)
    check(@fbit_to_bits_16(NARROW) == 0x3C01, 0x1F)
    check(@fbit_to_bits_64(WIDEN) == @fbit_to_bits_64(widen(@bits_to_fbit_16(0x0001))), 0x20)
    check(BITS == 0x3F800000, 0x21)
    // Only the live arm of a constant condition is lowered.
    if @f_less_than_64(@f_sqrt_64(2.0), 1.5) {
        print_line("folded")
    } else {
        @compile_error("sqrt(2) folds below 1.5")
    }
}
