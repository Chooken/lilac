// expect-stdout: 250 6 200 1 4 true false
// expect-stdout: 255 65535 4294967295 18446744073709551615 0
// expect-stdout: 44 56 255 0
// expect-stdout: c8 11001000 ffffffffffffffff
// expect-stdout: 65 10
// The unsigned integer types (math plan phase 2): their operators, limits,
// wrapping methods and formats. `Byte` is `Uint8`.

using Standard
using Standard.Io

main: function () nothing {
    a: Uint8 = 200
    b: Uint8 = 50
    print_line($"{a + b} {a / 33} {a - b + b} {a % 3 - 1} {b / 12} {a > b} {a < b}")
    print_line($"{Uint8.MAX} {Uint16.MAX} {Uint32.MAX} {Uint64.MAX} {Uint.MIN}")
    print_line($"{a.wrapping_add(100)} {a.wrapping_negate()} {b.wrapping_subtract(51)} {b.wrapping_multiply(0)}")
    print_line($"{a.hex()} {a.binary()} {Uint64.MAX.hex()}")
    c: Byte = 0x41
    d: Uint = 10
    print_line($"{c} {d}")
}
