// expect-exit: 101
// expect-stderr: panic: division overflow
// expect-stderr:   at remainder (remainder_overflow.lilac:14:25)
// expect-stderr:   at main (remainder_overflow.lilac:18:10)
// `MIN % -1` panics like `MIN / -1`: the remainder is computed by the same
// division, which traps on x86.

using Standard.Process

minimum: @bit8 = 0x80
minus_one: @bit8 = 0xFF

remainder: function (value: @bit8) rest: @bit32 {
    rest = @extend_zero(@i_mod_8(value, minus_one))
}

main: function () nothing {
    exit(remainder(minimum))
}
