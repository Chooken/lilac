// expect-exit: 0
// `@array(T, N)`: C layout inside structures, copies, `@array_at` reads and
// writes, nested arrays and `@array_len`.

using Standard.Process

// C: `struct { uint8_t tag; uint32_t items[3]; }` is 16 bytes, aligned 4.
Small: structure {
    tag: @bit8
    items: @array(@bit32, 3)
}

// C: `struct { uint16_t a; uint64_t wide[2]; uint8_t bytes[5]; }` is 32
// bytes, aligned 8.
Wide: structure {
    a: @bit16
    wide: @array(@bit64, 2)
    bytes: @array(@bit8, 5)
}

// C: `struct { uint16_t rows[2][3]; }` is 12 bytes, aligned 2.
Grid: structure {
    rows: @array(@array(@bit16, 3), 2)
}

check: function (actual: @bit_native, want: @bit_native, code: @bit32) nothing {
    if @i_less_than_u_native(actual, want) {
        exit(code)
    }
    if @i_greater_than_u_native(actual, want) {
        exit(code)
    }
}

check32: function (actual: @bit32, want: @bit32, code: @bit32) nothing {
    check(@extend_zero(actual), @extend_zero(want), code)
}

sum: function (values: ref @array(@bit32, 3)) total: @bit32 {
    total = 0x0
    i: @bit_native = 0x0
    loop {
        if @i_less_than_u_native(i, @array_len(values)) {
            total = @i_add_32(total, @array_at(values, i))
            i = @i_add_native(i, 0x1)
        } else break
    }
}

main: function () nothing {
    check(@size_of(Small), 0x10, 0x1)
    check(@align_of(Small), 0x4, 0x2)
    check(@size_of(Wide), 0x20, 0x3)
    check(@align_of(Wide), 0x8, 0x4)
    check(@size_of(Grid), 0xc, 0x5)
    check(@align_of(Grid), 0x2, 0x6)
    check(@size_of(@array(@bit32, 3) {}), 0xc, 0x7)

    small: Small = Small { tag = 0x1, items = @array(@bit32, 3) {} }
    check32(sum(ref small.items), 0x0, 0x8)
    slot: ref @bit32 = @array_at(ref small.items, 0x0)
    slot = 0x5
    slot = @array_at(ref small.items, 0x2)
    slot = 0x7
    check32(sum(ref small.items), 0xc, 0x9)
    check(@array_len(small.items), 0x3, 0xa)

    // Copying the structure copies the array.
    copy: Small = small
    slot = @array_at(ref copy.items, 0x0)
    slot = 0x64
    check32(@array_at(ref small.items, 0x0), 0x5, 0xb)
    check32(@array_at(ref copy.items, 0x0), 0x64, 0xc)

    grid: Grid { rows = @array(@array(@bit16, 3), 2) {} }
    row: ref @array(@bit16, 3) = @array_at(ref grid.rows, 0x1)
    cell: ref @bit16 = @array_at(row, 0x2)
    cell = 0x2a
    check(@extend_zero(@array_at(@array_at(ref grid.rows, 0x1), 0x2)), 0x2a, 0xd)
    check(@extend_zero(@array_at(@array_at(ref grid.rows, 0x0), 0x2)), 0x0, 0xe)

    local: @array(@bit8, 4) {}
    byte: ref @bit8 = @array_at(ref local, 0x3)
    byte = 0xff
    check(@extend_zero(@array_at(ref local, 0x3)), 0xff, 0xf)
    exit(0x0)
}
