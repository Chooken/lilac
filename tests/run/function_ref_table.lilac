// expect-stdout: counter 3
// expect-stdout: doubler 8
// expect-stdout: counter 5
// expect-stdout: doubler 16
// An interface by hand: a context and a table of function references,
// built at run time. Each implementation's methods take their receiver
// as the first parameter (`ref Counter.add` is
// `ref function (ref Counter, @bit32) nothing`), laundered through
// `ref unknown` to the table's `ref function (ref unknown, …)` slots: a
// `ref X` slot and a `ref unknown` slot have the same representation.

using Standard.Io

Sink: object {
    context: ref unknown
    add: ref function (context: ref unknown, amount: @bit32) nothing
    total: ref function (context: ref unknown) total: @bit32
    name: @byte_buffer

    feed: function (self, amount: @bit32) nothing {
        self.add(self.context, amount)
    }

    report: function (self) nothing {
        print_line($"{self.name} {self.total(self.context)}")
    }
}

Counter: object {
    count: @bit32

    add: function (self, amount: @bit32) nothing {
        self.count = @i_add_32(self.count, 0x1)
    }

    total: function (self) total: @bit32 {
        total = self.count
    }

    sink: function (self) out: Sink {
        out = Sink {
            context = self as ref unknown
            add = ref Counter.add as ref unknown as ref function (context: ref unknown, amount: @bit32) nothing
            total = ref Counter.total as ref unknown as ref function (context: ref unknown) total: @bit32
            name = "counter"
        }
    }
}

Doubler: object {
    sum: @bit32

    add: function (self, amount: @bit32) nothing {
        self.sum = @i_add_32(self.sum, @i_mul_32(amount, 0x2))
    }

    total: function (self) total: @bit32 {
        total = self.sum
    }

    sink: function (self) out: Sink {
        out = Sink {
            context = self as ref unknown
            add = ref Doubler.add as ref unknown as ref function (context: ref unknown, amount: @bit32) nothing
            total = ref Doubler.total as ref unknown as ref function (context: ref unknown) total: @bit32
            name = "doubler"
        }
    }
}

/// Feeds every sink the same numbers, through the table only.
feed_all: function (sinks: ref @array(Sink, 2)) nothing {
    index: @bit_native = 0x0
    loop {
        if index == 0x2 { break }
        sink: ref Sink = @array_at(sinks, index)
        sink.feed(0x1)
        sink.feed(0x3)
        index = @i_add_native(index, 0x1)
    }
}

main: function () nothing {
    counter: Counter = Counter { count = 0x1 }
    doubler: Doubler = Doubler { sum = 0x0 }
    sinks: @array(Sink, 2) = @array(Sink, 2) {}
    first: ref Sink = @array_at(ref sinks, 0x0)
    first = counter.sink()
    second: ref Sink = @array_at(ref sinks, 0x1)
    second = doubler.sink()
    feed_all(ref sinks)
    first.report()
    second.report()
    feed_all(ref sinks)
    first.report()
    second.report()
}
