// pending: phase 5 (drops run only at function exit; locals are function-scoped)
// expect-stdout: dddd!

putchar: extern function (c: @bit32) result: @bit32

Noisy: object {
    tag: @bit32

    @on_drop: function (self) nothing {
        r: @bit32 = putchar('d')
    }
}

main: function () nothing {
    i: @bit32 = 0x0
    loop {
        if @i_less_than_32(i, 0x3) {
            n: Noisy = Noisy { tag = i }
            i = @i_add_32(i, 0x1)
        } else break
    }
    {
        m: Noisy = Noisy { tag = 0x9 }
    }
    r: @bit32 = putchar('!')
    r = putchar(0xA)
}
