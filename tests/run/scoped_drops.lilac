// expect-stdout: dddd!

using Standard.Io

Noisy: object {
    tag: @bit32

    @on_drop: function (self) nothing {
        print_char('d')
    }
}

main: function () nothing {
    i: @bit32 = 0x0
    loop {
        if @i_less_than_32(i, 0x3) {
            n: Noisy = Noisy { tag = i }
            i = @i_add_32(i, 0x1)
        } else break
    }
    {
        m: Noisy = Noisy { tag = 0x9 }
    }
    print_char('!')
    print_char(0xA)
}
