// expect-stdout: true false false true
// expect-stdout: false true
// expect-stdout: true false
// expect-stdout: true true false
// expect-stdout: true false
// `==` and `!=` call the operand types' exact `@eql` hook; a pair of one
// type with none compares bits, and `@mem_eql` always does.

using Standard
using Standard.Io

/// A fraction: `1/2` equals `2/4`, though their bits differ.
Fraction: structure {
    top: @bit32
    bottom: @bit32

    @eql: function (lhs: Fraction, rhs: Fraction) Bool =>
        @mem_eql(@i_mul_32(lhs.top, rhs.bottom), @i_mul_32(rhs.top, lhs.bottom))
}

/// A fraction against a whole number.
@eql: function (lhs: Fraction, rhs: @bit32) Bool => lhs == Fraction { top = rhs, bottom = 0x1 }

Point: structure {
    x: @bit32
    y: @bit32
}

same[T]: function (a: T, b: T) equal: Bool {
    equal = a == b
}

main: function () nothing {
    half: Fraction = Fraction { top = 0x1, bottom = 0x2 }
    two_quarters: Fraction = Fraction { top = 0x2, bottom = 0x4 }
    third: Fraction = Fraction { top = 0x1, bottom = 0x3 }
    print_line($"{half == two_quarters} {(half != two_quarters) as Bool} {half == third} {(half != third) as Bool}")
    print_line($"{@mem_eql(half, two_quarters) as Bool} {@mem_eql(half, half) as Bool}")
    four: Fraction = Fraction { top = 0x8, bottom = 0x2 }
    whole: @bit32 = 0x4
    print_line($"{four == whole} {four == @i_add_32(whole, 0x1)}")
    p: Point = Point { x = 0x1, y = 0x2 }
    print_line($"{same[Fraction](half, two_quarters)} {same[Point](p, p)} {same[Point](p, Point { x = 0x1, y = 0x3 })}")
    print_line($"{@has_hook(@eql, function (Fraction, Fraction) Bool) as Bool} {@has_hook(@eql, function (Point, Point) Bool) as Bool}")
}
