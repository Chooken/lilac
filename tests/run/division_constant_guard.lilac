// expect-exit: 4
// A division by a constant zero, or a constant `MIN / -1`, inside an arm a
// constant condition rules out is never compiled, so it is not `E060`; the
// live arm runs. A constant divisor that cannot panic needs no check.

using Standard.Process

quotient: function () value: @bit32 {
    if @i_less_than_u_32(0x0, 0x0) {
        value = @i_div_u_32(0x1, 0x0)
    } else if 0x0 {
        value = @i_div_32(0x80000000, 0xFFFFFFFF)
    } else {
        value = @i_div_32(0xFFFFFFF8, 0xFFFFFFFE)
    }
}

main: function () nothing {
    exit(quotient())
}
