// expect-stdout: 2 1 | 2 0 | 1 2
// Where `@is_copyable(T)` holds and is not known true, the ownership
// pass assumes `T` copies: a by-value use there copies, so a move-only
// `T` may be used twice in the arm the test rules out. Only the arm the
// test picks is compiled.

using Standard
using Standard.Io

Handle: structure {
    id: Int

    @on_drop: function (self) nothing {
    }
}

Plain: structure {
    id: Int
}

spread[T]: function (value: T) copies: Int {
    if @is_copyable(T) {
        first: T = value
        second: T = value
        copies = 2
    } else {
        only: T = value
        copies = 1
    }
}

// The test holds after it in an `and`, and in the `then` arm.
both[T]: function (value: T, x: Bool) copies: Int {
    copies = 0
    if x and @is_copyable(T) {
        first: T = value
        second: T = value
        copies = 2
    }
}

// `not t` is false only where `t` holds: the `else` arm sees it.
flipped[T]: function (value: T) copies: Int =>
    if not @is_copyable(T) then 1 else count_two[T](value, value)

count_two[T]: function (first: T, second: T) Int => 2

main: function () nothing {
    plain: Plain = Plain { id = 1 }
    print($"{spread[Plain](plain)} {spread[Handle](Handle { id = 2 })} | ")
    print($"{both[Plain](plain, true)} {both[Handle](Handle { id = 3 }, true)} | ")
    print_line($"{flipped[Handle](Handle { id = 4 })} {flipped[Plain](plain)}")
}
