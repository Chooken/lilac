// expect-exit: 1
// lib: Standard=lib/Standard

using Standard.Process

Bool: object {
    data: @bit8

    @conversion: function (from: Bool) to: @bit8 {
        to = from.data
    }
}

main: function () nothing {
    t: Bool = Bool { data = 0x1 }
    if t {
        exit(0x1)
    }
    exit(0x0)
}
