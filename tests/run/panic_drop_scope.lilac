// expect-exit: 101
// expect-stderr: panic: dropped
// expect-stderr:   at Guard.@on_drop (panic_drop_scope.lilac:9:9)
// expect-stderr:   at main (panic_drop_scope.lilac:15:1)

// A drop at the end of a scope is reported at the scope's closing `}`.
Guard: object {
    @on_drop: function (from: ref Guard) nothing {
        @panic("dropped")
    }
}

main: function () nothing {
    g: Guard = Guard {}
}
