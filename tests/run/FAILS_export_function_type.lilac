// expect-error: E028
// expect-stderr: error[E028]: `export function (@bit32) (@bit32, @bit32)` returns 2 values; C returns at most one
// A `ref export function` type is a C function's: it returns at most one value.

main: function () nothing {
    f: ref export function (x: @bit32) (a: @bit32, b: @bit32) = @address_to_ptr(0x0) as ref export function (x: @bit32) (a: @bit32, b: @bit32)
}
