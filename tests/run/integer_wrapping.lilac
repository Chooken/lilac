// expect-stdout: -128 127 -128 -2
// expect-stdout: 0 255 254 0
// expect-stdout: -9223372036854775808 0
// The `wrapping_*` methods wrap around in every build mode, so code that
// means to wrap (hashes, address arithmetic) says so; this is a Debug
// build, where `+` would panic.

using Standard
using Standard.Io

largest: Int8 = 127
smallest: Int8 = -128
top: Uint8 = 255

main: function () nothing {
    print_line($"{largest.wrapping_add(1)} {smallest.wrapping_subtract(1)} {smallest.wrapping_negate()} {largest.wrapping_multiply(2)}")
    print_line($"{top.wrapping_add(1)} {top.wrapping_multiply(1)} {top.wrapping_multiply(2)} {top.wrapping_negate().wrapping_add(top)}")
    big: Int64 = Int64.MAX
    print_line($"{big.wrapping_add(1)} {Int.MIN.wrapping_add(Int.MIN)}")
}
