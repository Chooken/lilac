// expect-error: E010
// expect-stderr: error[E010]: `@read` needs a `ref` to a known type, found `ref unknown`
// `ref unknown` has no type to move out, so the memory builtins refuse
// it: cast it to the type the memory holds first.

using Standard.Os

main: function () nothing {
    memory: ref unknown = map_pages(0x8).get() else {
        @panic("out of memory")
    }
    value: @bit64 = @read(memory)
    unmap_pages(memory, 0x8)
}
