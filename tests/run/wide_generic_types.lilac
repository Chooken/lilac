// expect-exit: 0
// Types whose written form grows 4^n while the type graph stays small:
// each of 20 distinct generic functions wraps its argument in
// `P[T, T, T, T]`, so `f20`'s argument written out is 4^19 `Empty`s. There
// is no recursion, and no type length limit: symbols name each repeat by a
// backreference (`IR_SPEC.md`, "Symbol names"), so they grow linearly, and
// the program builds in well under a second.

using Standard.Process

Empty: object {
}

P[A, B, C, D]: object {
    a: A
    b: B
    c: C
    d: D
}

f1[T]: function (x: T) nothing {
    y: P[T, T, T, T] = P {
        a = x
        b = x
        c = x
        d = x
    }
    f2[P[T, T, T, T]](y)
}

f2[T]: function (x: T) nothing {
    y: P[T, T, T, T] = P {
        a = x
        b = x
        c = x
        d = x
    }
    f3[P[T, T, T, T]](y)
}

f3[T]: function (x: T) nothing {
    y: P[T, T, T, T] = P {
        a = x
        b = x
        c = x
        d = x
    }
    f4[P[T, T, T, T]](y)
}

f4[T]: function (x: T) nothing {
    y: P[T, T, T, T] = P {
        a = x
        b = x
        c = x
        d = x
    }
    f5[P[T, T, T, T]](y)
}

