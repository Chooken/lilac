// expect-error: E072
// A hole that borrows a temporary ends with the statement, so its format
// cannot be assigned to a local that outlives it.
Out: object {}

@format: function (value: ref @bit32, out: ref Out) nothing {}

number: function () value: @bit32 {
    value = 0x1
}


main: function () nothing {
    text: @format_args(Out) = "start"
    text = $"{number()}"
}
