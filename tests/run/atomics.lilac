// expect-exit: 0
// The atomic builtins in one thread: each returns the old value and leaves
// the new one, for every operation, width and ordering form.

using Standard.Process

// Exits with `code` unless `actual` is `want`.
expect: function (actual: @bit64, want: @bit64, code: @bit32) nothing {
    if @i_less_than_u_64(actual, want) {
        exit(code)
    }
    if @i_greater_than_u_64(actual, want) {
        exit(code)
    }
}

check: function (actual: @bit32, want: @bit32, code: @bit32) nothing {
    expect(@extend_zero(actual), @extend_zero(want), code)
}

main: function () nothing {
    value: @bit32 = 0x5
    check(@atomic_load_32(ref value), 0x5, 0x1)
    @atomic_store_32(ref value, 0x7)
    check(@atomic_load_acquire_32(ref value), 0x7, 0x2)
    check(@atomic_swap_32(ref value, 0x9), 0x7, 0x3)
    check(@atomic_add_32(ref value, 0x3), 0x9, 0x4)
    check(@atomic_sub_relaxed_32(ref value, 0x2), 0xc, 0x5)
    check(@atomic_and_32(ref value, 0x6), 0xa, 0x6)
    check(@atomic_or_release_32(ref value, 0x9), 0x2, 0x7)
    check(@atomic_xor_acq_rel_32(ref value, 0x3), 0xb, 0x8)
    check(value, 0x8, 0x9)
    // Signed: -1 is below 8; unsigned: it is above.
    check(@atomic_max_32(ref value, 0xffffffff), 0x8, 0xa)
    check(value, 0x8, 0xb)
    check(@atomic_max_u_32(ref value, 0xffffffff), 0x8, 0xc)
    check(@atomic_min_32(ref value, 0x1), 0xffffffff, 0xd)
    check(value, 0xffffffff, 0xe)
    check(@atomic_min_u_acquire_32(ref value, 0x1), 0xffffffff, 0xf)
    check(value, 0x1, 0x10)
    // A failed compare-swap leaves the value; a matching one replaces it.
    check(@atomic_compare_swap_32(ref value, 0x2, 0x30), 0x1, 0x11)
    check(value, 0x1, 0x12)
    check(@atomic_compare_swap_acquire_32(ref value, 0x1, 0x30), 0x1, 0x13)
    check(value, 0x30, 0x14)
    @atomic_fence()
    @atomic_fence_acquire()
    @atomic_fence_release()
    @atomic_fence_acq_rel()

    byte: @bit8 = 0xff
    expect(@extend_zero(@atomic_add_8(ref byte, 0x1)), 0xff, 0x15)
    expect(@extend_zero(byte), 0x0, 0x16)
    @atomic_store_release_8(ref byte, 0x2a)
    expect(@extend_zero(@atomic_load_relaxed_8(ref byte)), 0x2a, 0x17)

    wide: @bit64 = 0x100000000
    expect(@atomic_add_64(ref wide, 0x1), 0x100000000, 0x18)
    expect(@atomic_compare_swap_relaxed_64(ref wide, 0x100000001, 0x2), 0x100000001, 0x19)
    expect(wide, 0x2, 0x1a)

    count: @bit_native = 0x0
    before: @bit_native = @atomic_add_native(ref count, 0x4)
    expect(@extend_zero(before), 0x0, 0x1b)
    before = @atomic_sub_native(ref count, 0x1)
    expect(@extend_zero(before), 0x4, 0x1c)
    expect(@extend_zero(@atomic_load_native(ref count)), 0x3, 0x1d)
    exit(0x0)
}
