// expect-stdout: co
// expect-exit: 1

using Standard.Io
using Standard.Process

Counted: object {
    copies: @bit32

    @on_copy: function (self) out: Counted {
        print_char('c')
        out = Counted { copies = @i_add_32(self.copies, 0x1) }
    }

    @on_override: function (prev: ref Counted, new: ref Counted) nothing {
        print_char('o')
    }
}

main: function () nothing {
    a: Counted = Counted { copies = 0x0 }
    // `a` is read again below, so this copies (a last use would move).
    b: Counted = a
    a = Counted { copies = @i_add_32(a.copies, 0x5) }
    print_char(0xA)
    exit(b.copies)
}
