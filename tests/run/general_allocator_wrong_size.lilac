// build-arg: --stack-traces=off
// expect-exit: 101
// expect-stderr: panic: Freed or resized memory this allocator did not give, or with another size or alignment.
// expect-stderr:   at Standard.Heap.slot_flag (Standard/Heap/general_allocator.lilac:664:17)
// expect-stderr:   (stack trace disabled; build with --stack-traces=on)
// A Debug `GeneralAllocator` panics on a free with a size of another class: the slot is in none of that class's slabs.

using Standard
using Standard.Heap

main: function () nothing {
    general: GeneralAllocator = GeneralAllocator.init()
    memory: ref unknown = general.allocate_raw(24, 8)
    general.free_raw(memory, 200, 8)
}
