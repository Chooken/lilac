// build-arg: --stack-traces=off
// expect-exit: 101
// expect-stderr: panic: unlocked a lock this thread does not hold
// expect-stderr:   at Standard.Sync.RawReentrantMutex.unlock (Standard/Sync/reentrant_mutex.lilac:78:17)
// expect-stderr:   (stack trace disabled; build with --stack-traces=on)
// A Debug `Sync.RawReentrantMutex` panics when a thread unlocks a lock
// another thread holds, even one it holds twice.

using Standard
using Standard.Process
using Standard.Os as Os
using Standard.Sync as Sync

lock: Sync.RawReentrantMutex

release: function (argument: ref unknown) nothing {
    lock.unlock()
}

main: function () nothing {
    lock.lock()
    lock.lock()
    thread: Os.Thread = Os.spawn(ref release, ref lock as ref unknown).get() else {
        exit(0x1)
        return
    }
    match Os.join(thread) {
        .Some => exit(0x2)
    }
}
