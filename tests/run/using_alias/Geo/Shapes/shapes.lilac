UNIT: @bit32 => 0x1

Square: structure {
    side: @bit32
    perimeter: function (self) n: @bit32 => @i_mul_32(self.side, 0x4)
}

Pair[T]: structure {
    a: T
    b: T
}

Shape: either {
    Dot
    Circle: @bit32
}

area: function (square: Square) n: @bit32 => @i_mul_32(square.side, square.side)
