// expect-stdout: 3 -4 -4 3 4 -3 -3 4
// expect-stdout: 3 4 128 255 0
// expect-stdout: 1 3 -2 1 -1 3 2 1 127
// expect-stdout: -3 -1 3 1
// expect-stdout: 6 0 18 16 128 0 12 36 0 64
// Integer division methods (math plan phase 3): `div_floor`, `div_ceil`,
// `div_euclid`, `rem_euclid`, `div_rem`, `gcd` and `lcm`.

using Standard
using Standard.Io

main: function () nothing {
    p: Int32 = 7
    n: Int32 = -7
    print_line($"{p.div_floor(2)} {n.div_floor(2)} {p.div_floor(-2)} {n.div_floor(-2)} {p.div_ceil(2)} {n.div_ceil(2)} {p.div_ceil(-2)} {n.div_ceil(-2)}")

    u: Uint8 = 7
    print_line($"{u.div_floor(2)} {u.div_ceil(2)} {Uint8.MAX.div_ceil(2)} {Uint8.MAX.div_ceil(1)} {(0 as Uint8).div_ceil(5)}")

    print_line($"{p.div_euclid(4)} {p.rem_euclid(4)} {n.div_euclid(4)} {n.rem_euclid(4)} {p.div_euclid(-4)} {p.rem_euclid(-4)} {n.div_euclid(-4)} {n.rem_euclid(-4)} {(-1 as Int8).rem_euclid(Int8.MIN)}")

    q: Int32, r: Int32 = n.div_rem(2)
    uq: Uint32, ur: Uint32 = (7 as Uint32).div_rem(2)
    print_line($"{q} {r} {uq} {ur}")

    print_line($"{(-12 as Int32).gcd(18)} {(0 as Int32).gcd(0)} {(0 as Int32).gcd(-18)} {Int8.MIN.gcd(48)} {(128 as Uint8).gcd(0)} {(0 as Int32).lcm(18)} {(-4 as Int32).lcm(6)} {(12 as Uint32).lcm(18)} {(18 as Int32).lcm(0)} {(-64 as Int8).lcm(2)}")
}
