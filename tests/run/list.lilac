// expect-stdout: [zabcd]z[abcd]bc[ad]++ef[adef]f|de[a]a
// expect-stdout: [0, 0, 0] 1..3
// A `List` moves its elements: `add`, `insert` and `pop` run no hook, and
// shifting (`insert`, `remove`, `remove_range`, growing past 4) moves
// bytes. `add_slice` copies through `@on_copy` (each `+`), leaving the
// slice's own elements, which drop separately. Each element drops exactly
// once: at `remove`, `remove_range`, the popped value's end, or the
// list's own drop. A `Slice` and a `Range` format.

using Standard
using Standard.Io
using Standard.Heap
using Standard.Collections

Leaf: object {
    c: @bit32

    @on_copy: function (self) copy: Leaf {
        print_char('+')
        copy = Leaf { c = self.c }
    }

    @on_drop: function (self) nothing {
        print_char(self.c)
    }
}

show: function (list: ref List[Leaf]) nothing {
    print_char('[')
    index: Int = 0
    loop if index < list.get_count() {
        print_char(list.get(index).c)
        index += 1
    } else break
    print_char(']')
}

main: function () nothing {
    {
        list: List[Leaf] = List[Leaf].init()
        list.add(Leaf { c = 'a' })
        list.add(Leaf { c = 'c' })
        list.insert(1, Leaf { c = 'b' })
        list.insert(3, Leaf { c = 'd' })
        list.insert(0, Leaf { c = 'z' })
        show(ref list)
        list.remove(0)
        show(ref list)
        list.remove_range(Range.of(1, 3))
        show(ref list)

        slots: Slice[Leaf] = get_default_allocator().allocate[Leaf](2)
        @write(slots.get(0), Leaf { c = 'e' })
        @write(slots.get(1), Leaf { c = 'f' })
        list.add_slice(slots)
        @drop(slots.get(0))
        @drop(slots.get(1))
        get_default_allocator().deallocate[Leaf](slots)
        show(ref list)

        {
            popped: Optional[Leaf] = list.pop()
        }
        print_char('|')
        list.remove_range(Range.of(3, 1))
        list.remove_range(Range.of(1, 1))
        list.trim()
        show(ref list)
    }
    print_char(0xA)

    ints: Slice[Int] = get_default_allocator().allocate[Int](3)
    print_line($"{ints} {Range.of(1, 3)}")
    get_default_allocator().deallocate[Int](ints)
}
