// expect-stdout: written
// expect-exit: 0
// The portable `Standard.Os` with no C library: writing a stream, a file's
// whole life (create, write, reopen, size, seek, read, end of file,
// close), a missing file, the clocks and sleep, random bytes, the
// heap's `reallocate` and pages. Exits with the number of the first
// failed check.

using Standard
using Standard.Process
using Standard.Os as Os

check: function (ok: Bool, code: @bit32) nothing {
    if ok {
    } else {
        exit(code)
    }
}

// The value of an `Ok`, else exits with `code`.
value_of: function (result: Result[@bit_native, Os.Error], code: @bit32) value: @bit_native {
    if result.get() -> got: @bit_native {
        value = got
    } else {
        exit(code)
        // `exit` does not return.
        @trap()
    }
}

value_of_64: function (result: Result[@bit64, Os.Error], code: @bit32) value: @bit64 {
    if result.get() -> got: @bit64 {
        value = got
    } else {
        exit(code)
        // `exit` does not return.
        @trap()
    }
}

handle_of: function (result: Result[Os.Handle, Os.Error], code: @bit32) handle: Os.Handle {
    if result.get() -> got: Os.Handle {
        handle = got
    } else {
        exit(code)
        // `exit` does not return.
        @trap()
    }
}

text_ptr: function (text: @byte_buffer) ref unknown => @byte_buffer_ptr(text) as ref unknown

// Exits with `code` when `error` holds one.
check_none: function (error: Optional[Os.Error], code: @bit32) nothing {
    match error {
        .Some => exit(code)
    }
}

nonzero: function (value: @bit64) Bool => @i_greater_than_u_64(value, 0x0)

streams: function () nothing {
    text: @byte_buffer = "written\n"
    written: @bit_native = value_of(Os.write(Os.standard_output(), text_ptr(text), @byte_buffer_len(text)), 0x1)
    check(written == 0x8, 0x2)
}

files: function () nothing {
    name: @byte_buffer = "os_layer.tmp"
    file: Os.Handle = handle_of(Os.open(name, .Write), 0x10)
    content: @byte_buffer = "abcdef"
    check(value_of(Os.write(file, text_ptr(content), 0x6), 0x11) == 0x6, 0x12)
    check_none(Os.close(file), 0x13)

    file = handle_of(Os.open(name, .Read), 0x14)
    check(value_of_64(Os.size(file), 0x15) == 0x6, 0x16)
    check(value_of_64(Os.seek(file, 0x2, .Start), 0x17) == 0x2, 0x18)
    buffer: @array(@bit8, 8) = @array(@bit8, 8) {}
    into: ref @array(@bit8, 8) = ref buffer
    check(value_of(Os.read(file, into as ref unknown, 0x8), 0x19) == 0x4, 0x1A)
    check(@array_at(into, 0x0) == 0x63, 0x1B)
    check(@array_at(into, 0x3) == 0x66, 0x1C)
    check(value_of(Os.read(file, into as ref unknown, 0x8), 0x1D) == 0x0, 0x1E)
    check_none(Os.close(file), 0x1F)

    missing: Result[Os.Handle, Os.Error] = Os.open("os_layer.missing", .Read)
    why: Os.Error = missing.error() else {
        exit(0x20)
        return
    }
    match why {
        .NotFound => {
        }
    } else {
        exit(0x21)
    }
}

clocks: function () nothing {
    start: @bit64 = Os.monotonic_nanos()
    Os.sleep(0x1E8480)
    elapsed: @bit64 = @i_sub_64(Os.monotonic_nanos(), start)
    // At least the 2 ms slept.
    check(@i_greater_than_or_equal_u_64(elapsed, 0x1E8480), 0x30)
    // After 2020.
    check(@i_greater_than_u_64(Os.wall_clock_nanos(), 0x16345785D8A00000), 0x31)
}

random: function () nothing {
    bytes: @array(@bit64, 4) = @array(@bit64, 4) {}
    into: ref @array(@bit64, 4) = ref bytes
    Os.fill_random(into as ref unknown, 0x20)
    any: @bit64 = @bit_or_64(@bit_or_64(@array_at(into, 0x0), @array_at(into, 0x1)), @bit_or_64(@array_at(into, 0x2), @array_at(into, 0x3)))
    check(nonzero(any), 0x40)
}

heap: function () nothing {
    memory: ref unknown = Os.allocate(0x10).get() else {
        exit(0x50)
        return
    }
    bytes: ref @bit8 = memory as ref @bit8
    @store_u8(bytes, 0xF, 0x2A)
    grown: ref unknown = Os.reallocate(memory, 0x10000).get() else {
        exit(0x51)
        return
    }

    check(@load_u8(grown as ref @bit8, 0xF) == 0x2A, 0x52)
    @store_u8(grown as ref @bit8, 0xFFFF, 0x1)
    Os.deallocate(grown)

    // Whole pages, zeroed, and the error for a size no address space has.
    size: @bit_native = Os.page_size()
    pages: ref unknown = Os.map_pages(size).get() else {
        exit(0x53)
        return
    }
    check(@load_u8(pages as ref @bit8, @i_sub_native(size, 0x1)) == 0x0, 0x54)
    @store_u8(pages as ref @bit8, 0x0, 0x1)
    match Os.unmap_pages(pages, size) {
        .Some => exit(0x55)
    }
    match Os.map_pages(0x4000000000000000) {
        .Ok => exit(0x56)
    }
}

main: function () nothing {
    streams()
    files()
    clocks()
    random()
    heap()
}
