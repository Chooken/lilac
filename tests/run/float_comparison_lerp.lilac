// expect-stdout: 0 true 1 false false true
// expect-stdout: true true false false false
// expect-stdout: Less Less Less Less Less Less Less Equal
// expect-stdout: Equal Less Greater none
// expect-stdout: 3ff0000000000000 4024000000000000 4016000000000000 0 true
// expect-stdout: 3fe0000000000000 4049000000000000 0 3fe0000000000000 3ff0000000000000
// Float comparison and interpolation (math plan phase 4): `equals`,
// `approximately_equals`, `total_compare`, `compare`, `lerp`,
// `inverse_lerp`, `remap` and `smooth_step`.

using Standard
using Standard.Io

main: function () nothing {
    pos_zero: Float64 = 0.0
    neg_zero: Float64 = -0.0
    nan: Float64 = Float64.NAN
    neg_nan: Float64 = (-1.0 as Float64).copy_sign(nan)
    neg_nan = nan.copy_sign(-1.0)
    print_line($"{pos_zero == neg_zero} {pos_zero.equals(neg_zero)} {nan == nan} {nan.equals(nan)} {(1.0 as Float64).equals(2.0)} {Float64.INFINITY.equals(Float64.INFINITY)}")

    a: Float64 = 1.0
    b: Float64 = 1.000000001
    print_line($"{a.approximately_equals(b, 0.000001, 0.0)} {pos_zero.approximately_equals(neg_zero, 0.0, 0.0)} {a.approximately_equals(2.0, 0.001, 0.001)} {a.approximately_equals(Float64.INFINITY, 0.1, 0.1)} {a.approximately_equals(nan, 1.0, 1.0)}")

    min_sub: Float64 = Float64.MIN_SUBNORMAL
    print_line($"{neg_nan.total_compare(Float64.NEG_INFINITY)} {Float64.NEG_INFINITY.total_compare(-1.0)} {(-1.0 as Float64).total_compare(-min_sub)} {(-min_sub).total_compare(neg_zero)} {neg_zero.total_compare(pos_zero)} {pos_zero.total_compare(min_sub)} {Float64.MAX.total_compare(Float64.INFINITY)} {nan.total_compare(nan)}")

    c0: Ordering = pos_zero.compare(neg_zero) else { return }
    c1: Ordering = (-1.0 as Float64).compare(1.0) else { return }
    c2: Ordering = (2.0 as Float64).compare(1.0) else { return }
    print($"{c0} {c1} {c2} ")
    if nan.compare(1.0) -> ord: Ordering { print_line($"{ord}") } else { print_line("none") }

    ten: Float64 = 10.0
    neg_five: Float64 = -5.0
    five: Float64 = 5.0
    print_line($"{a.lerp(ten, 0.0).hex()} {a.lerp(ten, 1.0).hex()} {a.lerp(ten, 0.5).hex()} {neg_five.lerp(five, 0.5).hex()} {a.lerp(ten, nan).is_nan()}")

    print_line($"{(5.0 as Float64).inverse_lerp(0.0, 10.0).hex()} {(5.0 as Float64).remap(0.0, 10.0, 0.0, 100.0).hex()} {(-1.0 as Float64).smooth_step(0.0, 10.0).hex()} {(5.0 as Float64).smooth_step(0.0, 10.0).hex()} {(20.0 as Float64).smooth_step(0.0, 10.0).hex()}")
}
