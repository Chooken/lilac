// The instruction builtins: `@ptr_add`/`@ptr_to_address`/`@address_to_ptr`
// are `bitcast`s around an `i.add`, `@align_of` is a constant,
// `@memmove`/`@memset` call their leaves, and `@trap` is the abort leaf
// followed by `unreachable`.

Pair: object {
    low: @bit64
    high: @bit64
}

main: function () nothing {
    pair: Pair = Pair { low = 0x0706050403020100, high = 0x0 }
    base: ref unknown = ref pair as ref unknown
    @memmove(@ptr_add(base, 0x2), base, 0x8)
    @memset(base, 0x0, @align_of(Pair))
    address: @bit_native = @ptr_to_address(base)
    again: ref unknown = @address_to_ptr(address)
    if @i_less_than_u_native(@ptr_to_address(again), address) {
        @trap()
    }
}
