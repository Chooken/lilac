lilac_ir = "0.2"
target = "x86_64-unknown-none"
type #Number {
    tag: #bit8,
}
function @main
{
  $l.3:
    alloca #Number %number : zeroed
    alloca #Number %tmp.1 : zeroed
    &1: #bit8 = const 0x0
    copy &1 -> %tmp.1.tag  // idx 0
    copy %tmp.1 -> %number
    &2: #bit8 = field %number .tag  // idx 0
    &3: #bit8 = const 0x0
    &4: #bit8 = cmp.eql &2, &3
    branch.if &4, $l.4, $l.5
  $l.4:
    branch $l.1
  $l.5:
    &5: #bit8 = field %number .tag  // idx 0
    &6: #bit8 = const 0x1
    &7: #bit8 = cmp.eql &5, &6
    branch.if &7, $l.6, $l.2
  $l.6:
    branch $l.1
  $l.2:
    branch $l.1
  $l.1:
    return
}
