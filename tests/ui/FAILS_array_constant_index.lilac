// A constant `@array_at` index past the end is `E037`, even in a function
// nothing calls; an arm a constant condition rules out is not checked.

fourth: function (values: ref @array(@bit32, 4)) value: @bit32 {
    value = @array_at(values, 0x4)
}

never_called: function (values: ref @array(@bit32, 4)) value: @bit32 {
    value = fourth(values)
}

guarded: function (values: ref @array(@bit32, 4)) nothing {
    if @i_greater_than_u_native(@array_len(values), 0x4) {
        fifth: @bit32 = @array_at(values, 0x4)
    }
}

main: function () nothing {
    values: @array(@bit32, 4) {}
    guarded(ref values)
}
