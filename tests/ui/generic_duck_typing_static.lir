lilac_ir = "0.5"
target = "x86_64-unknown-none"
function @Object.get
  out #bit32 %result
{
  $entry:
    zero %result
    &1: #bit32 = const 0x2
    copy &1 -> %result
    return
}
function @main
{
  $entry:
    alloca #bit32 %result : zeroed
    alloca #bit32 %tmp.1 : zeroed
    call @.root.gen[6Object] (in) (out %tmp.1)
    copy %tmp.1 -> %result
    return
}
function @.root.gen[6Object]
  out #bit32 %out
{
  $entry:
    alloca #bit32 %tmp.1 : zeroed
    zero %out
    call @Object.get (in) (out %tmp.1)
    copy %tmp.1 -> %out
    return
}
