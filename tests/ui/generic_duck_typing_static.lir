lilac_ir = "0.2"
target = "x86_64-unknown-none"
type #Object {
}
function @Object.get
  out #bit32 %result
{
  $entry:
    &1: #bit32 = const 0x2
    copy &1 -> %result
    return
}
function @gen__1__Object
  out #bit32 %out
{
  $entry:
    alloca #bit32 %tmp.1 : zeroed
    &cf.1: #bit32 = const 0x2
    copy &cf.1 -> %tmp.1
    copy %tmp.1 -> %out
    return
}
function @main
{
  $entry:
    alloca #bit32 %result : zeroed
    alloca #bit32 %tmp.1 : zeroed
    &cf.2: #bit32 = const 0x2
    copy &cf.2 -> %tmp.1
    copy %tmp.1 -> %result
    return
}
