lilac_ir = "0.3"
target = "x86_64-unknown-none"
!c0: str = "hi
"
extern @write
  in #bit32 %fd
  in ref #bit8 %buf
  in #bit_native %n
  out #bit_native %result
function @main
{
  $entry:
    alloca #byte_buffer %s : zeroed
    alloca #bit_native %n : zeroed
    alloca #bit_native %tmp.1 : zeroed
    alloca #bit32 %tmp.2 : zeroed
    alloca ref #bit8 %tmp.3 : zeroed
    alloca ref #bit8 %tmp.4 : zeroed
    alloca #bit_native %tmp.5 : zeroed
    alloca #bit_native %tmp.6 : zeroed
    &1: #byte_buffer = const !c0
    copy &1 -> %s
    &2: #bit32 = const 0x1
    copy &2 -> %tmp.2
    call @.lilac.byte_buffer_ptr (in %s) (out %tmp.3)
    &3: ref #bit8 = copy %tmp.3
    copy &3 -> %tmp.4
    &cf.1: #bit_native = const 0x3
    copy &cf.1 -> %tmp.5
    &4: #bit_native = copy %tmp.5
    copy &4 -> %tmp.6
    call @write (in %tmp.2, %tmp.4, %tmp.6) (out %tmp.1)
    copy %tmp.1 -> %n
    return
}
function @.lilac.byte_buffer_ptr
  in #byte_buffer %buffer
  out ref #bit8 %out
{
  $entry:
    &r: ref #bit8 = field %buffer .data  // idx 1
    copy &r -> %out
    return
}
