lilac_ir = "0.2"
target = "x86_64-unknown-none"
function @@add:bit8:bit32:bit32
  in #bit8 %lhs
  in #bit32 %rhs
  out #bit32 %result
{
  $entry:
    &1: #bit32 = const 0x0
    copy &1 -> %result
    return
}
function @main
{
  $entry:
    alloca #bit8 %a : zeroed
    alloca #bit32 %b : zeroed
    alloca #bit32 %c : zeroed
    alloca #bit32 %tmp.1 : zeroed
    &1: #bit8 = const 0x1
    copy &1 -> %a
    &2: #bit32 = const 0x2
    copy &2 -> %b
    &cf.1: #bit32 = const 0x0
    copy &cf.1 -> %tmp.1
    copy %tmp.1 -> %c
    return
}
