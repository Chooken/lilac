main: function () nothing {

    add: ref function (@bit32) @bit32 = ref addOne

    value: @bit32 = 0x0

    value = add(value)

    add = ref addTwo

    value = add(value)
}

addOne: function (value: @bit32) result: @bit32 {
    result = @i_add_32(value, 0x1)
}

addTwo: function (value: @bit32) result: @bit32 {
    result = @i_add_32(value, 0x2)
}