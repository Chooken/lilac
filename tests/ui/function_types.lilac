main: function () nothing {

    add: function (@bit32) @bit32 = addOne

    value: @bit32 = 0x0

    value = add(value)

    add = addTwo

    value = add(value)
}

addOne: function (value: @bit32) result: @bit32 {
    result = @i_add(value, 0x1)
}

addTwo: function (value: @bit32) result: @bit32 {
    result = @i_add(value, 0x2)
}