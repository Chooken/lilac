lilac_ir = "0.3"
target = "x86_64-unknown-none"
type #OptionalBit32 {
    tag: #bit8,
    Some: #bit32,
}
function @main
{
  $entry:
    alloca #OptionalBit32 %number : zeroed
    alloca #OptionalBit32 %tmp.1 : zeroed
    alloca #bit32 %some : zeroed
    alloca ref #bit32 %tmp.2 : zeroed
    zero %tmp.1
    &1: #bit8 = const 0x0
    copy &1 -> %tmp.1.tag  // idx 0
    &2: #bit32 = const 0x1
    copy &2 -> %tmp.1.Some  // idx 1
    copy %tmp.1 -> %number
    branch $l.3
  $l.3:
    &3: #bit8 = field %number .tag  // idx 0
    &4: #bit8 = const 0x0
    &5: #bit8 = cmp.eql &3, &4
    branch.if &5, $l.4, $l.5
  $l.4:
    &6: ref #bit32 = field.addr %number .Some  // idx 1
    copy &6 -> %tmp.2
    &7: #bit32 = load %tmp.2
    copy &7 -> %some
    branch $l.1
  $l.5:
    &8: #bit8 = field %number .tag  // idx 0
    &9: #bit8 = const 0x1
    &10: #bit8 = cmp.eql &8, &9
    branch.if &10, $l.6, $l.2
  $l.6:
    return
  $l.2:
    branch $l.1
  $l.1:
    return
}
