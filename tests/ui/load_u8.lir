lilac_ir = "0.5"
target = "x86_64-unknown-none"
!c0: str = "hello"
function @main
{
  $entry:
    alloca #byte_buffer %s : zeroed
    alloca #byte_buffer %tmp.1 : zeroed
    alloca ref #bit8 %p : zeroed
    alloca #byte_buffer %tmp.2 : zeroed
    alloca ref #bit8 %tmp.3 : zeroed
    alloca #bit8 %c : zeroed
    alloca ref #bit8 %tmp.4 : zeroed
    alloca #bit_native %tmp.5 : zeroed
    alloca #bit8 %tmp.6 : zeroed
    alloca #bit8 %cell : zeroed
    alloca ref #bit8 %q : zeroed
    alloca ref #bit8 %tmp.7 : zeroed
    alloca #bit_native %tmp.8 : zeroed
    alloca #bit8 %tmp.9 : zeroed
    alloca #bit8 %d : zeroed
    alloca ref #bit8 %tmp.10 : zeroed
    alloca #bit_native %tmp.11 : zeroed
    alloca #bit8 %tmp.12 : zeroed
    &1: ref #bit8 = const !c0
    copy &1 -> %tmp.1.data  // idx 1
    &2: #bit_native = const 0x5
    copy &2 -> %tmp.1.len  // idx 0
    copy %tmp.1 -> %s
    copy %s -> %tmp.2
    call @.lilac.byte_buffer_ptr (in %tmp.2) (out %tmp.3)
    copy %tmp.3 -> %p
    copy %p -> %tmp.4
    &3: #bit_native = const 0x0
    copy &3 -> %tmp.5
    call @.lilac.load_u8 (in %tmp.4, %tmp.5) (out %tmp.6)
    copy %tmp.6 -> %c
    &4: #bit8 = const 0x0
    copy &4 -> %cell
    &5: ref #bit8 = addr %cell
    copy &5 -> %q
    copy %q -> %tmp.7
    &6: #bit_native = const 0x0
    copy &6 -> %tmp.8
    copy %c -> %tmp.9
    call @.lilac.store_u8 (in %tmp.7, %tmp.8, %tmp.9) (out)
    copy %q -> %tmp.10
    &7: #bit_native = const 0x0
    copy &7 -> %tmp.11
    call @.lilac.load_u8 (in %tmp.10, %tmp.11) (out %tmp.12)
    copy %tmp.12 -> %d
    return
}
function @.lilac.byte_buffer_ptr
  in #byte_buffer %buffer
  out ref #bit8 %out
{
  $entry:
    &r: ref #bit8 = field %buffer .data  // idx 1
    copy &r -> %out
    return
}
function @.lilac.load_u8
  in ref #bit8 %base
  in #bit_native %index
  out #bit8 %out
{
  $entry:
    alloca ref #bit8 %slot : zeroed
    call @ptr_add (in %base, %index) (out %slot)
    &r: #bit8 = load %slot
    copy &r -> %out
    return
}
function @.lilac.store_u8
  in ref #bit8 %base
  in #bit_native %index
  in #bit8 %value
{
  $entry:
    alloca ref #bit8 %slot : zeroed
    call @ptr_add (in %base, %index) (out %slot)
    copy %value -> ref %slot
    return
}
