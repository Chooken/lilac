lilac_ir = "0.3"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit8 %tmp.1 : zeroed
    alloca #bit8 %tmp.2 : zeroed
    &1: #bit8 = const 0x0
    branch $l.2
  $l.2:
    branch $l.3
  $l.3:
    &2: #bit8 = const 0x1
    branch $l.4
  $l.4:
    branch $l.6
  $l.6:
    return
}
