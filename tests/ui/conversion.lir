lilac_ir = "0.4"
target = "x86_64-unknown-none"
function @@conversion:bit32:bit8
  in #bit32 %from
  out #bit8 %to
{
  $entry:
    zero %to
    &1: #bit32 = copy %from
    &2: #bit8 = trunc &1
    copy &2 -> %to
    return
}
function @main
{
  $entry:
    alloca #bit32 %a : zeroed
    alloca #bit8 %b : zeroed
    alloca #bit8 %tmp.1 : zeroed
    alloca #bit32 %tmp.2 : zeroed
    &1: #bit32 = const 0x1
    copy &1 -> %a
    copy %a -> %tmp.2
    call @@conversion:bit32:bit8 (in %tmp.2) (out %tmp.1)
    copy %tmp.1 -> %b
    return
}
