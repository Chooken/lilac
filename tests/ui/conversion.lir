lilac_ir = "0.3"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %a : zeroed
    alloca #bit8 %b : zeroed
    alloca #bit8 %tmp.1 : zeroed
    &1: #bit32 = const 0x1
    copy &1 -> %a
    &cf.1: #bit8 = const 0x1
    copy &cf.1 -> %tmp.1
    copy %tmp.1 -> %b
    return
}
