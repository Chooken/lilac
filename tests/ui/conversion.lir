lilac_ir = "0.2"
target = "x86_64-unknown-none"
function @@conversion:bit32:bit8
  in #bit32 %from
  out #bit8 %to
{
  $entry:
    &1: #bit32 = copy %from
    &2: #bit8 = trunc &1
    copy &2 -> %to
    return
}
function @main
{
  $entry:
    alloca #bit32 %a : zeroed
    alloca #bit8 %b : zeroed
    alloca #bit8 %tmp.1 : zeroed
    &1: #bit32 = const 0x1
    copy &1 -> %a
    &cf.1: #bit8 = const 0x1
    copy &cf.1 -> %tmp.1
    copy %tmp.1 -> %b
    return
}
