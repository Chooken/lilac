lilac_ir = "0.3"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca ref #unknown %add : zeroed
    alloca #bit32 %value : zeroed
    alloca #bit32 %tmp.1 : zeroed
    alloca #bit32 %tmp.2 : zeroed
    alloca #bit32 %tmp.3 : zeroed
    alloca #bit32 %tmp.4 : zeroed
    &1: ref #unknown = addr.func @addOne
    copy &1 -> %add
    &2: #bit32 = const 0x0
    copy &2 -> %value
    copy %value -> %tmp.2
    &3: ref #unknown = copy %add
    call &3 (in %tmp.2) (out %tmp.1)
    copy %tmp.1 -> %value
    &4: ref #unknown = addr.func @addTwo
    copy &4 -> %add
    copy %value -> %tmp.4
    &5: ref #unknown = copy %add
    call &5 (in %tmp.4) (out %tmp.3)
    copy %tmp.3 -> %value
    return
}
function @addOne
  in #bit32 %value
  out #bit32 %result
{
  $entry:
    zero %result
    &1: #bit32 = const 0x1
    &2: #bit32 = copy %value
    &3: #bit32 = i.add &2, &1
    copy &3 -> %result
    return
}
function @addTwo
  in #bit32 %value
  out #bit32 %result
{
  $entry:
    zero %result
    &1: #bit32 = const 0x2
    &2: #bit32 = copy %value
    &3: #bit32 = i.add &2, &1
    copy &3 -> %result
    return
}
