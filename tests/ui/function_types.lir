lilac_ir = "0.2"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit64 %add : zeroed
    alloca #bit32 %value : zeroed
    alloca #bit32 %tmp.1 : zeroed
    alloca #bit32 %tmp.2 : zeroed
    &1: #bit64 = addr.func @addOne
    copy &1 -> %add
    &2: #bit32 = const 0x0
    copy &2 -> %value
    &3: #bit64 = copy %add
    call &3 (in %value) (out %tmp.1)
    copy %tmp.1 -> %value
    &4: #bit64 = addr.func @addTwo
    copy &4 -> %add
    &5: #bit64 = copy %add
    call &5 (in %value) (out %tmp.2)
    copy %tmp.2 -> %value
    return
}
function @addOne
  in #bit32 %value
  out #bit32 %result
{
  $entry:
    &1: #bit32 = copy %value
    &2: #bit32 = const 0x1
    &3: #bit32 = i.add &1, &2
    copy &3 -> %result
    return
}
function @addTwo
  in #bit32 %value
  out #bit32 %result
{
  $entry:
    &1: #bit32 = copy %value
    &2: #bit32 = const 0x2
    &3: #bit32 = i.add &1, &2
    copy &3 -> %result
    return
}
