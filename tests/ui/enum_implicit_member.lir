lilac_ir = "0.3"
target = "x86_64-unknown-none"
type #Number {
    tag: #bit8,
}
function @main
{
  $entry:
    alloca #Number %number : zeroed
    alloca #Number %tmp.1 : zeroed
    alloca #Number %tmp.2 : zeroed
    alloca #Number %tmp.3 : zeroed
    &1: #bit8 = const 0x0
    copy &1 -> %tmp.1.tag  // idx 0
    copy %tmp.1 -> %number
    &2: #bit8 = const 0x1
    copy &2 -> %tmp.2.tag  // idx 0
    copy %tmp.2 -> %number
    &3: #bit8 = const 0x2
    copy &3 -> %tmp.3.tag  // idx 0
    copy %tmp.3 -> %number
    return
}
