Object: structure {
    private {
        private {
            f: @bit8
        }
    }

    create: function () result: Object {
        result = Object {
            f = 0x1
        }
    }

    get: function (instance: ref Object) result: @bit8 {
        result = instance.f
    }
}

main: function () nothing {
    variable: Object = Object.create()
    value: @bit8 = variable.get()
}
