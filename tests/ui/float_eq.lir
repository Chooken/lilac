lilac_ir = "0.4"
target = "x86_64-unknown-none"
inline function @f
  in #fbit32 %a
  in #fbit32 %b
  out #bit8 %out.1
{
  $entry:
    zero %out.1
    &1: #fbit32 = copy %a
    &2: #fbit32 = copy %b
    &3: #bit8 = cmp.eql &1, &2
    copy &3 -> %out.1
    return
}
function @main
{
  $entry:
    alloca #fbit32 %a : zeroed
    alloca #fbit32 %b : zeroed
    alloca #bit8 %eq : zeroed
    alloca #bit8 %tmp.1 : zeroed
    alloca #fbit32 %tmp.2 : zeroed
    alloca #fbit32 %tmp.3 : zeroed
    &1: #fbit32 = const 5.25
    copy &1 -> %a
    &2: #fbit32 = const 5.25
    copy &2 -> %b
    copy %a -> %tmp.2
    copy %b -> %tmp.3
    call @f (in %tmp.2, %tmp.3) (out %tmp.1)
    copy %tmp.1 -> %eq
    return
}
