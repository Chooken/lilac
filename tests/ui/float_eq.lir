lilac_ir = "0.3"
target = "x86_64-unknown-none"
!c0: numlit = "5.25"
function @main
{
  $entry:
    alloca #fbit32 %a : zeroed
    alloca #fbit32 %b : zeroed
    alloca #bit8 %eq : zeroed
    &1: #byte_buffer = const !c0
    &2: #fbit32 = const 5.25
    copy &2 -> %a
    &3: #byte_buffer = const !c0
    &4: #fbit32 = const 5.25
    copy &4 -> %b
    &5: #fbit32 = copy %a
    &6: #fbit32 = copy %b
    &7: #bit8 = cmp.eql &5, &6
    copy &7 -> %eq
    return
}
