lilac_ir = "0.5"
target = "x86_64-unknown-none"
type #Object size 4 align 4 {
    member: #bit32,
}
function @Object.get
  in ref #Object %instance
  out #bit32 %result
{
  $entry:
    zero %result
    &1: #bit32 = field %instance .member  // idx 0
    copy &1 -> %result
    return
}
function @main
{
  $entry:
    alloca #Object %variable : zeroed
    alloca #Object %tmp.1 : zeroed
    alloca #bit32 %member : zeroed
    alloca #bit32 %tmp.2 : zeroed
    alloca ref #Object %tmp.3 : zeroed
    zero %tmp.1
    &1: #bit32 = const 0x1
    copy &1 -> %tmp.1.member  // idx 0
    copy %tmp.1 -> %variable
    &2: ref #Object = addr %variable
    copy &2 -> %tmp.3
    call @Object.get (in %tmp.3) (out %tmp.2)
    copy %tmp.2 -> %member
    return
}
