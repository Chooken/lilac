lilac_ir = "0.5"
target = "x86_64-unknown-none"
type #@builtin.Os tagged size 1 align 1 {
    tag: #bit8,
}
function @.root.on_bare
{
  $entry:
    return
}
function @.root.with_libc
{
  $entry:
    return
}
function @main
{
  $entry:
    alloca #@builtin.Os %os : zeroed
    alloca #@builtin.Os %tmp.1 : zeroed
    call @.root.on_bare (in) (out)
    call @.root.with_libc (in) (out)
    zero %tmp.1
    &1: #bit8 = const 0x3
    copy &1 -> %tmp.1.tag  // idx 0
    copy %tmp.1 -> %os
    return
}
