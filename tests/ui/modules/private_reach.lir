lilac_ir = "0.3"
target = "x86_64-unknown-none"
function @root_bump
  in ref #bit8 %cell
{
  $entry:
    alloca #bit_native %tmp.1 : zeroed
    alloca #bit8 %tmp.2 : zeroed
    &1: #bit_native = const 0x0
    copy &1 -> %tmp.1
    &2: #bit8 = const 0x1
    copy &2 -> %tmp.2
    call @.lilac.store_u8 (in %cell, %tmp.1, %tmp.2) (out)
    return
}
function @main
{
  $entry:
    alloca #bit8 %cell : zeroed
    alloca ref #bit8 %p : zeroed
    &1: #bit8 = const 0x0
    copy &1 -> %cell
    &2: ref #bit8 = addr %cell
    copy &2 -> %p
    call @util.write_byte (in %p) (out)
    return
}
function @util.secret
  in ref #bit8 %cell
{
  $entry:
    alloca #bit_native %tmp.1 : zeroed
    alloca #bit8 %tmp.2 : zeroed
    &1: #bit_native = const 0x0
    copy &1 -> %tmp.1
    &2: #bit8 = const 0x9
    copy &2 -> %tmp.2
    call @.lilac.store_u8 (in %cell, %tmp.1, %tmp.2) (out)
    return
}
function @util.write_byte
  in ref #bit8 %cell
{
  $entry:
    call @root_bump (in %cell) (out)
    call @util.secret (in %cell) (out)
    return
}
function @.lilac.store_u8
  in ref #bit8 %base
  in #bit_native %index
  in #bit8 %value
{
  $entry:
    alloca ref #bit8 %slot : zeroed
    call @ptr_add (in %base, %index) (out %slot)
    copy %value -> ref %slot
    return
}
