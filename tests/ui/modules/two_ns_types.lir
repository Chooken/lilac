lilac_ir = "0.5"
target = "x86_64-unknown-none"
type #a.Thing size 4 align 4 {
    a_field: #bit32,
}
type #b.Thing size 4 align 4 {
    b_field: #bit32,
}
function @b.Thing.@on_drop(RN1b5ThingE)
  in ref #b.Thing %from
{
  $entry:
    alloca ref #bit32 %tmp.1 : zeroed
    &1: #bit32 = const 0x0
    &2: ref #bit32 = field.addr %from .b_field  // idx 0
    copy &2 -> %tmp.1
    copy &1 -> ref %tmp.1
    return
}
function @a.Thing.@on_drop(RN1a5ThingE)
  in ref #a.Thing %from
{
  $entry:
    alloca ref #bit32 %tmp.1 : zeroed
    &1: #bit32 = const 0x0
    &2: ref #bit32 = field.addr %from .a_field  // idx 0
    copy &2 -> %tmp.1
    copy &1 -> ref %tmp.1
    return
}
function @.root.b_use
{
  $entry:
    alloca #b.Thing %x : zeroed
    alloca #b.Thing %tmp.1 : zeroed
    alloca #bit32 %y : zeroed
    alloca ref #b.Thing %tmp.2 : zeroed
    zero %tmp.1
    &1: #bit32 = const 0x2
    copy &1 -> %tmp.1.b_field  // idx 0
    copy %tmp.1 -> %x
    &2: #bit32 = field %x .b_field  // idx 0
    copy &2 -> %y
    &3: ref #b.Thing = addr %x
    copy &3 -> %tmp.2
    call @b.Thing.@on_drop(RN1b5ThingE) (in %tmp.2) (out)
    drop %x
    return
}
function @main
{
  $entry:
    alloca #a.Thing %x : zeroed
    alloca #a.Thing %tmp.1 : zeroed
    alloca #bit32 %y : zeroed
    alloca ref #a.Thing %tmp.2 : zeroed
    zero %tmp.1
    &1: #bit32 = const 0x1
    copy &1 -> %tmp.1.a_field  // idx 0
    copy %tmp.1 -> %x
    &2: #bit32 = field %x .a_field  // idx 0
    copy &2 -> %y
    call @.root.b_use (in) (out)
    &3: ref #a.Thing = addr %x
    copy &3 -> %tmp.2
    call @a.Thing.@on_drop(RN1a5ThingE) (in %tmp.2) (out)
    drop %x
    return
}
