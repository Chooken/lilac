lilac_ir = "0.3"
target = "x86_64-unknown-none"
type #a.Thing {
    a_field: #bit32,
}
type #b.Thing {
    b_field: #bit32,
}
function @b_use
{
  $entry:
    alloca #b.Thing %x : zeroed
    alloca #b.Thing %tmp.1 : zeroed
    alloca #bit32 %y : zeroed
    &1: #bit32 = const 0x2
    copy &1 -> %tmp.1.b_field  // idx 0
    copy %tmp.1 -> %x
    &2: #bit32 = field %x .b_field  // idx 0
    copy &2 -> %y
    call @b.Thing.@on_drop:ref_b.Thing (in %x) (out)
    drop %x
    return
}
function @main
{
  $entry:
    alloca #a.Thing %x : zeroed
    alloca #a.Thing %tmp.1 : zeroed
    alloca #bit32 %y : zeroed
    &1: #bit32 = const 0x1
    copy &1 -> %tmp.1.a_field  // idx 0
    copy %tmp.1 -> %x
    &2: #bit32 = field %x .a_field  // idx 0
    copy &2 -> %y
    call @b_use (in) (out)
    call @a.Thing.@on_drop:ref_a.Thing (in %x) (out)
    drop %x
    return
}
function @b.Thing.@on_drop:ref_b.Thing
  in ref #b.Thing %from
{
  $entry:
    &1: #bit32 = const 0x0
    copy &1 -> %from.b_field  // idx 0
    return
}
function @a.Thing.@on_drop:ref_a.Thing
  in ref #a.Thing %from
{
  $entry:
    &1: #bit32 = const 0x0
    copy &1 -> %from.a_field  // idx 0
    return
}
