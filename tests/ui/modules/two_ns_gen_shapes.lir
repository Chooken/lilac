lilac_ir = "0.4"
target = "x86_64-unknown-none"
type #a.GenBox.1..bit32 {
    a_value: #bit32,
}
type #b.GenBox.1..bit64 {
    b_value: #bit64,
    b_extra: #bit64,
}
function @.root.b_use
{
  $entry:
    alloca #b.GenBox.1..bit64 %x : zeroed
    alloca #b.GenBox.1..bit64 %tmp.1 : zeroed
    alloca #bit64 %y : zeroed
    alloca #bit32 %m : zeroed
    alloca #bit32 %tmp.2 : zeroed
    alloca #bit64 %tmp.3 : zeroed
    zero %tmp.1
    &1: #bit64 = const 0x2
    copy &1 -> %tmp.1.b_value  // idx 0
    &2: #bit64 = const 0x3
    copy &2 -> %tmp.1.b_extra  // idx 1
    copy %tmp.1 -> %x
    &3: #bit64 = field %x .b_value  // idx 0
    copy &3 -> %y
    &4: #bit64 = const 0x0
    copy &4 -> %tmp.3
    call @b.tag.1..bit64 (in %tmp.3) (out %tmp.2)
    copy %tmp.2 -> %m
    return
}
function @main
{
  $entry:
    alloca #a.GenBox.1..bit32 %x : zeroed
    alloca #a.GenBox.1..bit32 %tmp.1 : zeroed
    alloca #bit32 %y : zeroed
    alloca #bit32 %n : zeroed
    alloca #bit32 %tmp.2 : zeroed
    alloca #bit32 %tmp.3 : zeroed
    zero %tmp.1
    &1: #bit32 = const 0x1
    copy &1 -> %tmp.1.a_value  // idx 0
    copy %tmp.1 -> %x
    &2: #bit32 = field %x .a_value  // idx 0
    copy &2 -> %y
    &3: #bit32 = const 0x0
    copy &3 -> %tmp.3
    call @a.tag.1..bit32 (in %tmp.3) (out %tmp.2)
    copy %tmp.2 -> %n
    call @.root.b_use (in) (out)
    return
}
function @b.tag.1..bit64
  in #bit64 %x
  out #bit32 %result
{
  $entry:
    zero %result
    &1: #bit32 = const 0x2
    copy &1 -> %result
    return
}
function @a.tag.1..bit32
  in #bit32 %x
  out #bit32 %result
{
  $entry:
    zero %result
    &1: #bit32 = const 0x1
    copy &1 -> %result
    return
}
