// A member `private` reaches the type's whole namespace: `Handle` and
// `Watcher` (another file of the same folder) build and read each other's
// private fields, and so does the namespace inside it.
Handle: structure {
    private {
        count: @bit8
    }

    watch: function (self) watcher: Watcher {
        watcher = Watcher { seen = self.count }
    }
}
