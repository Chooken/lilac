lilac_ir = "0.3"
target = "x86_64-unknown-none"
!c0: str = "hello"
function @main
{
  $entry:
    alloca #byte_buffer %s : zeroed
    alloca #bitNative %n : zeroed
    alloca #bitNative %tmp.1 : zeroed
    alloca ref #bit8 %p : zeroed
    alloca ref #bit8 %tmp.2 : zeroed
    &1: #byte_buffer = const !c0
    copy &1 -> %s
    &cf.1: #bitNative = const 0x5
    copy &cf.1 -> %tmp.1
    &2: #bitNative = copy %tmp.1
    copy &2 -> %n
    call @.lilac.byte_buffer_ptr (in %s) (out %tmp.2)
    &3: ref #bit8 = copy %tmp.2
    copy &3 -> %p
    return
}
function @.lilac.byte_buffer_ptr
  in #byte_buffer %buffer
  out ref #bit8 %out
{
  $entry:
    &r: ref #bit8 = field %buffer .data  // idx 1
    copy &r -> %out
    return
}
