lilac_ir = "0.5"
target = "x86_64-unknown-none"
!c0: str = "hello"
function @main
{
  $entry:
    alloca #byte_buffer %s : zeroed
    alloca #byte_buffer %tmp.1 : zeroed
    alloca #bit_native %n : zeroed
    alloca #byte_buffer %tmp.2 : zeroed
    alloca #bit_native %tmp.3 : zeroed
    alloca ref #bit8 %p : zeroed
    alloca #byte_buffer %tmp.4 : zeroed
    alloca ref #bit8 %tmp.5 : zeroed
    &1: ref #bit8 = const !c0
    copy &1 -> %tmp.1.data  // idx 1
    &2: #bit_native = const 0x5
    copy &2 -> %tmp.1.len  // idx 0
    copy %tmp.1 -> %s
    copy %s -> %tmp.2
    call @.lilac.byte_buffer_len (in %tmp.2) (out %tmp.3)
    copy %tmp.3 -> %n
    copy %s -> %tmp.4
    call @.lilac.byte_buffer_ptr (in %tmp.4) (out %tmp.5)
    copy %tmp.5 -> %p
    return
}
function @.lilac.byte_buffer_ptr
  in #byte_buffer %buffer
  out ref #bit8 %out
{
  $entry:
    &r: ref #bit8 = field %buffer .data  // idx 1
    copy &r -> %out
    return
}
function @.lilac.byte_buffer_len
  in #byte_buffer %buffer
  out #bit_native %out
{
  $entry:
    &r: #bit_native = field %buffer .len  // idx 0
    copy &r -> %out
    return
}
