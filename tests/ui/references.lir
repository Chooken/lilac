lilac_ir = "0.5"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %variable : zeroed
    alloca ref #bit32 %ref_to_variable : zeroed
    &1: #bit32 = const 0x0
    copy &1 -> %variable
    &2: ref #bit32 = addr %variable
    copy &2 -> %ref_to_variable
    &3: #bit32 = const 0x1
    copy &3 -> ref %ref_to_variable
    return
}
