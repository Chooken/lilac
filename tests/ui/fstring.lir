lilac_ir = "0.5"
target = "x86_64-unknown-none"
!c0: str = "x"
!fmt0: format "a" {@@format(ReR3OutE)} "b"
type #Out size 0 align 1 {
}
function @@format(ReR3OutE)
  in ref #byte_buffer %value
  in ref #Out %out
{
  $entry:
    return
}
function @main
{
  $entry:
    alloca #byte_buffer %part : zeroed
    alloca #byte_buffer %tmp.1 : zeroed
    alloca #format_args %msg : zeroed
    alloca #format_args %tmp.2 : zeroed
    &1: ref #bit8 = const !c0
    copy &1 -> %tmp.1.data  // idx 1
    &2: #bit_native = const 0x1
    copy &2 -> %tmp.1.len  // idx 0
    copy %tmp.1 -> %part
    &3: ref #byte_buffer = addr %part
    format !fmt0 (&3) -> %tmp.2
    copy %tmp.2 -> %msg
    return
}
