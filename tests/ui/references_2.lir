lilac_ir = "0.2"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %variable : zeroed
    alloca #bit32 %variable_2 : zeroed
    alloca ref #bit32 %ref_to_variable : zeroed
    &1: #bit32 = const 0x0
    copy &1 -> %variable
    &2: #bit32 = const 0x2
    copy &2 -> %variable_2
    &3: ref #bit32 = addr %variable
    copy &3 -> %ref_to_variable
    &4: ref #bit32 = addr %variable_2
    copy &4 -> %ref_to_variable
    &5: #bit32 = const 0x1
    copy &5 -> ref %ref_to_variable
    return
}
