lilac_ir = "0.4"
target = "x86_64-unknown-none"
type #Store {
    Data: ref #unknown,
}
extern @malloc
  in #bit_native %size
  out ref #unknown %result
extern @free
  in ref #unknown %p
function @put
  in ref #unknown %b
  in #bit8 %v
{
  $entry:
    alloca ref #bit8 %p : zeroed
    alloca ref #bit8 %tmp.1 : zeroed
    alloca #bit_native %tmp.2 : zeroed
    alloca #bit8 %tmp.3 : zeroed
    &1: ref #bit8 = copy %b
    copy &1 -> %p
    copy %p -> %tmp.1
    &2: #bit_native = const 0x0
    copy &2 -> %tmp.2
    copy %v -> %tmp.3
    call @.lilac.store_u8 (in %tmp.1, %tmp.2, %tmp.3) (out)
    return
}
function @main
{
  $entry:
    alloca ref #unknown %raw : zeroed
    alloca ref #unknown %tmp.1 : zeroed
    alloca #bit_native %tmp.2 : zeroed
    alloca #Store %s : zeroed
    alloca #Store %tmp.3 : zeroed
    alloca ref #unknown %tmp.4 : zeroed
    alloca #bit8 %tmp.5 : zeroed
    alloca ref #unknown %tmp.6 : zeroed
    &1: #bit_native = const 0x8
    copy &1 -> %tmp.2
    call @malloc (in %tmp.2) (out %tmp.1)
    copy %tmp.1 -> %raw
    zero %tmp.3
    copy %raw -> %tmp.3.Data  // idx 0
    copy %tmp.3 -> %s
    &2: ref #unknown = field %s .Data  // idx 0
    copy &2 -> %tmp.4
    &3: #bit8 = const 0x2A
    copy &3 -> %tmp.5
    call @put (in %tmp.4, %tmp.5) (out)
    &4: ref #unknown = field %s .Data  // idx 0
    copy &4 -> %tmp.6
    call @free (in %tmp.6) (out)
    return
}
function @.lilac.store_u8
  in ref #bit8 %base
  in #bit_native %index
  in #bit8 %value
{
  $entry:
    alloca ref #bit8 %slot : zeroed
    call @ptr_add (in %base, %index) (out %slot)
    copy %value -> ref %slot
    return
}
