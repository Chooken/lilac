lilac_ir = "0.2"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %result : zeroed
    alloca #bit32 %tmp.1 : zeroed
    call @get (in) (out %tmp.1)
    copy %tmp.1 -> %result
    return
}
function @get
  out #bit32 %result
{
  $entry:
    &1: #bit32 = const 0x1
    copy &1 -> %result
    return
}
