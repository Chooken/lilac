lilac_ir = "0.4"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %result : zeroed
    alloca #bit32 %tmp.1 : zeroed
    call @.root.get (in) (out %tmp.1)
    copy %tmp.1 -> %result
    return
}
function @.root.get
  out #bit32 %result
{
  $entry:
    zero %result
    &1: #bit32 = const 0x1
    copy &1 -> %result
    return
}
