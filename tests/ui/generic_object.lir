lilac_ir = "0.2"
target = "x86_64-unknown-none"
type #GenObject__1__bit32 {
    value: #bit32,
}
function @main
{
  $entry:
    alloca #GenObject__1__bit32 %variable : zeroed
    alloca #GenObject__1__bit32 %tmp.1 : zeroed
    &1: #bit32 = const 0x0
    copy &1 -> %tmp.1.value  // idx 0
    copy %tmp.1 -> %variable
    return
}
