lilac_ir = "0.3"
target = "x86_64-unknown-none"
!c0: str = "x"
!c1: str = "a"
!c2: str = "b"
function @main
{
  $entry:
    alloca #byte_buffer %part : zeroed
    alloca #format_args %msg : zeroed
    alloca #format_args %tmp.1 : zeroed
    alloca #byte_buffer %tmp.2 : zeroed
    alloca ref #format_args %tmp.3 : zeroed
    alloca #byte_buffer %tmp.4 : zeroed
    alloca ref #format_args %tmp.5 : zeroed
    alloca #byte_buffer %tmp.6 : zeroed
    alloca ref #format_args %tmp.7 : zeroed
    alloca #bit_native %n : zeroed
    alloca #format_args %tmp.8 : zeroed
    alloca #bit_native %tmp.9 : zeroed
    alloca #byte_buffer %first : zeroed
    alloca #format_args %tmp.10 : zeroed
    alloca #bit_native %tmp.11 : zeroed
    alloca #byte_buffer %tmp.12 : zeroed
    &1: #byte_buffer = const !c0
    copy &1 -> %part
    call @.lilac.format_args_new (in) (out %tmp.1)
    &2: #byte_buffer = const !c1
    copy &2 -> %tmp.2
    &3: ref #format_args = addr %tmp.1
    copy &3 -> %tmp.3
    call @.lilac.format_args_push (in %tmp.3, %tmp.2) (out)
    copy %part -> %tmp.4
    &4: ref #format_args = addr %tmp.1
    copy &4 -> %tmp.5
    call @.lilac.format_args_push (in %tmp.5, %tmp.4) (out)
    &5: #byte_buffer = const !c2
    copy &5 -> %tmp.6
    &6: ref #format_args = addr %tmp.1
    copy &6 -> %tmp.7
    call @.lilac.format_args_push (in %tmp.7, %tmp.6) (out)
    copy %tmp.1 -> %msg
    copy %msg -> %tmp.8
    call @.lilac.format_args_count (in %tmp.8) (out %tmp.9)
    copy %tmp.9 -> %n
    copy %msg -> %tmp.10
    &7: #bit_native = const 0x0
    copy &7 -> %tmp.11
    call @.lilac.format_args_piece (in %tmp.10, %tmp.11) (out %tmp.12)
    copy %tmp.12 -> %first
    return
}
function @.lilac.format_args_new
  out #format_args %out
{
  $entry:
    alloca #format_args %tmp : zeroed
    copy %tmp -> %out
    return
}
function @.lilac.format_args_push
  in ref #format_args %table
  in #byte_buffer %piece
{
  $entry:
    &c: #bit_native = field %table .count  // idx 0
    &cap: #bit_native = const 0x10
    &ok: #bit8 = i.cmp.lt.u &c, &cap
    branch.if &ok, $append, $done
  $append:
    &c: #bit_native = field %table .count  // idx 0
    &p0: ref #byte_buffer = field.addr %table .p0  // idx 1
    alloca ref #bit8 %base : zeroed
    copy &p0 -> %base
    &stride: #bit_native = const 0x10
    &off: #bit_native = i.mul &c, &stride
    alloca #bit_native %offp : zeroed
    copy &off -> %offp
    alloca ref #bit8 %slot : zeroed
    call @ptr_add (in %base, %offp) (out %slot)
    alloca ref #byte_buffer %s : zeroed
    copy %slot -> %s
    copy %piece -> ref %s
    &one: #bit_native = const 0x1
    &n: #bit_native = i.add &c, &one
    copy &n -> %table.count  // idx 0
    branch $done
  $done:
    return
}
function @.lilac.format_args_count
  in #format_args %table
  out #bit_native %out
{
  $entry:
    &r: #bit_native = field %table .count  // idx 0
    copy &r -> %out
    return
}
function @.lilac.format_args_piece
  in #format_args %table
  in #bit_native %index
  out #byte_buffer %out
{
  $entry:
    &c: #bit_native = field %table .count  // idx 0
    &idx: #bit_native = copy %index
    &ok: #bit8 = i.cmp.lt.u &idx, &c
    branch.if &ok, $load, $trap
  $trap:
    call @lilac_abort (in) (out)
    unreachable
  $load:
    &idx: #bit_native = copy %index
    &p0: ref #byte_buffer = field.addr %table .p0  // idx 1
    alloca ref #bit8 %base : zeroed
    copy &p0 -> %base
    &stride: #bit_native = const 0x10
    &off: #bit_native = i.mul &idx, &stride
    alloca #bit_native %offp : zeroed
    copy &off -> %offp
    alloca ref #bit8 %slot : zeroed
    call @ptr_add (in %base, %offp) (out %slot)
    alloca ref #byte_buffer %s : zeroed
    copy %slot -> %s
    &v: #byte_buffer = load %s
    copy &v -> %out
    return
}
