lilac_ir = "0.5"
target = "x86_64-unknown-none"
!c0: str = "xy"
!c1: str = "format piece index out of bounds"
!c2: str = "  at main (format_args_use.lilac:14:27)
"
!c3: str = "format hole index out of bounds"
!c4: str = "  at main (format_args_use.lilac:15:5)
"
!.lilac.panic.head: str = "panic: "
!.lilac.panic.newline: str = "
"
!.lilac.panic.elided: str = "  ...
"
!.lilac.panic.no_trace: str = "  (stack trace disabled; build with --stack-traces=on)
"
!.lilac.panic.nested: str = "
panic while writing a panic message
"
!fmt0: format "a" {@@format(ReR3OutE)} "b"
type #Out size 8 align 8 {
    count: #bit_native,
}
function @@format(ReR3OutE)
  in ref #byte_buffer %value
  in ref #Out %out
{
  $entry:
    alloca #byte_buffer %tmp.1 : zeroed
    alloca #bit_native %tmp.2 : zeroed
    alloca ref #bit_native %tmp.3 : zeroed
    &1: #bit_native = field %out .count  // idx 0
    copy ref %value -> %tmp.1
    call @.lilac.byte_buffer_len (in %tmp.1) (out %tmp.2)
    &2: #bit_native = copy %tmp.2
    &3: #bit_native = i.add &1, &2
    &4: ref #bit_native = field.addr %out .count  // idx 0
    copy &4 -> %tmp.3
    copy &3 -> ref %tmp.3
    return
}
function @main
{
  $entry:
    alloca #byte_buffer %part : zeroed
    alloca #byte_buffer %tmp.1 : zeroed
    alloca #Out %out : zeroed
    alloca #Out %tmp.2 : zeroed
    alloca #format_args %msg : zeroed
    alloca #format_args %tmp.3 : zeroed
    alloca #bit_native %holes : zeroed
    alloca #format_args %tmp.4 : zeroed
    alloca #bit_native %tmp.5 : zeroed
    alloca #byte_buffer %first : zeroed
    alloca #format_args %tmp.6 : zeroed
    alloca #bit_native %tmp.7 : zeroed
    alloca #bit_native %tmp.8 : zeroed
    alloca #byte_buffer %tmp.9 : zeroed
    alloca #byte_buffer %tmp.10 : zeroed
    alloca #byte_buffer %tmp.11 : zeroed
    alloca #format_args %tmp.12 : zeroed
    alloca #bit_native %tmp.13 : zeroed
    alloca ref #Out %tmp.14 : zeroed
    alloca #bit_native %tmp.15 : zeroed
    alloca #byte_buffer %tmp.16 : zeroed
    alloca #byte_buffer %tmp.17 : zeroed
    &1: ref #bit8 = const !c0
    copy &1 -> %tmp.1.data  // idx 1
    &2: #bit_native = const 0x2
    copy &2 -> %tmp.1.len  // idx 0
    copy %tmp.1 -> %part
    zero %tmp.2
    &3: #bit_native = const 0x0
    copy &3 -> %tmp.2.count  // idx 0
    copy %tmp.2 -> %out
    &4: ref #byte_buffer = addr %part
    format !fmt0 (&4) -> %tmp.3
    copy %tmp.3 -> %msg
    copy %msg -> %tmp.4
    call @.lilac.format_args_holes (in %tmp.4) (out %tmp.5)
    copy %tmp.5 -> %holes
    copy %msg -> %tmp.6
    &5: #bit_native = const 0x0
    copy &5 -> %tmp.7
    call @.lilac.format_args_holes (in %tmp.6) (out %tmp.8)
    &6: #bit_native = copy %tmp.8
    &7: #bit_native = copy %tmp.7
    &8: #bit8 = i.cmp.lt.u &6, &7
    branch.if &8, $l.2, $l.1
  $l.2:
    &9: ref #bit8 = const !c1
    copy &9 -> %tmp.9.data  // idx 1
    &10: #bit_native = const 0x20
    copy &10 -> %tmp.9.len  // idx 0
    &11: ref #bit8 = const !c2
    copy &11 -> %tmp.10.data  // idx 1
    &12: #bit_native = const 0x28
    copy &12 -> %tmp.10.len  // idx 0
    call @.lilac.panic (in %tmp.9, %tmp.10) (out)
    unreachable
  $l.1:
    call @.lilac.format_args_piece (in %tmp.6, %tmp.7) (out %tmp.11)
    copy %tmp.11 -> %first
    copy %msg -> %tmp.12
    &13: #bit_native = const 0x0
    copy &13 -> %tmp.13
    &14: ref #Out = addr %out
    copy &14 -> %tmp.14
    call @.lilac.format_args_holes (in %tmp.12) (out %tmp.15)
    &15: #bit_native = copy %tmp.15
    &16: #bit_native = copy %tmp.13
    &17: #bit8 = i.cmp.lt.u &16, &15
    branch.if &17, $l.3, $l.4
  $l.4:
    &18: ref #bit8 = const !c3
    copy &18 -> %tmp.16.data  // idx 1
    &19: #bit_native = const 0x1f
    copy &19 -> %tmp.16.len  // idx 0
    &20: ref #bit8 = const !c4
    copy &20 -> %tmp.17.data  // idx 1
    &21: #bit_native = const 0x27
    copy &21 -> %tmp.17.len  // idx 0
    call @.lilac.panic (in %tmp.16, %tmp.17) (out)
    unreachable
  $l.3:
    call @.lilac.format_args_hole (in %tmp.12, %tmp.13, %tmp.14) (out)
    return
}
function @.lilac.byte_buffer_len
  in #byte_buffer %buffer
  out #bit_native %out
{
  $entry:
    &r: #bit_native = field %buffer .len  // idx 0
    copy &r -> %out
    return
}
inline function @.lilac.format_args_holes
  in #format_args %args
  out #bit_native %out
{
  $entry:
    alloca ref #unknown %template : zeroed
    &t: ref #unknown = field %args .template  // idx 0
    copy &t -> %template
    copy ref %template -> %out
    return
}
inline function @.lilac.format_args_piece
  in #format_args %args
  in #bit_native %index
  out #byte_buffer %out
{
  $entry:
    alloca ref #bit8 %part.base : zeroed
    &part.ptr: ref #unknown = field %args .template  // idx 0
    copy &part.ptr -> %part.base
    &part.index: #bit_native = copy %index
    &part.stride: #bit_native = const 0x18
    &part.scaled: #bit_native = i.mul &part.index, &part.stride
    &part.offset: #bit_native = const 0x8
    &part.sum: #bit_native = i.add &part.scaled, &part.offset
    alloca #bit_native %part.at : zeroed
    copy &part.sum -> %part.at
    alloca ref #unknown %part : zeroed
    call @ptr_add (in %part.base, %part.at) (out %part)
    copy ref %part -> %out
    return
}
inline function @.lilac.format_args_hole
  in #format_args %args
  in #bit_native %index
  in ref #unknown %out
{
  $entry:
    alloca ref #bit8 %part.base : zeroed
    &part.ptr: ref #unknown = field %args .template  // idx 0
    copy &part.ptr -> %part.base
    &part.index: #bit_native = copy %index
    &part.stride: #bit_native = const 0x18
    &part.scaled: #bit_native = i.mul &part.index, &part.stride
    &part.offset: #bit_native = const 0x18
    &part.sum: #bit_native = i.add &part.scaled, &part.offset
    alloca #bit_native %part.at : zeroed
    copy &part.sum -> %part.at
    alloca ref #unknown %part : zeroed
    call @ptr_add (in %part.base, %part.at) (out %part)
    alloca ref #bit8 %hole.base : zeroed
    &hole.ptr: ref #unknown = field %args .holes  // idx 1
    copy &hole.ptr -> %hole.base
    &hole.index: #bit_native = copy %index
    &hole.stride: #bit_native = const 0x8
    &hole.scaled: #bit_native = i.mul &hole.index, &hole.stride
    &hole.offset: #bit_native = const 0x0
    &hole.sum: #bit_native = i.add &hole.scaled, &hole.offset
    alloca #bit_native %hole.at : zeroed
    copy &hole.sum -> %hole.at
    alloca ref #unknown %hole : zeroed
    call @ptr_add (in %hole.base, %hole.at) (out %hole)
    alloca ref #unknown %format : zeroed
    copy ref %part -> %format
    alloca ref #unknown %value : zeroed
    copy ref %hole -> %value
    &f: ref #unknown = copy %format
    call &f (in %value, %out) (out)
    return
}
extern @.lilac.exit
  in #bit32 %code
extern @.lilac.compiler_print
  in #byte_buffer %text
function @.lilac.panic
  in #byte_buffer %msg
  in #byte_buffer %site
{
  $entry:
    alloca #byte_buffer %text : zeroed
    alloca ref ref #.lilac.frame %head : zeroed
    alloca ref #.lilac.frame %frame : zeroed
    alloca #bit_native %count : zeroed
    alloca ref #byte_buffer %frame.site : zeroed
    alloca ref #bit_native %depth : zeroed
    call @panic_depth (in) (out %depth)
    &d: #bit_native = load %depth
    &one: #bit_native = const 0x1
    &deeper: #bit_native = i.add &d, &one
    copy &deeper -> ref %depth
    &zero: #bit_native = const 0x0
    &first: #bit8 = cmp.eql &d, &zero
    branch.if &first, $start, $again
  $again:
    &d: #bit_native = load %depth
    &two: #bit_native = const 0x2
    &second: #bit8 = cmp.eql &d, &two
    branch.if &second, $nested, $broken
  $nested:
    &a.text: ref #bit8 = const !.lilac.panic.nested
    copy &a.text -> %text.data  // idx 1
    &a.len: #bit_native = const 0x25
    copy &a.len -> %text.len  // idx 0
    call @.lilac.compiler_print (in %text) (out)
    branch $exit
  $broken:
    call @lilac_abort (in) (out)
    unreachable
  $start:
    &a.text: ref #bit8 = const !.lilac.panic.head
    copy &a.text -> %text.data  // idx 1
    &a.len: #bit_native = const 0x7
    copy &a.len -> %text.len  // idx 0
    call @.lilac.compiler_print (in %text) (out)
    call @.lilac.compiler_print (in %msg) (out)
    &c.text: ref #bit8 = const !.lilac.panic.newline
    copy &c.text -> %text.data  // idx 1
    &c.len: #bit_native = const 0x1
    copy &c.len -> %text.len  // idx 0
    call @.lilac.compiler_print (in %text) (out)
    call @trace_head (in) (out %head)
    &top: ref #.lilac.frame = load %head
    copy &top -> %frame
    &untraced.address: #bit_native = bitcast &top
    &untraced.zero: #bit_native = const 0x0
    &untraced: #bit8 = cmp.eql &untraced.address, &untraced.zero
    branch.if &untraced, $untraced, $walk
  $untraced:
    call @.lilac.compiler_print (in %site) (out)
    &b.text: ref #bit8 = const !.lilac.panic.no_trace
    copy &b.text -> %text.data  // idx 1
    &b.len: #bit_native = const 0x37
    copy &b.len -> %text.len  // idx 0
    call @.lilac.compiler_print (in %text) (out)
    branch $exit
  $walk:
    &cur: ref #.lilac.frame = copy %frame
    &done.address: #bit_native = bitcast &cur
    &done.zero: #bit_native = const 0x0
    &done: #bit8 = cmp.eql &done.address, &done.zero
    branch.if &done, $exit, $check
  $check:
    &n: #bit_native = copy %count
    &max: #bit_native = const 0x80
    &full: #bit8 = cmp.eql &n, &max
    branch.if &full, $elided, $print
  $print:
    &site.at: ref #byte_buffer = field.addr %frame .site  // idx 1
    copy &site.at -> %frame.site
    copy ref %frame.site -> %text
    call @.lilac.compiler_print (in %text) (out)
    &prev: ref #.lilac.frame = field %frame .prev  // idx 0
    copy &prev -> %frame
    &n: #bit_native = copy %count
    &one: #bit_native = const 0x1
    &next: #bit_native = i.add &n, &one
    copy &next -> %count
    branch $walk
  $elided:
    &a.text: ref #bit8 = const !.lilac.panic.elided
    copy &a.text -> %text.data  // idx 1
    &a.len: #bit_native = const 0x6
    copy &a.len -> %text.len  // idx 0
    call @.lilac.compiler_print (in %text) (out)
    branch $exit
  $exit:
    alloca #bit32 %code : zeroed
    &code.value: #bit32 = const 0x65
    copy &code.value -> %code
    call @.lilac.exit (in %code) (out)
    call @lilac_abort (in) (out)
    unreachable
}
