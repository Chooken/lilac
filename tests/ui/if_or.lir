lilac_ir = "0.4"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %conditional : zeroed
    alloca #bit8 %tmp.1 : zeroed
    &1: #bit32 = const 0x0
    copy &1 -> %conditional
    &2: #bit8 = const 0x0
    branch $l.1
  $l.1:
    &3: #bit8 = const 0x1
    copy &3 -> %tmp.1
    branch $l.3
  $l.3:
    &5: #bit8 = copy %tmp.1
    branch $l.4
  $l.4:
    &6: #bit32 = const 0x1
    copy &6 -> %conditional
    branch $l.6
  $l.6:
    return
}
