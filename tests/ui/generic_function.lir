lilac_ir = "0.4"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %result : zeroed
    alloca #bit32 %tmp.1 : zeroed
    alloca #bit32 %tmp.2 : zeroed
    &1: #bit32 = const 0x1
    copy &1 -> %tmp.2
    call @.root.gen_function[m] (in %tmp.2) (out %tmp.1)
    copy %tmp.1 -> %result
    return
}
function @.root.gen_function[m]
  in #bit32 %value
  out #bit32 %out
{
  $entry:
    zero %out
    copy %value -> %out
    return
}
