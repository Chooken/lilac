lilac_ir = "0.4"
target = "x86_64-unknown-none"
type #Holder size 20 align 4 {
    tag: #bit8,
    items: [4 x #bit32],
}
function @main
{
  $entry:
    alloca #Holder %holder : zeroed
    alloca #Holder %tmp.1 : zeroed
    alloca [4 x #bit32] %tmp.2 : zeroed
    alloca ref #bit32 %slot : zeroed
    alloca ref [4 x #bit32] %tmp.3 : zeroed
    alloca #bit_native %count : zeroed
    zero %tmp.1
    &1: #bit8 = const 0x1
    copy &1 -> %tmp.1.tag  // idx 0
    zero %tmp.2
    copy %tmp.2 -> %tmp.1.items  // idx 1
    copy %tmp.1 -> %holder
    &2: ref [4 x #bit32] = field.addr %holder .items  // idx 1
    copy &2 -> %tmp.3
    &3: ref [4 x #bit32] = copy %tmp.3
    &4: #bit_native = const 0x2
    &5: ref #bit32 = elem.addr &3, &4
    copy &5 -> %slot
    &6: #bit32 = const 0x7
    copy &6 -> ref %slot
    &7: #bit_native = const 0x4
    copy &7 -> %count
    return
}
