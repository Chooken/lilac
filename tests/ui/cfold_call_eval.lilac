parse: function (buf: @byte_buffer) result: @bit_native {
    i: @bit_native = 0x0
    acc: @bit_native = 0x0
    len: @bit_native = @byte_buffer_len(buf)
    ptr: ref @bit8 = @byte_buffer_ptr(buf)
    loop {
        if @i_less_than_native(i, len) {
            c: @bit_native = @extend_zero(@load_u8(ptr, i))
            acc = @i_add_native(acc, c)
            i = @i_add_native(i, 0x1)
        } else {
            break
        }
    }
    result = acc
}

main: function () nothing {
    total: @bit_native = parse("AB")
}
