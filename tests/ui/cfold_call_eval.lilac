parse: function (buf: @byte_buffer) result: @bitNative {
    i: @bitNative = 0x0
    acc: @bitNative = 0x0
    len: @bitNative = @byte_buffer_len(buf)
    ptr: ref @bit8 = @byte_buffer_ptr(buf)
    loop {
        if @i_less_than(i, len) {
            c: @bitNative = @extend_zero(@load_u8(ptr, i))
            acc = @iadd(acc, c)
            i = @iadd(i, 0x1)
        } else {
            break
        }
    }
    result = acc
}

main: function () nothing {
    total: @bitNative = parse("AB")
}
