lilac_ir = "0.2"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %conditional : zeroed
    alloca #bit8 %t.1 : zeroed
    &1: #bit32 = const 0x0
    copy &1 -> %conditional
    &2: #bit8 = const 0x0
    branch $l.2
  $l.2:
    &4: #bit8 = const 0x0
    copy &4 -> %t.1
    branch $l.3
  $l.3:
    &5: #bit8 = copy %t.1
    branch.if &5, $l.4, $l.5
  $l.4:
    &6: #bit32 = const 0x1
    copy &6 -> %conditional
    branch $l.6
  $l.5:
    branch $l.6
  $l.6:
    return
}
