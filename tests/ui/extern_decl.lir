lilac_ir = "0.4"
target = "x86_64-unknown-none"
!c0: str = "hi"
extern @write
  in #bit32 %fd
  in ref #unknown %buf
  in #bit_native %n
  out #bit_native %result
function @main
{
  $entry:
    alloca #byte_buffer %s : zeroed
    alloca #bit_native %n : zeroed
    alloca #bit_native %tmp.1 : zeroed
    alloca #bit32 %tmp.2 : zeroed
    alloca #byte_buffer %tmp.3 : zeroed
    alloca ref #bit8 %tmp.4 : zeroed
    alloca ref #unknown %tmp.5 : zeroed
    alloca #byte_buffer %tmp.6 : zeroed
    alloca #bit_native %tmp.7 : zeroed
    &1: #byte_buffer = const !c0
    copy &1 -> %s
    &2: #bit32 = const 0x1
    copy &2 -> %tmp.2
    copy %s -> %tmp.3
    call @.lilac.byte_buffer_ptr (in %tmp.3) (out %tmp.4)
    &3: ref #bit8 = copy %tmp.4
    &4: ref #unknown = bitcast &3
    copy &4 -> %tmp.5
    copy %s -> %tmp.6
    call @.lilac.byte_buffer_len (in %tmp.6) (out %tmp.7)
    call @write (in %tmp.2, %tmp.5, %tmp.7) (out %tmp.1)
    copy %tmp.1 -> %n
    return
}
function @.lilac.byte_buffer_ptr
  in #byte_buffer %buffer
  out ref #bit8 %out
{
  $entry:
    &r: ref #bit8 = field %buffer .data  // idx 1
    copy &r -> %out
    return
}
function @.lilac.byte_buffer_len
  in #byte_buffer %buffer
  out #bit_native %out
{
  $entry:
    &r: #bit_native = field %buffer .len  // idx 0
    copy &r -> %out
    return
}
