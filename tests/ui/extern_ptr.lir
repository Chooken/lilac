lilac_ir = "0.4"
target = "x86_64-unknown-none"
extern @malloc
  in #bit_native %size
  out ref #unknown %result
extern @free
  in ref #unknown %p
function @main
{
  $entry:
    alloca ref #bit8 %p : zeroed
    alloca ref #bit8 %tmp.1 : zeroed
    alloca #bit_native %tmp.2 : zeroed
    alloca ref #unknown %tmp.3 : zeroed
    alloca ref #bit8 %tmp.4 : zeroed
    alloca ref #unknown %tmp.5 : zeroed
    &1: #bit_native = const 0x10
    copy &1 -> %tmp.2
    call @malloc (in %tmp.2) (out %tmp.3)
    &2: ref #unknown = copy %tmp.3
    &3: ref #bit8 = bitcast &2
    copy &3 -> %tmp.1
    copy %tmp.1 -> %p
    copy %p -> %tmp.4
    &4: ref #bit8 = copy %tmp.4
    &5: ref #unknown = bitcast &4
    copy &5 -> %tmp.5
    call @free (in %tmp.5) (out)
    return
}
