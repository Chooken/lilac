lilac_ir = "0.3"
target = "x86_64-unknown-none"
extern @malloc
  in #bit64 %size
  out ref #bit8 %result
extern @free
  in ref #bit8 %p
function @main
{
  $entry:
    alloca ref #bit8 %p : zeroed
    alloca ref #bit8 %tmp.1 : zeroed
    alloca #bit64 %tmp.2 : zeroed
    alloca ref #bit8 %tmp.3 : zeroed
    &1: #bit64 = const 0x10
    copy &1 -> %tmp.2
    call @malloc (in %tmp.2) (out %tmp.1)
    copy %tmp.1 -> %p
    copy %p -> %tmp.3
    call @free (in %tmp.3) (out)
    return
}
