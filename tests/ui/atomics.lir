lilac_ir = "0.4"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %value : zeroed
    alloca #bit32 %old : zeroed
    alloca #bit_native %wide : zeroed
    alloca #bit_native %count : zeroed
    &1: #bit32 = const 0x5
    copy &1 -> %value
    &2: ref #bit32 = addr %value
    &3: #bit32 = atomic.load.acquire &2
    copy &3 -> %old
    &4: ref #bit32 = addr %value
    &5: #bit32 = const 0x7
    atomic.store.release #bit32 &5 -> &4
    &6: ref #bit32 = addr %value
    &7: #bit32 = const 0x1
    &8: #bit32 = atomic.add.seq_cst &6, &7
    copy &8 -> %old
    &9: ref #bit32 = addr %value
    &10: #bit32 = const 0x9
    &11: #bit32 = atomic.max.u.relaxed &9, &10
    copy &11 -> %old
    &12: ref #bit32 = addr %value
    &13: #bit32 = const 0x9
    &14: #bit32 = const 0x2
    &15: #bit32 = atomic.cmpxchg.acq_rel &12, &13, &14
    copy &15 -> %old
    fence.seq_cst
    &16: #bit_native = const 0x0
    copy &16 -> %wide
    &17: ref #bit_native = addr %wide
    &18: #bit_native = const 0x1
    &19: #bit_native = atomic.swap.seq_cst &17, &18
    copy &19 -> %count
    return
}
