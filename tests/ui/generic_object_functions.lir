lilac_ir = "0.4"
target = "x86_64-unknown-none"
type #GenObject.1..bit32 size 4 align 4 {
    value: #bit32,
}
function @main
{
  $entry:
    alloca #GenObject.1..bit32 %variable : zeroed
    alloca #GenObject.1..bit32 %tmp.1 : zeroed
    alloca #bit32 %value : zeroed
    alloca #bit32 %tmp.2 : zeroed
    alloca ref #GenObject.1..bit32 %tmp.3 : zeroed
    zero %tmp.1
    &1: #bit32 = const 0x0
    copy &1 -> %tmp.1.value  // idx 0
    copy %tmp.1 -> %variable
    &2: ref #GenObject.1..bit32 = addr %variable
    copy &2 -> %tmp.3
    call @GenObject.1..bit32.get (in %tmp.3) (out %tmp.2)
    copy %tmp.2 -> %value
    return
}
function @GenObject.1..bit32.get
  in ref #GenObject.1..bit32 %self
  out #bit32 %result
{
  $entry:
    zero %result
    &1: #bit32 = field %self .value  // idx 0
    copy &1 -> %result
    return
}
