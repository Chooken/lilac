main: function (a: @bit32, b: @bit32, w: @bit_native) nothing {
    one: @bit32 = 0x1
    divisor: @bit32 = @i_add(b, one)
    quotient: @bit32 = @i_div_u(a, divisor)
    remainder: @bit32 = @i_mod_u(a, divisor)
    if @i_less_than_u(a, divisor) {
        quotient = 0x1
    }
    if @i_greater_than_u(a, divisor) {
        remainder = 0x1
    }
    native_one: @bit_native = 0x1
    wide_divisor: @bit_native = @i_add(w, native_one)
    wide_quotient: @bit_native = @i_div_u(w, wide_divisor)
    wide_remainder: @bit_native = @i_mod_u(w, wide_divisor)
}
