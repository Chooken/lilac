lilac_ir = "0.2"
target = "x86_64-unknown-none"
!c0: str = "AB"
function @parse
  in #byte_buffer %buf
  out #bitNative %result
{
  $entry:
    alloca #bitNative %i : zeroed
    alloca #bitNative %acc : zeroed
    alloca #bitNative %len : zeroed
    alloca #bitNative %tmp.1 : zeroed
    alloca ref #bit8 %ptr : zeroed
    alloca ref #bit8 %tmp.2 : zeroed
    alloca #bitNative %c : zeroed
    alloca #bit8 %tmp.3 : zeroed
    &1: #bitNative = const 0x0
    copy &1 -> %i
    &2: #bitNative = const 0x0
    copy &2 -> %acc
    call @byte_buffer_len (in %buf) (out %tmp.1)
    &3: #bitNative = copy %tmp.1
    copy &3 -> %len
    call @byte_buffer_ptr (in %buf) (out %tmp.2)
    &4: ref #bit8 = copy %tmp.2
    copy &4 -> %ptr
    branch $l.1
  $l.1:
    &5: #bitNative = copy %i
    &6: #bitNative = copy %len
    &7: #bit8 = i.cmp.lt &5, &6
    branch.if &7, $l.3, $l.4
  $l.3:
    call @load_u8 (in %ptr, %i) (out %tmp.3)
    &8: #bit8 = copy %tmp.3
    &9: #bitNative = extend.zero &8
    copy &9 -> %c
    &10: #bitNative = copy %acc
    &11: #bitNative = copy %c
    &12: #bitNative = i.add &10, &11
    copy &12 -> %acc
    &13: #bitNative = copy %i
    &14: #bitNative = const 0x1
    &15: #bitNative = i.add &13, &14
    copy &15 -> %i
    branch $l.5
  $l.4:
    branch $l.2
  $l.5:
    branch $l.1
  $l.2:
    copy %acc -> %result
    return
}
function @main
{
  $entry:
    alloca #bitNative %total : zeroed
    alloca #bitNative %tmp.1 : zeroed
    alloca #byte_buffer %tmp.2 : zeroed
    &1: #byte_buffer = const !c0
    copy &1 -> %tmp.2
    &cf.1: #bitNative = const 0x83
    copy &cf.1 -> %tmp.1
    copy %tmp.1 -> %total
    return
}
