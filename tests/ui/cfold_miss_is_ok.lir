lilac_ir = "0.2"
target = "x86_64-unknown-none"
function @add_one
  in #bit32 %x
  out #bit32 %result
{
  $entry:
    &1: #bit32 = copy %x
    &2: #bit32 = const 0x1
    &3: #bit32 = i.add &1, &2
    copy &3 -> %result
    return
}
function @main
  in #bit32 %n
{
  $entry:
    alloca #bit32 %y : zeroed
    alloca #bit32 %tmp.1 : zeroed
    call @add_one (in %n) (out %tmp.1)
    copy %tmp.1 -> %y
    return
}
