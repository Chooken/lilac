lilac_ir = "0.3"
target = "x86_64-unknown-none"
function @add_one
  in #bit32 %x
  out #bit32 %result
{
  $entry:
    zero %result
    &1: #bit32 = const 0x1
    &2: #bit32 = copy %x
    &3: #bit32 = i.add &2, &1
    copy &3 -> %result
    return
}
function @main
  in #bit32 %n
{
  $entry:
    alloca #bit32 %y : zeroed
    alloca #bit32 %tmp.1 : zeroed
    alloca #bit32 %tmp.2 : zeroed
    copy %n -> %tmp.2
    call @add_one (in %tmp.2) (out %tmp.1)
    copy %tmp.1 -> %y
    return
}
