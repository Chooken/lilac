lilac_ir = "0.2"
target = "x86_64-unknown-none"
function @main
{
  $entry:
    alloca #bit32 %variable : zeroed
    alloca #bit32 %result : zeroed
    &1: #bit32 = const 0x2
    copy &1 -> %variable
    &2: #bit32 = copy %variable
    &3: #bit32 = const 0x1
    &4: #bit32 = i.add &2, &3
    copy &4 -> %result
    return
}
