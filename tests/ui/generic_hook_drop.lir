lilac_ir = "0.4"
target = "x86_64-unknown-none"
type #GenBox[m] size 4 align 4 {
    value: #bit32,
}
function @main
{
  $entry:
    alloca #GenBox[m] %box : zeroed
    alloca #GenBox[m] %tmp.1 : zeroed
    alloca ref #GenBox[m] %tmp.2 : zeroed
    zero %tmp.1
    &1: #bit32 = const 0x0
    copy &1 -> %tmp.1.value  // idx 0
    copy %tmp.1 -> %box
    &2: ref #GenBox[m] = addr %box
    copy &2 -> %tmp.2
    call @GenBox[m].@on_drop(RI6GenBoxmEE) (in %tmp.2) (out)
    drop %box
    return
}
function @GenBox[m].@on_drop(RI6GenBoxmEE)
  in ref #GenBox[m] %from
{
  $entry:
    alloca ref #bit32 %tmp.1 : zeroed
    &1: #bit32 = const 0x0
    &2: ref #bit32 = field.addr %from .value  // idx 0
    copy &2 -> %tmp.1
    copy &1 -> ref %tmp.1
    return
}
