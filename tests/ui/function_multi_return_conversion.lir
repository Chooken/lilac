lilac_ir = "0.4"
target = "x86_64-unknown-none"
function @@conversion(mEh)
  in #bit32 %from
  out #bit8 %to
{
  $entry:
    zero %to
    &1: #bit32 = copy %from
    &2: #bit8 = trunc &1
    copy &2 -> %to
    return
}
function @.root.get_multi
  out #bit32 %condition
  out #bit32 %result
{
  $entry:
    zero %condition
    zero %result
    &1: #bit32 = const 0x1
    copy &1 -> %condition
    &2: #bit32 = const 0x2
    copy &2 -> %result
    return
}
function @main
{
  $entry:
    alloca #bit32 %l.0 : zeroed
    alloca #bit32 %l.1 : zeroed
    alloca #bit8 %condition : zeroed
    alloca #bit8 %tmp.1 : zeroed
    alloca #bit32 %tmp.2 : zeroed
    alloca #bit32 %return_val : zeroed
    call @.root.get_multi (in) (out %l.0, %l.1)
    copy %l.0 -> %tmp.2
    call @@conversion(mEh) (in %tmp.2) (out %tmp.1)
    copy %tmp.1 -> %condition
    copy %l.1 -> %return_val
    return
}
