lilac_ir = "0.5"
target = "x86_64-unknown-none"
type #Pair size 16 align 8 {
    low: #bit64,
    high: #bit64,
}
function @main
{
  $entry:
    alloca #Pair %pair : zeroed
    alloca #Pair %tmp.1 : zeroed
    alloca ref #unknown %base : zeroed
    alloca ref #unknown %tmp.2 : zeroed
    alloca #bit_native %tmp.3 : zeroed
    alloca ref #unknown %tmp.4 : zeroed
    alloca ref #unknown %tmp.5 : zeroed
    alloca #bit_native %tmp.6 : zeroed
    alloca ref #unknown %tmp.7 : zeroed
    alloca #bit8 %tmp.8 : zeroed
    alloca #bit_native %tmp.9 : zeroed
    alloca #bit_native %address : zeroed
    alloca ref #unknown %again : zeroed
    zero %tmp.1
    &1: #bit64 = const 0x706050403020100
    copy &1 -> %tmp.1.low  // idx 0
    &2: #bit64 = const 0x0
    copy &2 -> %tmp.1.high  // idx 1
    copy %tmp.1 -> %pair
    &3: ref #Pair = addr %pair
    &4: ref #unknown = copy &3
    copy &4 -> %base
    copy %base -> %tmp.2
    &5: #bit_native = const 0x2
    copy &5 -> %tmp.3
    call @ptr_add (in %tmp.2, %tmp.3) (out %tmp.4)
    copy %base -> %tmp.5
    &6: #bit_native = const 0x8
    copy &6 -> %tmp.6
    call @memmove (in %tmp.4, %tmp.5, %tmp.6) (out)
    copy %base -> %tmp.7
    &7: #bit8 = const 0x0
    copy &7 -> %tmp.8
    &8: #bit_native = const 0x8
    copy &8 -> %tmp.9
    call @memset (in %tmp.7, %tmp.8, %tmp.9) (out)
    &9: ref #unknown = copy %base
    &10: #bit_native = bitcast &9
    copy &10 -> %address
    &11: #bit_native = copy %address
    &12: ref #unknown = bitcast &11
    copy &12 -> %again
    &13: ref #unknown = copy %again
    &14: #bit_native = bitcast &13
    &15: #bit_native = copy %address
    &16: #bit8 = i.cmp.lt.u &14, &15
    branch.if &16, $l.1, $l.2
  $l.1:
    call @lilac_abort (in) (out)
    unreachable
  $l.2:
    branch $l.3
  $l.3:
    return
}
