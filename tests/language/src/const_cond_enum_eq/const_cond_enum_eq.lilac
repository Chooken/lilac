// `==` on constant either values (with or without a payload) decides at
// lowering, so the arms it rules out are never lowered.

using Standard

Mode: either {
    Fast
    Small
    Level: @bit32
}

MODE: Mode => .Level(0x3)

program: function () code: @bit32 {
    code = 0x0
    if MODE == .Level(0x3) {
        code = 0x7
    } else {
        @compile_error("`MODE == .Level(0x3)` must hold")
    }
    if MODE == .Level(0x4) {
        @compile_error("`MODE == .Level(0x4)` must not hold")
    }
    if .Fast == MODE {
        @compile_error("`.Fast == MODE` must not hold")
    }
    if @builtin.Target.os == @builtin.Os.Windows {
    } else if @builtin.Target.os == .Windows {
        @compile_error("the two spellings must agree")
    }
}

test "const_cond_enum_eq" {
    Transcript.expect_code(program(), 0x7)
}
