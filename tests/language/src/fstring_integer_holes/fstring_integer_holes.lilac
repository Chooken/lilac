// Holes of a builtin integer type format through a top-level `@format`
// hook for that builtin, and two holes in one f-string each get their
// own value.

using Standard.Os as Os

// Writes formatted text straight to standard output.
Out: structure {
    write: function (self, text: @format_args(Out)) nothing {
        last: @bit_native = @format_args_holes(text)
        index: @bit_native = 0x0
        loop {
            write_bytes(@format_args_piece(text, index))
            if index == last { break }
            @format_args_hole(text, index, self)
            index = @i_add_native(index, 0x1)
        }
    }
}

// A `@bit32` in unsigned decimal.
@format: function (value: ref @bit32, out: ref Out) nothing {
    write_decimal(value)
}

write_decimal: function (value: @bit32) nothing {
    if @i_greater_than_or_equal_u_32(value, 0xA) {
        write_decimal(@i_div_u_32(value, 0xA))
    }
    digit: @bit_native = @extend_zero(@i_mod_u_32(value, 0xA))
    digits: ref unknown = @byte_buffer_ptr("0123456789") as ref unknown
    write_bytes(@byte_buffer_from(@ptr_add(digits, digit) as ref @bit8, 0x1))
}

write_bytes: function (bytes: @byte_buffer) nothing {
    Transcript.record(bytes)
}

program: function () nothing {
    out: Out = Out {}
    a: @bit32 = 0x7
    b: @bit32 = 0x23
    sum: @bit32 = @i_add_32(a, b)
    out.write($"{a} + {b} = {sum}\n")
    zero: @bit32 = 0x0
    max: @bit32 = 0xFFFFFFFF
    out.write($"{zero} and {max}\n")
}

test "fstring_integer_holes" {
    program()
    Transcript.expect_printed("7 + 35 = 42\n0 and 4294967295\n")
}
