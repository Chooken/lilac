// A call returning a `ref` is a place: `=` and `op=` write through the
// reference, also to a field of what it points to. `op=` runs the call
// once. The old value of an element with an `@on_drop` drops once, when
// it is replaced.

using Standard
using Transcript
using Standard.Collections

Point: structure {
    x: Int
    y: Int
}

Leaf: structure {
    c: @bit32

    @on_copy: function (self) copy: Leaf {
        copy = Leaf { c = self.c }
    }

    @on_drop: function (self) nothing {
        print($"{self.c as Scalar}")
    }
}

calls: Int = 0

first: function (list: ref List[Int]) value: ref Int {
    calls += 1
    value = list.get(0)
}

program: function () nothing {
    numbers: List[Int] = List[Int].new()
    numbers.add(1)
    numbers.add(2)
    numbers.add(3)
    numbers.get(0) = 5
    print_line($"{numbers.get(0)} {numbers.get(1)} {numbers.get(2)}")

    numbers.get(0) += 10
    numbers.get(2) *= 4
    numbers.get(2) += 1
    print_line($"{numbers.get(0)} {numbers.get(1)} {numbers.get(2)}")

    points: List[Point] = List[Point].new()
    points.add(Point { x = 1, y = 2 })
    points.get(0).y = 9
    print_line($"{points.get(0).x} {points.get(0).y}")
    points.get(0).x += 3
    print_line($"{points.get(0).x} {points.get(0).y}")

    first(ref numbers) += 1
    first(ref numbers) = 0
    print_line($"{calls}")

    {
        leaves: List[Leaf] = List[Leaf].new()
        leaves.add(Leaf { c = 'a' })
        print("[")
        leaves.get(0) = Leaf { c = 'b' }
        print("]")
        leaves.add(Leaf { c = 'x' })
        print("[")
        leaves.remove(1)
        print("]")
    }
    print_line("")
}

test "assign_through_call" {
    program()
    Transcript.expect_printed("5 2 3\n15 2 13\n1 9\n4 9\n2\n[a][x]b\n")
}
