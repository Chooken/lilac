// The first assignment of an out slot fills it: nothing was there, so
// nothing drops. A zero drop would print `z`.

using Standard
using Transcript

Tag: structure {
    c: @bit32

    @on_drop: function (self) nothing {
        if self.c == 0x0 {
            print("z")
        } else {
            print($"{self.c as Scalar}")
        }
    }
}

make: function () value: Tag {
    value = Tag { c = 'x' }
}

program: function () nothing {
    {
        t: Tag = make()
        print("|")
    }
    print("\n")
}

test "out_slot_no_zero_drop" {
    program()
    Transcript.expect_printed("|x\n")
}
