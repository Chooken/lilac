// A literal on either side of a `Standard` number's operator takes that
// number's width through the mixed `(T, @bitW)`/`(@bitW, T)` hooks (and
// `@fbitW` for floats), so it needs no `as`.

using Standard
using Transcript

program: function () nothing {
    n: Int32 = 7
    print_line($"{n * 3} {21 / 3} {0 - n} {1 < n} {n >= 7} {n % 2} {15 / n}")
    big: Uint32 = 1000000000
    small: Uint8 = 100
    wide: Uint16 = 65534
    print_line($"{big * 3} {small * 2} {wide + 1}")
    x: Float64 = 3.5
    y: Float32 = 0.5
    print_line($"{(x * 2.0).to_int32_truncated()} {(2.0 * y).to_int32_truncated()} {(-x + 0.5).to_int32_truncated()} {(1.0 / y).to_int32_truncated()}")
}

test "numeric_mixed_literals" {
    program()
    Transcript.expect_printed("21 7 -7 true true 1 2\n3000000000 200 65535\n7 1 -3 2\n")
}
