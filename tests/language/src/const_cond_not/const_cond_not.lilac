// `not` and `!=` on constants decide at lowering like `==`, so the arms
// they rule out are never lowered; they decide top-level conditional
// items and fold into global initializers too.

using Standard

DEBUG: @bit8 => 0x0
LEVEL: @bit32 => 0x3

if not @builtin.Target.libc {
    picked: function () n: @bit32 => 0x2
} else {
    picked: function () n: @bit32 => 0x40
}

if LEVEL != 0x3 {
    missing: function () nothing {}
}

differs: @bit8 = LEVEL != 0x4

program: function () code: @bit32 {
    code = picked()
    if not DEBUG {
        code = @i_add_32(code, 0x1)
    } else {
        @compile_error("`not DEBUG` must hold")
    }
    if LEVEL != 0x3 {
        @compile_error("`LEVEL != 0x3` must not hold")
    }
    if not (LEVEL != 0x3) and differs {
        code = @i_add_32(code, 0x3)
    }
}

test "const_cond_not" {
    Transcript.expect_code(program(), 0x6)
}
