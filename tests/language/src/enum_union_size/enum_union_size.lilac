// An either is a tagged union, the C `struct { uint8_t tag; union { … }
// payload; }`: three 256-byte payloads share one area after the tag, so the
// either is 257 bytes, aligned 1.


Three: either {
    A: @array(@bit8, 0x100)
    B: @array(@bit8, 0x100)
    C: @array(@bit8, 0x100)
}

check: function (ok: @bit8, code: @bit32) nothing {
    if ok {
    } else {
        Transcript.fail_with(code)
    }
}

program: function () nothing {
    size: @bit_native = @size_of(Three)
    align: @bit_native = @align_of(Three)
    check(size == 0x101, 0x1)
    check(align == 0x1, 0x2)
}

test "enum_union_size" {
    program()
}
