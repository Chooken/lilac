// A `loop` over an `if` chain with no final `else` ends once no branch
// runs. A capture `loop if` ends when its call fails, dropping the
// failure outs it does not capture; `continue` tests the condition again;
// an explicit `else` still runs until something breaks.

using Standard
using Transcript

Leaf: structure {
    c: @bit32

    @on_drop: function (self) nothing {
        print_char(self.c)
    }
}

Countdown: structure {
    left: Int

    // The next number, until none are left; the failure out is a `Leaf`.
    next: function (self) number: Int else leaf: Leaf {
        if self.left == 0 as Int {
            leaf = Leaf { c = 'z' }
            fail
        }
        number = self.left
        self.left -= 1
    }
}

program: function () nothing {
    i: Int = 0
    loop if i < 5 {
        i += 1
    }
    print_line($"{i}")

    // Each link is tested in turn; the loop ends when both are false.
    a: Int = 0
    b: Int = 0
    loop if a < 3 {
        a += 1
    } else if b < 2 {
        b += 1
    }
    print_line($"{a} {b}")

    count: Countdown { left = 3 }
    loop if count.next() -> n: Int {
        print($"{n} ")
    }
    print_char('[')
    {
        again: Countdown { left = 0 }
        loop if again.next() -> n: Int {
            print($"{n} ")
        }
    }
    print_char(']')
    print_line("")

    // The odd numbers up to 9.
    sum: Int = 0
    j: Int = 0
    loop if j < 10 {
        j += 1
        if j % 2 == 0 as Int {
            continue
        }
        sum += j
    }
    print_line($"{sum}")

    k: Int = 0
    loop if k > 100 {
        k = 0
    } else {
        k += 1
        if k == 4 as Int {
            break
        }
    }
    print_line($"{k}")
}

test "loop_if_implicit_break" {
    program()
    Transcript.expect_printed("5\n3 2\n3 2 1 z[z]\n25\n4\n")
}
