// `@needs_drop(T)` is a constant: whether dropping a `T` does anything
// (its own `@on_drop`, or a field that needs one). As a condition, only
// the live arm is lowered, so a `@compile_error` in the other never fires.

using Standard

Hooked: structure {
    id: @bit32

    @on_drop: function (self) nothing {
    }
}

Holder: structure {
    inner: Hooked
}

Plain: structure {
    id: @bit32
    next: ref Plain
}

refuses_drops[T]: function () nothing {
    if @needs_drop(T) {
        @compile_error("a type that needs a drop")
    }
}

program: function () nothing {
    refuses_drops[Plain]()
    refuses_drops[@bit64]()
    refuses_drops[ref Hooked]()
    if @needs_drop(Hooked) == 0x0 {
        Transcript.fail_with(0x1)
    }
    if @needs_drop(Holder) == 0x0 {
        Transcript.fail_with(0x2)
    }
    if @needs_drop(Box[@bit8]) == 0x0 {
        Transcript.fail_with(0x3)
    }
}

test "needs_drop" {
    program()
}
