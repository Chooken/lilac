// Drop order: a by-value parameter is dropped by the callee, `return`
// drops live locals, a structure drops itself before its fields (in
// declaration order), and locals drop in reverse declaration order.

using Standard
using Transcript

Inner: structure {
    c: @bit32

    @on_drop: function (self) nothing {
        print($"{self.c as Scalar}")
    }
}

Outer: structure {
    a: Inner
    b: Inner

    @on_drop: function (self) nothing {
        print("O")
    }
}

take: function (v: Inner) nothing {
}

early: function () nothing {
    k: Inner = Inner { c = 'r' }
    return
}

program: function () nothing {
    {
        x: Inner = Inner { c = 'x' }
        o: Outer = Outer { a = Inner { c = 'a' }, b = Inner { c = 'b' } }
        take(Inner { c = 'p' })
        early()
        print("|")
    }
    print("\n")
}

test "drop_order" {
    program()
    Transcript.expect_printed("pr|Oabx\n")
}
