// The ownership state at a loop's head takes more than one walk of the body
// to settle: moves and new values on different branches, in nested loops,
// on `continue` and `break` paths. Each place drops exactly once, and only
// while it holds a value.

using Standard
using Transcript

Leaf: structure {
    c: @bit32

    @on_drop: function (self) nothing {
        print($"{self.c as Scalar}")
    }
}

Pair: structure {
    left: Leaf
    right: Leaf
}

keep: function (leaf: Leaf) nothing {
    print("k")
}

// A field moves out in the inner loop's `continue` path and is set again
// before each move; the other field is overwritten on the fall-through
// path. After the loops `left` may be empty, so it drops under its flag.
nested_fields: function () nothing {
    pair: Pair = Pair { left = Leaf { c = 'a' }, right = Leaf { c = 'b' } }
    i: @bit32 = 0x0
    loop {
        i = @i_add_32(i, 0x1)
        if i == 0x4 {
            break
        }
        j: @bit32 = 0x0
        loop {
            j = @i_add_32(j, 0x1)
            if j == 0x3 {
                break
            }
            if j == i {
                pair.left = Leaf { c = 'n' }
                keep(pair.left)
                continue
            }
            pair.right = Leaf { c = 'm' }
        }
        print("|")
    }
    print(";")
}

// The inner loop leaves through three `break`s: one after a move, one
// with the value untouched, one after a new value. The outer `break` sees
// it maybe moved, and the next round sets it again.
break_paths: function () nothing {
    leaf: Leaf = Leaf { c = 'x' }
    i: @bit32 = 0x0
    loop {
        i = @i_add_32(i, 0x1)
        loop {
            if i == 0x2 {
                keep(leaf)
                break
            }
            if i == 0x3 {
                break
            }
            leaf = Leaf { c = @i_add_32('0', i) }
            break
        }
        if i == 0x3 {
            break
        }
        leaf = Leaf { c = 'y' }
    }
    print(";")
}

// Three levels: the innermost loop moves a field on some rounds and
// leaves through a `continue` or a `break`, the middle one sets the field
// again before each inner loop, and the outer one sets it again on all
// rounds but the last.
three_levels: function () nothing {
    pair: Pair = Pair { left = Leaf { c = 'p' }, right = Leaf { c = 'r' } }
    i: @bit32 = 0x0
    loop {
        i = @i_add_32(i, 0x1)
        j: @bit32 = 0x0
        loop {
            j = @i_add_32(j, 0x1)
            if j == 0x2 {
                break
            }
            pair.left = Leaf { c = 's' }
            k: @bit32 = 0x0
            loop {
                k = @i_add_32(k, 0x1)
                if k == 0x2 {
                    break
                }
                if i == 0x2 {
                    continue
                }
                keep(pair.left)
                break
            }
        }
        print("|")
        if i == 0x3 {
            break
        }
        pair.left = Leaf { c = 'q' }
    }
    print(";")
}

program: function () nothing {
    nested_fields()
    print("\n")
    break_paths()
    print("\n")
    three_levels()
    print("\n")
}

test "loop_ownership_settles" {
    program()
    Transcript.expect_printed("aknb|mkn|mm|;m\nx1ky;y\npks|q|sqks|;r\n")
}
