
bump: function (c: ref @bit32) v: @bit32 {
    c = @i_add_32(c, 0x1)
    v = c
}

twice: function (v: @bit32) r: @bit32 => @i_add_32(v, v)

program: function () code: @bit32 {
    count: @bit32 = 0x0
    t: @bit32 = twice(bump(ref count))
    code = count
}

test "inline_single_evaluation" {
    Transcript.expect_code(program(), 0x1)
}
