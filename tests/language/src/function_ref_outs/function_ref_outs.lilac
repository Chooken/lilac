// A function type's outs are `nothing`, one slot or a parenthesized list,
// so a function type ends at its out inside a parameter list: `apply`
// takes `f` and then `value`. More than one out is written `(q, r)`, which a
// declaration may write too (`divide_slow`).

using Transcript

Divider: structure {
    divide: ref function (n: @bit32, d: @bit32) (quotient: @bit32, remainder: @bit32)
}

double: function (value: @bit32) doubled: @bit32 {
    doubled = @i_add_32(value, value)
}

apply: function (f: ref function (@bit32) @bit32, value: @bit32) out: @bit32 {
    out = f(value)
}

divide_slow: function (n: @bit32, d: @bit32) (quotient: @bit32, remainder: @bit32) {
    quotient = 0x0
    remainder = n
    loop if @i_less_than_or_equal_32(d, remainder) {
        remainder = @i_sub_32(remainder, d)
        quotient = @i_add_32(quotient, 0x1)
    }
}

run: function (divide: ref function (@bit32, @bit32) (@bit32, @bit32), n: @bit32, d: @bit32) nothing {
    q: @bit32, r: @bit32 = divide(n, d)
    print_line($"{q} {r}")
}

program: function () nothing {
    print_line($"{apply(ref double, 0x3)}")
    run(ref divide_slow, 0x10, 0x7)
    divider: Divider = Divider { divide = ref divide_slow }
    q: @bit32, r: @bit32 = divider.divide(0xA, 0x3)
    print_line($"{q} {r}")
}

test "function_ref_outs" {
    program()
    Transcript.expect_printed("6\n2 2\n3 1\n")
}
