// The bitwise intrinsics at run time and folded in a constant condition:
// `and`/`or`/`xor`/`not`, shifts taking the amount modulo the width, and
// `@extend_sign`.


check: function (actual: @bit32, want: @bit32, code: @bit32) nothing {
    if actual == want {
    } else {
        Transcript.fail_with(code)
    }
}

flags: @bit32 => @bit_or_32(0x40, 0x200)
at_cwd: @bit32 => @extend_sign(@i_negate_8(0x64))

program: function () nothing {
    a: @bit32 = 0xF0F0
    b: @bit32 = 0x0FF0
    check(@bit_and_32(a, b), 0x00F0, 0x1)
    check(@bit_or_32(a, b), 0xFFF0, 0x2)
    check(@bit_xor_32(a, b), 0xFF00, 0x3)
    check(@bit_not_32(a), 0xFFFF0F0F, 0x4)
    one: @bit32 = 0x1
    check(@bit_shift_left_32(one, 0x4), 0x10, 0x5)
    // The amount is taken modulo 32.
    check(@bit_shift_left_32(one, 0x21), 0x2, 0x6)
    minus: @bit32 = 0x80000000
    check(@bit_shift_right_32(minus, 0x4), 0xF8000000, 0x7)
    check(@bit_shift_right_u_32(minus, 0x4), 0x08000000, 0x8)
    byte: @bit8 = 0x81
    check(@extend_zero(@bit_shift_right_8(byte, 0x1)), 0xC0, 0x9)
    if @bit_and_32(flags, 0x200) == 0x0 {
        @compile_error("the constant `or` lost a bit")
    }
    check(flags, 0x240, 0xA)
    // Sign extension, at run time and folded.
    negative: @bit8 = 0xFE
    check(@extend_sign(negative), 0xFFFFFFFE, 0xB)
    positive: @bit8 = 0x7F
    check(@extend_sign(positive), 0x7F, 0xC)
    wide: @bit64 = @extend_sign(minus)
    if wide == 0xFFFFFFFF80000000 {
    } else {
        Transcript.fail_with(0xD)
    }
    check(at_cwd, 0xFFFFFF9C, 0xE)
}

test "bitwise" {
    program()
}
