// The instruction builtins: `@memmove` over overlapping ranges, `@memset`,
// pointer math through `@ptr_add`, `@ptr_to_address` and
// `@address_to_ptr`, and `@align_of`.


Bytes: structure {
    low: @bit64
    high: @bit64
}

Mixed: structure {
    a: @bit8
    b: @bit32
}

// Fails with `code` unless `actual` is `want`.
expect: function (actual: @bit64, want: @bit64, code: @bit32) nothing {
    if @i_less_than_u_64(actual, want) {
        Transcript.fail_with(code)
    }
    if @i_greater_than_u_64(actual, want) {
        Transcript.fail_with(code)
    }
}

program: function () nothing {
    bytes: Bytes = Bytes { low = 0x0706050403020100, high = 0x0 }
    base: ref unknown = ref bytes as ref unknown
    // Shift bytes 0..8 up by two: the ranges overlap.
    @memmove(@ptr_add(base, 0x2), base, 0x8)
    expect(bytes.low, 0x0504030201000100, 0x1)
    expect(bytes.high, 0x0706, 0x2)
    @memset(base, 0xab, 0x3)
    expect(bytes.low, 0x0504030201ababab, 0x3)
    address: @bit_native = @ptr_to_address(base)
    third: ref @bit8 = @address_to_ptr(@i_add_native(address, 0x3)) as ref @bit8
    expect(@extend_zero(@load_u8(third, 0x0)), 0x01, 0x4)
    null: ref unknown = @address_to_ptr(0x0)
    expect(@extend_zero(@ptr_to_address(null)), 0x0, 0x5)
    expect(@extend_zero(@align_of(Mixed)), 0x4, 0x6)
    expect(@extend_zero(@align_of(@bit64)), 0x8, 0x7)
    expect(@extend_zero(@align_of(@bit8)), 0x1, 0x8)
}

test "memory_builtins" {
    program()
}
