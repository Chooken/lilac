// A `ref` either payload is read back as the pointer it stores, not the
// address of the payload slot.


Maybe[T]: either {
    Some: T
    None
}

program: function () code: @bit32 {
    x: @bit32 = 0x7
    m: Maybe[ref @bit32] = .Some(ref x)
    match m {
        .Some -> p: ref @bit32 {
            code = p
            return
        }
    }
    code = 0x0
}

test "ref_payload" {
    Transcript.expect_code(program(), 0x7)
}
