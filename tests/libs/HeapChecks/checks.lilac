// The checks `heap_allocators` and `heap_allocators_libc` run on each
// allocator.

using Standard
using Standard.Process
using Standard.Heap

check: function (ok: Bool, code: @bit32) nothing {
    if not ok {
        exit(code)
    }
}

drops: Int = 0

Counted: object {
    value: @bit64

    @on_drop: function (self) nothing {
        drops = drops + 1
    }
}

Empty: object {}

address: function (memory: ref unknown) Int => @ptr_to_address(memory)

/// Every check on one allocator; `base` numbers its failures.
exercise: function (allocator: Allocator, base: @bit32) nothing {
    words: Slice[@bit64] = allocator.allocate[@bit64](4)
    check(address(words.base() as ref unknown) % 8 == 0 as Int, base)
    allocator.deallocate[@bit64](words)

    bytes: Slice[@bit8] = allocator.allocate[@bit8](32)
    check(@load_u8(bytes.base(), 0x1F) == 0x0, @i_add_32(base, 0x1))
    @store_u8(bytes.base(), 0x0, 0x2A)
    @store_u8(bytes.base(), 0x1F, 0x2B)

    // Growing keeps the bytes and zeroes the rest.
    grown: Slice[@bit8] = allocator.reallocate[@bit8](bytes, 0x10000)
    check(@load_u8(grown.base(), 0x0) == 0x2A, @i_add_32(base, 0x2))
    check(@load_u8(grown.base(), 0x1F) == 0x2B, @i_add_32(base, 0x3))
    check(@load_u8(grown.base(), 0xFFFF) == 0x0, @i_add_32(base, 0x4))
    @store_u8(grown.base(), 0x20, 0x2C)

    // A shrink then a growth: what came back is zero again.
    shrunk: Slice[@bit8] = allocator.reallocate[@bit8](grown, 1)
    regrown: Slice[@bit8] = allocator.reallocate[@bit8](shrunk, 0x40)
    check(@load_u8(regrown.base(), 0x0) == 0x2A, @i_add_32(base, 0x5))
    check(@load_u8(regrown.base(), 0x1F) == 0x0 and @load_u8(regrown.base(), 0x20) == 0x0, @i_add_32(base, 0x6))
    allocator.deallocate[@bit8](regrown)

    // A zero size is an aligned address that takes nothing.
    empty: ref Empty = allocator.create[Empty](Empty {})
    check(address(empty as ref unknown) != 0 as Int, @i_add_32(base, 0x7))
    allocator.destroy[Empty](empty)
    none: Slice[@bit64] = allocator.allocate[@bit64](0)
    check(address(none.base() as ref unknown) % 8 == 0 as Int, @i_add_32(base, 0x8))
    allocator.deallocate[@bit64](none)

    // `create` moves in, `destroy` drops once, `free` drops nothing.
    before: Int = drops
    counted: ref Counted = allocator.create[Counted](Counted { value = 0x7 })
    check(counted.value == 0x7, @i_add_32(base, 0x9))
    allocator.destroy[Counted](counted)
    check(drops == before + 1, @i_add_32(base, 0xA))
    kept: ref Counted = allocator.create[Counted](Counted { value = 0x8 })
    moved: Counted = @read(kept)
    allocator.free[Counted](kept)
    check(moved.value == 0x8, @i_add_32(base, 0xB))
}
