// What a test program prints, kept instead of written. `print`,
// `print_line`, `print_byte` and `print_char` take what `Standard.Io`'s
// do, so a program written for `Io` checks its output with `using
// Transcript` in its place; `expect_printed` then compares the text.
// `tests/language` and `tests/standard` mount it.

using Standard
using Standard.Testing

print: function (text: Format) nothing {
    out: Formatter = Formatter.over[Recorder](ref recorded, ref Recorder.push)
    out.write(text)
}

print_line: function (text: Format) nothing {
    out: Formatter = Formatter.over[Recorder](ref recorded, ref Recorder.push)
    out.write(text)
    out.write_bytes("\n")
}

/// Keeps `bytes` as they are (a writer's sink in place of the output).
record: function (bytes: @byte_buffer) nothing {
    recorded.push(bytes)
}

print_byte: function (byte: @bit8) nothing {
    b: Byte = byte as Byte
    recorded.push(Slice[Byte].new(ref b, 1))
}

/// Keeps the code point `c` as UTF-8.
print_char: function (c: @bit32) nothing {
    if @i_less_than_u_32(c, 0x80) {
        print_byte(@truncate(c))
    } else if @i_less_than_u_32(c, 0x800) {
        print_byte(@truncate(@i_add_32(0xC0, @i_div_u_32(c, 0x40))))
        print_continuation(c, 0x1)
    } else if @i_less_than_u_32(c, 0x10000) {
        print_byte(@truncate(@i_add_32(0xE0, @i_div_u_32(c, 0x1000))))
        print_continuation(c, 0x40)
        print_continuation(c, 0x1)
    } else {
        print_byte(@truncate(@i_add_32(0xF0, @i_div_u_32(c, 0x40000))))
        print_continuation(c, 0x1000)
        print_continuation(c, 0x40)
        print_continuation(c, 0x1)
    }
}

/// Fails the test unless what was printed is exactly `expected`, showing
/// both, then forgets it.
expect_printed: function (expected: @byte_buffer) nothing {
    printed: @byte_buffer = recorded.written()
    if recorded.full {
        @panic($"printed more than {@array_len(recorded.bytes)} bytes")
    }
    expect_text(printed, expected)
    recorded.used = 0
}

/// Fails the test with `code`: where a program would have exited with it.
fail_with: function (code: @bit32) nothing {
    @panic($"failed with code {code}")
}

/// Fails the test unless a program's result `code` is `expected`.
expect_code: function (code: @bit32, expected: @bit32) nothing {
    if code != expected {
        @panic($"expected code {expected}, found {code}")
    }
}

private {
    /// The printed bytes so far.
    Recorder: structure {
        used: Int
        full: Bool
        bytes: @array(Byte, 0x10000)

        /// The bytes kept so far.
        written: function (self) Slice[Byte] => Slice[Byte].new(@array_at(ref self.bytes, 0x0), self.used)

        /// The whole buffer, used or not.
        whole: function (self) Slice[Byte] => Slice[Byte].new(@array_at(ref self.bytes, 0x0), @array_len(self.bytes))

        push: function (self, text: Slice[Byte]) nothing {
            if text.get_count() > self.whole().get_count() - self.used {
                self.full = true
                return
            }
            text.copy_to(self.whole(), self.used)
            self.used += text.get_count()
        }
    }

    recorded: Recorder

    print_continuation: function (c: @bit32, scale: @bit32) nothing {
        print_byte(@truncate(@i_add_32(0x80, @i_mod_u_32(@i_div_u_32(c, scale), 0x40))))
    }
}
