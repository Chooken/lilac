function @main
{
    allocate #bit32, %a
    copy #bit32, 0x1, &1
    copy #bit32, &1, %a
    allocate #bit8, %b
    allocate #bit32, %tmp:1
    copy #bit32, %a, %tmp:1
    allocate #bit8, %tmp:2
    call @conversion:bit32:bit8, in %tmp:1, out %tmp:2
    copy #bit8, %tmp:2, %b
    return
}

function @conversion:bit32:bit8
    in #bit32 %from,
    out #bit8 %to
{
    copy #bit32, %from, &1
    truncate #bit32, &1, #bit8, &2
    copy #bit8, &2, %to
    return
}