// Parsing integers and floats (math plan phase 6): `Int*.parse`,
// `Uint*.parse` and `Float*.parse`, including IEEE halfway points and
// `ParseError` variants.

using Standard
using Standard.Testing

test "integers" {
    i1: Int8 = Int8.parse("-128") else { @panic("-128 did not parse") }
    i2: Int8 = Int8.parse("0x7F") else { @panic("0x7F did not parse") }
    u1: Uint8 = Uint8.parse("0b1111_1111") else { @panic("0b1111_1111 did not parse") }
    u2: Uint64 = Uint64.parse("18_446_744_073_709_551_615") else { @panic("Uint64.MAX did not parse") }
    n1: Int = Int.parse("+42") else { @panic("+42 did not parse") }
    i64: Int64 = Int64.parse("-9223372036854775808") else { @panic("Int64.MIN did not parse") }
    expect_text($"{i1} {i2} {u1} {u2} {n1} {i64}", "-128 127 255 18446744073709551615 42 -9223372036854775808")
}

test "integer errors" {
    if Int8.parse("") -> v: Int8 { @panic($"\"\" parsed as {v}") } else -> e: ParseError { expect_text(e, "Empty") }
    if Int8.parse("12x") -> v: Int8 { @panic($"12x parsed as {v}") } else -> e: ParseError { expect_text(e, "InvalidDigit") }
    if Int8.parse("128") -> v: Int8 { @panic($"128 parsed as {v}") } else -> e: ParseError { expect_text(e, "Overflow") }
    if Float64.parse("1.5xyz") -> v: Float64 { @panic($"1.5xyz parsed as {v}") } else -> e: ParseError { expect_text(e, "Trailing") }
}

test "floats round to nearest, ties to even" {
    // Halfway between 1.0 (even LSB 0) and 1.0 + 2^-52: rounds to even 1.0.
    h_even: Float64 = Float64.parse("1.00000000000000011102230246251565404236316680908203125") else { @panic("h_even did not parse") }
    // Halfway between 1.0 + 2^-52 (odd LSB 1) and 1.0 + 2 * 2^-52: rounds up to even.
    h_odd: Float64 = Float64.parse("1.00000000000000033306690738754696212708950042724609375") else { @panic("h_odd did not parse") }
    // Halfway between 0.0 and MIN_SUBNORMAL (2^-1075): rounds to even 0.0.
    sub_even: Float64 = Float64.parse("2.47032822920623272088284396434110686e-324") else { @panic("sub_even did not parse") }
    // Halfway between MIN_SUBNORMAL (odd) and 2 * MIN_SUBNORMAL: rounds up to 2 * MIN_SUBNORMAL.
    sub_odd: Float64 = Float64.parse("7.41098468761869816264853189302332059e-324") else { @panic("sub_odd did not parse") }
    neg_z: Float64 = Float64.parse("-0") else { @panic("-0 did not parse") }
    inf_p: Float64 = Float64.parse("inf") else { @panic("inf did not parse") }
    inf_n: Float64 = Float64.parse("-inf") else { @panic("-inf did not parse") }
    nan_v: Float64 = Float64.parse("nan") else { @panic("nan did not parse") }
    expect_text($"{h_even.hex()} {h_odd.hex()} {sub_even.hex()} {sub_odd.hex()} {neg_z.hex()} {inf_p.hex()} {inf_n.hex()} {nan_v.is_nan()}", "3ff0000000000000 3ff0000000000002 0 2 8000000000000000 7ff0000000000000 fff0000000000000 true")
}

test "narrow floats" {
    f32: Float32 = Float32.parse("1.0") else { @panic("1.0 did not parse as Float32") }
    f16: Float16 = Float16.parse("1.0") else { @panic("1.0 did not parse as Float16") }
    expect_text($"{f32.hex()} {f16.hex()}", "3f800000 3c00")
    if Float16.parse("65520.0") -> v: Float16 { @panic($"65520.0 parsed as {v}") } else -> e: ParseError { expect_text(e, "Overflow") }
    if Float64.parse(".") -> v: Float64 { @panic($". parsed as {v}") } else -> e: ParseError { expect_text(e, "InvalidDigit") }
}
