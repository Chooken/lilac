// `Map` with keys that all hash alike (every lookup and removal walks one
// long probe chain, and lookups of absent keys stop at its end), through
// growth (each rehash moves every entry), replacing a key's value (the
// old value drops), copies (each value copied through `@on_copy`) and
// drops (each value once). `Set` over it.

using Standard
using Transcript
using Standard.Collections

Collide: structure {
    n: Int

    hash: function (self) @bit64 => 0x7
}

Key: structure {
    n: Int

    hash: function (self) @bit64 => @i_mul_64(@extend_zero(self.n as @bit_native), 0x9E3779B97F4A7C15)
}

Leaf: structure {
    c: @bit32

    @on_copy: function (self) copy: Leaf {
        print("+")
        copy = Leaf { c = self.c }
    }

    @on_drop: function (self) nothing {
        print($"{self.c as Scalar}")
    }
}

count_colliding: function (map: ref Map[Collide, Int]) found: Int {
    found = 0
    i: Int = 0
    loop if i < 12 {
        if map.contains(Collide { n = i }) {
            found += 1
        }
        i += 1
    }
}

flag: function (b: Bool) Int => if b then 1 else 0

program: function () nothing {
    colliding: Map[Collide, Int] = Map[Collide, Int].new()
    i: Int = 0
    loop if i < 12 {
        colliding.add(Collide { n = i }, i * 10)
        i += 1
    }
    print_line($"{count_colliding(ref colliding)} {flag(colliding.contains(Collide { n = 5 }))} {flag(colliding.contains(Collide { n = 99 }))}")
    colliding.remove(Collide { n = 5 })
    colliding.remove(Collide { n = 99 })
    print_line($"{count_colliding(ref colliding)} {flag(colliding.contains(Collide { n = 5 }))} {flag(colliding.contains(Collide { n = 11 }))}")

    // A hundred keys grow the map from 16 buckets to 256.
    numbers: Map[Key, Int] = Map[Key, Int].new()
    i = 0
    loop if i < 100 {
        numbers.add(Key { n = i }, i)
        i += 1
    }
    sum: Int = 0
    i = 0
    loop if i < 100 {
        value: ref Int = numbers.get(Key { n = i }) else {
            print_line("missing")
            return
        }
        sum += value
        i += 1
    }
    print_line($"{numbers.get_count()} {sum} {flag(numbers.contains(Key { n = 99 }))}")
    numbers.add(Key { n = 7 }, 900)
    numbers.remove(Key { n = 3 })
    seven: ref Int = numbers.get(Key { n = 7 }) else {
        return
    }
    print_line($"{numbers.get_count()} {seven + 90}")

    {
        leaves: Map[Key, Leaf] = Map[Key, Leaf].new()
        leaves.add(Key { n = 1 }, Leaf { c = 'a' })
        leaves.add(Key { n = 1 }, Leaf { c = 'b' })
        print("|")
        leaves.remove(Key { n = 1 })
        print("|")
        leaves.add(Key { n = 2 }, Leaf { c = 'd' })
        copy: Map[Key, Leaf] = leaves
        print("|")
        leaves.add(Key { n = 3 }, Leaf { c = 'c' })
        leaves.remove(Key { n = 9 })
        leaves.remove(Key { n = 3 })
        copy.add(Key { n = 4 }, Leaf { c = 'e' })
        copy.remove(Key { n = 4 })
        print("|")
    }
    print_line("")

    keys: Set[Key] = Set[Key].new()
    keys.add(Key { n = 1 })
    keys.add(Key { n = 1 })
    keys.add(Key { n = 2 })
    keys.remove(Key { n = 2 })
    print_line($"{flag(keys.contains(Key { n = 1 }))} {flag(keys.contains(Key { n = 2 }))}")
}

test "map" {
    program()
    Transcript.expect_printed("12 1 0\n11 0 1\n100 4950 1\n99 990\na|b|+|ce|dd\n1 0\n")
}
