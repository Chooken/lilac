// `File` and the file functions, on files in the system's temporary
// folder. Each test names its own files, with a random part, since tests
// (and the Debug and Release runs) run at once.

using Standard
using Standard.Testing
using Standard.Io
using Standard.Collections
using Standard.Os as Os

/// A path in the temporary folder for `name`, unique to this run.
temporary_path: function (name: @byte_buffer) path: String {

    folder: @array(@bit8, 0x400) = @array(@bit8, 0x400) {}
    variable: @byte_buffer = "TMPDIR"
    if @builtin.Target.os == .Windows {
        variable = "TEMP"
    }

    bits: @bit64 = 0x0
    Os.fill_random(ref bits as ref unknown, 0x8)
    unique: Uint64 = bits as Uint64

    if Os.environment_variable(variable, @array_at(ref folder, 0x0), 0x400).get() -> length: @bit_native {
        if @i_less_than_u_native(length, 0x400) {
            bytes: Slice[Byte] = Slice[Byte].new(@array_at(ref folder, 0x0) as ref unknown as ref Byte, length as Int)
            path = String.new($"{bytes as @byte_buffer}/lilac-{name}-{unique.hex()}")
            return
        }
    }

    path = String.new($"/tmp/lilac-{name}-{unique.hex()}")
}

/// `count` bytes of text: the alphabet and a newline, over and over.
text_of: function (count: Int) bytes: List[Byte] {
    alphabet: Slice[Byte] = "abcdefghijklmnopqrstuvwxyz\n"
    bytes = List[Byte].new()
    index: Int = 0
    loop if index < count {
        bytes.add(alphabet.get(index % alphabet.get_count()))
        index += 1
    }
}

/// Fails the test unless `error` is `expected`.
expect_error: function (error: Error, expected: Error) nothing {
    expect_with(error == expected, $"expected the error `{expected}`, found `{error}`")
}

/// Writes `count` bytes with `write_file`, then reads them back.
round_trip: function (count: Int) nothing {

    path: String = temporary_path("round-trip")
    expected: List[Byte] = text_of(count)
    contents: @byte_buffer = expected.get_slice() as @byte_buffer

    write_file(path, contents) else -> error: Error {
        @panic($"write_file of {count} bytes failed: {error}")
    }

    text: String = read_file(path) else -> error: Error {
        @panic($"read_file of {count} bytes failed: {error}")
    }

    expect_equal[Int](text.get_count(), count)
    expect(text == contents)

    remove_file(path) else -> error: Error {
        @panic($"remove_file failed: {error}")
    }
}

test "write_file then read_file gives the text back, at every size" {
    round_trip(0)
    round_trip(1)
    round_trip(4095)
    round_trip(4096)
    round_trip(4097)
    round_trip(8192)
    round_trip(8193)
    round_trip(100000)
}

test "read_file keeps a scalar that two reads split" {

    path: String = temporary_path("split-scalar")
    // Two bytes each, so one straddles every 8 KiB read after an odd
    // first byte.
    expected: List[Byte] = List[Byte].new()
    expected.add_slice("a")
    count: Int = 0
    loop if count < 10000 {
        expected.add_slice("é")
        count += 1
    }
    contents: @byte_buffer = expected.get_slice() as @byte_buffer

    write_file(path, contents) else -> error: Error {
        @panic($"write_file failed: {error}")
    }
    text: String = read_file(path) else -> error: Error {
        @panic($"read_file failed: {error}")
    }
    expect(text == contents)

    remove_file(path) else -> error: Error {
        @panic($"remove_file failed: {error}")
    }
}

test "write_file replaces what the file held" {

    path: String = temporary_path("replace")

    write_file(path, "a longer first text\n") else -> error: Error {
        @panic($"write_file failed: {error}")
    }
    write_file(path, $"short {1}") else -> error: Error {
        @panic($"write_file failed: {error}")
    }
    text: String = read_file(path) else -> error: Error {
        @panic($"read_file failed: {error}")
    }
    expect_text(text, "short 1")

    remove_file(path) else -> error: Error {
        @panic($"remove_file failed: {error}")
    }
}

test "append_file adds at the end, creating a missing file" {

    path: String = temporary_path("append")

    append_file(path, "one\n") else -> error: Error {
        @panic($"append_file failed: {error}")
    }
    append_file(path, "two\n") else -> error: Error {
        @panic($"append_file failed: {error}")
    }
    append_file(path, $"{3}\n") else -> error: Error {
        @panic($"append_file failed: {error}")
    }
    text: String = read_file(path) else -> error: Error {
        @panic($"read_file failed: {error}")
    }
    expect_text(text, "one\ntwo\n3\n")

    remove_file(path) else -> error: Error {
        @panic($"remove_file failed: {error}")
    }
}

test "a missing file is NotFound" {

    path: String = temporary_path("missing")

    text: String = read_file(path) else -> error: Error {
        expect_error(error, .NotFound)
        file: File = File.open(path) else -> open_error: Error {
            expect_error(open_error, .NotFound)
            remove_file(path) else -> remove_error: Error {
                expect_error(remove_error, .NotFound)
                return
            }
            @panic("remove_file of a missing file worked")
        }
        @panic("File.open of a missing file worked")
    }
    @panic("read_file of a missing file worked")
}

test "a file that is not UTF-8 is InvalidData" {

    path: String = temporary_path("not-utf8")
    bytes: @array(Byte, 3) = @array(Byte, 3) {}
    @array_at(ref bytes, 0x0) = 0x61 as Byte
    @array_at(ref bytes, 0x1) = 0xFF as Byte
    @array_at(ref bytes, 0x2) = 0x62 as Byte

    file: File = File.create(path) else -> error: Error {
        @panic($"File.create failed: {error}")
    }
    file.write_bytes(Slice[Byte].new(@array_at(ref bytes, 0x0), 3)) else -> error: Error {
        @panic($"write_bytes failed: {error}")
    }
    @move(file).close() else -> error: Error {
        @panic($"close failed: {error}")
    }

    text: String = read_file(path) else -> error: Error {
        expect_error(error, .InvalidData)
        remove_file(path) else -> remove_error: Error {
            @panic($"remove_file failed: {remove_error}")
        }
        return
    }
    @panic("read_file of bad UTF-8 worked")
}

test "a path longer than MAX_PATH_BYTES is InvalidInput" {

    long: List[Byte] = List[Byte].new()
    count: Int = 0
    loop if count < MAX_PATH_BYTES + 1 {
        long.add_slice("a")
        count += 1
    }
    path: @byte_buffer = long.get_slice() as @byte_buffer

    file: File = File.open(path) else -> error: Error {
        expect_error(error, .InvalidInput)
        return
    }
    @panic("File.open of a long path worked")
}

test "a path holding a zero byte is InvalidInput" {

    bytes: @array(Byte, 3) = @array(Byte, 3) {}
    @array_at(ref bytes, 0x0) = 0x61 as Byte
    @array_at(ref bytes, 0x1) = 0x0 as Byte
    @array_at(ref bytes, 0x2) = 0x62 as Byte
    path: @byte_buffer = Slice[Byte].new(@array_at(ref bytes, 0x0), 3) as @byte_buffer

    file: File = File.create(path) else -> error: Error {
        expect_error(error, .InvalidInput)
        remove_file(path) else -> remove_error: Error {
            expect_error(remove_error, .InvalidInput)
            return
        }
        @panic("remove_file of a path with a zero byte worked")
    }
    @panic("File.create of a path with a zero byte worked")
}

test "dropping a file closes it" {

    path: String = temporary_path("drops")
    write_file(path, "x") else -> error: Error {
        @panic($"write_file failed: {error}")
    }

    // Far past a process's usual 1,024 descriptors, were any left open.
    count: Int = 0
    loop if count < 10000 {
        file: File = File.open(path) else -> error: Error {
            @panic($"File.open number {count} failed: {error}")
        }
        count += 1
    }

    remove_file(path) else -> error: Error {
        @panic($"remove_file failed: {error}")
    }
}

test "seek moves where read reads, and size counts the bytes" {

    path: String = temporary_path("seek")
    write_file(path, "0123456789") else -> error: Error {
        @panic($"write_file failed: {error}")
    }

    file: File = File.open(path) else -> error: Error {
        @panic($"File.open failed: {error}")
    }
    into: @array(Byte, 0x10) = @array(Byte, 0x10) {}
    three: Slice[Byte] = Slice[Byte].new(@array_at(ref into, 0x0), 3)

    size: Uint64 = file.size() else -> error: Error {
        @panic($"size failed: {error}")
    }
    expect_equal[Uint64](size, 10 as Uint64)

    at: Uint64 = file.seek(4 as Int64, .Start) else -> error: Error {
        @panic($"seek failed: {error}")
    }
    expect_equal[Uint64](at, 4 as Uint64)
    got: Int = file.read(three) else -> error: Error {
        @panic($"read failed: {error}")
    }
    expect_equal[Int](got, 3)
    expect_text(three as @byte_buffer, "456")

    near_end: Uint64 = file.seek(-2 as Int64, .End) else -> error: Error {
        @panic($"seek failed: {error}")
    }
    expect_equal[Uint64](near_end, 8 as Uint64)
    last: Int = file.read(three) else -> error: Error {
        @panic($"read failed: {error}")
    }
    expect_equal[Int](last, 2)
    expect_text(three.slice(Range.of(0, last)) as @byte_buffer, "89")

    none: Int = file.read(three) else -> error: Error {
        @panic($"read failed: {error}")
    }
    expect_equal[Int](none, 0)

    end: Uint64 = file.seek(0 as Int64, .Current) else -> error: Error {
        @panic($"seek failed: {error}")
    }
    expect_equal[Uint64](end, 10 as Uint64)

    @move(file).close() else -> error: Error {
        @panic($"close failed: {error}")
    }
    remove_file(path) else -> error: Error {
        @panic($"remove_file failed: {error}")
    }
}

test "a file opened to read and write takes writes in place" {

    path: String = temporary_path("read-write")
    write_file(path, "abc") else -> error: Error {
        @panic($"write_file failed: {error}")
    }

    file: File = File.open_with(path, .ReadWrite) else -> error: Error {
        @panic($"File.open_with failed: {error}")
    }
    file.write_bytes("X") else -> error: Error {
        @panic($"write_bytes failed: {error}")
    }
    at: Uint64 = file.seek(0 as Int64, .Start) else -> error: Error {
        @panic($"seek failed: {error}")
    }
    into: @array(Byte, 0x10) = @array(Byte, 0x10) {}
    whole: Slice[Byte] = Slice[Byte].new(@array_at(ref into, 0x0), 0x10)
    got: Int = file.read(whole) else -> error: Error {
        @panic($"read failed: {error}")
    }
    expect_text(whole.slice(Range.of(0, got)) as @byte_buffer, "Xbc")

    @move(file).close() else -> error: Error {
        @panic($"close failed: {error}")
    }
    remove_file(path) else -> error: Error {
        @panic($"remove_file failed: {error}")
    }
}

test "close keeps what was written, and File.write writes a format" {

    path: String = temporary_path("close")

    file: File = File.create(path) else -> error: Error {
        @panic($"File.create failed: {error}")
    }
    file.write($"{1} and {"two"}") else -> error: Error {
        @panic($"write failed: {error}")
    }
    file.write_line(", three") else -> error: Error {
        @panic($"write_line failed: {error}")
    }
    @move(file).close() else -> error: Error {
        @panic($"close failed: {error}")
    }

    text: String = read_file(path) else -> error: Error {
        @panic($"read_file failed: {error}")
    }
    expect_text(text, "1 and two, three\n")

    remove_file(path) else -> error: Error {
        @panic($"remove_file failed: {error}")
    }
}

test "closing a standard stream's File leaves the stream open" {

    File.standard_output().close() else -> error: Error {
        @panic($"close failed: {error}")
    }
    File.standard_output().write_bytes("still open\n") else -> error: Error {
        @panic($"standard output was closed: {error}")
    }
}
