// Identities and properties of the elementary functions (math plan phase 5)
// that need no reference table: oddness and evenness, exact results,
// `sin_cos` agreeing with `sin` and `cos`, `pow(x, 0.5)` agreeing with
// `sqrt`, `exp(ln x)` close to `x`, and monotonicity across the points
// where the kernels change their reduction (so a table boundary cannot
// jump).

using Standard

failed: function (code: @bit32) nothing {
    Transcript.fail_with(code)
}

// A small generator of well-spread doubles in `[0, 1)`.
next: function (state: ref @bit64) value: Float64 {
    state = @i_add_64(@i_mul_64(state, 0x5851F42D4C957F2D), 0x14057B7EF767814F)
    bits: @bit64 = @bit_shift_right_u_64(state, 0xB)
    value = (bits as Uint64).to_float64_rounded() * 1.1102230246251565e-16
}

same: function (a: Float64, b: Float64) Bool => a == b or (a.is_nan() and b.is_nan())

check_odd: function (x: Float64, code: @bit32) nothing {
    if not same(x.sin(), -((-x).sin())) { failed(code) }
    if not same(x.tan(), -((-x).tan())) { failed(@i_add_32(code, 0x1)) }
    if not same(x.atan(), -((-x).atan())) { failed(@i_add_32(code, 0x2)) }
    if not same(x.sinh(), -((-x).sinh())) { failed(@i_add_32(code, 0x3)) }
    if not same(x.tanh(), -((-x).tanh())) { failed(@i_add_32(code, 0x4)) }
    if not same(x.asinh(), -((-x).asinh())) { failed(@i_add_32(code, 0x5)) }
    if not same(x.erf(), -((-x).erf())) { failed(@i_add_32(code, 0x6)) }
    if not same(x.cbrt(), -((-x).cbrt())) { failed(@i_add_32(code, 0x7)) }
    if not same(x.cos(), (-x).cos()) { failed(@i_add_32(code, 0x8)) }
    if not same(x.cosh(), (-x).cosh()) { failed(@i_add_32(code, 0x9)) }
    s: Float64, c: Float64 = x.sin_cos()
    if not same(s, x.sin()) or not same(c, x.cos()) { failed(@i_add_32(code, 0xA)) }
    if not same(x.sin_pi(), -((-x).sin_pi())) { failed(@i_add_32(code, 0xB)) }
    if not same(x.cos_pi(), (-x).cos_pi()) { failed(@i_add_32(code, 0xC)) }
}

check_positive: function (x: Float64, code: @bit32) nothing {
    if not same(x.pow(0.5), x.sqrt()) { failed(code) }
    if (x.ln().exp() - x).abs() > x * 1.2e-15 { failed(@i_add_32(code, 0x1)) }
    if (x.log2().exp2() - x).abs() > x * 1.2e-15 { failed(@i_add_32(code, 0x2)) }
    if (x.log10().exp10() - x).abs() > x * 1.2e-15 { failed(@i_add_32(code, 0x3)) }
    cube: Float64 = x.cbrt()
    if (cube * cube * cube - x).abs() > x * 1.2e-15 { failed(@i_add_32(code, 0x4)) }
    if not same(x.hypot(0.0), x) { failed(@i_add_32(code, 0x5)) }
    if not same(x.pow(2.0), x * x) { failed(@i_add_32(code, 0x6)) }
    if (x.exp_m1() + 1.0 - x.exp()).abs() > x.exp() * 1.2e-15 { failed(@i_add_32(code, 0x7)) }
    if (x.ln_1p() - (1.0 + x).ln()).abs() > (1.0 + x).ln() * 1.2e-15 { failed(@i_add_32(code, 0x8)) }
}

// Each function is non-decreasing over the 600 doubles around `at`.
check_monotone: function (at: Float64, code: @bit32) nothing {
    x: Float64 = at
    i: Int32 = 0
    loop {
        if i >= 300 as Int32 { break }
        x = x.next_down()
        i = i + 1
    }
    prev_exp: Float64 = x.exp()
    prev_ln: Float64 = x.abs().ln()
    prev_atan: Float64 = x.atan()
    prev_sin: Float64 = x.sin()
    prev_erf: Float64 = x.erf()
    prev_sinh: Float64 = x.sinh()
    i = 0
    loop {
        if i >= 600 as Int32 { break }
        x = x.next_up()
        e: Float64 = x.exp()
        l: Float64 = x.abs().ln()
        a: Float64 = x.atan()
        s: Float64 = x.sin()
        f: Float64 = x.erf()
        h: Float64 = x.sinh()
        if e < prev_exp { failed(code) }
        if x > 0.0 and l < prev_ln { failed(@i_add_32(code, 0x1)) }
        if a < prev_atan { failed(@i_add_32(code, 0x2)) }
        if f < prev_erf { failed(@i_add_32(code, 0x3)) }
        if h < prev_sinh { failed(@i_add_32(code, 0x4)) }
        if x.abs() < 0.78 and s < prev_sin { failed(@i_add_32(code, 0x5)) }
        prev_exp = e
        prev_ln = l
        prev_atan = a
        prev_sin = s
        prev_erf = f
        prev_sinh = h
        i = i + 1
    }
}

program: function () nothing {
    state: @bit64 = 0x1234ABCD
    i: Int32 = 0
    loop {
        if i >= 300 as Int32 { break }
        x: Float64 = next(ref state) * 40.0 - 20.0
        check_odd(x, 0x10)
        check_odd(next(ref state) * 4.0e5, 0x30)
        check_positive(next(ref state) * 30.0 + 0.001, 0x50)
        i = i + 1
    }
    // the points where kernels change branch
    check_monotone(0.3466, 0x100)
    check_monotone(0.7853981633974483, 0x110)
    check_monotone(1.0, 0x120)
    check_monotone(1.40625, 0x130)
    check_monotone(2.0, 0x140)
    check_monotone(0.0078125, 0x150)
    check_monotone(40.0, 0x160)
    check_monotone(22.0, 0x170)

    // exact results
    two: Float64 = 2.0
    if not same(two.pow(10.0), 1024.0) { failed(0x70) }
    if not same((1024.0 as Float64).log2(), 10.0) { failed(0x71) }
    if not same((27.0 as Float64).cbrt(), 3.0) { failed(0x72) }
    if not same((3.0 as Float64).hypot(4.0), 5.0) { failed(0x73) }
    if not same((10.0 as Float64).pow_int(3), 1000.0) { failed(0x74) }
    if not same((8.0 as Float64).root(3), 2.0) { failed(0x75) }
    if not same((0.5 as Float64).sin_pi(), 1.0) { failed(0x76) }
    if not same((0.5 as Float64).cos_pi(), 0.0) { failed(0x77) }
    if not same((1.0 as Float64).sin_pi(), 0.0) { failed(0x78) }
    if not same((5.0 as Float64).gamma(), 24.0) { failed(0x7A) }
    if not same((1.0 as Float64).ln_gamma(), 0.0) { failed(0x7B) }
    if not same((0.0 as Float64).erf(), 0.0) { failed(0x7C) }
    if not same((1.0 as Float64).exp().ln(), 1.0) { failed(0x7D) }
    neg_zero: Float64 = -0.0
    if not same(neg_zero.sin(), neg_zero) { failed(0x79) }
}

test "math_identities" {
    program()
}
