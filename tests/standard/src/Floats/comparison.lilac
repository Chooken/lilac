// Float comparison and interpolation (math plan phase 4): `equals`,
// `approximately_equals`, `total_compare`, `compare`, `lerp`,
// `inverse_lerp`, `remap` and `smooth_step`.

using Standard
using Standard.Testing

test "equals" {
    pos_zero: Float64 = 0.0
    neg_zero: Float64 = -0.0
    nan: Float64 = Float64.NAN
    expect_text($"{pos_zero == neg_zero} {pos_zero.equals(neg_zero)} {nan == nan} {nan.equals(nan)} {(1.0 as Float64).equals(2.0)} {Float64.INFINITY.equals(Float64.INFINITY)}", "0 true 1 false false true")
}

test "approximately_equals" {
    pos_zero: Float64 = 0.0
    neg_zero: Float64 = -0.0
    nan: Float64 = Float64.NAN
    a: Float64 = 1.0
    b: Float64 = 1.000000001
    expect_text($"{a.approximately_equals(b, 0.000001, 0.0)} {pos_zero.approximately_equals(neg_zero, 0.0, 0.0)} {a.approximately_equals(2.0, 0.001, 0.001)} {a.approximately_equals(Float64.INFINITY, 0.1, 0.1)} {a.approximately_equals(nan, 1.0, 1.0)}", "true true false false false")
}

test "total_compare" {
    pos_zero: Float64 = 0.0
    neg_zero: Float64 = -0.0
    nan: Float64 = Float64.NAN
    neg_nan: Float64 = nan.copy_sign(-1.0)
    min_sub: Float64 = Float64.MIN_SUBNORMAL
    expect_text($"{neg_nan.total_compare(Float64.NEG_INFINITY)} {Float64.NEG_INFINITY.total_compare(-1.0)} {(-1.0 as Float64).total_compare(-min_sub)} {(-min_sub).total_compare(neg_zero)} {neg_zero.total_compare(pos_zero)} {pos_zero.total_compare(min_sub)} {Float64.MAX.total_compare(Float64.INFINITY)} {nan.total_compare(nan)}", "Less Less Less Less Less Less Less Equal")
}

test "compare" {
    pos_zero: Float64 = 0.0
    neg_zero: Float64 = -0.0
    c0: Ordering = pos_zero.compare(neg_zero) else { @panic("0 and -0 are unordered") }
    c1: Ordering = (-1.0 as Float64).compare(1.0) else { @panic("-1 and 1 are unordered") }
    c2: Ordering = (2.0 as Float64).compare(1.0) else { @panic("2 and 1 are unordered") }
    expect_text($"{c0} {c1} {c2}", "Equal Less Greater")
    if Float64.NAN.compare(1.0) -> ord: Ordering { @panic($"NaN compared {ord} to 1") }
}

test "lerp" {
    nan: Float64 = Float64.NAN
    a: Float64 = 1.0
    ten: Float64 = 10.0
    neg_five: Float64 = -5.0
    five: Float64 = 5.0
    expect_text($"{a.lerp(ten, 0.0).hex()} {a.lerp(ten, 1.0).hex()} {a.lerp(ten, 0.5).hex()} {neg_five.lerp(five, 0.5).hex()} {a.lerp(ten, nan).is_nan()}", "3ff0000000000000 4024000000000000 4016000000000000 0 true")
}

test "inverse_lerp, remap and smooth_step" {
    expect_text($"{(5.0 as Float64).inverse_lerp(0.0, 10.0).hex()} {(5.0 as Float64).remap(0.0, 10.0, 0.0, 100.0).hex()} {(-1.0 as Float64).smooth_step(0.0, 10.0).hex()} {(5.0 as Float64).smooth_step(0.0, 10.0).hex()} {(20.0 as Float64).smooth_step(0.0, 10.0).hex()}", "3fe0000000000000 4049000000000000 0 3fe0000000000000 3ff0000000000000")
}
