// Fixed and scientific float formatting (math plan phase 6): `{x.fixed(n)}`
// and `{x.scientific(n)}`, with exact decimal rounding (ties to even).

using Standard
using Transcript

program: function () nothing {
    a: Float64 = 0.125
    b: Float64 = 0.375
    big: Float64 = 1e23
    nz: Float64 = -0.0
    print_line($"{a.fixed(2)} {b.fixed(2)} {big.fixed(0)} {(2.5 as Float64).fixed(0)} {(3.5 as Float64).fixed(0)} {nz.fixed(3)} {(9.996 as Float64).fixed(2)} {Float64.INFINITY.fixed(2)} {Float64.NEG_INFINITY.fixed(2)} {Float64.NAN.fixed(2)}")

    v: Float64 = 1234.5678
    print_line($"{v.scientific(3)} {(0.0625 as Float64).scientific(1)} {(0.00135 as Float64).scientific(1)} {(9.996 as Float64).scientific(2)} {(0.0 as Float64).scientific(2)} {nz.scientific(1)} {Float64.INFINITY.scientific(2)} {Float64.NAN.scientific(2)}")

    f32: Float32 = 1.5
    f16: Float16 = 1.5
    print_line($"{f32.fixed(2)} {f16.scientific(1)}")
}

test "float_fixed_scientific" {
    program()
    Transcript.expect_printed("0.12 0.38 99999999999999991611392 2 4 -0.000 10.00 inf -inf nan\n1.235e3 6.2e-2 1.4e-3 1.00e1 0.00e0 -0.0e0 inf nan\n1.50 1.5e0\n")
}
