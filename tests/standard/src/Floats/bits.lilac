// Float bits and ULPs (math plan phase 4): `to_bits`/`from_bits`,
// `next_up`/`next_down`, `ulp`, `exponent`/`mantissa`,
// `scale_by_power_of_two` and `split_exponent`, including NaN, ±0, ±∞ and
// subnormals.

using Standard
using Standard.Testing

test "to_bits and from_bits" {
    one: Float64 = 1.0
    expect_text($"{one.to_bits().hex()} {Float64.from_bits(0x3FF0000000000000).hex()} {Float16.from_bits(0x3C00).hex()} {Float32.from_bits(0x3F800000).hex()}", "3ff0000000000000 3ff0000000000000 3c00 3f800000")
}

test "next_up and next_down" {
    pos_zero: Float64 = 0.0
    neg_zero: Float64 = -0.0
    min_sub: Float64 = Float64.MIN_SUBNORMAL
    neg_min_sub: Float64 = -Float64.MIN_SUBNORMAL
    expect_text($"{pos_zero.next_up().hex()} {neg_zero.next_up().hex()} {pos_zero.next_down().hex()} {neg_zero.next_down().hex()} {neg_min_sub.next_up().hex()} {min_sub.next_down().hex()} {Float64.MAX.next_up().hex()} {Float64.MIN.next_down().hex()} {Float64.INFINITY.next_down().hex()} {Float64.NEG_INFINITY.next_up().hex()} {Float64.NAN.next_up().is_nan()} {Float64.NAN.next_down().is_nan()}", "1 1 8000000000000001 8000000000000001 8000000000000000 0 7ff0000000000000 fff0000000000000 7fefffffffffffff ffefffffffffffff true true")
}

test "ulp" {
    one: Float64 = 1.0
    pos_zero: Float64 = 0.0
    min_sub: Float64 = Float64.MIN_SUBNORMAL
    expect_text($"{one.ulp().hex()} {pos_zero.ulp().hex()} {min_sub.ulp().hex()} {Float64.MAX.ulp().hex()} {Float64.INFINITY.ulp().is_nan()} {Float64.NAN.ulp().is_nan()}", "3cb0000000000000 1 1 7ca0000000000000 true true")
}

test "exponent and mantissa" {
    one: Float64 = 1.0
    three: Float64 = 3.0
    half: Float64 = 0.5
    expect_text($"{one.exponent()} {one.mantissa()} {three.exponent()} {three.mantissa()} {half.exponent()} {half.mantissa()}", "0 0 1 2251799813685248 -1 0")
}

test "scale_by_power_of_two" {
    one: Float64 = 1.0
    neg_zero: Float64 = -0.0
    min_sub: Float64 = Float64.MIN_SUBNORMAL
    expect_text($"{one.scale_by_power_of_two(3).hex()} {min_sub.scale_by_power_of_two(52).hex()} {one.scale_by_power_of_two(-1074).hex()} {one.scale_by_power_of_two(-1075).hex()} {Float64.MAX.scale_by_power_of_two(1).hex()} {neg_zero.scale_by_power_of_two(100).hex()} {Float64.NAN.scale_by_power_of_two(5).is_nan()}", "4020000000000000 10000000000000 1 0 7ff0000000000000 8000000000000000 true")
}

test "split_exponent" {
    one: Float64 = 1.0
    neg_zero: Float64 = -0.0
    min_sub: Float64 = Float64.MIN_SUBNORMAL
    f1: Float64, e1: Int32 = one.split_exponent()
    f2: Float64, e2: Int32 = (-6.0 as Float64).split_exponent()
    f3: Float64, e3: Int32 = min_sub.split_exponent()
    f4: Float64, e4: Int32 = neg_zero.split_exponent()
    f5: Float64, e5: Int32 = Float64.INFINITY.split_exponent()
    f6: Float64, e6: Int32 = Float64.NAN.split_exponent()
    expect_text($"{f1.hex()} {e1} {f2.hex()} {e2} {f3.hex()} {e3} {f4.hex()} {e4} {f5.hex()} {e5} {f6.is_nan()} {e6}", "3fe0000000000000 1 bfe8000000000000 3 3fe0000000000000 -1073 8000000000000000 0 7ff0000000000000 0 true 0")
}
