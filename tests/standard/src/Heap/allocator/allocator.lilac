// A free-list allocator in Lilac (`free_list.lilac`): aligned allocation,
// `realloc` in place and by moving, `free` with coalescing. Each failed
// check fails with its own code.


// Fails with `code` unless `actual` is `want`.
expect: function (actual: @bit_native, want: @bit_native, code: @bit32) nothing {
    if @i_less_than_u_native(actual, want) {
        Transcript.fail_with(code)
    }
    if @i_greater_than_u_native(actual, want) {
        Transcript.fail_with(code)
    }
}

// Fails with `code` unless `address` is a multiple of `align`.
expect_aligned: function (address: @bit_native, align: @bit_native, code: @bit32) nothing {
    expect(@i_mod_u_native(address, align), 0x0, code)
}

// Fails with `code` unless all `len` bytes at `address` are `byte`.
expect_filled: function (address: @bit_native, byte: @bit8, len: @bit_native, code: @bit32) nothing {
    data: ref @bit8 = @address_to_ptr(address) as ref @bit8
    index: @bit_native = 0x0
    loop if @i_less_than_u_native(index, len) {
        expect(@extend_zero(@load_u8(data, index)), @extend_zero(byte), code)
        index = @i_add_native(index, 0x1)
    }
}

fill: function (address: @bit_native, byte: @bit8, len: @bit_native) nothing {
    @memset(@address_to_ptr(address), byte, len)
}

program: function () nothing {
    list: FreeList = create_free_list(0x2000)
    total: @bit_native = @i_sub_native(list.end, list.start)

    a: @bit_native = alloc(ref list, 0x18, 0x8)
    expect_aligned(a, 0x10, 0x1)
    fill(a, 0x11, 0x18)
    b: @bit_native = alloc(ref list, 0x64, 0x40)
    expect_aligned(b, 0x40, 0x2)
    fill(b, 0x22, 0x64)
    c: @bit_native = alloc(ref list, 0x28, 0x10)
    expect_aligned(c, 0x10, 0x3)
    fill(c, 0x33, 0x28)
    expect_filled(a, 0x11, 0x18, 0x4)
    expect_filled(b, 0x22, 0x64, 0x5)

    // `b` is freed and merges with the gap before it, so `a` grows in place.
    free(ref list, b)
    grown: @bit_native = realloc(ref list, a, 0x3c, 0x8)
    expect(grown, a, 0x6)
    expect_filled(a, 0x11, 0x18, 0x7)
    expect_filled(c, 0x33, 0x28, 0x8)

    // `c` is in the way of a large size, so `a` moves.
    big: @bit_native = realloc(ref list, a, 0x400, 0x8)
    if @i_less_than_u_native(big, 0x1) {
        Transcript.fail_with(0x9)
    }
    if @i_less_than_u_native(@i_sub_native(big, a), 0x1) {
        Transcript.fail_with(0xa)
    }
    expect_filled(big, 0x11, 0x18, 0xb)

    // Too big for the arena.
    expect(alloc(ref list, 0x4000, 0x8), 0x0, 0xc)

    // Freeing everything coalesces the arena back into one free block.
    free(ref list, big)
    free(ref list, c)
    whole: ref Block = block_at(list.start)
    expect(whole.size, total, 0xd)
    expect(whole.used, 0x0, 0xe)
}

test "allocator" {
    program()
}
