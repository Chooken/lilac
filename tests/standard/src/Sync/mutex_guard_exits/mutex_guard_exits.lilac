// A `Sync.MutexGuard` unlocks its mutex on every way out of its scope:
// the end of a block, `return`, `break`, `continue`, a failure, its
// early `unlock`, and being moved into a function that drops it. After
// each, `try_lock` must succeed (in Debug the guard's thread is also
// cleared as the owner, or relocking would panic). Fails with the number
// of the first failed check.

using Standard
using Transcript
using Standard.Sync as Sync

counter: Sync.Mutex[Int]

/// Panics with "deadlock" in Debug, or fails, if a guard was left behind.
unlocked: function (code: @bit32) nothing {
    if counter.try_lock() -> held: Sync.MutexGuard[Int] {
    } else {
        Transcript.fail_with(code)
    }
    guard: Sync.MutexGuard[Int] = counter.lock()
}

returns_early: function (stop: Bool) nothing {
    guard: Sync.MutexGuard[Int] = counter.lock()
    guard.value() += 1
    if stop {
        return
    }
    Transcript.fail_with(0x10)
}

fails: function () value: Int else nothing {
    guard: Sync.MutexGuard[Int] = counter.lock()
    guard.value() += 1
    fail
}

consumes: function (guard: Sync.MutexGuard[Int]) nothing {
    guard.value() += 1
}

program: function () nothing {
    {
        guard: Sync.MutexGuard[Int] = counter.lock()
        guard.value() += 1
    }
    unlocked(0x1)

    returns_early(true)
    unlocked(0x2)

    loop {
        guard: Sync.MutexGuard[Int] = counter.lock()
        guard.value() += 1
        break
    }
    unlocked(0x3)

    round: Int = 0
    loop if round < 2 {
        guard: Sync.MutexGuard[Int] = counter.lock()
        round += 1
        continue
    }
    unlocked(0x4)

    if fails() -> value: Int {
        Transcript.fail_with(0x5)
    }
    unlocked(0x6)

    early: Sync.MutexGuard[Int] = counter.lock()
    early.value() += 1
    // `value` lent out a `ref`, so the guard moves only when told.
    @move(early).unlock()
    unlocked(0x7)

    consumes(counter.lock())
    unlocked(0x8)

    total: Int = counter.lock().value()
    print_line($"{total}")
}

test "mutex_guard_exits" {
    program()
    Transcript.expect_printed("6\n")
}
