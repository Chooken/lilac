// Integer division methods (math plan phase 3): `div_floor`, `div_ceil`,
// `div_euclid`, `rem_euclid`, `div_rem`, `gcd` and `lcm`.

using Standard
using Standard.Testing

test "div_floor and div_ceil" {
    p: Int32 = 7
    n: Int32 = -7
    expect_text($"{p.div_floor(2)} {n.div_floor(2)} {p.div_floor(-2)} {n.div_floor(-2)} {p.div_ceil(2)} {n.div_ceil(2)} {p.div_ceil(-2)} {n.div_ceil(-2)}", "3 -4 -4 3 4 -3 -3 4")
    u: Uint8 = 7
    expect_text($"{u.div_floor(2)} {u.div_ceil(2)} {Uint8.MAX.div_ceil(2)} {Uint8.MAX.div_ceil(1)} {(0 as Uint8).div_ceil(5)}", "3 4 128 255 0")
}

test "div_euclid and rem_euclid" {
    p: Int32 = 7
    n: Int32 = -7
    expect_text($"{p.div_euclid(4)} {p.rem_euclid(4)} {n.div_euclid(4)} {n.rem_euclid(4)} {p.div_euclid(-4)} {p.rem_euclid(-4)} {n.div_euclid(-4)} {n.rem_euclid(-4)} {(-1 as Int8).rem_euclid(Int8.MIN)}", "1 3 -2 1 -1 3 2 1 127")
}

test "div_rem" {
    n: Int32 = -7
    q: Int32, r: Int32 = n.div_rem(2)
    uq: Uint32, ur: Uint32 = (7 as Uint32).div_rem(2)
    expect_text($"{q} {r} {uq} {ur}", "-3 -1 3 1")
}

test "gcd and lcm" {
    expect_text($"{(-12 as Int32).gcd(18)} {(0 as Int32).gcd(0)} {(0 as Int32).gcd(-18)} {Int8.MIN.gcd(48)} {(128 as Uint8).gcd(0)} {(0 as Int32).lcm(18)} {(-4 as Int32).lcm(6)} {(12 as Uint32).lcm(18)} {(18 as Int32).lcm(0)} {(-64 as Int8).lcm(2)}", "6 0 18 16 128 0 12 36 0 64")
}
