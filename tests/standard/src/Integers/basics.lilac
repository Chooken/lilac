// Integer basics and `Ordering` (math plan phase 3): `compare`, `abs`,
// `unsigned_abs`, `sign`, `min`, `max`, `clamp`, `is_power_of_two` and
// `next_power_of_two`, at boundary values (`MIN`, `MAX`, 0, ±1, powers of
// two) and in global initializers.

using Standard
using Standard.Testing

const_abs: Int32 = (-42 as Int32).abs()
const_clamped: Int32 = (100 as Int32).clamp(0, 7)

test "compare and Ordering" {
    a: Int32 = -5
    b: Int32 = 5
    lt: Ordering = a.compare(b)
    eq: Ordering = b.compare(5)
    gt: Ordering = b.compare(a)
    expect_text($"{lt} {eq} {gt} {lt.is_less()} {eq.is_equal()} {gt.is_greater()} {gt.is_less_or_equal()} {eq.is_greater_or_equal()} {lt.reverse()} {eq.and_then(lt)}", "Less Equal Greater true true true false true Greater Less")
}

test "abs and unsigned_abs" {
    z: Int8 = 0
    neg_one: Int8 = -1
    expect_text($"{z.abs()} {neg_one.abs()} {Int8.MAX.abs()} {Int8.MIN.unsigned_abs()} {(0 as Uint8).unsigned_abs()} {Uint8.MAX.abs()}", "0 1 127 128 0 255")
}

test "sign" {
    expect_text($"{Int64.MIN.sign()} {(0 as Int64).sign()} {Int64.MAX.sign()} {(0 as Uint64).sign()} {Uint64.MAX.sign()}", "-1 0 1 0 1")
}

test "min, max and clamp" {
    expect_text($"{Int8.MIN.min(Int8.MAX)} {Int8.MIN.max(Int8.MAX)} {(-50 as Int8).clamp(0, 10)} {(50 as Int8).clamp(0, 10)} {Uint8.MIN.min(Uint8.MAX)} {Uint8.MIN.max(Uint8.MAX)}", "-128 127 0 10 0 255")
}

test "is_power_of_two" {
    expect_text($"{Int8.MIN.is_power_of_two()} {(1 as Int8).is_power_of_two()} {(64 as Int8).is_power_of_two()} {(0 as Int8).is_power_of_two()} {(0 as Uint8).is_power_of_two()} {(1 as Uint8).is_power_of_two()} {(128 as Uint8).is_power_of_two()} {Uint8.MAX.is_power_of_two()}", "false true true false false true true false")
}

test "next_power_of_two" {
    p0: Int8 = (-5 as Int8).next_power_of_two() else { @panic("-5 has no next power of two") }
    p1: Int8 = (0 as Int8).next_power_of_two() else { @panic("0 has no next power of two") }
    p2: Int8 = (1 as Int8).next_power_of_two() else { @panic("1 has no next power of two") }
    p3: Int8 = (33 as Int8).next_power_of_two() else { @panic("33 has no next power of two") }
    u0: Uint8 = (0 as Uint8).next_power_of_two() else { @panic("0 has no next power of two") }
    u1: Uint8 = (1 as Uint8).next_power_of_two() else { @panic("1 has no next power of two") }
    u2: Uint8 = (128 as Uint8).next_power_of_two() else { @panic("128 has no next power of two") }
    expect_text($"{p0} {p1} {p2} {p3} {u0} {u1} {u2}", "1 1 1 64 1 1 128")
    if (65 as Int8).next_power_of_two() -> v: Int8 { @panic($"65 rounded up to {v}") }
    if (129 as Uint8).next_power_of_two() -> v: Uint8 { @panic($"129 rounded up to {v}") }
}

test "in global initializers" {
    expect_text($"{const_abs} {const_clamped}", "42 7")
}
